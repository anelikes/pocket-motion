{
  "name": "pocket-motion",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Deterministic video rendering for PocketJS compositions — no browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anelikes/pocket-motion.git"
  },
  "keywords": [
    "pocketjs",
    "video",
    "render",
    "deterministic",
    "captions",
    "motion-graphics",
    "bun"
  ],
  "bin": {
    "pocket-motion": "src/cli/main.ts"
  },
  "exports": {
    ".": {
      "types": "./src/api.ts",
      "bun": "./src/api.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "test": "bun test ./tests/",
    "typecheck": "tsc --noEmit",
    "vendor": "bun scripts/vendor.ts",
    "motion": "bun src/cli/main.ts",
    "catalog": "bun scripts/catalog.ts",
    "pack": "bun scripts/pack.ts",
    "prepack": "echo 'pocket-motion: the checkout is not the package. upstream gitignores vendor/pocketjs/node_modules and hosts/web/pocketjs.wasm, so npm would pack it without either. Run: bun scripts/pack.ts' >&2 && exit 1"
  },
  "devDependencies": {
    "@types/bun": "^1.2",
    "typescript": "^5"
  }
}
