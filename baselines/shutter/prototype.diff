 }
 
+// ---- pocket-motion PROTOTYPE: shutter (stage 1, not a patch) ---------------
+
+static mut SHUTTER_ACC: Vec<u32> = Vec::new();
+static mut EXPOSURE: Vec<u8> = Vec::new();
+static mut SHUTTER_LUT: Vec<u8> = Vec::new();
+
+/// Re-evaluate transform timelines at `num/den` ticks from the frame's tick.
+#[no_mangle]
+pub extern "C" fn ui_shutter_sample(num: i32, den: i32) {
+    if den > 0 {
+        ui().shutter_sample(num as i64, den as i64)
+    }
+}
+
+/// Measurement only: integrate opacity as well as transforms.
+#[no_mangle]
+pub extern "C" fn ui_shutter_integrate_opacity(on: i32) {
+    ui().shutter_integrate_opacity(on != 0)
+}
+
+/// Hold `id`'s timelines at the frame's tick in every sample.
+#[no_mangle]
+pub extern "C" fn ui_shutter_exempt(id: i32) {
+    ui().shutter_exempt(id)
+}
+
+/// Add one straight-alpha RGBA8 sample into the premultiplied accumulator:
+/// per pixel the sums of r*a, g*a, b*a and a, exact in u32 for <= 256 samples.
+/// Four pixels per step: each channel byte is multiplied by its pixel's alpha
+/// (the alpha byte by 1) into u16, then widened and added.
+#[cfg(target_feature = "simd128")]
+fn shutter_accumulate(src: &[u8], acc: &mut [u32]) {
+    use core::arch::wasm32::*;
+    let quads = src.len() / 16;
+    let rgb = u32x4_splat(0x00ff_ffff);
+    let one = u32x4_splat(0x0100_0000);
+    for i in 0..quads {
+        // SAFETY: i*16+16 <= src.len() and acc.len() == src.len(); wasm loads
+        // and stores need no alignment.
+        unsafe {
+            let v = v128_load(src.as_ptr().add(i * 16) as *const v128);
+            let a = i8x16_shuffle::<3, 3, 3, 3, 7, 7, 7, 7, 11, 11, 11, 11, 15, 15, 15, 15>(v, v);
+            let m = v128_bitselect(a, one, rgb);
+            let lo = u16x8_extmul_low_u8x16(v, m);
+            let hi = u16x8_extmul_high_u8x16(v, m);
+            let p = acc.as_mut_ptr().add(i * 16) as *mut v128;
+            v128_store(p, i32x4_add(v128_load(p), u32x4_extend_low_u16x8(lo)));
+            v128_store(p.add(1), i32x4_add(v128_load(p.add(1)), u32x4_extend_high_u16x8(lo)));
+            v128_store(p.add(2), i32x4_add(v128_load(p.add(2)), u32x4_extend_low_u16x8(hi)));
+            v128_store(p.add(3), i32x4_add(v128_load(p.add(3)), u32x4_extend_high_u16x8(hi)));
+        }
+    }
+    shutter_accumulate_scalar(&src[quads * 16..], &mut acc[quads * 16..]);
+}
+
+#[cfg(not(target_feature = "simd128"))]
+fn shutter_accumulate(src: &[u8], acc: &mut [u32]) {
+    shutter_accumulate_scalar(src, acc)
+}
+
+fn shutter_accumulate_scalar(src: &[u8], acc: &mut [u32]) {
+    for (px, a) in src.chunks_exact(4).zip(acc.chunks_exact_mut(4)) {
+        let al = px[3] as u32;
+        a[0] += px[0] as u32 * al;
+        a[1] += px[1] as u32 * al;
+        a[2] += px[2] as u32 * al;
+        a[3] += al;
+    }
+}
+
+/// Resolve `n` accumulated samples to straight-alpha RGBA8, round half up:
+/// a = (2*sum_a + n) / 2n, c = (2*sum_ca + sum_a) / (2*sum_a). A pixel opaque in
+/// every sample takes a table lookup that is the same expression.
+fn shutter_resolve(acc: &[u32], out: &mut [u8], n: u32, lut: &mut Vec<u8>) {
+    lut.clear();
+    // Opaque: sum_ca = 255*sum_c, sum_a = 255n, so c = (2*sum_c + n) / 2n.
+    for sc in 0..=255 * n {
+        lut.push(((2 * sc + n) / (2 * n)) as u8);
+    }
+    let full = 255 * n;
+    for (a, o) in acc.chunks_exact(4).zip(out.chunks_exact_mut(4)) {
+        let sa = a[3];
+        if sa == full {
+            o[0] = lut[(a[0] / 255) as usize];
+            o[1] = lut[(a[1] / 255) as usize];
+            o[2] = lut[(a[2] / 255) as usize];
+            o[3] = 255;
+        } else if sa == 0 {
+            o.copy_from_slice(&[0, 0, 0, 0]);
+        } else {
+            for c in 0..3 {
+                o[c] = ((2 * a[c] as u64 + sa as u64) / (2 * sa as u64)).min(255) as u8;
+            }
+            o[3] = ((2 * sa + n) / (2 * n)) as u8;
+        }
+    }
+}
+
+/// Render one exposure: `samples` renders at offsets centred on the frame's
+/// tick, spread over `span_num/span_den` ticks, averaged. `samples <= 1` (or a
+/// zero span) is `ui_render_scaled` and nothing else.
+#[no_mangle]
+pub extern "C" fn ui_render_exposure(scale: u32, span_num: u32, span_den: u32, samples: u32) -> *const u8 {
+    if samples <= 1 || span_num == 0 {
+        return render_at_scale(scale);
+    }
+    if samples > 256 || span_den == 0 {
+        return core::ptr::null();
+    }
+    let n = samples as i64;
+    unsafe {
+        let mut bytes = 0usize;
+        for k in 0..n {
+            // offset_k = span * (2k + 1 - n) / 2n, centred on the tick
+            let num = span_num as i64 * (2 * k + 1 - n);
+            let den = span_den as i64 * 2 * n;
+            ui().shutter_sample(num, den);
+            let ptr = render_at_scale(scale);
+            if ptr.is_null() {
+                ui().shutter_sample(0, 1);
+                return ptr;
+            }
+            if k == 0 {
+                bytes = FRAMEBUFFER.len();
+                SHUTTER_ACC.clear();
+                SHUTTER_ACC.resize(bytes, 0);
+            }
+            shutter_accumulate(&FRAMEBUFFER[..bytes], &mut SHUTTER_ACC);
+        }
+        ui().shutter_sample(0, 1);
+        EXPOSURE.resize(bytes, 0);
+        shutter_resolve(&SHUTTER_ACC, &mut EXPOSURE, samples, &mut SHUTTER_LUT);
+        EXPOSURE.as_ptr()
+    }
+}
+
 /// Rasterize the primary DrawList at an integer physical scale into RGBA8 that
 /// keeps coverage: the buffer starts transparent, and each pixel ends as
 /// premultiplied R,G,B with the alpha its ops accumulated. The R,G,B bytes
