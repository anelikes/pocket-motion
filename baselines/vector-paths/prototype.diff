+/// styles.bin with `records` (base props only), no anims, and `paths`.
+fn styles_with_paths(records: &[Vec<(u8, u32)>], paths: &[PathEntry]) -> Vec<u8> {
+    use crate::spec::style_table as st;
+    let mut b = Vec::new();
+    b.extend_from_slice(&st::MAGIC.to_le_bytes());
+    b.extend_from_slice(&st::VERSION.to_le_bytes());
+    b.extend_from_slice(&(records.len() as u16).to_le_bytes());
+    b.extend_from_slice(&0u16.to_le_bytes());
+    b.extend_from_slice(&(paths.len() as u16).to_le_bytes());
+    for r in records {
+        b.push(st::VARIANT_BASE);
+        b.push(r.len() as u8);
+        for &(prop, v) in r {
+            b.push(prop);
+            b.push(0);
+            b.extend_from_slice(&v.to_le_bytes());
+        }
+    }
+    PathTable::encode(paths, &mut b);
+    b
+}
