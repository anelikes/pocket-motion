+// ---- PATH: any polygon set, 4×4 samples by winding (pocket-motion) -----------------
+//
+// The sample grid is POLY's: 16 points per pixel at quarter-pixel offsets
+// ±1/8, ±3/8 from the centre, a pixel blends at `a * hits / 16`, and a run of
+// fully covered pixels is one `fill_opaque`. What differs is the predicate.
+// POLY asks every edge function of one convex polygon for F >= 0, which
+// counts a sample lying exactly on an edge as inside for BOTH polygons that
+// share the edge. PATH counts winding over any number of contours, with the
+// top-left convention: an edge counts at sample row Y when ytop <= Y < ybot,
+// and a crossing at x counts for the samples with X >= x. Two paths that
+// share an edge therefore partition its samples — `hits_a + hits_b == 16` on
+// the seam — which an illustration of abutting shapes needs and POLY's
+// inclusive rule cannot give.
+//
+// Coordinates arrive as i32 in 1/256 logical px; times `scale` they are
+// 1/256 physical px, where pixel p spans [256p, 256p + 256) and sample
+// column s sits at X = 64s + 32 (four per pixel). Every crossing is solved
+// exactly in i64: no float enters the coverage.
+
+/// One edge at its first sample row, stepped exactly from row to row.
+///
+/// The crossing's first sample column at row Y is c = ceil(n / D) with
+/// n = x0*den + (Y - y0)*dx - 32*den and D = 64*den. Between sample rows n
+/// grows by S = 64*dx = qs*D + rs, so c and its remainder rem = c*D - n
+/// step by integer adds: c += qs, rem -= rs, and one more column (with
+/// rem += D) when rem goes negative. No division after the first row; the
+/// same value the division would give, every row.
+#[derive(Clone, Copy)]
+struct PathEdge {
+    c: i32,
+    rem: i32,
+    d: i32,
+    qs: i32,
+    rs: i32,
+    /// First and last sample row (inclusive) the edge counts at.
+    r0: i32,
+    r1: i32,
+    dir: i32,
+}
+
+/// Header words of a PATH op: op, len, flags, color, contour count.
+const PATH_HEADER: usize = 5;
+
+/// Walk a PATH op's contours; false when a count disagrees with `len`.
+fn path_contours(op: &[u32], mut f: impl FnMut(&[u32])) -> bool {
+    let count = op[4] as usize;
+    let mut k = PATH_HEADER;
+    for _ in 0..count {
+        let Some(&n) = op.get(k) else {
+            return false;
+        };
+        let n = n as usize;
+        if n == 0 || k + 1 + 2 * n > op.len() {
+            return false;
+        }
+        f(&op[k + 1..k + 1 + 2 * n]);
+        k += 1 + 2 * n;
+    }
+    k == op.len()
+}
+
+/// A PATH op's words are well-formed: header, contour counts summing to `len`.
+pub(crate) fn path_op_valid(op: &[u32]) -> bool {
+    op.len() >= PATH_HEADER && op[1] as usize == op.len() && path_contours(op, |_| {})
+}
+
+/// ceil(a / b) for b > 0.
+#[inline]
+fn ceil_div(a: i64, b: i64) -> i64 {
+    -((-a).div_euclid(b))
+}
