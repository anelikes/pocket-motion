@@ -0,0 +1,1166 @@
+//! Vector path tests (pocket-motion prototype). Each test names the defect
+//! that turns it red.
+
+extern crate std;
+
+use alloc::vec::Vec;
+use std::collections::BTreeMap;
+
+use crate::draw::Affine;
+use crate::path::*;
+use crate::path_scenes::*;
+use crate::raster::{path_rows, poly_hits_rows, Clip, PathRaster};
+use crate::spec::draw_op;
+
+// ---- the reference rasteriser -------------------------------------------------------
+//
+// The rule, written once more without any of the scanline machinery: for a
+// sample (X, Y) in physical 1/256 px, sum `dir` over every edge with
+// ytop <= Y < ybot whose crossing x satisfies X >= x — tested as
+// X * den >= num, no division — and apply the fill rule. One pixel at a
+// time, sixteen samples, every edge. No sorting, no active list, no
+// difference arrays, no clamping to a clip.
+
+type Edge = (i64, i64, i64, i64); // directed, physical 1/256 px
+
+fn op_edges(op: &[u32], scale: i64) -> Vec<Edge> {
+    let mut out = Vec::new();
+    let mut k = 5usize;
+    for _ in 0..op[4] {
+        let n = op[k] as usize;
+        let v = |i: usize| (op[k + 1 + 2 * i] as i32 as i64 * scale, op[k + 2 + 2 * i] as i32 as i64 * scale);
+        for i in 0..n {
+            let (a, b) = (v(if i == 0 { n - 1 } else { i - 1 }), v(i));
+            out.push((a.0, a.1, b.0, b.1));
+        }
+        k += 1 + 2 * n;
+    }
+    out
+}
+
+fn ref_inside(edges: &[Edge], x: i64, y: i64, evenodd: bool) -> bool {
+    let mut w = 0i32;
+    for &(x0, y0, x1, y1) in edges {
+        if y0 == y1 {
+            continue;
+        }
+        let (xa, ya, xb, yb, dir) = if y1 > y0 { (x0, y0, x1, y1, 1) } else { (x1, y1, x0, y0, -1) };
+        if ya <= y && y < yb {
+            let den = yb - ya;
+            let num = xa * den + (y - ya) * (xb - xa);
+            if x * den >= num {
+                w += dir;
+            }
+        }
+    }
+    if evenodd {
+        w & 1 != 0
+    } else {
+        w != 0
+    }
+}
+
+const SAMPLE: [i64; 4] = [32, 96, 160, 224];
+
+fn ref_hits(op: &[u32], scale: i32, clip: Clip) -> BTreeMap<(i32, i32), u8> {
+    let edges = op_edges(op, scale as i64);
+    let evenodd = op[2] & 1 != 0;
+    let mut out = BTreeMap::new();
+    for py in clip.y0..clip.y1 {
+        for px in clip.x0..clip.x1 {
+            let mut h = 0u8;
+            for &sy in &SAMPLE {
+                for &sx in &SAMPLE {
+                    if ref_inside(&edges, 256 * px as i64 + sx, 256 * py as i64 + sy, evenodd) {
+                        h += 1;
+                    }
+                }
+            }
+            if h > 0 {
+                out.insert((px, py), h);
+            }
+        }
+    }
+    out
+}
+
+fn opt_hits(op: &[u32], scale: i32, clip: Clip) -> BTreeMap<(i32, i32), u8> {
+    let mut ras = PathRaster::default();
+    let mut out = BTreeMap::new();
+    path_rows(scale, clip, op, &mut ras, |py, x0, x1, h| {
+        assert!((1..=16).contains(&h) && x1 > x0, "run ({x0}..{x1}, {h})");
+        for x in x0..x1 {
+            assert!(out.insert((x, py), h as u8).is_none(), "pixel ({x},{py}) emitted twice");
+        }
+    });
+    out
+}
+
+/// A PATH op from contours in 1/256 logical px.
+fn op_from(contours: &[Vec<(i32, i32)>], evenodd: bool, color: u32) -> Vec<u32> {
+    let mut w = alloc::vec![draw_op::PATH, 0, evenodd as u32, color, contours.len() as u32];
+    for c in contours {
+        w.push(c.len() as u32);
+        for &(x, y) in c {
+            w.push(x as u32);
+            w.push(y as u32);
+        }
+    }
+    w[1] = w.len() as u32;
+    w
+}
+
+fn clip(x0: i32, y0: i32, x1: i32, y1: i32) -> Clip {
+    Clip { x0, y0, x1, y1 }
+}
+
+/// Random contours on a grid of `g` (1/256 px units), so vertices and
+/// crossings land exactly on sample rows and columns as often as the grid
+/// allows: g = 64 puts vertices ON the sample lattice's rows, g = 256 on
+/// pixel corners, g = 1 anywhere.
+fn random_contours(rng: &mut Rng, g: i32, span: i32, lo: i32) -> Vec<Vec<(i32, i32)>> {
+    let nc = 1 + rng.below(4) as usize;
+    let mut cs = Vec::new();
+    // A coordinate in [lo, lo + span) px, in 1/256 px snapped to the grid.
+    let coord = |rng: &mut Rng| ((lo * 256 + rng.below(span as u64 * 256) as i32).div_euclid(g)) * g;
+    for _ in 0..nc {
+        let n = 2 + rng.below(28) as usize;
+        let mut c = Vec::new();
+        for _ in 0..n {
+            let (x, y) = (coord(rng), coord(rng));
+            c.push((x, y));
+            // Repeats, horizontal runs and spikes, on purpose.
+            match rng.below(10) {
+                0 => c.push((x, y)),
+                1 => c.push((x + g * (1 + rng.below(40) as i32), y)),
+                2 => {
+                    c.push((x - g * rng.below(30) as i32, y + g));
+                    c.push((x, y));
+                }
+                _ => {}
+            }
+        }
+        cs.push(c);
+    }
+    cs
+}
+
+// ---- 1. the scanline equals the reference ----------------------------------------
+
+#[test]
+fn path_coverage_equals_the_brute_force_reference() {
+    // Red if the scanline drops a crossing, rounds a ceil the wrong way,
+    // mishandles a horizontal edge, a vertex on a sample row, a crossing
+    // left of the clip, a pixel boundary in the difference arrays, or a
+    // fill rule — any of those changes a hit count somewhere in the sweep.
+    let mut rng = Rng(0x0123_4567_89ab_cdef);
+    let grids = [256, 128, 64, 32, 85, 1];
+    let mut cases = 0;
+    let mut pixels = 0usize;
+    for case in 0..480 {
+        let g = grids[case % grids.len()];
+        let scale = 1 + (case / grids.len()) as i32 % 3;
+        let cs = random_contours(&mut rng, g, 56, -8);
+        let op = op_from(&cs, case % 2 == 1, 0xffff_ffff);
+        let size = 40 * scale;
+        let c = if case % 5 == 0 {
+            let x0 = rng.below(size as u64 / 2) as i32;
+            let y0 = rng.below(size as u64 / 2) as i32;
+            clip(x0, y0, x0 + 1 + rng.below(size as u64 / 2) as i32, y0 + 1 + rng.below(size as u64 / 2) as i32)
+        } else {
+            clip(0, 0, size, size)
+        };
+        let want = ref_hits(&op, scale, c);
+        let got = opt_hits(&op, scale, c);
+        assert_eq!(got, want, "case {case}: grid {g}, scale {scale}, contours {cs:?}");
+        pixels += want.len();
+        cases += 1;
+    }
+    assert_eq!(cases, 480);
+    assert!(pixels > 100_000, "the sweep covers pixels: {pixels}");
+}
+
+#[test]
+fn path_blends_each_pixel_at_a_times_hits_over_16() {
+    // The framebuffer a PATH op leaves equals one built from the reference
+    // hits with 1x1 RECTs of alpha a*h/16 (opaque runs are fill_opaque,
+    // which RECT also takes at alpha 255). Red if the row emitter skips a
+    // pixel, merges a partial pixel into an opaque run, or blends a full
+    // pixel of a translucent colour at anything but a.
+    let mut rng = Rng(77);
+    for case in 0..40 {
+        let cs = random_contours(&mut rng, [256, 16, 1][case % 3], 60, 0);
+        let alpha = [255u32, 180, 37][case % 3];
+        let color = abgr(200, 120, 40, alpha);
+        let op = op_from(&cs, case % 2 == 0, color);
+        let mut words = Vec::new();
+        ground(&mut words, 64, 64, abgr(10, 20, 30, 255));
+        let mut expect = words.clone();
+        words.extend_from_slice(&op);
+        for ((x, y), h) in ref_hits(&op, 1, clip(0, 0, 64, 64)) {
+            let a = alpha * h as u32 / 16;
+            expect.extend_from_slice(&[draw_op::RECT, (x as u32) | ((y as u32) << 16), 1 | (1 << 16), (color & 0x00ff_ffff) | (a << 24)]);
+        }
+        assert_eq!(render(&words, 64, 64, 1), render(&expect, 64, 64, 1), "case {case}");
+    }
+}
+
+// ---- 2. against POLY ------------------------------------------------------------------
+
+/// POLY's predicate for a convex polygon: every edge function >= 0 (the
+/// inclusive rule), at doubled-pixel... here at 1/256 px, exactly.
+fn inclusive_inside(verts: &[(i64, i64)], x: i64, y: i64) -> (bool, bool) {
+    let n = verts.len();
+    let mut area = 0i64;
+    for i in 0..n {
+        let (a, b) = (verts[i], verts[(i + 1) % n]);
+        area += a.0 * b.1 - b.0 * a.1;
+    }
+    let sign = if area > 0 { 1 } else { -1 };
+    let mut on_edge = false;
+    for i in 0..n {
+        let (a, b) = (verts[i], verts[(i + 1) % n]);
+        let f = ((b.0 - a.0) * (y - a.1) - (b.1 - a.1) * (x - a.0)) * sign;
+        if f < 0 {
+            return (false, false);
+        }
+        if f == 0 {
+            on_edge = true;
+        }
+    }
+    (true, on_edge)
+}
+
+fn convex_hull(mut p: Vec<(i32, i32)>) -> Vec<(i32, i32)> {
+    p.sort();
+    p.dedup();
+    if p.len() < 3 {
+        return p;
+    }
+    let cross = |o: (i32, i32), a: (i32, i32), b: (i32, i32)| (a.0 - o.0) as i64 * (b.1 - o.1) as i64 - (a.1 - o.1) as i64 * (b.0 - o.0) as i64;
+    let mut lower: Vec<(i32, i32)> = Vec::new();
+    for &q in &p {
+        while lower.len() >= 2 && cross(lower[lower.len() - 2], lower[lower.len() - 1], q) <= 0 {
+            lower.pop();
+        }
+        lower.push(q);
+    }
+    let mut upper: Vec<(i32, i32)> = Vec::new();
+    for &q in p.iter().rev() {
+        while upper.len() >= 2 && cross(upper[upper.len() - 2], upper[upper.len() - 1], q) <= 0 {
+            upper.pop();
+        }
+        upper.push(q);
+    }
+    lower.pop();
+    upper.pop();
+    lower.extend(upper);
+    lower
+}
+
+#[test]
+fn convex_path_counts_what_poly_counts_except_samples_on_its_right_and_bottom_edges() {
+    // Same lattice, same 16 levels, same polygon: the hit count differs only
+    // by samples lying EXACTLY on an edge, which POLY counts for every edge
+    // and PATH for top and left ones (the partition rule). Red if PATH's
+    // sample lattice is offset from POLY's, its scale mapping differs, or it
+    // loses or gains any sample off the boundary.
+    let mut rng = Rng(0xfeed);
+    let (mut differing_pixels, mut covered_pixels, mut tie_samples) = (0usize, 0usize, 0usize);
+    let mut polys = 0;
+    while polys < 300 {
+        let k = 3 + rng.below(9) as usize;
+        let pts: Vec<(i32, i32)> = (0..k).map(|_| (rng.below(48) as i32, rng.below(48) as i32)).collect();
+        let mut hull = convex_hull(pts);
+        if hull.len() < 3 || hull.len() > 8 {
+            continue;
+        }
+        if rng.below(2) == 0 {
+            hull.reverse();
+        }
+        polys += 1;
+        let scale = 1 + (polys % 3) as i32;
+        let c = clip(0, 0, 48 * scale, 48 * scale);
+        let words: Vec<u32> = hull.iter().map(|&(x, y)| (x as u32) | ((y as u32) << 16)).collect();
+        let mut poly = BTreeMap::new();
+        poly_hits_rows(scale, c, &words, |y, x, h| {
+            if h > 0 {
+                poly.insert((x, y), h as u8);
+            }
+        });
+        let op = op_from(&[hull.iter().map(|&(x, y)| (x * 256, y * 256)).collect()], false, 0xffff_ffff);
+        let path = opt_hits(&op, scale, c);
+        let verts: Vec<(i64, i64)> = hull.iter().map(|&(x, y)| (x as i64 * 256 * scale as i64, y as i64 * 256 * scale as i64)).collect();
+        let edges = op_edges(&op, scale as i64);
+        for py in c.y0..c.y1 {
+            for px in c.x0..c.x1 {
+                let (mut inc, mut tl, mut ties_here) = (0u8, 0u8, 0usize);
+                for &sy in &SAMPLE {
+                    for &sx in &SAMPLE {
+                        let (x, y) = (256 * px as i64 + sx, 256 * py as i64 + sy);
+                        let (i_in, on) = inclusive_inside(&verts, x, y);
+                        let t_in = ref_inside(&edges, x, y, false);
+                        assert!(!t_in || i_in, "PATH has a sample POLY does not: {hull:?} at ({x},{y})");
+                        if i_in != t_in {
+                            assert!(on, "a disagreement off the boundary: {hull:?} at ({x},{y})");
+                            ties_here += 1;
+                        }
+                        inc += i_in as u8;
+                        tl += t_in as u8;
+                    }
+                }
+                assert_eq!(poly.get(&(px, py)).copied().unwrap_or(0), inc, "POLY's own hits are the inclusive count");
+                assert_eq!(path.get(&(px, py)).copied().unwrap_or(0), tl, "PATH's hits are the top-left count");
+                tie_samples += ties_here;
+                if inc > 0 {
+                    covered_pixels += 1;
+                }
+                if inc != tl {
+                    differing_pixels += 1;
+                }
+            }
+        }
+    }
+    std::println!("POLY vs PATH over 300 convex integer polygons: {differing_pixels} of {covered_pixels} covered pixels differ, by {tie_samples} on-edge samples");
+}
+
+#[test]
+fn abutting_paths_partition_the_samples_of_their_shared_edge() {
+    // A convex polygon cut along a diagonal into two ops: on every pixel the
+    // two counts add up to the whole's. Red under POLY's inclusive rule (the
+    // diagonal's on-edge samples would count twice) and red if the top-left
+    // convention were applied to one orientation only.
+    let mut rng = Rng(0xab0e);
+    let mut cases = 0;
+    let mut seam_ties = 0usize;
+    while cases < 300 {
+        let k = 4 + rng.below(8) as usize;
+        let g = [256, 64, 1][cases % 3];
+        let pts: Vec<(i32, i32)> = (0..k).map(|_| (rng.below(40 * 256) as i32 / g * g, rng.below(40 * 256) as i32 / g * g)).collect();
+        let hull = convex_hull(pts);
+        if hull.len() < 4 {
+            continue;
+        }
+        cases += 1;
+        let cut = 2 + rng.below(hull.len() as u64 - 3) as usize;
+        let mut a: Vec<(i32, i32)> = hull[..=cut].to_vec();
+        let mut b: Vec<(i32, i32)> = hull[cut..].to_vec();
+        b.push(hull[0]);
+        if rng.below(2) == 0 {
+            a.reverse();
+        }
+        if rng.below(2) == 0 {
+            b.reverse();
+        }
+        let scale = 1 + (cases % 2) as i32;
+        let c = clip(0, 0, 41 * scale, 41 * scale);
+        let whole = opt_hits(&op_from(&[hull.clone()], false, !0), scale, c);
+        let ha = opt_hits(&op_from(&[a], false, !0), scale, c);
+        let hb = opt_hits(&op_from(&[b], false, !0), scale, c);
+        for py in c.y0..c.y1 {
+            for px in c.x0..c.x1 {
+                let (wa, wb) = (ha.get(&(px, py)).copied().unwrap_or(0), hb.get(&(px, py)).copied().unwrap_or(0));
+                let w = whole.get(&(px, py)).copied().unwrap_or(0);
+                assert_eq!(wa + wb, w, "pixel ({px},{py}) of {hull:?} cut at {cut}");
+                if wa > 0 && wb > 0 {
+                    seam_ties += 1;
+                }
+            }
+        }
+    }
+    assert!(seam_ties > 1000, "the sweep crosses seams: {seam_ties}");
+}
+
+// ---- 3. stroke: the union, and the offset ---------------------------------------------
+
+fn q(v: f32) -> i64 {
+    floor_i32(v * PATH_UNITS + 0.5) as i64
+}
+
+fn convex_contains(poly: &[(i64, i64)], x: i64, y: i64) -> Option<(bool, bool)> {
+    let n = poly.len();
+    let mut area = 0i64;
+    for i in 0..n {
+        let (a, b) = (poly[i], poly[(i + 1) % n]);
+        area += a.0 * b.1 - b.0 * a.1;
+    }
+    if area == 0 {
+        return None;
+    }
+    let sign = if area > 0 { 1 } else { -1 };
+    let mut on = false;
+    for i in 0..n {
+        let (a, b) = (poly[i], poly[(i + 1) % n]);
+        let f = ((b.0 - a.0) * (y - a.1) - (b.1 - a.1) * (x - a.0)) * sign;
+        if f < 0 {
+            return Some((false, false));
+        }
+        if f == 0 {
+            on = true;
+        }
+    }
+    Some((true, on))
+}
+
+/// Distance in 1/256 px from (x, y) to segment a-b.
+fn seg_dist(a: (i64, i64), b: (i64, i64), x: i64, y: i64) -> f64 {
+    dist_to_segment((x as f64, y as f64), (a.0 as f64, a.1 as f64), (b.0 as f64, b.1 as f64))
+}
+
+fn random_polyline(rng: &mut Rng, n: usize, lo: f32, hi: f32, short: bool) -> Vec<Pt> {
+    let mut v = Vec::new();
+    let mut p = pt(rng.range(lo, hi), rng.range(lo, hi));
+    for _ in 0..n {
+        v.push(p);
+        let step = if short && rng.below(3) == 0 { rng.range(0.2, 3.0) } else { rng.range(4.0, 30.0) };
+        let mut np = pt(p.x + rng.range(-1.0, 1.0) * step, p.y + rng.range(-1.0, 1.0) * step);
+        np.x = np.x.clamp(lo, hi);
+        np.y = np.y.clamp(lo, hi);
+        if rng.below(12) == 0 {
+            np = v[v.len() - 1]; // a repeated point
+        }
+        if rng.below(10) == 0 && v.len() > 1 {
+            np = v[v.len() - 2]; // an exact reversal
+        }
+        p = np;
+    }
+    v
+}
