+/// Reused buffers for PATH coverage.
+#[derive(Default)]
+pub(crate) struct PathRaster {
+    edges: Vec<PathEdge>,
+    /// Edge indices bucketed by first sample row (counting sort).
+    order: Vec<u32>,
+    starts: Vec<u32>,
+    fill: Vec<u32>,
+    active: Vec<PathEdge>,
+    /// Interval ends of one pixel row's four sample rows: (column, +1|-1),
+    /// each sample row's run sorted; `row_ends` closes each run.
+    events: Vec<(i64, i32)>,
+    row_ends: [usize; 4],
+    merged: Vec<(i64, i32)>,
+    pair: Vec<(i64, i32)>,
+}
+
+/// Merge two sorted runs of interval ends.
+fn merge_ends(a: &[(i64, i32)], b: &[(i64, i32)], out: &mut Vec<(i64, i32)>) {
+    out.clear();
+    let (mut i, mut j) = (0, 0);
+    while i < a.len() && j < b.len() {
+        if a[i].0 <= b[j].0 {
+            out.push(a[i]);
+            i += 1;
+        } else {
+            out.push(b[j]);
+            j += 1;
+        }
+    }
+    out.extend_from_slice(&a[i..]);
+    out.extend_from_slice(&b[j..]);
+}
+
+/// Coverage of one PATH op as runs: `emit(py, x0, x1, hits)` for pixels
+/// `x0..x1` of physical row `py`, all with `hits` (1..=16) samples inside by
+/// the op's fill rule; runs come left to right, no pixel twice. Rows and
+/// columns are limited to `clip`; crossings left of it still count.
+///
+/// Per sample row the active edges, kept in crossing order, give the inside
+/// intervals; their ends from the pixel row's four sample rows are swept
+/// once, so a pixel's count is the sum over its four sample columns of how
+/// many sample rows are inside there. A run of whole pixels between two
+/// ends is emitted as one run — a solid interior is one `fill_opaque`, and
+/// the hole of a ring costs nothing.
+pub(crate) fn path_rows(scale: i32, clip: Clip, op: &[u32], ras: &mut PathRaster, mut emit: impl FnMut(i32, i32, i32, u32)) {
+    let evenodd = op[2] & 1 != 0;
+    let sc = scale as i64;
+    // The op's bounds first: they decide the rows an edge is clipped to.
+    let (mut bx0, mut by0, mut bx1, mut by1) = (i64::MAX, i64::MAX, i64::MIN, i64::MIN);
+    path_contours(op, |c| {
+        for v in c.chunks(2) {
+            let (x, y) = (v[0] as i32 as i64 * sc, v[1] as i32 as i64 * sc);
+            bx0 = bx0.min(x);
+            by0 = by0.min(y);
+            bx1 = bx1.max(x);
+            by1 = by1.max(y);
+        }
+    });
+    if bx0 > bx1 {
+        return;
+    }
+    let px0 = (bx0.div_euclid(256) as i32).max(clip.x0);
+    let px1 = (ceil_div(bx1, 256) as i32).min(clip.x1);
+    let py0 = (by0.div_euclid(256) as i32).max(clip.y0);
+    let py1 = (ceil_div(by1, 256) as i32).min(clip.y1);
+    if px0 >= px1 || py0 >= py1 {
+        return;
+    }
+    // Sample rows R = 4*py + j sit at Y = 64R + 32.
+    let (rlo, rhi) = (4 * py0, 4 * py1);
+    ras.edges.clear();
+    let edges = &mut ras.edges;
+    path_contours(op, |c| {
+        let n = c.len() / 2;
+        let at = |i: usize| (c[2 * i] as i32 as i64 * sc, c[2 * i + 1] as i32 as i64 * sc);
+        let mut prev = at(n - 1);
+        for i in 0..n {
+            let cur = at(i);
+            let (a, b, dir) = if cur.1 > prev.1 {
+                (prev, cur, 1)
+            } else {
+                (cur, prev, -1)
+            };
+            prev = cur;
+            if a.1 == b.1 {
+                continue;
+            }
+            // Rows with ytop <= Y < ybot: R from ceil((ytop-32)/64) to
+            // ceil((ybot-32)/64) - 1. An edge between two sample rows counts
+            // nowhere and is dropped here.
+            let r0 = (ceil_div(a.1 - 32, 64) as i32).max(rlo);
+            let r1 = (ceil_div(b.1 - 32, 64) as i32 - 1).min(rhi - 1);
+            if r0 > r1 {
+                continue;
+            }
+            let den = b.1 - a.1;
+            let dx = b.0 - a.0;
+            let d = 64 * den;
+            let y = 64 * r0 as i64 + 32;
+            let num = a.0 * den + (y - a.1) * dx - 32 * den;
+            let c0 = ceil_div(num, d);
+            let s = 64 * dx;
+            let qs = s.div_euclid(d);
+            // Every one of these fits an i32: coordinates are clipped to the
+            // guard band (|x| < 2^20 at scale 4), so d = 64*den < 2^27 and
+            // c, a sample column, < 2^23.
+            edges.push(PathEdge {
+                c: c0 as i32,
+                rem: (c0 * d - num) as i32,
+                d: d as i32,
+                qs: qs as i32,
+                rs: (s - qs * d) as i32,
+                r0,
+                r1,
+                dir,
+            });
+        }
+    });
+    if ras.edges.is_empty() {
+        return;
+    }
+    // Counting sort by first row.
+    let nrows = (rhi - rlo) as usize;
+    ras.starts.clear();
+    ras.starts.resize(nrows + 1, 0);
+    for e in ras.edges.iter() {
+        ras.starts[(e.r0 - rlo) as usize + 1] += 1;
+    }
+    for k in 0..nrows {
+        ras.starts[k + 1] += ras.starts[k];
+    }
+    ras.order.clear();
+    ras.order.resize(ras.edges.len(), 0);
+    ras.fill.clear();
+    ras.fill.extend_from_slice(&ras.starts[..nrows]);
+    for (i, e) in ras.edges.iter().enumerate() {
+        let k = (e.r0 - rlo) as usize;
+        ras.order[ras.fill[k] as usize] = i as u32;
+        ras.fill[k] += 1;
+    }
+    let (s_lo, s_hi) = (4 * px0 as i64, 4 * px1 as i64);
+    ras.active.clear();
+    ras.events.clear();
+    let inside = |w: i32| if evenodd { w & 1 != 0 } else { w != 0 };
+    for r in rlo..rhi {
+        // Step the edges carried from the row above; drop the finished.
+        let a = &mut ras.active;
+        let mut keep = 0usize;
+        for i in 0..a.len() {
+            let mut e = a[i];
+            if e.r1 < r {
+                continue;
+            }
+            e.c += e.qs;
+            e.rem -= e.rs;
+            let carry = (e.rem < 0) as i32;
+            e.rem += carry * e.d;
+            e.c += carry;
+            a[keep] = e;
+            keep += 1;
+        }
+        a.truncate(keep);
+        let k = (r - rlo) as usize;
+        for &i in &ras.order[ras.starts[k] as usize..ras.starts[k + 1] as usize] {
+            a.push(ras.edges[i as usize]);
+        }
+        if !a.is_empty() {
+            // Insertion sort: the order from the row above is nearly right.
+            for i in 1..a.len() {
+                let mut j = i;
+                while j > 0 && a[j - 1].c > a[j].c {
+                    a.swap(j - 1, j);
+                    j -= 1;
+                }
+            }
+            // Every change of inside-ness is an interval end: +1 where the
+            // fill rule turns on, -1 where it turns off. Appended without a
+            // branch (the slot is written, the length advances only on a
+            // change), because which edges change it is data, not a pattern.
+            let base = ras.events.len();
+            ras.events.resize(base + a.len(), (0, 0));
+            let ev = &mut ras.events[base..];
+            let mut n = 0usize;
+            let mut w = 0i32;
+            let mut was = 0i32;
+            for e in a.iter() {
+                w += e.dir;
+                let now = inside(w) as i32;
+                ev[n] = ((e.c as i64).clamp(s_lo, s_hi), now - was);
+                n += (now != was) as usize;
+                was = now;
+            }
+            ras.events.truncate(base + n);
+        }
+        ras.row_ends[(r & 3) as usize] = ras.events.len();
+        // The fourth sample row closes a pixel row: sweep its interval ends.
+        if r & 3 == 3 && !ras.events.is_empty() {
+            // Four sorted runs, merged pairwise in linear time (an insertion
+            // sort of their concatenation is quadratic once they interleave).
+            let [e0, e1, e2, _] = ras.row_ends;
+            merge_ends(&ras.events[..e0], &ras.events[e0..e1], &mut ras.merged);
+            merge_ends(&ras.events[e1..e2], &ras.events[e2..], &mut ras.pair);
+            let (m, q) = (core::mem::take(&mut ras.merged), core::mem::take(&mut ras.pair));
+            merge_ends(&m, &q, &mut ras.events);
+            ras.merged = m;
+            ras.pair = q;
+            let ev = &mut ras.events;
+            let py = r >> 2;
+            // The pixel being accumulated and its count so far.
+            let (mut acc_px, mut acc) = (i64::MIN, 0u32);
+            let mut k = 0u32;
+            let mut prev = ev[0].0;
+            let mut i = 0usize;
+            while i < ev.len() {
+                let x = ev[i].0;
+                if x > prev && k > 0 {
+                    // Sample columns prev..x carry k inside rows each.
+                    let (pa, pb) = (prev >> 2, x >> 2);
+                    if pa == pb {
+                        if acc_px != pa {
+                            if acc > 0 {
+                                emit(py, acc_px as i32, acc_px as i32 + 1, acc);
+                            }
+                            acc_px = pa;
+                            acc = 0;
+                        }
+                        acc += k * (x - prev) as u32;
+                    } else {
+                        let head = k * (4 - (prev & 3)) as u32;
+                        if acc_px != pa {
+                            if acc > 0 {
+                                emit(py, acc_px as i32, acc_px as i32 + 1, acc);
+                            }
+                            acc_px = pa;
+                            acc = 0;
+                        }
+                        acc += head;
+                        emit(py, acc_px as i32, acc_px as i32 + 1, acc);
+                        if pb > pa + 1 {
+                            emit(py, (pa + 1) as i32, pb as i32, 4 * k);
+                        }
+                        acc_px = pb;
+                        acc = k * (x & 3) as u32;
+                    }
+                }
+                while i < ev.len() && ev[i].0 == x {
+                    k = (k as i32 + ev[i].1) as u32;
+                    i += 1;
+                }
+                prev = x;
+            }
+            if acc > 0 {
+                emit(py, acc_px as i32, acc_px as i32 + 1, acc);
+            }
+            ev.clear();
+        }
+    }
+}
+
+fn path_fill<T: RenderTarget>(target: &mut T, stride: i32, scale: i32, clip: Clip, op: &[u32], ras: &mut PathRaster) {
+    let (r, g, b, a) = channels(op[3]);
+    if a == 0 {
+        return;
+    }
+    let opaque = a >= 255;
+    path_rows(scale, clip, op, ras, |py, x0, x1, h| {
+        let base = py * stride;
+        if h >= 16 && opaque {
+            target.fill_opaque((base + x0) as usize, (x1 - x0) as usize, r, g, b);
+        } else {
+            let a = a * h / 16;
+            for x in x0..x1 {
+                target.blend((base + x) as usize, r, g, b, a);
+            }
+        }
+    });
+}
