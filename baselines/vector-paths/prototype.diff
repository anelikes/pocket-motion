+// ---- the dense illustration (cost and digest) ------------------------------------
+
+pub const DENSE_W: u32 = 1920;
+pub const DENSE_H: u32 = 1080;
+pub const DENSE_PATHS: usize = 300;
+/// Cubic segments per path; 300 x 67 = 20,100.
+pub const DENSE_SEGS: usize = 67;
+
+/// Which dense illustration: the stress case (spiky blobs, ~4.4x overdraw),
+/// a flat-vector one (smooth blobs, ~1.4x coverage), or line art (open
+/// curves, stroked only).
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Dense {
+    Spiky,
+    Smooth,
+    LineArt,
+}
+
+/// The 300 entries, 67 cubics each (20,100), two shapes (morph keys).
+pub fn dense_entries() -> Vec<(PathEntry, Affine, u32, u32, f32)> {
+    dense_entries_of(Dense::Spiky)
+}
+
+pub fn dense_entries_of(kind: Dense) -> Vec<(PathEntry, Affine, u32, u32, f32)> {
+    let mut rng = Rng(0x5eed_1234_abcd_0001);
+    let mut out = Vec::with_capacity(DENSE_PATHS);
+    let (rlo, rhi, wlo, whi) = match kind {
+        Dense::Spiky => (20.0, 160.0, 0.75, 1.15),
+        Dense::Smooth => (10.0, 90.0, 0.97, 1.03),
+        Dense::LineArt => (40.0, 140.0, 0.0, 0.0),
+    };
+    for _ in 0..DENSE_PATHS {
+        let r = rng.range(rlo, rhi);
+        let cx = rng.range(0.0, DENSE_W as f32);
+        let cy = rng.range(0.0, DENSE_H as f32);
+        let mut shapes = [Shape::default(), Shape::default()];
+        if kind == Dense::LineArt {
+            // A meandering open curve: 67 cubics, tangent-continuous, each
+            // a step of about r/20 in a slowly turning direction.
+            for sh in shapes.iter_mut() {
+                let (mut x, mut y) = (-r, 0.0f32);
+                let mut a = rng.range(-1.0, 1.0);
+                let step = r / 20.0;
+                sh.m(x, y);
+                let (mut tx, mut ty) = (cos_any(a), sin_any(a));
+                for _ in 0..DENSE_SEGS {
+                    a += rng.range(-0.6, 0.6);
+                    let (nx, ny) = (cos_any(a), sin_any(a));
+                    let (ex, ey) = (x + step * nx * 3.0, y + step * ny * 3.0);
+                    sh.c(x + step * tx, y + step * ty, ex - step * nx, ey - step * ny, ex, ey);
+                    x = ex;
+                    y = ey;
+                    tx = nx;
+                    ty = ny;
+                }
+            }
+        } else {
+            let a = 2.0 * core::f32::consts::PI / DENSE_SEGS as f32;
+            let (c, s) = (cos_poly(a), sin_poly(a));
+            let h = 0.3 * a; // handle length per unit radius, roughly circular
+            for sh in shapes.iter_mut() {
+                let wob: Vec<f32> = (0..DENSE_SEGS).map(|_| rng.range(wlo, whi)).collect();
+                let (mut ux, mut uy) = (1.0f32, 0.0f32);
+                let rad = |k: usize| r * wob[k % DENSE_SEGS];
+                sh.m(rad(0) * ux, rad(0) * uy);
+                for k in 0..DENSE_SEGS {
+                    let (vx, vy) = (ux * c - uy * s, ux * s + uy * c);
+                    let (r0, r1) = (rad(k), rad(k + 1));
+                    sh.c(
+                        r0 * (ux - h * uy),
+                        r0 * (uy + h * ux),
+                        r1 * (vx + h * vy),
+                        r1 * (vy - h * vx),
+                        r1 * vx,
+                        r1 * vy,
+                    );
+                    ux = vx;
+                    uy = vy;
+                }
+                sh.z();
+            }
+        }
+        let e = morph_entry(&[&shapes[0], &shapes[1]]);
+        let rot = rng.range(0.0, 360.0);
+        let xf = rotation(rot, 1.0, 1.0, cx, cy);
+        let fill = if kind == Dense::LineArt { 0 } else { abgr(rng.below(256) as u32, rng.below(256) as u32, rng.below(256) as u32, 255) };
+        let stroke = abgr(rng.below(256) as u32, rng.below(256) as u32, rng.below(256) as u32, 255);
+        let width = rng.range(1.5, 6.0);
+        out.push((e, xf, fill, stroke, width));
+    }
+    out
+}
+
+/// One frame of the dense illustration: every path filled and stroked; for
+/// `frame > 0` the morph, the trim window and a rotation move with it.
+pub fn dense(frame: u32, scale: u32) -> (Vec<u32>, u32, u32, u32) {
+    let entries = dense_entries();
+    let (words, _) = dense_words(&entries, frame);
+    (words, DENSE_W, DENSE_H, scale)
+}
+
+pub fn dense_words(entries: &[(PathEntry, Affine, u32, u32, f32)], frame: u32) -> (Vec<u32>, PathStats) {
+    let screen = (DENSE_W as f32, DENSE_H as f32);
+    let mut w = Vec::with_capacity(1 << 20);
+    ground(&mut w, DENSE_W, DENSE_H, abgr(12, 12, 16, 255));
+    let mut st = PathStats::default();
+    let mut sc = PathScratch::default();
+    let t = frame as f32 / 60.0;
+    for (k, (e, xf, fill, stroke, width)) in entries.iter().enumerate() {
+        let mut p = PathPaint {
+            morph: if frame == 0 { 0.0 } else { 0.5 + 0.5 * sin_any(t * 3.0 + k as f32 * 0.1) },
+            fill: *fill,
+            evenodd: false,
+            stroke: *stroke,
+            stroke_style: StrokeStyle { width: *width, join: Join::Round, cap: Cap::Round, miter_limit: 4.0 },
+            trim: Trim::NONE,
+        };
+        let mut xf = *xf;
+        if frame > 0 {
+            p.trim = Trim { start: 0.0, end: 0.2 + 0.6 * (0.5 + 0.5 * sin_any(t + k as f32)), offset: t * 0.25, mode: TrimMode::Each };
+            let r = rotation(frame as f32 * 0.7, 1.0, 1.0, 0.0, 0.0);
+            xf = Affine {
+                a: xf.a * r.a + xf.c * r.b,
+                b: xf.b * r.a + xf.d * r.b,
+                c: xf.a * r.c + xf.c * r.d,
+                d: xf.b * r.c + xf.d * r.d,
+                tx: xf.tx,
+                ty: xf.ty,
+            };
+        }
+        emit_path(&mut w, e, 0.0, 0.0, &xf, &p, screen, &mut sc, &mut st);
+    }
+    (w, st)
+}
+
+/// (words digest, framebuffer digest) of scene `i`.
+pub fn scene_digest(i: usize) -> (u64, u64) {
+    let (words, w, h, scale) = scene(i);
+    let fb = render(&words, w, h, scale);
+    (words_digest(&words), fnv64(&fb))
+}
