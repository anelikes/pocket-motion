diff --git a/engine/core/src/path.rs b/engine/core/src/path.rs
new file mode 100644
index 0000000..0902776
--- /dev/null
+++ b/engine/core/src/path.rs
@@ -0,0 +1,1296 @@
+//! Vector paths (pocket-motion prototype; design in
+//! docs/vector-paths.design.md of the pocket-motion repository).
+//!
+//! A path is baked by the compiler into a PATH TABLE entry: verbs (move,
+//! line, cubic, close) and one or more SHAPES — the same verbs with
+//! different points, which `morph` interpolates. Per frame the core:
+//!
+//!   1. interpolates the control points (morph);
+//!   2. flattens cubics into chords in the path's LOCAL space, with a
+//!      tolerance divided by a bound on the transform's scale, so the chord
+//!      count does not depend on rotation;
+//!   3. trims the flattened subpaths by arc length (stroke only);
+//!   4. outlines the stroke as one cycle per open subpath (two per closed
+//!      one) whose winding is the SUM of positively wound segment quads and
+//!      join/cap wedges — so a nonzero fill of the cycle is their union,
+//!      whatever the curvature, with no boolean geometry;
+//!   5. maps the result through the node's world affine, clips it to a guard
+//!      rect around the viewport and quantises to 1/256 logical px;
+//!
+//! and emits PATH ops, which the rasteriser fills by sample winding
+//! (`raster.rs`, `path_fill`).
+//!
+//! Determinism: f32 add/sub/mul/div, comparisons, and a Newton square root
+//! — no libm, no transcendental, no FMA (Rust never contracts `a * b + c`).
+//! No NaN reaches an output: every divisor is checked first and a
+//! non-finite point drops the op, because NaN bit patterns are the one f32
+//! result that differs between x86, ARM and wasm.
+
+use alloc::vec::Vec;
+
+use crate::draw::Affine;
+use crate::spec;
+
+// ---- verbs and the baked entry -------------------------------------------------
+
+pub const VERB_MOVE: u8 = 0;
+pub const VERB_LINE: u8 = 1;
+pub const VERB_CUBIC: u8 = 2;
+pub const VERB_CLOSE: u8 = 3;
+
+/// Points a verb consumes.
+#[inline]
+pub fn verb_points(v: u8) -> usize {
+    match v {
+        VERB_MOVE | VERB_LINE => 1,
+        VERB_CUBIC => 3,
+        _ => 0,
+    }
+}
+
+/// Most shapes one entry may carry (morph keys).
+pub const PATH_MAX_SHAPES: usize = 8;
+
+/// Flattening tolerance in LOGICAL px: the largest distance a chord may sit
+/// from its curve, and a join or cap arc from its circle.
+pub const FLATTEN_TOL: f32 = 1.0 / 16.0;
+
+/// Most chords one cubic may become.
+pub const CUBIC_MAX_STEPS: usize = 256;
+
+/// Deepest bisection of a round join or a quarter cap: 2^7 chords.
+const ARC_MAX_LEVELS: u32 = 7;
+
+/// Guard band around the viewport, in logical px, outside which emitted
+/// geometry is clipped (Sutherland-Hodgman preserves winding inside).
+const GUARD: f32 = 4.0;
+
+/// One quantum of an emitted coordinate: 1/256 logical px.
+pub const PATH_UNITS: f32 = 256.0;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Pt {
+    pub x: f32,
+    pub y: f32,
+}
+
+#[inline]
+pub const fn pt(x: f32, y: f32) -> Pt {
+    Pt { x, y }
+}
+
+/// One PATH TABLE entry.
+#[derive(Clone, Debug)]
+pub struct PathEntry {
+    pub verbs: Vec<u8>,
+    /// Morph keys (>= 1).
+    pub shapes: usize,
+    /// Points per shape.
+    pub npts: usize,
+    /// shapes x npts x (x, y), shape-major.
+    pub coords: Vec<f32>,
+    /// (x, y, w, h): the coordinates' frame, mapped onto the node's box
+    /// (xMidYMid meet). None: coordinates are the node's local px.
+    pub view_box: Option<[f32; 4]>,
+}
+
+impl PathEntry {
+    /// Validates the verb stream against the shapes: starts with a move,
+    /// every shape carries exactly the points the verbs consume, every
+    /// coordinate finite.
+    pub fn new(verbs: Vec<u8>, shapes: &[Vec<Pt>], view_box: Option<[f32; 4]>) -> Option<PathEntry> {
+        if shapes.is_empty() || shapes.len() > PATH_MAX_SHAPES || verbs.first() != Some(&VERB_MOVE) {
+            return None;
+        }
+        let mut npts = 0usize;
+        for &v in &verbs {
+            if v > VERB_CLOSE {
+                return None;
+            }
+            npts += verb_points(v);
+        }
+        let mut coords = Vec::with_capacity(shapes.len() * npts * 2);
+        for s in shapes {
+            if s.len() != npts {
+                return None;
+            }
+            for p in s {
+                if !p.x.is_finite() || !p.y.is_finite() {
+                    return None;
+                }
+                coords.push(p.x);
+                coords.push(p.y);
+            }
+        }
+        if let Some(vb) = view_box {
+            if !(vb[2] > 0.0 && vb[3] > 0.0) || !vb[0].is_finite() || !vb[1].is_finite() || !vb[2].is_finite() || !vb[3].is_finite() {
+                return None;
+            }
+        }
+        Some(PathEntry { verbs, shapes: shapes.len(), npts, coords, view_box })
+    }
+
+    /// Control points at morph value `m` (0 = the first shape, k = shape k;
+    /// between two keys, the two-term lerp, which is EXACT at both ends:
+    /// `a * 0 + b * 1 == b` and `a * 1 + b * 0 == a` for finite a, b).
+    pub fn points_at(&self, m: f32, out: &mut Vec<Pt>) {
+        out.clear();
+        let n = self.npts;
+        if self.shapes == 1 || !(m > 0.0) {
+            for i in 0..n {
+                out.push(pt(self.coords[2 * i], self.coords[2 * i + 1]));
+            }
+            return;
+        }
+        let last = (self.shapes - 1) as f32;
+        let m = if m > last { last } else { m };
+        let mut k = m as usize; // m > 0: truncation is floor
+        if k > self.shapes - 2 {
+            k = self.shapes - 2;
+        }
+        let f = m - k as f32;
+        let a = &self.coords[2 * n * k..2 * n * (k + 1)];
+        let b = &self.coords[2 * n * (k + 1)..2 * n * (k + 2)];
+        if f == 0.0 {
+            for i in 0..n {
+                out.push(pt(a[2 * i], a[2 * i + 1]));
+            }
+            return;
+        }
+        let g = 1.0 - f;
+        for i in 0..n {
+            out.push(pt(a[2 * i] * g + b[2 * i] * f, a[2 * i + 1] * g + b[2 * i + 1] * f));
+        }
+    }
+}
+
+// ---- PATH TABLE binary format ----------------------------------------------------
+//
+// Appended to styles.bin after the ANIM TABLE, counted by the header's u16
+// at offset 10 (reserved, 0, before this patch — so a composition with no
+// path is byte-identical). Little-endian, unaligned, like the style records.
+//
+//   Path entry:
+//     +0  u16  verbCount
+//     +2  u8   shapeCount (1..=PATH_MAX_SHAPES)
+//     +3  u8   flags      bit 0: viewBox present
+//     [if viewBox] 4 x f32  x, y, w, h
+//     verbCount x u8 verb
+//     shapeCount x npts x (f32 x, f32 y), npts derived from the verbs
+
+#[derive(Clone, Debug, Default)]
+pub struct PathTable {
+    pub entries: Vec<PathEntry>,
+}
+
+fn rd_u16(b: &[u8], o: usize) -> Option<u16> {
+    Some(u16::from_le_bytes([*b.get(o)?, *b.get(o + 1)?]))
+}
+
+fn rd_f32(b: &[u8], o: usize) -> Option<f32> {
+    Some(f32::from_le_bytes([*b.get(o)?, *b.get(o + 1)?, *b.get(o + 2)?, *b.get(o + 3)?]))
+}
+
+impl PathTable {
+    /// Parse `count` entries starting at `off`. None on any malformed entry.
+    pub fn parse(bytes: &[u8], mut off: usize, count: usize) -> Option<(PathTable, usize)> {
+        let mut entries = Vec::with_capacity(count);
+        for _ in 0..count {
+            let nv = rd_u16(bytes, off)? as usize;
+            let shapes = *bytes.get(off + 2)? as usize;
+            let flags = *bytes.get(off + 3)?;
+            off += 4;
+            let view_box = if flags & 1 != 0 {
+                let vb = [rd_f32(bytes, off)?, rd_f32(bytes, off + 4)?, rd_f32(bytes, off + 8)?, rd_f32(bytes, off + 12)?];
+                off += 16;
+                Some(vb)
+            } else {
+                None
+            };
+            let verbs = bytes.get(off..off + nv)?.to_vec();
+            off += nv;
+            let npts: usize = verbs.iter().map(|&v| verb_points(v)).sum();
+            let mut shape_pts = Vec::with_capacity(shapes);
+            for _ in 0..shapes {
+                let mut s = Vec::with_capacity(npts);
+                for _ in 0..npts {
+                    s.push(pt(rd_f32(bytes, off)?, rd_f32(bytes, off + 4)?));
+                    off += 8;
+                }
+                shape_pts.push(s);
+            }
+            entries.push(PathEntry::new(verbs, &shape_pts, view_box)?);
+        }
+        Some((PathTable { entries }, off))
+    }
+
+    /// Encode (compiler-side mirror; used by tests).
+    pub fn encode(entries: &[PathEntry], out: &mut Vec<u8>) {
+        for e in entries {
+            out.extend_from_slice(&(e.verbs.len() as u16).to_le_bytes());
+            out.push(e.shapes as u8);
+            out.push(if e.view_box.is_some() { 1 } else { 0 });
+            if let Some(vb) = e.view_box {
+                for v in vb {
+                    out.extend_from_slice(&v.to_le_bytes());
+                }
+            }
+            out.extend_from_slice(&e.verbs);
+            for c in &e.coords {
+                out.extend_from_slice(&c.to_le_bytes());
+            }
+        }
+    }
+}
+
+// ---- small deterministic math ----------------------------------------------------
+
+/// Newton square root: a bit-trick seed and three steps, the sequence
+/// `draw.rs` uses. A fixed sequence of IEEE ops, so the same bits everywhere.
+#[inline]
+pub fn sqrtf(x: f32) -> f32 {
+    if !(x > 0.0) {
+        return 0.0;
+    }
+    let mut y = f32::from_bits((x.to_bits() >> 1) + 0x1fc0_0000);
+    y = 0.5 * (y + x / y);
+    y = 0.5 * (y + x / y);
+    y = 0.5 * (y + x / y);
+    y
+}
+
+/// floor to i32 for |x| < 2^24 (saturating outside; NaN -> 0).
+#[inline]
+pub fn floor_i32(x: f32) -> i32 {
+    let i = x as i32;
+    if (i as f32) > x {
+        i - 1
+    } else {
+        i
+    }
+}
+
+#[inline]
+fn ceil_usize(x: f32) -> usize {
+    let i = x as usize; // x >= 0 here
+    if (i as f32) < x {
+        i + 1
+    } else {
+        i
+    }
+}
+
+#[inline]
+fn lerp_pt(a: Pt, b: Pt, u: f32) -> Pt {
+    pt(a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u)
+}
+
+#[inline]
+fn dist(a: Pt, b: Pt) -> f32 {
+    let (dx, dy) = (b.x - a.x, b.y - a.y);
+    sqrtf(dx * dx + dy * dy)
+}
+
+// ---- flattening --------------------------------------------------------------------
+
+/// A flattened subpath: `pts[start..end]`, closed or open.
+#[derive(Clone, Copy, Debug)]
+pub struct Sub {
+    pub start: usize,
+    pub end: usize,
+    pub closed: bool,
+}
+
+/// Flattened subpaths (polylines).
+#[derive(Clone, Debug, Default)]
+pub struct Flat {
+    pub pts: Vec<Pt>,
+    pub subs: Vec<Sub>,
+}
+
+impl Flat {
+    pub fn clear(&mut self) {
+        self.pts.clear();
+        self.subs.clear();
+    }
+
+    fn begin(&mut self, p: Pt) {
+        let s = self.pts.len();
+        self.pts.push(p);
+        self.subs.push(Sub { start: s, end: s + 1, closed: false });
+    }
+
+    fn push(&mut self, p: Pt) {
+        self.pts.push(p);
+        if let Some(s) = self.subs.last_mut() {
+            s.end = self.pts.len();
+        }
+    }
+}
+
+/// Chords for one cubic: Wang's bound, n = ceil(sqrt(3/4 * M / tol)) with
+/// M the larger second difference of the control polygon, computed as a
+/// fourth root of squares so no norm needs its own square root.
+pub fn cubic_steps(p0: Pt, p1: Pt, p2: Pt, p3: Pt, tol: f32) -> usize {
+    let ax = p0.x - 2.0 * p1.x + p2.x;
+    let ay = p0.y - 2.0 * p1.y + p2.y;
+    let bx = p1.x - 2.0 * p2.x + p3.x;
+    let by = p1.y - 2.0 * p2.y + p3.y;
+    let a2 = ax * ax + ay * ay;
+    let b2 = bx * bx + by * by;
+    let m2 = if a2 > b2 { a2 } else { b2 };
+    let q = 0.5625 * m2 / (tol * tol);
+    if !(q > 1.0) {
+        return 1;
+    }
+    let n = ceil_usize(sqrtf(sqrtf(q)));
+    if n > CUBIC_MAX_STEPS {
+        CUBIC_MAX_STEPS
+    } else if n < 1 {
+        1
+    } else {
+        n
+    }
+}
+
+/// Flatten verbs over `pts` (local space) with chord tolerance `tol`.
+pub fn flatten(verbs: &[u8], pts: &[Pt], tol: f32, out: &mut Flat) {
+    out.clear();
+    let mut k = 0usize;
+    let mut sub_start = pt(0.0, 0.0);
+    let mut open = false;
+    for &v in verbs {
+        match v {
+            VERB_MOVE => {
+                let p = pts[k];
+                k += 1;
+                out.begin(p);
+                sub_start = p;
+                open = true;
+            }
+            VERB_LINE => {
+                if !open {
+                    out.begin(sub_start);
+                    open = true;
+                }
+                out.push(pts[k]);
+                k += 1;
+            }
+            VERB_CUBIC => {
+                if !open {
+                    out.begin(sub_start);
+                    open = true;
+                }
+                let p0 = *out.pts.last().unwrap();
+                let (p1, p2, p3) = (pts[k], pts[k + 1], pts[k + 2]);
+                k += 3;
+                let n = cubic_steps(p0, p1, p2, p3, tol);
+                let inv = n as f32;
+                for i in 1..n {
+                    let t = i as f32 / inv;
+                    let mt = 1.0 - t;
+                    let a = mt * mt * mt;
+                    let b = 3.0 * mt * mt * t;
+                    let c = 3.0 * mt * t * t;
+                    let d = t * t * t;
+                    out.push(pt(
+                        a * p0.x + b * p1.x + c * p2.x + d * p3.x,
+                        a * p0.y + b * p1.y + c * p2.y + d * p3.y,
+                    ));
+                }
+                out.push(p3); // the end point exactly, so subpaths join exactly
+            }
+            VERB_CLOSE => {
+                if open {
+                    if let Some(s) = out.subs.last_mut() {
+                        s.closed = true;
+                    }
+                    open = false;
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+// ---- trim --------------------------------------------------------------------------
+
+/// Which arc length the trim fractions are of.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum TrimMode {
+    /// Every subpath trimmed by the same fractions of its own length
+    /// (After Effects "Simultaneously").
+    Each,
+    /// The subpaths as one sequence, in order (After Effects "Individually").
+    Whole,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct Trim {
+    pub start: f32,
+    pub end: f32,
+    pub offset: f32,
+    pub mode: TrimMode,
+}
+
+impl Trim {
+    pub const NONE: Trim = Trim { start: 0.0, end: 1.0, offset: 0.0, mode: TrimMode::Each };
+
+    /// The visible fractions after ordering, clamping and the offset: None
+    /// for nothing, Some(None) for everything, else one or two intervals in
+    /// [0, 1] (two when the offset wraps the window past the end).
+    fn intervals(&self) -> Option<Option<[(f32, f32); 2]>> {
+        let clamp01 = |v: f32| if v > 1.0 { 1.0 } else if v > 0.0 { v } else { 0.0 };
+        let (a, b) = if self.start <= self.end { (self.start, self.end) } else { (self.end, self.start) };
+        let (s, e) = (clamp01(a), clamp01(b));
+        if !(e > s) {
+            return None;
+        }
+        if e - s >= 1.0 {
+            return Some(None);
+        }
+        let o = if self.offset.is_finite() { self.offset - crate::layout::floorf(self.offset) } else { 0.0 };
+        let mut s2 = s + o;
+        let mut e2 = e + o;
+        if s2 >= 1.0 {
+            s2 -= 1.0;
+            e2 -= 1.0;
+        }
+        if e2 <= 1.0 {
+            Some(Some([(s2, e2), (0.0, 0.0)]))
+        } else {
+            Some(Some([(s2, 1.0), (0.0, e2 - 1.0)]))
+        }
+    }
+}
+
+/// Cumulative arc length at each vertex of `sub`, and the closing edge's
+/// end for a closed one (so `cum.len() == n + closed as usize`).
+fn sub_lengths(pts: &[Pt], sub: Sub, cum: &mut Vec<f32>) -> f32 {
+    cum.clear();
+    let mut acc = 0.0f32;
+    cum.push(0.0);
+    for i in sub.start + 1..sub.end {
+        acc += dist(pts[i - 1], pts[i]);
+        cum.push(acc);
+    }
+    if sub.closed && sub.end - sub.start > 1 {
+        acc += dist(pts[sub.end - 1], pts[sub.start]);
+        cum.push(acc);
+    }
+    acc
+}
+
+/// Vertex `j` of the sub walked as a ring when closed (j == n is the start).
+#[inline]
+fn ring(pts: &[Pt], sub: Sub, j: usize) -> Pt {
+    let n = sub.end - sub.start;
+    pts[sub.start + if j >= n { j - n } else { j }]
+}
+
+/// The point at arc length `pos` along the sub.
+fn point_at(pts: &[Pt], sub: Sub, cum: &[f32], pos: f32) -> (Pt, usize) {
+    // Segment j runs from vertex j to j+1, lengths cum[j]..cum[j+1].
+    let segs = cum.len() - 1;
+    let mut j = 0usize;
+    while j + 1 < segs && cum[j + 1] < pos {
+        j += 1;
+    }
+    let (l0, l1) = (cum[j], cum[j + 1]);
+    let a = ring(pts, sub, j);
+    let b = ring(pts, sub, j + 1);
+    let len = l1 - l0;
+    let u = if len > 0.0 {
+        let u = (pos - l0) / len;
+        if u < 0.0 {
+            0.0
+        } else if u > 1.0 {
+            1.0
+        } else {
+            u
+        }
+    } else {
+        0.0
+    };
+    (lerp_pt(a, b, u), j)
+}
+
+/// Append the piece [a, b] of the sub (0 <= a < b <= total) as an open
+/// polyline: the cut at a, every vertex strictly inside, the cut at b.
+fn piece(pts: &[Pt], sub: Sub, cum: &[f32], a: f32, b: f32, out: &mut Flat, continue_last: bool) {
+    let (pa, ja) = point_at(pts, sub, cum, a);
+    let (pb, jb) = point_at(pts, sub, cum, b);
+    if continue_last {
+        out.push(pa);
+    } else {
+        out.begin(pa);
+    }
+    for j in ja + 1..=jb {
+        if cum[j] > a && cum[j] < b {
+            out.push(ring(pts, sub, j));
+        }
+    }
+    out.push(pb);
+}
+
+/// Trim every subpath of `flat` into `out`. `trim` fractions are of arc
+/// length measured on the flattened local polyline.
+pub fn trim(flat: &Flat, t: &Trim, out: &mut Flat, cum: &mut Vec<f32>) {
+    out.clear();
+    let iv = match t.intervals() {
+        None => return,
+        Some(None) => {
+            out.pts.extend_from_slice(&flat.pts);
+            out.subs.extend_from_slice(&flat.subs);
+            return;
+        }
+        Some(Some(iv)) => iv,
+    };
+    let wraps = iv[1].1 > 0.0;
+    let each = t.mode == TrimMode::Each || flat.subs.len() == 1;
+    if each {
+        for &sub in &flat.subs {
+            let total = sub_lengths(&flat.pts, sub, cum);
+            if !(total > 0.0) {
+                continue;
+            }
+            if wraps && sub.closed {
+                // One piece across the closing vertex: [s, total] then [0, e].
+                let (s, e) = (iv[0].0 * total, iv[1].1 * total);
+                piece(&flat.pts, sub, cum, s, total, out, false);
+                if e > 0.0 {
+                    let last = out.pts.len();
+                    piece(&flat.pts, sub, cum, 0.0, e, out, true);
+                    // `continue_last` re-pushed the start vertex, which the
+                    // first half already ended on: drop the duplicate.
+                    if out.pts.len() > last {
+                        out.pts.remove(last);
+                        if let Some(s) = out.subs.last_mut() {
+                            s.end = out.pts.len();
+                        }
+                    }
+                }
+            } else {
+                for &(s, e) in iv.iter().take(if wraps { 2 } else { 1 }) {
+                    if e > s {
+                        piece(&flat.pts, sub, cum, s * total, e * total, out, false);
+                    }
+                }
+            }
+        }
+        return;
+    }
+    // Whole: global positions over the subpaths in order.
+    let mut totals: Vec<f32> = Vec::with_capacity(flat.subs.len());
+    let mut grand = 0.0f32;
+    for &sub in &flat.subs {
+        let l = sub_lengths(&flat.pts, sub, cum);
+        totals.push(l);
+        grand += l;
+    }
+    if !(grand > 0.0) {
+        return;
+    }
+    for &(s, e) in iv.iter().take(if wraps { 2 } else { 1 }) {
+        if !(e > s) {
+            continue;
+        }
+        let (gs, ge) = (s * grand, e * grand);
+        let mut base = 0.0f32;
+        for (k, &sub) in flat.subs.iter().enumerate() {
+            let l = totals[k];
+            let (a, b) = (gs - base, ge - base);
+            if b > 0.0 && a < l && l > 0.0 {
+                let a = if a > 0.0 { a } else { 0.0 };
+                let b = if b < l { b } else { l };
+                if a == 0.0 && b == l && sub.closed {
+                    // The whole of a closed subpath stays closed (joins, no caps).
+                    let st = out.pts.len();
+                    out.pts.extend_from_slice(&flat.pts[sub.start..sub.end]);
+                    out.subs.push(Sub { start: st, end: out.pts.len(), closed: true });
+                } else if b > a {
+                    sub_lengths(&flat.pts, sub, cum);
+                    piece(&flat.pts, sub, cum, a, b, out, false);
+                }
+            }
+            base += l;
+        }
+    }
+}
+
+// ---- stroke ------------------------------------------------------------------------
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Join {
+    Miter,
+    Round,
+    Bevel,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Cap {
+    Butt,
+    Round,
+    Square,
+}
+
+/// Closed contours: `pts[ends[k-1]..ends[k]]`.
+#[derive(Clone, Debug, Default)]
+pub struct Contours {
+    pub pts: Vec<Pt>,
+    pub ends: Vec<usize>,
+}
+
+impl Contours {
+    pub fn clear(&mut self) {
+        self.pts.clear();
+        self.ends.clear();
+    }
+
+    fn close(&mut self) {
+        let start = self.ends.last().copied().unwrap_or(0);
+        if self.pts.len() - start < 3 {
+            self.pts.truncate(start); // encloses nothing
+        } else {
+            self.ends.push(self.pts.len());
+        }
+    }
+
+    pub fn len(&self) -> usize {
+        self.ends.len()
+    }
+
+    pub fn contour(&self, k: usize) -> &[Pt] {
+        let s = if k == 0 { 0 } else { self.ends[k - 1] };
+        &self.pts[s..self.ends[k]]
+    }
+}
+
+/// Stroke parameters in local units.
+#[derive(Clone, Copy, Debug)]
+pub struct StrokeStyle {
+    pub width: f32,
+    pub join: Join,
+    pub cap: Cap,
+    pub miter_limit: f32,
+}
+
+/// The outward bisector of unit vectors u and v: through u + v when the
+/// angle between them is under 90 degrees, through the perpendicular of
+/// v - u otherwise (u + v cancels as the angle nears 180), oriented away
+/// from the turn — `fwd` decides only for an exact reversal.
+#[inline]
+fn bisect(u: Pt, v: Pt, fwd: Pt) -> Pt {
+    let c = u.x * v.x + u.y * v.y;
+    if c >= 0.0 {
+        let s = pt(u.x + v.x, u.y + v.y);
+        let l = sqrtf(s.x * s.x + s.y * s.y);
+        return pt(s.x / l, s.y / l);
+    }
+    let w = pt(v.x - u.x, v.y - u.y);
+    let mut m = pt(-w.y, w.x);
+    let l = sqrtf(m.x * m.x + m.y * m.y);
+    m = pt(m.x / l, m.y / l);
+    let s = pt(u.x + v.x, u.y + v.y);
+    let toward = s.x * m.x + s.y * m.y;
+    let flip = if toward != 0.0 { toward < 0.0 } else { fwd.x * m.x + fwd.y * m.y < 0.0 };
+    if flip {
+        pt(-m.x, -m.y)
+    } else {
+        m
+    }
+}
+
+/// Bisection levels for an arc of cosine `c` and radius `r` so every chord's
+/// sagitta stays under `tol`: halve while r * (1 - cos(half chord angle))
+/// exceeds it. No trigonometry: cos(x/2) = sqrt((1 + cos x) / 2).
+fn arc_levels(c: f32, r: f32, tol: f32) -> u32 {
+    let mut ch = if c < -1.0 { -1.0 } else if c > 1.0 { 1.0 } else { c };
+    let mut levels = 0u32;
+    loop {
+        let half = sqrtf((1.0 + ch) * 0.5);
+        if r * (1.0 - half) <= tol || levels >= ARC_MAX_LEVELS {
+            return levels;
+        }
+        ch = half;
+        levels += 1;
+    }
+}
+
+/// Push the arc from direction u to v around `o` at radius r, exclusive of
+/// both ends, by recursive bisection.
+fn arc(out: &mut Vec<Pt>, o: Pt, r: f32, u: Pt, v: Pt, fwd: Pt, levels: u32) {
+    if levels == 0 {
+        return;
+    }
+    let m = bisect(u, v, fwd);
+    arc(out, o, r, u, m, fwd, levels - 1);
+    out.push(pt(o.x + m.x * r, o.y + m.y * r));
+    arc(out, o, r, m, v, fwd, levels - 1);
+}
+
+/// The outer side of a join at `v` from segment direction `d0` (normal n0)
+/// to `d1` (normal n1); `side` +1 for the A side (p + n*hw), -1 for B.
+/// Pushes the points strictly between the two offset ends.
+#[allow(clippy::too_many_arguments)]
+fn outer_join(out: &mut Vec<Pt>, v: Pt, n0: Pt, n1: Pt, d0: Pt, side: f32, hw: f32, s: &StrokeStyle, tol: f32) {
+    let u = pt(n0.x * side, n0.y * side);
+    let w = pt(n1.x * side, n1.y * side);
+    let c = n0.x * n1.x + n0.y * n1.y;
+    match s.join {
+        Join::Bevel => {}
+        Join::Miter => {
+            // Miter length / width = 1 / cos(theta/2) = 1 / sqrt((1+c)/2):
+            // within the limit iff (1 + c) >= 2 / limit^2. No root needed.
+            let lim = if s.miter_limit > 1.0 { s.miter_limit } else { 1.0 };
+            let k = 1.0 + c;
+            if k >= 2.0 / (lim * lim) && k > 0.0 {
+                let f = hw / k;
+                out.push(pt(v.x + (u.x + w.x) * f, v.y + (u.y + w.y) * f));
+            }
+        }
+        Join::Round => {
+            let levels = arc_levels(c, hw, tol);
+            arc(out, v, hw, u, w, d0, levels);
+        }
+    }
+}
+
+/// One segment of a stroked polyline: unit direction, its normal (the
+/// direction rotated +90 degrees), and its length.
+#[derive(Clone, Copy, Debug)]
+pub struct Seg {
+    d: Pt,
+    n: Pt,
+    len: f32,
+}
+
+/// What one side of a polyline does at a join.
+enum SideJoin {
+    /// The two offset lines meet at one point, which replaces both offset
+    /// ends: an outer miter within the limit (the ends are collinear with
+    /// it, so dropping them changes nothing), an outer round or bevel join
+    /// so gentle that the miter point overshoots it by less than 1/256 px,
+    /// or an inner side whose wedge lies inside both quads (where the
+    /// meeting point IS the union's boundary).
+    Meet(Pt),
+    /// Both offset ends, with the join's points (outer) or the vertex
+    /// itself, the pivot (inner), between them.
+    Ends,
+}
+
+/// The decision for `side` at the join of segments `s0` and `s1` at `v`.
+fn side_join(v: Pt, s0: &Seg, s1: &Seg, side: f32, hw: f32, st: &StrokeStyle, tol: f32) -> (SideJoin, bool) {
+    let cross = s0.d.x * s1.d.y - s0.d.y * s1.d.x;
+    let dot = s0.d.x * s1.d.x + s0.d.y * s1.d.y;
+    let a_outer = cross < 0.0 || (cross == 0.0 && dot < 0.0);
+    let outer = if side > 0.0 { a_outer } else { !a_outer };
+    let c = s0.n.x * s1.n.x + s0.n.y * s1.n.y; // = dot
+    let k = 1.0 + c;
+    let meet = |k: f32| {
+        let f = side * hw / k;
+        pt(v.x + (s0.n.x + s1.n.x) * f, v.y + (s0.n.y + s1.n.y) * f)
+    };
+    if outer {
+        let merge = match st.join {
+            Join::Miter => {
+                let lim = if st.miter_limit > 1.0 { st.miter_limit } else { 1.0 };
+                k >= 2.0 / (lim * lim) && k > 0.0
+            }
+            // The miter point overshoots a round join by hw (1/cos - 1) and
+            // a bevel by about twice that: merge while 2 / (1 + c) <=
+            // (1 + t / (2 hw))^2, t = tol / 16 (1/256 px on screen).
+            Join::Round | Join::Bevel => {
+                let g = 1.0 + tol / (32.0 * hw);
+                k > 0.0 && 2.0 <= k * g * g
+            }
+        };
+        (if merge { SideJoin::Meet(meet(k)) } else { SideJoin::Ends }, true)
+    } else {
+        let sin = if cross < 0.0 { -cross } else { cross };
+        let short = if s0.len < s1.len { s0.len } else { s1.len };
+        let inside = dot > 0.0 && hw * sin * 1.125 <= short;
+        (if inside { SideJoin::Meet(meet(k)) } else { SideJoin::Ends }, false)
+    }
+}
+
+/// One side of a polyline, walked forward: offsets by `side * n * hw`; at
+/// each join either the meeting point of the two offset lines, or both
+/// offset ends with the join's points between them (outer side) or the
+/// vertex itself, the pivot (inner side), so the cycle's winding is the sum
+/// of the segment quads and the outer wedges. `closed` adds the join at the
+/// closing vertex.
+#[allow(clippy::too_many_arguments)]
+fn side_walk(out: &mut Vec<Pt>, p: &[Pt], segs: &[Seg], closed: bool, side: f32, hw: f32, s: &StrokeStyle, tol: f32) {
+    let ns = segs.len();
+    let off = |q: Pt, n: Pt| pt(q.x + n.x * side * hw, q.y + n.y * side * hw);
+    // A closed side starts after the closing join: if that join meets, its
+    // point (pushed last) stands for the first segment's start.
+    let mut met = closed && matches!(side_join(p[0], &segs[ns - 1], &segs[0], side, hw, s, tol).0, SideJoin::Meet(_));
+    for i in 0..ns {
+        let n = segs[i].n;
+        let a = p[i];
+        let b = p[if i + 1 == p.len() { 0 } else { i + 1 }];
+        if !met {
+            out.push(off(a, n));
+        }
+        if !(closed || i + 1 < ns) {
+            out.push(off(b, n));
+            break;
+        }
+        let j = if i + 1 == ns { 0 } else { i + 1 };
+        let (s0, s1) = (segs[i], segs[j]);
+        match side_join(b, &s0, &s1, side, hw, s, tol) {
+            (SideJoin::Meet(m), _) => {
+                out.push(m);
+                met = true;
+            }
+            (SideJoin::Ends, outer) => {
+                out.push(off(b, n));
+                if outer {
+                    outer_join(out, b, s0.n, s1.n, s0.d, side, hw, s, tol);
+                } else {
+                    out.push(b); // the pivot: the inner offsets meet through the centre
+                }
+                met = false;
+            }
+        }
+    }
+}
+
+/// Outline one polyline's stroke into `out` (local space). Open: one cycle
+/// (side A forward, end cap, side B backward, start cap). Closed: two (side
+/// A forward, side B backward). Every segment contributes a positively
+/// wound quad and every join or cap a positively wound wedge to the
+/// cycles' winding, so their nonzero fill is the union of the pieces.
+pub fn stroke_polyline(pts: &[Pt], closed: bool, s: &StrokeStyle, tol: f32, out: &mut Contours, scratch: &mut StrokeScratch) {
+    let hw = s.width * 0.5;
+    if !(hw > 0.0) {
+        return;
+    }
+    // Drop repeated points: a zero-length segment has no direction.
+    let p = &mut scratch.p;
+    p.clear();
+    for &q in pts {
+        if let Some(&last) = p.last() {
+            let (dx, dy) = (q.x - last.x, q.y - last.y);
+            if !(dx * dx + dy * dy > 1e-12) {
+                continue;
+            }
+        }
+        p.push(q);
+    }
+    if closed && p.len() > 1 {
+        let (f, l) = (p[0], p[p.len() - 1]);
+        let (dx, dy) = (f.x - l.x, f.y - l.y);
+        if !(dx * dx + dy * dy > 1e-12) {
+            p.pop();
+        }
+    }
+    if p.len() < 2 {
+        return; // zero-length subpath: nothing (no dot for round caps yet)
+    }
+    let ns = if closed { p.len() } else { p.len() - 1 };
+    let segs = &mut scratch.segs;
+    segs.clear();
+    for i in 0..ns {
+        let a = p[i];
+        let b = p[if i + 1 == p.len() { 0 } else { i + 1 }];
+        let (dx, dy) = (b.x - a.x, b.y - a.y);
+        let len = sqrtf(dx * dx + dy * dy);
+        let d = pt(dx / len, dy / len);
+        segs.push(Seg { d, n: pt(-d.y, d.x), len });
+    }
+    if closed {
+        side_walk(&mut out.pts, p, segs, true, 1.0, hw, s, tol);
+        out.close();
+        let b = &mut scratch.b;
+        b.clear();
+        side_walk(b, p, segs, true, -1.0, hw, s, tol);
+        out.pts.extend(b.iter().rev());
+        out.close();
+        return;
+    }
+    side_walk(&mut out.pts, p, segs, false, 1.0, hw, s, tol);
+    // End cap: from A's last offset to B's, around the end point forward.
+    let Seg { d: de, n: ne, .. } = segs[ns - 1];
+    let pe = p[p.len() - 1];
+    cap(&mut out.pts, pe, ne, de, hw, s.cap, tol);
+    let b = &mut scratch.b;
+    b.clear();
+    side_walk(b, p, segs, false, -1.0, hw, s, tol);
+    out.pts.extend(b.iter().rev());
+    // Start cap: from B's first offset to A's, around the start backward.
+    let Seg { d: d0, n: n0, .. } = segs[0];
+    cap(&mut out.pts, p[0], pt(-n0.x, -n0.y), pt(-d0.x, -d0.y), hw, s.cap, tol);
+    out.close();
+}
+
+/// The points strictly between `o + n*hw` and `o - n*hw` around `o`
+/// through direction `d` (n is d rotated +90 degrees).
+fn cap(out: &mut Vec<Pt>, o: Pt, n: Pt, d: Pt, hw: f32, c: Cap, tol: f32) {
+    match c {
+        Cap::Butt => {}
+        Cap::Square => {
+            out.push(pt(o.x + (n.x + d.x) * hw, o.y + (n.y + d.y) * hw));
+            out.push(pt(o.x + (d.x - n.x) * hw, o.y + (d.y - n.y) * hw));
+        }
+        Cap::Round => {
+            let levels = arc_levels(0.0, hw, tol);
+            let neg = pt(-n.x, -n.y);
+            arc(out, o, hw, n, d, d, levels);
+            out.push(pt(o.x + d.x * hw, o.y + d.y * hw));
+            arc(out, o, hw, d, neg, d, levels);
+        }
+    }
+}
+
+#[derive(Default)]
+pub struct StrokeScratch {
+    p: Vec<Pt>,
+    segs: Vec<Seg>,
+    b: Vec<Pt>,
+}
+
+/// Stroke every subpath of `flat`.
+pub fn stroke(flat: &Flat, s: &StrokeStyle, tol: f32, out: &mut Contours, scratch: &mut StrokeScratch) {
+    for sub in &flat.subs {
+        stroke_polyline(&flat.pts[sub.start..sub.end], sub.closed, s, tol, out, scratch);
+    }
+}
+
+// ---- emission ----------------------------------------------------------------------
+
+/// Sutherland-Hodgman against one axis-aligned half-plane. Winding is
+/// preserved for every point strictly inside it: each excursion outside is
+/// replaced by a segment of the boundary, and the loop that excursion and
+/// segment form lies wholly outside.
+fn clip_half(src: &[Pt], dst: &mut Vec<Pt>, axis_x: bool, bound: f32, keep_less: bool) {
+    dst.clear();
+    let n = src.len();
+    if n == 0 {
+        return;
+    }
+    let inside = |p: Pt| {
+        let v = if axis_x { p.x } else { p.y };
+        if keep_less {
+            v <= bound
+        } else {
+            v >= bound
+        }
+    };
+    let mut prev = src[n - 1];
+    let mut prev_in = inside(prev);
+    for &cur in src {
+        let cur_in = inside(cur);
+        if cur_in != prev_in {
+            // Intersection with the boundary line; the divisor is non-zero
+            // because the two points lie on opposite sides of it.
+            let p = if axis_x {
+                let t = (bound - prev.x) / (cur.x - prev.x);
+                pt(bound, prev.y + (cur.y - prev.y) * t)
+            } else {
+                let t = (bound - prev.y) / (cur.y - prev.y);
+                pt(prev.x + (cur.x - prev.x) * t, bound)
+            };
+            dst.push(p);
+        }
+        if cur_in {
+            dst.push(cur);
+        }
+        prev = cur;
+        prev_in = cur_in;
+    }
+}
+
+#[derive(Default)]
+pub struct EmitScratch {
+    a: Vec<Pt>,
+    b: Vec<Pt>,
+}
+
+/// Append one PATH op (spec: op, len, flags, color, C, then C x { n, n x
+/// (x, y) i32 in 1/256 logical px }) for `contours` mapped through `xf`.
+/// Returns false (and emits nothing) when nothing survives or a point is
+/// not finite.
+pub fn emit_op(
+    words: &mut Vec<u32>,
+    contours: &Contours,
+    xf: &Affine,
+    color: u32,
+    evenodd: bool,
+    screen: (f32, f32),
+    scratch: &mut EmitScratch,
+) -> bool {
+    if color >> 24 == 0 || contours.len() == 0 {
+        return false;
+    }
+    let (x0, y0, x1, y1) = (-GUARD, -GUARD, screen.0 + GUARD, screen.1 + GUARD);
+    let head = words.len();
+    words.push(spec::draw_op::PATH);
+    words.push(0); // len, patched below
+    words.push(if evenodd { 1 } else { 0 });
+    words.push(color);
+    words.push(0); // contour count, patched below
+    let mut count = 0u32;
+    for k in 0..contours.len() {
+        let src = contours.contour(k);
+        let a = &mut scratch.a;
+        a.clear();
+        let (mut bx0, mut by0, mut bx1, mut by1) = (f32::MAX, f32::MAX, f32::MIN, f32::MIN);
+        for &q in src {
+            let p = pt(xf.a * q.x + xf.c * q.y + xf.tx, xf.b * q.x + xf.d * q.y + xf.ty);
+            if !p.x.is_finite() || !p.y.is_finite() {
+                words.truncate(head);
+                return false;
+            }
+            bx0 = if p.x < bx0 { p.x } else { bx0 };
+            by0 = if p.y < by0 { p.y } else { by0 };
+            bx1 = if p.x > bx1 { p.x } else { bx1 };
+            by1 = if p.y > by1 { p.y } else { by1 };
+            a.push(p);
+        }
+        if bx1 < x0 || by1 < y0 || bx0 > x1 || by0 > y1 {
+            // Wholly outside on one side: its winding is zero everywhere
+            // inside the guard rect, so it is dropped rather than clipped.
+            continue;
+        }
+        if bx0 < x0 || by0 < y0 || bx1 > x1 || by1 > y1 {
+            let b = &mut scratch.b;
+            clip_half(a, b, true, x0, false);
+            clip_half(b, a, true, x1, true);
+            clip_half(a, b, false, y0, false);
+            clip_half(b, a, false, y1, true);
+        }
+        if a.len() < 3 {
+            continue;
+        }
+        words.push(a.len() as u32);
+        for &p in a.iter() {
+            words.push(floor_i32(p.x * PATH_UNITS + 0.5) as u32);
+            words.push(floor_i32(p.y * PATH_UNITS + 0.5) as u32);
+        }
+        count += 1;
+    }
+    if count == 0 {
+        words.truncate(head);
+        return false;
+    }
+    words[head + 1] = (words.len() - head) as u32;
+    words[head + 4] = count;
+    true
+}
+
+// ---- the per-node pipeline --------------------------------------------------------
+
+/// What a node asks of its path (resolved style values).
+#[derive(Clone, Copy, Debug)]
+pub struct PathPaint {
+    pub morph: f32,
+    pub fill: u32,
+    pub evenodd: bool,
+    pub stroke: u32,
+    pub stroke_style: StrokeStyle,
+    pub trim: Trim,
+}
+
+#[derive(Default)]
+pub struct PathScratch {
+    pub pts: Vec<Pt>,
+    pub flat: Flat,
+    pub trimmed: Flat,
+    pub contours: Contours,
+    pub cum: Vec<f32>,
+    pub stroke: StrokeScratch,
+    pub emit: EmitScratch,
+}
+
+/// Counters for the cost measurements: chords flattened, contour vertices
+/// emitted.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct PathStats {
+    pub chords: usize,
+    pub vertices: usize,
+}
+
+/// A bound on the scale `xf` applies to any length: its Frobenius norm,
+/// which is at least the largest singular value and does not change under
+/// rotation (up to rounding), so a turning path keeps its chord count.
+pub fn scale_bound(xf: &Affine) -> f32 {
+    sqrtf(xf.a * xf.a + xf.b * xf.b + xf.c * xf.c + xf.d * xf.d)
+}
+
+/// The viewBox mapping (xMidYMid meet) onto a w x h box, composed before
+/// `world`.
+pub fn local_frame(entry: &PathEntry, w: f32, h: f32, world: &Affine) -> Affine {
+    let Some([vx, vy, vw, vh]) = entry.view_box else {
+        return *world;
+    };
+    let sx = w / vw;
+    let sy = h / vh;
+    let s = if sx < sy { sx } else { sy };
+    let tx = (w - vw * s) * 0.5 - vx * s;
+    let ty = (h - vh * s) * 0.5 - vy * s;
+    let m = Affine { a: s, b: 0.0, c: 0.0, d: s, tx, ty };
+    Affine {
+        a: world.a * m.a + world.c * m.b,
+        b: world.b * m.a + world.d * m.b,
+        c: world.a * m.c + world.c * m.d,
+        d: world.b * m.c + world.d * m.d,
+        tx: world.a * m.tx + world.c * m.ty + world.tx,
+        ty: world.b * m.tx + world.d * m.ty + world.ty,
+    }
+}
+
+/// Morph and flatten an entry for one node; returns the local-to-screen
+/// affine and the local tolerance, or None when the transform collapses it.
+pub fn prepare(entry: &PathEntry, w: f32, h: f32, world: &Affine, morph: f32, sc: &mut PathScratch, stats: &mut PathStats) -> Option<(Affine, f32)> {
+    let xf = local_frame(entry, w, h, world);
+    let s = scale_bound(&xf);
+    if !(s > 0.0) || !s.is_finite() {
+        return None;
+    }
+    let tol = FLATTEN_TOL / s;
+    entry.points_at(morph, &mut sc.pts);
+    flatten(&entry.verbs, &sc.pts, tol, &mut sc.flat);
+    stats.chords += sc.flat.pts.len();
+    Some((xf, tol))
+}
+
+/// The fill op of a prepared path (every subpath closed implicitly).
+pub fn emit_fill(words: &mut Vec<u32>, xf: &Affine, color: u32, evenodd: bool, screen: (f32, f32), sc: &mut PathScratch, stats: &mut PathStats) -> bool {
+    sc.contours.clear();
+    for sub in &sc.flat.subs {
+        sc.contours.pts.extend_from_slice(&sc.flat.pts[sub.start..sub.end]);
+        sc.contours.close();
+    }
+    stats.vertices += sc.contours.pts.len();
+    emit_op(words, &sc.contours, xf, color, evenodd, screen, &mut sc.emit)
+}
+
+/// The stroke op of a prepared path: trimmed, outlined, filled nonzero.
+#[allow(clippy::too_many_arguments)]
+pub fn emit_stroke(
+    words: &mut Vec<u32>,
+    xf: &Affine,
+    tol: f32,
+    color: u32,
+    style: &StrokeStyle,
+    t: &Trim,
+    screen: (f32, f32),
+    sc: &mut PathScratch,
+    stats: &mut PathStats,
+) -> bool {
+    if !(style.width > 0.0) {
+        return false;
+    }
+    trim(&sc.flat, t, &mut sc.trimmed, &mut sc.cum);
+    sc.contours.clear();
+    stroke(&sc.trimmed, style, tol, &mut sc.contours, &mut sc.stroke);
+    stats.vertices += sc.contours.pts.len();
+    emit_op(words, &sc.contours, xf, color, false, screen, &mut sc.emit)
+}
+
+/// Emit a node's path: fill (if its colour has alpha) then stroke.
+#[allow(clippy::too_many_arguments)]
+pub fn emit_path(
+    words: &mut Vec<u32>,
+    entry: &PathEntry,
+    w: f32,
+    h: f32,
+    world: &Affine,
+    paint: &PathPaint,
+    screen: (f32, f32),
+    sc: &mut PathScratch,
+    stats: &mut PathStats,
+) {
+    let Some((xf, tol)) = prepare(entry, w, h, world, paint.morph, sc, stats) else {
+        return;
+    };
+    if paint.fill >> 24 != 0 {
+        emit_fill(words, &xf, paint.fill, paint.evenodd, screen, sc, stats);
+    }
+    if paint.stroke >> 24 != 0 {
+        emit_stroke(words, &xf, tol, paint.stroke, &paint.stroke_style, &paint.trim, screen, sc, stats);
+    }
+}
+
+// ---- test support -----------------------------------------------------------------
+
+/// The convex pieces whose union a stroke is: one quad per segment, the
+/// outer wedge of every join, the caps. Built from the same normals and the
+/// same join and cap points the outline uses, so a test can hold the
+/// outline's winding to the union of these (the assembly), while the
+/// geometry of the pieces is held to the true offset separately.
+#[cfg(test)]
+pub(crate) fn stroke_pieces(pts: &[Pt], closed: bool, s: &StrokeStyle, tol: f32) -> Vec<Vec<Pt>> {
+    let hw = s.width * 0.5;
+    let mut p: Vec<Pt> = Vec::new();
+    for &q in pts {
+        if let Some(&last) = p.last() {
+            let (dx, dy) = (q.x - last.x, q.y - last.y);
+            if !(dx * dx + dy * dy > 1e-12) {
+                continue;
+            }
+        }
+        p.push(q);
+    }
+    if closed && p.len() > 1 {
+        let (f, l) = (p[0], p[p.len() - 1]);
+        let (dx, dy) = (f.x - l.x, f.y - l.y);
+        if !(dx * dx + dy * dy > 1e-12) {
+            p.pop();
+        }
+    }
+    let mut out = Vec::new();
+    if p.len() < 2 || !(hw > 0.0) {
+        return out;
+    }
+    let ns = if closed { p.len() } else { p.len() - 1 };
+    let mut segs = Vec::new();
+    for i in 0..ns {
+        let a = p[i];
+        let b = p[if i + 1 == p.len() { 0 } else { i + 1 }];
+        let (dx, dy) = (b.x - a.x, b.y - a.y);
+        let len = sqrtf(dx * dx + dy * dy);
+        let d = pt(dx / len, dy / len);
+        segs.push(Seg { d, n: pt(-d.y, d.x), len });
+    }
+    let off = |q: Pt, n: Pt, side: f32| pt(q.x + n.x * side * hw, q.y + n.y * side * hw);
+    for i in 0..ns {
+        let a = p[i];
+        let b = p[if i + 1 == p.len() { 0 } else { i + 1 }];
+        let n = segs[i].n;
+        out.push(alloc::vec![off(a, n, 1.0), off(b, n, 1.0), off(b, n, -1.0), off(a, n, -1.0)]);
+        if !(closed || i + 1 < ns) {
+            continue;
+        }
+        let j = if i + 1 == ns { 0 } else { i + 1 };
+        let (s0, s1) = (segs[i], segs[j]);
+        let cross = s0.d.x * s1.d.y - s0.d.y * s1.d.x;
+        let dot = s0.d.x * s1.d.x + s0.d.y * s1.d.y;
+        let a_outer = cross < 0.0 || (cross == 0.0 && dot < 0.0);
+        let side = if a_outer { 1.0 } else { -1.0 };
+        let mut mid = Vec::new();
+        outer_join(&mut mid, b, s0.n, s1.n, s0.d, side, hw, s, tol);
+        let mut wedge = alloc::vec![b, off(b, s0.n, side)];
+        wedge.extend_from_slice(&mid);
+        wedge.push(off(b, s1.n, side));
+        out.push(wedge);
+    }
+    if !closed {
+        let last = segs[ns - 1];
+        let pe = p[p.len() - 1];
+        let mut c = alloc::vec![pe, off(pe, last.n, 1.0)];
+        cap(&mut c, pe, last.n, last.d, hw, s.cap, tol);
+        c.push(off(pe, last.n, -1.0));
+        out.push(c);
+        let first = segs[0];
+        let n0 = pt(-first.n.x, -first.n.y);
+        let mut c = alloc::vec![p[0], off(p[0], n0, 1.0)];
+        cap(&mut c, p[0], n0, pt(-first.d.x, -first.d.y), hw, s.cap, tol);
+        c.push(off(p[0], n0, -1.0));
+        out.push(c);
+    }
+    out
+}
