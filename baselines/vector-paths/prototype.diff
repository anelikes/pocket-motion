+    // b - a rounds: the far end must still be b to the bit.
+    let mut sa = Shape::default();
+    let mut sb = Shape::default();
+    sa.m(0.1, 3.0e-3).l(1234.567, -0.7).c(0.3, 9.9, 17.0, 0.013, 5.5, 2.2).z();
+    sb.m(0.3, 777.7).l(0.0123, 41.0).c(-65.0, 0.29, 1.0e-3, 33.3, 0.77, 1.0e4).z();
+    let two = morph_entry(&[&sa, &sb]);
+    two.points_at(1.0, &mut got);
+    assert!(got.iter().zip(sb.pts.iter()).all(|(p, q)| p.x.to_bits() == q.x.to_bits() && p.y.to_bits() == q.y.to_bits()), "far key is not exact: {got:?}");
+    let mut mid = Vec::new();
+    m.points_at(1.5, &mut mid);
+    for (i, p) in mid.iter().enumerate() {
+        let (pb, pc) = (b.pts[i], c.pts[i]);
+        assert!((p.x - (pb.x + pc.x) / 2.0).abs() < 1e-4 && (p.y - (pb.y + pc.y) / 2.0).abs() < 1e-4);
+    }
