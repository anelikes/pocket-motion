+#[test]
+fn round_stroke_is_the_true_offset_within_the_tolerance() {
+    // With round joins and caps a stroke is every point within w/2 of the
+    // polyline. Each sample farther than w/2 + eps must be out and each
+    // nearer than w/2 - eps in, eps = the chord tolerance plus the 1/256 px
+    // quantisation. Red if an arc is generated around the wrong centre or
+    // with too few chords, or a cap faces backward.
+    let mut rng = Rng(0x0ff5e7);
+    let eps = FLATTEN_TOL as f64 + 2.0 / 256.0 + 1e-3;
+    let mut checked = 0usize;
+    for case in 0..120 {
+        let st = StrokeStyle { width: [2.0f32, 7.0, 15.0, 31.0][case % 4], join: Join::Round, cap: Cap::Round, miter_limit: 4.0 };
+        let closed = case % 5 == 0;
+        let n = 3 + rng.below(8) as usize;
+        let line = random_polyline(&mut rng, n, 16.0, 64.0, case % 3 == 0);
+        let mut out = Contours::default();
+        stroke_polyline(&line, closed, &st, FLATTEN_TOL, &mut out, &mut StrokeScratch::default());
+        let mut words = Vec::new();
+        if !emit_op(&mut words, &out, &Affine::IDENTITY, !0, false, (80.0, 80.0), &mut EmitScratch::default()) {
+            continue;
+        }
+        let edges = op_edges(&words, 1);
+        let mut segs: Vec<((f64, f64), (f64, f64))> = Vec::new();
+        for i in 0..line.len() - 1 + closed as usize {
+            let (a, b) = (line[i], line[(i + 1) % line.len()]);
+            segs.push(((a.x as f64, a.y as f64), (b.x as f64, b.y as f64)));
+        }
+        let hw = st.width as f64 / 2.0;
+        for py in 0..80i64 {
+            for px in 0..80i64 {
+                for &sy in &SAMPLE {
+                    for &sx in &SAMPLE {
+                        let (x, y) = (256 * px + sx, 256 * py + sy);
+                        let p = (x as f64 / 256.0, y as f64 / 256.0);
+                        let d = segs.iter().map(|&(a, b)| dist_to_segment(p, a, b)).fold(f64::MAX, f64::min);
+                        let got = ref_inside(&edges, x, y, false);
+                        if d < hw - eps {
+                            assert!(got, "case {case}: sample at distance {d} < {hw} is outside; line {line:?}");
+                        } else if d > hw + eps {
+                            assert!(!got, "case {case}: sample at distance {d} > {hw} is inside; line {line:?}");
+                        }
+                        checked += 1;
+                    }
+                }
+            }
+        }
+    }
+    assert!(checked > 1_000_000);
+}
