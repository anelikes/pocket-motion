+#[test]
+fn stroke_outline_fills_to_exactly_the_union_of_its_pieces() {
+    // The outline's nonzero fill against "inside any quad, join wedge or
+    // cap", sample by sample; they may disagree only on a sample lying
+    // within 2/256 px of a piece's edge: the top-left rule against the
+    // reference's closed test, and the pivot vertex, quantised on its own,
+    // sitting up to 1/256 px off the straight edge between the two offsets
+    // it lies between in exact arithmetic. Red if a join is wound the wrong way (a hole
+    // where the wedge cancels a quad), if the inner pivot is skipped where
+    // the wedge is not inside both quads, or if an outer join goes the long
+    // way round.
+    let mut rng = Rng(0x57_20_4e);
+    let (mut samples, mut edge_mismatch, mut worst) = (0usize, 0usize, 0f64);
+    for case in 0..240 {
+        let joins = [Join::Miter, Join::Round, Join::Bevel];
+        let caps = [Cap::Butt, Cap::Round, Cap::Square];
+        let st = StrokeStyle {
+            width: [1.0f32, 3.5, 9.0, 24.0][case % 4],
+            join: joins[case % 3],
+            cap: caps[(case / 3) % 3],
+            miter_limit: [1.5f32, 4.0, 30.0][(case / 9) % 3],
+        };
+        let closed = case % 7 == 0;
+        let n = 3 + rng.below(9) as usize;
+        let line = random_polyline(&mut rng, n, 12.0, 68.0, case % 2 == 0);
+        let mut out = Contours::default();
+        let mut scratch = StrokeScratch::default();
+        stroke_polyline(&line, closed, &st, FLATTEN_TOL, &mut out, &mut scratch);
+        let pieces: Vec<Vec<(i64, i64)>> = stroke_pieces(&line, closed, &st, FLATTEN_TOL)
+            .iter()
+            .map(|p| p.iter().map(|v| (q(v.x), q(v.y))).collect())
+            .collect();
+        let mut words = Vec::new();
+        let mut es = EmitScratch::default();
+        if !emit_op(&mut words, &out, &Affine::IDENTITY, 0xffff_ffff, false, (80.0, 80.0), &mut es) {
+            assert!(pieces.iter().all(|p| p.len() < 3), "case {case}: no outline but pieces exist");
+            continue;
+        }
+        let edges = op_edges(&words, 1);
+        for py in 0..80i64 {
+            for px in 0..80i64 {
+                for &sy in &SAMPLE {
+                    for &sx in &SAMPLE {
+                        let (x, y) = (256 * px + sx, 256 * py + sy);
+                        let got = ref_inside(&edges, x, y, false);
+                        let mut want = false;
+                        for p in &pieces {
+                            if let Some((inside, _)) = convex_contains(p, x, y) {
+                                want |= inside;
+                            }
+                        }
+                        samples += 1;
+                        if got != want {
+                            let near = pieces.iter().map(|p| (0..p.len()).map(|i| seg_dist(p[i], p[(i + 1) % p.len()], x, y)).fold(f64::MAX, f64::min)).fold(f64::MAX, f64::min);
+                            assert!(near <= 2.0, "case {case} ({st:?}, closed {closed}): sample ({x},{y}) is {got} by winding, {want} by the pieces, {near}/256 px from the nearest piece edge; line {line:?}");
+                            edge_mismatch += 1;
+                            worst = worst.max(near);
+                        }
+                    }
+                }
+            }
+        }
+    }
+    std::println!("stroke union: {samples} samples, {edge_mismatch} differ, the farthest {worst}/256 px from a piece edge");
+}
+
+fn dist_to_segment(p: (f64, f64), a: (f64, f64), b: (f64, f64)) -> f64 {
+    let (dx, dy) = (b.0 - a.0, b.1 - a.1);
+    let l2 = dx * dx + dy * dy;
+    let t = if l2 > 0.0 { (((p.0 - a.0) * dx + (p.1 - a.1) * dy) / l2).clamp(0.0, 1.0) } else { 0.0 };
+    let (cx, cy) = (a.0 + t * dx, a.1 + t * dy);
+    ((p.0 - cx).powi(2) + (p.1 - cy).powi(2)).sqrt()
+}
