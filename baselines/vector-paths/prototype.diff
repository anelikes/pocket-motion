+fn a_path_node_draws_fill_then_stroke_and_debug_hide_removes_both() {
+    // Red if the walk does not reach the path, emits the stroke under the
+    // fill, or draws a hidden node.
+    let mut ui = crate::Ui::new();
+    assert!(ui.load_styles(&styles_with_paths(&[], &[blob_entry()])));
+    let n = path_node(&mut ui);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    let ops = ops_of(&words);
+    assert_eq!(ops, [draw_op::PATH, draw_op::PATH], "fill, then stroke");
+    // The fill is the fill colour; the stroke op is the stroke colour.
+    let first = 0;
+    let second = words[1] as usize;
+    assert_eq!(words[first + 3], abgr(255, 160, 0, 255));
+    assert_eq!(words[second + 3], abgr(255, 255, 255, 255));
+    let fb = raster_through(&mut ui);
+    assert!(fb.chunks(4).any(|p| p == [255, 160, 0, 255]), "the fill reaches the picture");
+    ui.debug_hide(n);
+    assert!(ui.draw().words.is_empty(), "a hidden path node emits nothing");
+    ui.debug_hide(0);
+    assert_eq!(ui.draw().words, words, "and unhiding restores the same words");
+}
