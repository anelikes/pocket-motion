+#[test]
+fn morph_at_a_key_draws_that_key_exactly() {
+    // Red if the lerp is not exact at its ends (a + (b - a) * 1 is not b in
+    // f32), if the key index is off by one, or if out-of-range or NaN
+    // values are not clamped.
+    let mut a = Shape::default();
+    circle(&mut a, 50.0, 50.0, 30.0, 8);
+    let mut b = Shape::default();
+    flower(&mut b, 50.0, 50.0, 30.0, 0.45);
+    let mut c = Shape::default();
+    flower(&mut c, 48.0, 51.0, 41.0, -0.2);
+    let m = morph_entry(&[&a, &b, &c]);
+    let words = |e: &PathEntry, morph: f32| {
+        let mut p = paint_fill(!0, false);
+        p.stroke = abgr(255, 0, 0, 255);
+        p.stroke_style.width = 3.0;
+        p.morph = morph;
+        let mut w = Vec::new();
+        emit(&mut w, e, &rotation(33.0, 1.3, 0.9, 10.0, 5.0), &p, (100.0, 100.0), &mut PathStats::default());
+        w
+    };
+    assert_eq!(words(&m, 0.0), words(&a.entry(), 0.0));
+    assert_eq!(words(&m, 1.0), words(&b.entry(), 0.0));
+    assert_eq!(words(&m, 2.0), words(&c.entry(), 0.0));
+    assert_eq!(words(&m, 7.5), words(&c.entry(), 0.0), "clamped above");
+    assert_eq!(words(&m, -3.0), words(&a.entry(), 0.0), "clamped below");
+    assert_eq!(words(&m, f32::NAN), words(&a.entry(), 0.0), "NaN is the first key");
+    assert_ne!(words(&m, 1.5), words(&b.entry(), 0.0));
+    // The words are quantised to 1/256 px, which hides an error of one
+    // ulp; the points are compared exactly, at every key and both ends.
+    let mut got = Vec::new();
+    for (k, key) in [&a, &b, &c].iter().enumerate() {
+        m.points_at(k as f32, &mut got);
+        assert!(got.iter().zip(key.pts.iter()).all(|(p, q)| p.x.to_bits() == q.x.to_bits() && p.y.to_bits() == q.y.to_bits()), "key {k} is not exact");
+    }
