+/// Words of scene `i` and its frame size and render scale.
+pub fn scene(i: usize) -> (Vec<u32>, u32, u32, u32) {
+    let screen = (SCENE_W as f32, SCENE_H as f32);
+    let mut w = Vec::new();
+    let mut st = PathStats::default();
+    let bg = abgr(16, 18, 24, 255);
+    match i {
+        0 | 1 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            let mut s = Shape::default();
+            star(&mut s, 180.0, 180.0, 150.0, 7, 3);
+            star(&mut s, 470.0, 180.0, 140.0, 5, 2);
+            emit(&mut w, &s.entry(), &Affine::IDENTITY, &paint_fill(abgr(250, 200, 40, 255), i == 1), screen, &mut st);
+        }
+        2 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            // Outer circle clockwise, inner circle clockwise too (same
+            // direction): nonzero fills the hole, evenodd does not.
+            for (k, &eo) in [false, true].iter().enumerate() {
+                let mut s = Shape::default();
+                let cx = 170.0 + 300.0 * k as f32;
+                circle(&mut s, cx, 180.0, 140.0, 8);
+                circle(&mut s, cx + 20.0, 170.0, 70.0, 4);
+                emit(&mut w, &s.entry(), &Affine::IDENTITY, &paint_fill(abgr(90, 200, 255, 230), eo), screen, &mut st);
+            }
+        }
+        3 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            let joins = [Join::Miter, Join::Round, Join::Bevel];
+            let caps = [Cap::Butt, Cap::Round, Cap::Square];
+            for (row, &j) in joins.iter().enumerate() {
+                for (col, &c) in caps.iter().enumerate() {
+                    let (ox, oy) = (40.0 + 200.0 * col as f32, 30.0 + 110.0 * row as f32);
+                    let mut s = Shape::default();
+                    s.m(ox, oy + 60.0).l(ox + 40.0, oy).l(ox + 80.0, oy + 60.0).l(ox + 110.0, oy + 20.0).l(ox + 150.0, oy + 70.0).l(ox + 152.0, oy + 10.0);
+                    emit(&mut w, &s.entry(), &Affine::IDENTITY, &paint_stroke(abgr(240, 240, 240, 255), 14.0, j, c), screen, &mut st);
+                }
+            }
+        }
+        4 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            let mut s = Shape::default();
+            flower(&mut s, 200.0, 180.0, 130.0, 0.35);
+            let e = s.entry();
+            let mut p = paint_fill(abgr(40, 90, 200, 255), false);
+            p.stroke = abgr(255, 255, 255, 200);
+            p.stroke_style = StrokeStyle { width: 9.0, join: Join::Round, cap: Cap::Round, miter_limit: 4.0 };
+            emit(&mut w, &e, &Affine::IDENTITY, &p, screen, &mut st);
+            let mut q = Shape::default();
+            star(&mut q, 470.0, 180.0, 130.0, 9, 4);
+            let mut p2 = paint_stroke(abgr(255, 120, 60, 255), 6.0, Join::Miter, Cap::Butt);
+            p2.stroke_style.miter_limit = 10.0;
+            emit(&mut w, &q.entry(), &Affine::IDENTITY, &p2, screen, &mut st);
+        }
+        5 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            // A spiral and a hairpin whose curvature radius drops below the
+            // half-width: the inner offsets fold, the pivot keeps the union.
+            let mut s = Shape::default();
+            s.m(320.0, 180.0);
+            let mut r = 4.0f32;
+            let mut a = 0.0f32;
+            for _ in 0..40 {
+                a += 0.5;
+                r *= 1.09;
+                let (sa, ca) = (sin_any(a), cos_any(a));
+                s.l(320.0 + r * ca, 180.0 + r * sa);
+            }
+            emit(&mut w, &s.entry(), &Affine::IDENTITY, &paint_stroke(abgr(120, 255, 160, 255), 22.0, Join::Round, Cap::Round), screen, &mut st);
+            let mut h = Shape::default();
+            h.m(40.0, 300.0).c(40.0, 40.0, 60.0, 40.0, 60.0, 300.0);
+            emit(&mut w, &h.entry(), &Affine::IDENTITY, &paint_stroke(abgr(255, 90, 200, 255), 30.0, Join::Miter, Cap::Square), screen, &mut st);
+        }
+        6 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            // One spiral-ish shape trimmed at five windows, side by side.
+            let mut base = Shape::default();
+            base.m(0.0, 100.0).c(0.0, 0.0, 100.0, 0.0, 100.0, 60.0).c(100.0, 120.0, 30.0, 110.0, 40.0, 60.0).l(60.0, 40.0);
+            let e = base.entry();
+            let windows = [(0.0f32, 0.0f32), (0.0, 0.25), (0.1, 0.6), (0.3, 1.0), (0.0, 1.0)];
+            for (k, &(a, b)) in windows.iter().enumerate() {
+                let mut p = paint_stroke(abgr(255, 230, 120, 255), 8.0, Join::Round, Cap::Round);
+                p.trim = Trim { start: a, end: b, offset: 0.0, mode: TrimMode::Each };
+                emit(&mut w, &e, &affine(1.0, 0.0, 0.0, 1.0, 20.0 + 124.0 * k as f32, 100.0), &p, screen, &mut st);
+            }
+        }
+        7 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            // Three subpaths, Whole vs Each, with an offset that wraps.
+            let mut s = Shape::default();
+            circle(&mut s, 60.0, 60.0, 50.0, 4);
+            s.m(130.0, 20.0).l(230.0, 100.0);
+            s.m(130.0, 100.0).c(170.0, 0.0, 200.0, 140.0, 240.0, 30.0);
+            let e = s.entry();
+            for (row, mode) in [TrimMode::Whole, TrimMode::Each].iter().enumerate() {
+                for (col, off) in [0.0f32, 0.35, 0.8].iter().enumerate() {
+                    let mut p = paint_stroke(abgr(140, 200, 255, 255), 6.0, Join::Bevel, Cap::Butt);
+                    p.trim = Trim { start: 0.1, end: 0.55, offset: *off, mode: *mode };
+                    emit(&mut w, &e, &affine(0.8, 0.0, 0.0, 0.8, 10.0 + 210.0 * col as f32, 20.0 + 170.0 * row as f32), &p, screen, &mut st);
+                }
+            }
+        }
+        8 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            let mut a = Shape::default();
+            circle(&mut a, 0.0, 0.0, 60.0, 8);
+            let mut b = Shape::default();
+            flower(&mut b, 0.0, 0.0, 60.0, 0.5);
+            let e = morph_entry(&[&a, &b]);
+            for (k, &m) in [0.0f32, 0.25, 0.5, 0.75, 1.0].iter().enumerate() {
+                let mut p = paint_fill(abgr(255, 140, 90, 255), false);
+                p.morph = m;
+                p.stroke = abgr(255, 255, 255, 255);
+                p.stroke_style = StrokeStyle { width: 3.0, join: Join::Round, cap: Cap::Butt, miter_limit: 4.0 };
+                emit(&mut w, &e, &affine(1.0, 0.0, 0.0, 1.0, 70.0 + 125.0 * k as f32, 180.0), &p, screen, &mut st);
+            }
+        }
+        9 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            let mut s = Shape::default();
+            flower(&mut s, 0.0, 0.0, 50.0, 0.3);
+            star(&mut s, 0.0, 0.0, 30.0, 5, 2);
+            let e = s.entry();
+            let xfs = [
+                rotation(17.0, 1.0, 1.0, 110.0, 120.0),
+                rotation(-63.5, 1.6, 0.6, 320.0, 120.0),
+                affine(1.0, 0.0, 0.7, 1.0, 520.0, 120.0), // skew
+                rotation(200.0, 2.4, 2.4, 160.0, 270.0),
+                rotation(45.0, 0.2, 0.2, 480.0, 270.0), // tiny: few chords
+            ];
+            for (k, xf) in xfs.iter().enumerate() {
+                let mut p = paint_fill(abgr(80 + 30 * k as u32, 220, 140, 255), k % 2 == 1);
+                p.stroke = abgr(250, 250, 250, 255);
+                p.stroke_style = StrokeStyle { width: 4.0, join: Join::Miter, cap: Cap::Butt, miter_limit: 4.0 };
+                emit(&mut w, &e, xf, &p, screen, &mut st);
+            }
+            // A viewBox entry: a 24x24 icon mapped into a 200x120 box (meet).
+            let mut icon = Shape::default();
+            icon.m(12.0, 2.0).l(22.0, 22.0).l(2.0, 22.0).z();
+            let ie = PathEntry::new(icon.verbs.clone(), &[icon.pts.clone()], Some([0.0, 0.0, 24.0, 24.0])).unwrap();
+            let mut sc = PathScratch::default();
+            emit_path(&mut w, &ie, 200.0, 120.0, &affine(1.0, 0.0, 0.0, 1.0, 420.0, 220.0), &paint_fill(abgr(255, 255, 255, 255), false), screen, &mut sc, &mut st);
+        }
+        10 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            let mut s = Shape::default();
+            flower(&mut s, 0.0, 0.0, 120.0, 0.4);
+            let e = s.entry();
+            // Under a mask (a rotated square), under a gradient paint, in a
+            // blurred layer: the op reaches each through the target trait.
+            w.push(draw_op::MASK_PUSH);
+            w.push(4);
+            for (x, y) in [(60u32, 60u32), (260, 20), (300, 220), (100, 260)] {
+                w.push(x | (y << 16));
+            }
+            emit(&mut w, &e, &affine(1.0, 0.0, 0.0, 1.0, 170.0, 150.0), &paint_fill(abgr(255, 255, 255, 255), false), screen, &mut st);
+            w.push(draw_op::MASK_POP);
+            // PAINT_PUSH linear, t = x/200 - 1.6 over x in [320, 520].
+            w.push(draw_op::PAINT_PUSH);
+            w.push(1);
+            w.push(2);
+            for f in [1.0f32 / 200.0, 0.0, -1.6, 0.0, 0.0, 0.0] {
+                w.push(f.to_bits());
+            }
+            w.push(abgr(255, 60, 120, 255));
+            w.push(0f32.to_bits());
+            w.push(abgr(60, 160, 255, 255));
+            w.push(1f32.to_bits());
+            emit(&mut w, &e, &affine(0.7, 0.0, 0.0, 0.7, 420.0, 110.0), &paint_fill(abgr(255, 255, 255, 255), false), screen, &mut st);
+            w.push(draw_op::PAINT_POP);
+            w.push(draw_op::LAYER_PUSH);
+            w.push(0);
+            w.push(3f32.to_bits());
+            w.push(0f32.to_bits());
+            w.push(6f32.to_bits());
+            w.push(8f32.to_bits());
+            w.push(abgr(0, 0, 0, 200));
+            w.push(1f32.to_bits());
+            let mut p = paint_stroke(abgr(255, 255, 120, 255), 5.0, Join::Round, Cap::Round);
+            p.trim = Trim { start: 0.0, end: 0.7, offset: 0.1, mode: TrimMode::Each };
+            emit(&mut w, &e, &affine(0.6, 0.0, 0.0, 0.6, 470.0, 270.0), &p, screen, &mut st);
+            w.push(draw_op::LAYER_POP);
+        }
+        11 => {
+            ground(&mut w, SCENE_W, SCENE_H, bg);
+            // A fan of wedges sharing edges, each its own op: seams carry
+            // no double coverage (the partition the top-left rule gives).
+            let n = 24;
+            let (cx, cy, r) = (320.0f32, 180.0f32, 160.0f32);
+            let a = 2.0 * core::f32::consts::PI / n as f32;
+            let (c, s) = (cos_poly(a), sin_poly(a));
+            let (mut x, mut y) = (r, 0.0f32);
+            for k in 0..n {
+                let (nx, ny) = (x * c - y * s, x * s + y * c);
+                let mut sh = Shape::default();
+                sh.m(cx, cy).l(cx + x, cy + y).l(cx + nx, cy + ny).z();
+                let shade = 60 + (k as u32 * 7) % 190;
+                emit(&mut w, &sh.entry(), &Affine::IDENTITY, &paint_fill(abgr(shade, 255 - shade, 200, 255), false), screen, &mut st);
+                x = nx;
+                y = ny;
+            }
+        }
+        12 => return dense(0, 1),
+        13 => return dense(17, 2),
+        14 => return (dense_words(&dense_entries_of(Dense::Smooth), 0).0, DENSE_W, DENSE_H, 1),
+        15 => return (dense_words(&dense_entries_of(Dense::LineArt), 17).0, DENSE_W, DENSE_H, 1),
+        _ => {}
+    }
+    (w, SCENE_W, SCENE_H, 1)
+}
+
+fn wrap(a: f32) -> f32 {
+    // into [-pi/2, pi/2] for the Taylor polynomial, folding by symmetry
+    let pi = core::f32::consts::PI;
+    let mut r = a - 2.0 * pi * crate::layout::floorf((a + pi) / (2.0 * pi));
+    if r > pi / 2.0 {
+        r = pi - r;
+    } else if r < -pi / 2.0 {
+        r = -pi - r;
+    }
+    r
+}
