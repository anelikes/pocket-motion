+/// Logical-px bounds of a PATH op's vertices (1/256 px, floor/ceil).
+fn path_bounds(words: &[u32], clip: DamageRect) -> DamageRect {
+    let mut min_x = i32::MAX;
+    let mut min_y = i32::MAX;
+    let mut max_x = i32::MIN;
+    let mut max_y = i32::MIN;
+    let mut k = 5usize;
+    for _ in 0..words[4] {
+        let n = words[k] as usize;
+        for v in 0..n {
+            let x = words[k + 1 + 2 * v] as i32;
+            let y = words[k + 2 + 2 * v] as i32;
+            min_x = min_x.min(x.div_euclid(256));
+            min_y = min_y.min(y.div_euclid(256));
+            max_x = max_x.max(-((-x).div_euclid(256)));
+            max_y = max_y.max(-((-y).div_euclid(256)));
+        }
+        k += 1 + 2 * n;
+    }
+    if min_x > max_x {
+        return DamageRect::empty();
+    }
+    DamageRect::new(min_x, min_y, max_x, max_y).intersect(clip)
+}
