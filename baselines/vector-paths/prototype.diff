+#[test]
+fn miter_tip_sits_at_its_length_and_the_limit_bevels_it() {
+    // A corner of interior angle 60 degrees: the miter is w/2 / sin(30) = w
+    // from the vertex along the bisector; ratio 1/sin(30) = 2, so a limit
+    // of 2.01 keeps it and 1.99 bevels. Red if the limit test is inverted
+    // or the tip is computed from the wrong normals.
+    let line = [pt(0.0, 0.0), pt(50.0, 0.0), pt(50.0 - 50.0 * 0.5, 50.0 * 0.866_025_4)];
+    let tip_dist = |limit: f32| {
+        let st = StrokeStyle { width: 10.0, join: Join::Miter, cap: Cap::Butt, miter_limit: limit };
+        let mut out = Contours::default();
+        stroke_polyline(&line, false, &st, FLATTEN_TOL, &mut out, &mut StrokeScratch::default());
+        out.pts.iter().map(|p| ((p.x - 50.0).powi(2) + p.y.powi(2)).sqrt()).filter(|&d| d < 20.0).fold(0.0f32, f32::max)
+    };
+    let kept = tip_dist(2.01);
