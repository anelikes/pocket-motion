+#[test]
+fn trim_end_only_adds_samples_as_it_grows() {
+    // A draw-on: a longer window never uncovers a sample a shorter one
+    // covered (butt caps). Red if a cut point moves backward as its
+    // fraction grows, or a piece is rebuilt differently from frame to frame.
+    let e = spiral_entry();
+    let mut prev: Option<BTreeMap<(i32, i32), u8>> = None;
+    let mut violations = 0usize;
+    for k in 1..=40 {
+        let t = Trim { start: 0.0, end: k as f32 / 40.0, offset: 0.0, mode: TrimMode::Whole };
+        let w = stroke_words(&e, t, Cap::Butt);
+        let h = if w.is_empty() { BTreeMap::new() } else { opt_hits(&w, 1, clip(0, 0, 100, 100)) };
+        if let Some(p) = &prev {
+            for (px, &v) in p {
+                if h.get(px).copied().unwrap_or(0) < v {
+                    violations += 1;
+                }
+            }
+        }
+        prev = Some(h);
+    }
+    std::println!("trim growth: {violations} pixel decreases over 40 steps");
+    assert!(violations <= 4, "{violations} pixels lost coverage as the window grew");
+}
