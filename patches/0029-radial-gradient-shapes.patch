+ * closest and farthest corner are one point, and an ellipse's closest and
+ * farthest side are one size, so five shapes cover every pair. Null for
+ * anything else: a length, a percentage, `at <position>` — the centre is
+ * the box's — and a word that is neither.
+ */
+function radialShape(spec: string): number | null {
+  let shape: string | null = null;
+  let size: string | null = null;
+  for (const w of spec.split(/\s+/).filter(Boolean)) {
+    if (w === "circle" || w === "ellipse") {
+      if (shape !== null) return null;
+      shape = w;
+    } else if (/^(closest|farthest)-(side|corner)$/.test(w)) {
+      if (size !== null) return null;
+      size = w;
+    } else return null;
+  }
+  if (shape === null && size === null) return null;
+  const corner = size === null || size.endsWith("-corner");
+  if ((shape ?? "ellipse") === "ellipse") return corner ? ENUMS.GradShape.Ellipse : ENUMS.GradShape.EllipseClosestSide;
+  if (corner) return ENUMS.GradShape.Circle;
+  return size === "closest-side" ? ENUMS.GradShape.CircleClosestSide : ENUMS.GradShape.CircleFarthestSide;
+}
