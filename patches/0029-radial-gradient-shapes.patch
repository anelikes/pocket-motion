+#[test]
+fn a_radial_gradient_takes_the_ending_shape_it_names() {
+    // The paint's radial was only CSS's default, the farthest-corner
+    // ellipse: on a 200 x 40 box a "radial glow" was a flat oval and a round
+    // one had to be a square box around a circle. Each shape's radii about
+    // the centre (100, 120), read white-to-black at the pixel 15 px right of
+    // the centre and the one 15 px below it: a circle reads the same on both
+    // axes, an ellipse does not.
+    let (white, black) = (abgr(255, 255, 255, 255), abgr(0, 0, 0, 255));
+    let (hw, hh) = (100.0f64, 20.0f64);
+    let shapes: [(spec::GradShape, f64, f64); 5] = [
+        (spec::GradShape::Ellipse, hw * core::f64::consts::SQRT_2, hh * core::f64::consts::SQRT_2),
+        (spec::GradShape::Circle, (hw * hw + hh * hh).sqrt(), (hw * hw + hh * hh).sqrt()),
+        (spec::GradShape::EllipseClosestSide, hw, hh),
+        (spec::GradShape::CircleClosestSide, hh, hh),
+        (spec::GradShape::CircleFarthestSide, hw, hw),
+    ];
+    for &(shape, rx, ry) in shapes.iter() {
+        let (mut ui, _, _) = gradient_box(
+            spec::GradKind::Radial,
+            0.0,
+            &[(white, 0.0), (black, 1.0)],
+            &[(spec::prop::GRAD_SHAPE, shape as u32 as f64)],
+        );
+        let fb = raster_fb(&mut ui);
+        let want = |dx: f64, dy: f64| {
+            let t = ((dx / rx).powi(2) + (dy / ry).powi(2)).sqrt().min(1.0);
+            255.0 * (1.0 - t)
+        };
+        let across = sample_rgba(&fb, 115, 120)[0] as f64;
+        let down = sample_rgba(&fb, 100, 135)[0] as f64;
+        assert!((across - want(15.5, 0.5)).abs() <= 2.0, "{shape:?}: 15 px across reads {across}, want {}", want(15.5, 0.5));
+        assert!((down - want(0.5, 15.5)).abs() <= 2.0, "{shape:?}: 15 px down reads {down}, want {}", want(0.5, 15.5));
+        let round = matches!(shape, spec::GradShape::Circle | spec::GradShape::CircleClosestSide | spec::GradShape::CircleFarthestSide);
+        assert_eq!(round, across == down, "{shape:?}: across {across}, down {down}");
+    }
+}
