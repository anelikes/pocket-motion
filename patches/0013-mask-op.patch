+        ui.set_prop(b, spec::prop::HEIGHT, 120.0);
+        ui.set_prop(b, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+        ui.set_prop(b, spec::prop::INSET_L, 30.0);
+        ui.set_prop(b, spec::prop::INSET_T, -20.0);
+        ui.set_prop(b, spec::prop::OVERFLOW, inner as u32 as f64);
+        ui.set_prop(b, spec::prop::ROTATE, -40.0);
+        ui.insert_before(a, b, 0);
+        full_bleed_white_under(&mut ui, b, 120.0, 120.0);
+        ui.tick();
+        raster_fb(&mut ui)
+    }
+    let both = scene(spec::Overflow::Mask, spec::Overflow::Mask);
+    let only_a = scene(spec::Overflow::Mask, spec::Overflow::Visible);
+    let only_b = scene(spec::Overflow::Visible, spec::Overflow::Mask);
+    let hits_of = |a: u8| (a as u32 * 16 + 254) / 255;
+    let mut partial = 0usize;
+    for y in 0..spec::SCREEN_H as usize {
+        for x in 0..spec::SCREEN_W as usize {
+            let ha = hits_of(sample_rgba(&only_a, x, y)[0]);
+            let hb = hits_of(sample_rgba(&only_b, x, y)[0]);
+            let expect = (255 * (ha * hb / 16) / 16) as u8;
+            let got = sample_rgba(&both, x, y)[0];
+            assert_eq!(got, expect, "({x},{y}): hits {ha}*{hb}");
+            if got > 0 && got < 255 {
+                partial += 1;
+            }
+        }
+    }
+    assert!(partial > 0, "the intersection has an edge with coverage on it");
+}
+
+#[test]
+fn mask_reaches_the_rgb565_target() {
+    let mut ui = Ui::new();
+    let win = window(&mut ui, spec::Overflow::Mask, 200.0, 200.0, 0.0, 100.0);
+    full_bleed_white_under(&mut ui, win, 200.0, 200.0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    let mut fb = alloc::vec![0u16; spec::SCREEN_W as usize * spec::SCREEN_H as usize];
+    crate::raster::render_scaled_rgb565(&ui, &words, &mut fb, 1);
+    let at = |x: usize, y: usize| fb[y * spec::SCREEN_W as usize + x];
+    assert_eq!(at(240, 136), 0xffff);
+    assert_eq!(at(141, 36), 0x0000, "corner outside the circle");
+    let partial = (130..150).map(|x| at(x, 120)).filter(|&v| v != 0 && v != 0xffff).count();
+    assert!(partial > 0, "edge coverage survives the 565 pack");
+}
+
+#[test]
+fn a_mask_pop_with_no_push_stops_the_stream_like_any_corrupt_op() {
+    let mut ui = Ui::new();
+    let words = alloc::vec![
+        spec::draw_op::MASK_POP,
+        spec::draw_op::RECT,
+        0,
+        (100u32) | (100u32 << 16),
+        abgr(255, 255, 255, 255),
+    ];
+    let mut fb = alloc::vec![0u8; spec::SCREEN_W as usize * spec::SCREEN_H as usize * 4];
+    crate::raster::render(&ui, &words, &mut fb);
+    ui.tick();
+    assert_eq!(sample_rgba(&fb, 10, 10), [0, 0, 0, 255], "nothing after the stray pop is drawn");
+}
