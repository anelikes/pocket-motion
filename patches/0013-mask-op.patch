+    full_bleed_white_under(&mut ui, win, 200.0, 200.0);
+    ui.tick();
+    let fb = raster_fb(&mut ui);
+    // Centre (240,136): inside. The window's corner (140,36) is inside the
+    // AABB — the scissor lets it through — and outside the circle: the mask
+    // is what makes it black. Along the horizontal through the centre the
+    // edge is at x = 140 and x = 340; the pixel a hair inside is full and
+    // the one straddling it partial.
+    assert_eq!(sample_rgba(&fb, 240, 136), [255, 255, 255, 255]);
+    assert_eq!(sample_rgba(&fb, 141, 36), [0, 0, 0, 255], "corner outside the circle");
+    assert_eq!(sample_rgba(&fb, 339, 136), [255, 255, 255, 255]);
+    // The leftmost vertex lands on an integer x, so the exact edge pixel is
+    // full; the partial ones sit on the arc just above and below the centre
+    // row. Walk a row a little off centre and require a partial pixel.
+    let partial = (130..150).map(|x| sample_rgba(&fb, x, 120)[0]).filter(|&v| v > 0 && v < 255).count();
+    assert!(partial > 0, "the arc carries coverage where it crosses a row");
+    // Levels: more than binary along the arc.
+    let mut levels = alloc::collections::BTreeSet::new();
+    for x in 130..350 {
+        for y in 26..246 {
+            levels.insert(sample_rgba(&fb, x, y)[0]);
+        }
+    }
+    assert!(levels.len() > 4, "a circle's edge shows more than {} levels", levels.len());
