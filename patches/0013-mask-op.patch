+// ---- overflow-mask: the rasteriser (pocket-motion patch 0013) ----------------------
+
+/// A white box four screens wide centred on `parent`, so whatever `parent`
+/// masks is covered edge to edge by an opaque, rotated-with-it child.
+fn full_bleed_white_under(ui: &mut Ui, parent: i32, pw: f64, ph: f64) -> i32 {
+    let c = ui.create_node(0);
+    let (w, h) = (spec::SCREEN_W as f64 * 4.0, spec::SCREEN_H as f64 * 4.0);
+    ui.set_prop(c, spec::prop::WIDTH, w);
+    ui.set_prop(c, spec::prop::HEIGHT, h);
+    ui.set_prop(c, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(c, spec::prop::INSET_L, pw / 2.0 - w / 2.0);
+    ui.set_prop(c, spec::prop::INSET_T, ph / 2.0 - h / 2.0);
+    ui.set_prop(c, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.insert_before(parent, c, 0);
+    c
+}
+
+/// A centred window with `overflow`, `rotate` and `radius`, over black.
+fn window(ui: &mut Ui, overflow: spec::Overflow, w: f64, h: f64, rotate: f64, radius: f64) -> i32 {
+    let n = place_box(ui, w, h, 240.0 - w / 2.0, 136.0 - h / 2.0);
+    ui.set_prop(n, spec::prop::OVERFLOW, overflow as u32 as f64);
+    if rotate != 0.0 {
+        ui.set_prop(n, spec::prop::ROTATE, rotate);
+    }
+    if radius > 0.0 {
+        ui.set_prop(n, spec::prop::RADIUS, radius);
+    }
+    n
+}
+
+fn fb_differs(a: &[u8], b: &[u8]) -> usize {
+    a.chunks(4).zip(b.chunks(4)).filter(|(p, q)| p != q).count()
+}
