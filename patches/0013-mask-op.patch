+#[test]
+fn mask_of_a_rotated_window_equals_poly_of_the_same_box() {
+    // The mask's coverage is POLY's coverage: a white full-bleed child under
+    // a rotated square-cornered window must rasterise to the same bytes as a
+    // white rotated box of the window's geometry. Sizes and angles from the
+    // POLY sweep, including the ones that straddle sample offsets.
+    let sizes: [(f64, f64); 6] = [(2.0, 3.0), (9.0, 4.0), (31.0, 17.0), (120.0, 56.0), (200.0, 100.0), (400.0, 260.0)];
+    let angles: [f64; 9] = [0.5, 7.0, 20.0, 33.3, 45.0, 89.0, 91.0, 150.0, 359.5];
+    let mut checked = 0usize;
+    for &(w, h) in sizes.iter() {
+        for &a in angles.iter() {
+            let mut masked = Ui::new();
+            let win = window(&mut masked, spec::Overflow::Mask, w, h, a, 0.0);
+            full_bleed_white_under(&mut masked, win, w, h);
+            masked.tick();
+            let mut plain = Ui::new();
+            let boxed = window(&mut plain, spec::Overflow::Visible, w, h, a, 0.0);
+            plain.set_prop(boxed, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+            plain.tick();
+            let mw = masked.draw().words.clone();
+            assert_eq!(validate_drawlist(&mw)[spec::draw_op::MASK_PUSH as usize], 1, "{w}x{h} rot {a}");
+            let fa = raster_fb(&mut masked);
+            let fb = raster_fb(&mut plain);
+            assert_eq!(fb_differs(&fa, &fb), 0, "{w}x{h} rot {a}: mask and POLY disagree");
+            checked += 1;
+        }
+    }
+    assert_eq!(checked, 54);
+}
