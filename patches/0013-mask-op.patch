+
+    #[inline]
+    fn blend(&mut self, offset: usize, r: u32, g: u32, b: u32, a: u32) {
+        let hits = self.top(offset);
+        if hits == 0 {
+            return;
+        }
+        if hits >= 16 {
+            self.inner.blend(offset, r, g, b, a);
+        } else {
+            self.inner.blend(offset, r, g, b, a * hits / 16);
+        }
+    }
+
+    fn fill_opaque(&mut self, start: usize, len: usize, r: u32, g: u32, b: u32) {
+        let mut i = 0usize;
+        while i < len {
+            let hits = self.top(start + i);
+            if hits >= 16 {
+                let mut j = i + 1;
+                while j < len && self.top(start + j) >= 16 {
+                    j += 1;
+                }
+                self.inner.fill_opaque(start + i, j - i, r, g, b);
+                i = j;
+            } else {
+                if hits > 0 {
+                    self.inner.blend(start + i, r, g, b, 255 * hits / 16);
+                }
+                i += 1;
+            }
+        }
+    }
+
+    #[inline]
+    fn accepts_mask(&self) -> bool {
+        true
+    }
+
+    fn push_mask(&mut self, mut level: MaskLevel) {
+        if let Some(top) = self.levels.last() {
+            for y in 0..level.h {
+                for x in 0..level.w {
+                    let i = (y * level.w + x) as usize;
+                    let h = level.hits[i] as u32;
+                    if h != 0 {
+                        level.hits[i] = (h * top.at(level.x0 + x, level.y0 + y) / 16) as u8;
+                    }
+                }
+            }
+        }
+        self.levels.push(level);
+    }
+
+    fn pop_mask(&mut self) {
+        self.levels.pop();
+    }
+}
