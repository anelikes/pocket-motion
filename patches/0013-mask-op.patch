+// ---- overflow-mask (pocket-motion patch 0013) -----------------------------------
+
+/// A window with `overflow` set, holding one child that overhangs it.
+fn mask_window(ui: &mut Ui, overflow: spec::Overflow, w: f64, h: f64) -> (i32, i32) {
+    let win = place_box(ui, w, h, 240.0 - w / 2.0, 136.0 - h / 2.0);
+    ui.set_prop(win, spec::prop::OVERFLOW, overflow as u32 as f64);
+    let child = ui.create_node(0);
+    ui.set_prop(child, spec::prop::WIDTH, w * 2.0);
+    ui.set_prop(child, spec::prop::HEIGHT, h * 2.0);
+    ui.set_prop(child, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(child, spec::prop::INSET_L, -w / 2.0);
+    ui.set_prop(child, spec::prop::INSET_T, -h / 2.0);
+    ui.set_prop(child, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.insert_before(win, child, 0);
+    (win, child)
+}
+
+/// The ops of a draw list in order, one code per op.
+fn op_sequence(words: &[u32]) -> Vec<u32> {
+    let mut ops = Vec::new();
+    let mut i = 0usize;
+    while i < words.len() {
+        let op = words[i];
+        ops.push(op);
+        i += match op {
+            spec::draw_op::RECT => 4,
+            spec::draw_op::GRAD_RECT => 6,
+            spec::draw_op::GLYPH_RUN => 3 + 2 * ((words[i + 1] >> 16) as usize),
+            spec::draw_op::TEX_QUAD => 9,
+            spec::draw_op::SCISSOR => 3,
+            spec::draw_op::SCISSOR_POP => 1,
+            spec::draw_op::TRI => 7,
+            spec::draw_op::TEX_TRI => 12,
+            spec::draw_op::POLY => 3 + words[i + 1] as usize,
+            spec::draw_op::MASK_PUSH => 2 + words[i + 1] as usize,
+            spec::draw_op::MASK_POP => 1,
+            other => panic!("unknown op {other}"),
+        };
+    }
+    ops
+}
+
+fn first_mask_verts(words: &[u32]) -> Vec<(i32, i32)> {
+    let mut i = 0usize;
+    while i < words.len() {
+        if words[i] == spec::draw_op::MASK_PUSH {
+            let n = words[i + 1] as usize;
+            return words[i + 2..i + 2 + n].iter().map(|&w| decode_xy(w)).collect();
+        }
+        i += match words[i] {
+            spec::draw_op::RECT => 4,
+            spec::draw_op::GRAD_RECT => 6,
+            spec::draw_op::GLYPH_RUN => 3 + 2 * ((words[i + 1] >> 16) as usize),
+            spec::draw_op::TEX_QUAD => 9,
+            spec::draw_op::SCISSOR => 3,
+            spec::draw_op::SCISSOR_POP => 1,
+            spec::draw_op::TRI => 7,
+            spec::draw_op::TEX_TRI => 12,
+            spec::draw_op::POLY => 3 + words[i + 1] as usize,
+            spec::draw_op::MASK_POP => 1,
+            _ => panic!("unknown op"),
+        };
+    }
+    Vec::new()
+}
