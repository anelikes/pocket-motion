+// ---- overflow-mask outline ------------------------------------------------------
+
+/// What `mask_outline` decided for a node.
+enum MaskOutline {
+    /// Radius 0 on an axis-aligned world: the outline is the AABB, and the
+    /// SCISSOR already says that. No mask op.
+    Aabb,
+    /// Nothing of the outline survives the clip; the subtree is invisible.
+    Empty,
+    /// The clipped outline, rounded to pixels, ready for MASK_PUSH.
+    Poly(Vec<(f32, f32)>),
+}
+
+/// Chords per quarter-arc for a corner of `screen_r` pixels, chosen so the
+/// sagitta stays under a quarter of a pixel. A table rather than a formula
+/// because the formula wants a square root and this crate carries none.
+fn mask_chords(screen_r: f32) -> usize {
+    if screen_r < 8.0 {
+        3
+    } else if screen_r < 32.0 {
+        6
+    } else if screen_r < 128.0 {
+        12
+    } else if screen_r < 512.0 {
+        24
+    } else {
+        48
+    }
+}
+
+/// The node's rounded rectangle (`radius` clamped to half the shorter side,
+/// as the box painter clamps it) flattened to a convex polygon in local
+/// space, taken through `world`, clipped to `clip` (the viewport — see the
+/// caller for why not the scissor), rounded to pixels and deduplicated. The corner arcs go through the same Taylor `sinf` every
+/// rotation goes through, so a circle's vertices come from the arithmetic a
+/// rotated box's corners already come from.
+fn mask_outline(
+    world: &Affine,
+    w: f32,
+    h: f32,
+    radius: f32,
+    clip: &Clip,
+    screen: (f32, f32),
+) -> MaskOutline {
+    let r = clampf(radius, 0.0, (w.min(h) * 0.5).max(0.0));
+    if r <= 0.0 && world.is_axis_aligned() {
+        return MaskOutline::Aabb;
+    }
+    let mut local: Vec<(f32, f32)> = Vec::new();
+    if r <= 0.0 {
+        local.push((0.0, 0.0));
+        local.push((w, 0.0));
+        local.push((w, h));
+        local.push((0.0, h));
+    } else {
+        let scale = world.a.abs().max(world.b.abs()).max(world.c.abs()).max(world.d.abs());
+        let chords = mask_chords(r * scale);
+        // Corner centres and the quarter each covers, y-down, so the loop
+        // runs top-left, top-right, bottom-right, bottom-left.
+        let corners: [((f32, f32), f32); 4] = [
+            ((r, r), PI),
+            ((w - r, r), 1.5 * PI),
+            ((w - r, h - r), 0.0),
+            ((r, h - r), 0.5 * PI),
+        ];
+        for &((cx, cy), a0) in corners.iter() {
+            for k in 0..=chords {
+                let t = a0 + (0.5 * PI) * (k as f32 / chords as f32);
+                local.push((cx + r * cosf(t), cy + r * sinf(t)));
+            }
+        }
+    }
+    let verts: Vec<ClipVert> = local
+        .iter()
+        .map(|&(lx, ly)| {
+            let (x, y) = world.apply(lx, ly);
+            ClipVert { x, y, color: [0.0; 4], u: 0.0, v: 0.0 }
+        })
+        .collect();
+    let mut clipped: Vec<ClipVert> = Vec::new();
+    clip_poly(&verts, clip, |v| clipped.extend_from_slice(v));
+    let mut out: Vec<(f32, f32)> = Vec::with_capacity(clipped.len());
+    for v in &clipped {
+        let p = (
+            clampf(roundf(clampf(v.x, clip.x0, clip.x1)), 0.0, screen.0),
+            clampf(roundf(clampf(v.y, clip.y0, clip.y1)), 0.0, screen.1),
+        );
+        if out.last() != Some(&p) {
+            out.push(p);
+        }
+    }
+    while out.len() > 1 && out.first() == out.last() {
+        out.pop();
+    }
+    if out.len() < 3 || out.len() > spec::draw_op::MASK_MAX_VERTS {
+        return MaskOutline::Empty;
+    }
+    let mut area2 = 0.0f32;
+    for i in 0..out.len() {
+        let (x0, y0) = out[i];
+        let (x1, y1) = out[(i + 1) % out.len()];
+        area2 += x0 * y1 - x1 * y0;
+    }
+    if area2 == 0.0 {
+        return MaskOutline::Empty;
+    }
+    MaskOutline::Poly(out)
+}
