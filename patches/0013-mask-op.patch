+// ---- MASK_PUSH / MASK_POP: a convex polygon as coverage over what follows --------------
+// (pocket-motion patch 0013; the software rasteriser only.)
+
+/// One mask level: per-pixel hits (0..=16) over the polygon's bbox at
+/// physical resolution, already multiplied by the level under it. Outside
+/// the bbox the mask is 0.
+pub struct MaskLevel {
+    x0: i32,
+    y0: i32,
+    w: i32,
+    h: i32,
+    hits: Vec<u8>,
+}
+
+impl MaskLevel {
+    fn empty() -> MaskLevel {
+        MaskLevel { x0: 0, y0: 0, w: 0, h: 0, hits: Vec::new() }
+    }
+
+    #[inline]
+    fn at(&self, x: i32, y: i32) -> u32 {
+        if x < self.x0 || y < self.y0 || x >= self.x0 + self.w || y >= self.y0 + self.h {
+            return 0;
+        }
+        self.hits[((y - self.y0) * self.w + (x - self.x0)) as usize] as u32
+    }
+}
+
+/// Sample the polygon's coverage once into a level — the same rows and the
+/// same 16 samples POLY would use to draw it.
+fn mask_level(scale: i32, clip: Clip, verts: &[u32]) -> MaskLevel {
+    let Some(scan) = PolyScan::new(scale, clip, verts) else {
+        return MaskLevel::empty();
+    };
+    let w = scan.max_x - scan.min_x;
+    let h = scan.max_y - scan.min_y;
+    let mut hits = alloc::vec![0u8; (w as usize) * (h as usize)];
+    for row in scan.min_y..scan.max_y {
+        let Some(pr) = scan.row(row) else {
+            continue;
+        };
+        let base = ((row - scan.min_y) * w) as usize;
+        for col in pr.tl..pr.il {
+            hits[base + col as usize] = scan.hits(&pr, col) as u8;
+        }
+        for col in pr.il..pr.ih {
+            hits[base + col as usize] = 16;
+        }
+        for col in pr.ih..pr.th {
+            hits[base + col as usize] = scan.hits(&pr, col) as u8;
+        }
+    }
+    MaskLevel { x0: scan.min_x, y0: scan.min_y, w, h, hits }
+}
+
+/// A target under one or more masks. Every write is scaled by the top
+/// level's hits at that pixel — `a * hits / 16`, the expression POLY's own
+/// boundary uses — so a mask reaches every op without any op knowing.
+struct Masked<'a> {
+    inner: &'a mut dyn RenderTarget,
+    stride: i32,
+    levels: Vec<MaskLevel>,
+}
+
+impl Masked<'_> {
+    #[inline]
+    fn top(&self, offset: usize) -> u32 {
+        let Some(top) = self.levels.last() else {
+            return 16;
+        };
+        let o = offset as i32;
+        top.at(o % self.stride, o / self.stride)
+    }
+}
