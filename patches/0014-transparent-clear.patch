+// ---- pocket-motion patch 0014: the framebuffer carries alpha -------------------
+
+/// One absolutely positioned box at (10,10) 40x40 on a root that may or may
+/// not declare a ground.
+fn alpha_scene(ground: Option<u32>, color: u32) -> alloc::vec::Vec<u8> {
+    let mut ui = Ui::new();
+    let mut root = StyleSpec::new();
+    if let Some(g) = ground {
+        root.base = alloc::vec![(spec::prop::BG_COLOR, g)];
+    }
+    let mut boxed = StyleSpec::new();
+    boxed.base = alloc::vec![
+        (spec::prop::POS_TYPE, spec::PosType::Absolute as u32),
+        (spec::prop::WIDTH, 40f32.to_bits()),
+        (spec::prop::HEIGHT, 40f32.to_bits()),
+        (spec::prop::INSET_L, 10f32.to_bits()),
+        (spec::prop::INSET_T, 10f32.to_bits()),
+        (spec::prop::BG_COLOR, color),
+    ];
+    assert!(ui.load_styles(&encode_styles(&[root, boxed])));
+    ui.set_style(spec::ROOT_ID, 0);
+    let a = ui.create_node(0);
+    ui.insert_before(spec::ROOT_ID, a, 0);
+    ui.set_style(a, 1);
+    ui.tick();
+    raster_fb(&mut ui)
+}
+
+#[test]
+fn no_ground_clears_transparent_and_an_opaque_box_is_opaque() {
+    let fb = alpha_scene(None, abgr(0x22, 0xd3, 0xee, 0xff));
+    assert_eq!(sample_rgba(&fb, 5, 5), [0, 0, 0, 0], "nothing was drawn here");
+    assert_eq!(sample_rgba(&fb, 20, 20), [0x22, 0xd3, 0xee, 0xff], "the box is opaque");
+    let min_alpha = fb.chunks_exact(4).map(|p| p[3]).min().unwrap();
+    let max_alpha = fb.chunks_exact(4).map(|p| p[3]).max().unwrap();
+    assert_eq!((min_alpha, max_alpha), (0, 255));
+}
+
+#[test]
+fn half_alpha_box_over_transparent_keeps_its_colour() {
+    // Straight alpha: the colour survives untouched and only the alpha byte
+    // carries the 50%. Premultiplied-into-black would read 0x11,0x69,0x77.
+    let fb = alpha_scene(None, abgr(0x22, 0xd3, 0xee, 0x80));
+    assert_eq!(sample_rgba(&fb, 20, 20), [0x22, 0xd3, 0xee, 0x80]);
+}
+
+#[test]
+fn declared_ground_is_opaque_everywhere_and_blends_as_before() {
+    let fb = alpha_scene(Some(abgr(0x10, 0x20, 0x30, 0xff)), abgr(0x22, 0xd3, 0xee, 0x80));
+    assert!(fb.chunks_exact(4).all(|p| p[3] == 255), "a ground makes every pixel opaque");
+    // The opaque-destination expression, verbatim: (s*a + d*(255-a) + 127) / 255.
+    let mix = |s: u32, d: u32| ((s * 0x80 + d * 0x7f + 127) / 255) as u8;
+    assert_eq!(
+        sample_rgba(&fb, 20, 20),
+        [mix(0x22, 0x10), mix(0xd3, 0x20), mix(0xee, 0x30), 0xff]
+    );
+    assert_eq!(sample_rgba(&fb, 5, 5), [0x10, 0x20, 0x30, 0xff]);
+}
+
+#[test]
+fn two_half_alpha_layers_over_transparent_compose_src_over() {
+    // Two 50% boxes at the same place: alpha 0x80 + 0x80*(1-0x80/255) = 0xbf,
+    // and a colour that is the straight-alpha src-over of the two.
+    let mut ui = Ui::new();
+    let mut boxed = StyleSpec::new();
+    boxed.base = alloc::vec![
+        (spec::prop::POS_TYPE, spec::PosType::Absolute as u32),
+        (spec::prop::WIDTH, 40f32.to_bits()),
+        (spec::prop::HEIGHT, 40f32.to_bits()),
+        (spec::prop::INSET_L, 10f32.to_bits()),
+        (spec::prop::INSET_T, 10f32.to_bits()),
+        (spec::prop::BG_COLOR, abgr(0xff, 0x00, 0x00, 0x80)),
+    ];
+    let mut top = StyleSpec::new();
+    top.base = boxed.base.clone();
+    top.base[5] = (spec::prop::BG_COLOR, abgr(0x00, 0x00, 0xff, 0x80));
+    assert!(ui.load_styles(&encode_styles(&[boxed, top])));
+    for i in 0..2 {
+        let n = ui.create_node(0);
+        ui.insert_before(spec::ROOT_ID, n, 0);
+        ui.set_style(n, i);
+    }
+    ui.tick();
+    let fb = raster_fb(&mut ui);
+    let px = sample_rgba(&fb, 20, 20);
+    let want: u32 = 0x80 + (0x80u32 * 0x7f + 127) / 255;
+    assert_eq!(px[3] as u32, want, "alpha is src-over");
+    // red under blue at 50% each, straight alpha: red = 255*128*127/255 / (0xbf*255)...
+    // Rather than restate the integer expression, pin the property that
+    // matters: neither channel was pulled toward black.
+    assert!(px[0] > 0x40 && px[2] > 0x80, "colour kept: {:?}", px);
+}
