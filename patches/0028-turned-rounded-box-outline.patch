+    /// A rounded box under a world that is not axis-aligned. It used to be
+    /// drawn as the plain box — a turning `rounded-full` circle was a turning
+    /// square. Its outline is the rounded rectangle `overflow-mask` flattens
+    /// (`mask_outline`), pushed as a MASK_PUSH inside the box's AABB, and the
+    /// box's fill drawn under it: the coverage at its edge is the outline's,
+    /// sampled exactly as a mask is. A flat fill is drawn two screen pixels
+    /// past the box on every side, so its own edge never multiplies the
+    /// outline's; a two-stop gradient keeps its own box, so its colours stay
+    /// those of the box (its straight edges are the TRI fan's, as a turned
+    /// square gradient's are).
+    #[allow(clippy::too_many_arguments)]
+    fn emit_rounded_box_turned(
+        &mut self,
+        dl: &mut DrawList,
+        world: &Affine,
+        x0: f32,
+        y0: f32,
+        x1: f32,
+        y1: f32,
+        radius: f32,
+        fill: Fill,
+        clip: &Clip,
+    ) {
+        let (w, h) = (x1 - x0, y1 - y0);
+        if w <= 0.0 || h <= 0.0 {
+            return;
+        }
+        let local = world.then(&Affine::translate(x0, y0));
+        let aabb = clip.intersect(&self.world_aabb(&local, w, h));
+        if aabb.is_empty() {
+            return;
+        }
+        let verts = match mask_outline(&local, w, h, radius, &Clip::viewport(self.screen), self.screen) {
+            MaskOutline::Poly(verts) => verts,
+            MaskOutline::Empty => return,
+            MaskOutline::Aabb => {
+                self.emit_box(dl, world, x0, y0, x1, y1, fill, clip);
+                return;
+            }
+        };
+        dl.words.push(spec::draw_op::SCISSOR);
+        dl.words.push(xy_word(aabb.x0, aabb.y0));
+        dl.words.push(wh_word(aabb.x1 - aabb.x0, aabb.y1 - aabb.y0));
+        dl.words.push(spec::draw_op::MASK_PUSH);
+        dl.words.push(verts.len() as u32);
+        for &(x, y) in &verts {
+            dl.words.push(x.to_bits());
+            dl.words.push(y.to_bits());
+        }
+        match fill {
+            Fill::Flat(_) => {
+                // Two screen pixels past each edge: a local step along x moves
+                // a point |det| / |(c, d)| across the edges parallel to local y.
+                let det = (world.a * world.d - world.b * world.c).abs();
+                let ex = if det > 0.0 { 2.0 * sqrtf(world.c * world.c + world.d * world.d) / det } else { 0.0 };
+                let ey = if det > 0.0 { 2.0 * sqrtf(world.a * world.a + world.b * world.b) / det } else { 0.0 };
+                self.emit_box(dl, world, x0 - ex, y0 - ey, x1 + ex, y1 + ey, fill, &aabb);
+            }
+            Fill::Grad { .. } => self.emit_box(dl, world, x0, y0, x1, y1, fill, &aabb),
+        }
+        dl.words.push(spec::draw_op::MASK_POP);
+        dl.words.push(spec::draw_op::SCISSOR_POP);
+    }
