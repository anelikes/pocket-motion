+/// A 100 px `rounded-full` white box centred on the screen, turned `rotate`
+/// degrees about its centre, over black.
+fn turned_circle(rotate: f64, radius: f64) -> alloc::vec::Vec<u8> {
+    let mut ui = Ui::new();
+    ui.set_prop(spec::ROOT_ID, spec::prop::BG_COLOR, abgr(0, 0, 0, 255) as f64);
+    let n = place_box(&mut ui, 100.0, 100.0, 190.0, 86.0);
+    ui.set_prop(n, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.set_prop(n, spec::prop::RADIUS, radius);
+    if rotate != 0.0 {
+        ui.set_prop(n, spec::prop::ROTATE, rotate);
+    }
+    ui.tick();
+    let words = ui.draw().words.clone();
+    validate_drawlist(&words);
+    raster_fb(&mut ui)
+}
+
+#[test]
+fn a_turned_rounded_box_keeps_its_corners() {
+    // A rounded box under a rotation was drawn as the plain box: a turning
+    // `rounded-full` circle was a turning square. It is drawn under its
+    // rounded outline now, so the turned circle is the circle: the same
+    // area as the unturned one, and nothing in the square's corners.
+    let r = 50.0f64;
+    let disc = core::f64::consts::PI * r * r;
+    let lum = |fb: &[u8]| -> f64 {
+        let mut a = 0.0;
+        for y in 0..spec::SCREEN_H as usize {
+            for x in 0..spec::SCREEN_W as usize {
+                a += sample_rgba(fb, x, y)[0] as f64 / 255.0;
+            }
+        }
+        a
+    };
+    let flat = lum(&turned_circle(0.0, r));
+    assert!((flat - disc).abs() < disc * 0.015, "unturned circle: {flat} against {disc}");
+    for &turn in &[30.0f64, 45.0] {
+        let fb = turned_circle(turn, r);
+        let area = lum(&fb);
+        assert!((area - disc).abs() < disc * 0.015, "turned {turn}: area {area}, a circle is {disc}");
+        // The square's corners, turned with it: 0.9 of the half-diagonal out.
+        for k in 0..4 {
+            let t = (turn + 45.0 + 90.0 * k as f64).to_radians();
+            let d = 0.9 * r * core::f64::consts::SQRT_2;
+            let (x, y) = ((240.0 + d * t.cos()) as usize, (136.0 + d * t.sin()) as usize);
+            assert_eq!(sample_rgba(&fb, x, y)[0], 0, "turned {turn}: ink at the square's corner ({x},{y})");
+        }
+    }
+    // A turned square keeps its corners: radius 0 is still the plain box.
+    let square = lum(&turned_circle(30.0, 0.0));
+    assert!((square - 100.0 * 100.0).abs() < 200.0, "turned square: {square}");
+}
