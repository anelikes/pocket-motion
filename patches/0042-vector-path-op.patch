+fn flat_len(f: &Flat) -> (f32, usize) {
+    let mut total = 0.0f32;
+    for s in &f.subs {
+        for i in s.start + 1..s.end {
+            let (a, b) = (f.pts[i - 1], f.pts[i]);
+            total += sqrtf((b.x - a.x) * (b.x - a.x) + (b.y - a.y) * (b.y - a.y));
+        }
+        if s.closed {
+            let (a, b) = (f.pts[s.end - 1], f.pts[s.start]);
+            total += sqrtf((b.x - a.x) * (b.x - a.x) + (b.y - a.y) * (b.y - a.y));
+        }
+    }
+    (total, f.subs.len())
+}
