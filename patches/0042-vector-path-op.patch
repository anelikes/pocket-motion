+#[test]
+fn path_scene_digests_are_pinned() {
+    let mut out = std::string::String::new();
+    let mut mismatch = 0;
+    for i in 0..SCENE_NAMES.len() {
+        let (w, f) = scene_digest(i);
+        out.push_str(&std::format!("    (0x{w:016x}, 0x{f:016x}), // {}\n", SCENE_NAMES[i]));
