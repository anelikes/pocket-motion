+/// styles.bin with `records` (base props only), no anims, and `paths`.
+fn styles_with_paths(records: &[Vec<(u8, u32)>], paths: &[PathEntry]) -> Vec<u8> {
+    use crate::spec::style_table as st;
+    let mut b = Vec::new();
+    b.extend_from_slice(&st::MAGIC.to_le_bytes());
+    b.extend_from_slice(&st::VERSION.to_le_bytes());
+    b.extend_from_slice(&(records.len() as u16).to_le_bytes());
+    b.extend_from_slice(&0u16.to_le_bytes());
+    b.extend_from_slice(&(paths.len() as u16).to_le_bytes());
+    for r in records {
+        b.push(st::VARIANT_BASE);
+        b.push(r.len() as u8);
+        for &(prop, v) in r {
+            b.push(prop);
+            b.push(0);
+            b.extend_from_slice(&v.to_le_bytes());
+        }
+    }
+    PathTable::encode(paths, &mut b);
+    b
+}
+
+fn path_node(ui: &mut crate::Ui) -> i32 {
+    use crate::spec::{self, prop};
+    let n = ui.create_node(spec::NodeType::View as u8);
+    for (p, v) in [
+        (prop::WIDTH, 120.0),
+        (prop::HEIGHT, 120.0),
+        (prop::POS_TYPE, spec::PosType::Absolute as u32 as f64),
+        (prop::INSET_L, 100.0),
+        (prop::INSET_T, 60.0),
+        (prop::PATH, 1.0),
+        (prop::FILL_COLOR, abgr(255, 160, 0, 255) as f64),
+        (prop::STROKE_COLOR, abgr(255, 255, 255, 255) as f64),
+        (prop::STROKE_WIDTH, 4.0),
+        (prop::STROKE_JOIN, spec::StrokeJoin::Round as u32 as f64),
+        (prop::ROTATE, 20.0),
+    ] {
+        ui.set_prop(n, p, v);
+    }
+    ui.insert_before(spec::ROOT_ID, n, 0);
+    n
+}
+
+fn ops_of(words: &[u32]) -> Vec<u32> {
+    // Every op this test meets has a fixed or self-described length.
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < words.len() {
+        let op = words[i];
+        out.push(op);
+        i += match op {
+            draw_op::RECT => 4,
+            draw_op::PATH => words[i + 1] as usize,
+            draw_op::PAINT_PUSH => 9 + 2 * words[i + 2] as usize,
+            draw_op::PAINT_POP => 1,
+            draw_op::POLY => 3 + words[i + 1] as usize,
+            _ => panic!("unexpected op {op}"),
+        };
+    }
+    out
+}
