+//! Path test scenes, shared by the core tests, the cross-platform digest
+//! check and the cost measurement (feature `path-scenes` exposes them to
+//! the wasm harness). Every scene is a pure function of its index: the same
+//! words and the same pixels on every host, which is what the digests pin.
+
+use alloc::vec::Vec;
+
+use crate::draw::Affine;
+use crate::path::*;
+use crate::spec::draw_op;
+use crate::Ui;
+
+// ---- deterministic randomness ----------------------------------------------------
+
+pub struct Rng(pub u64);
+
+impl Rng {
+    pub fn next(&mut self) -> u64 {
+        // xorshift64*
+        let mut x = self.0;
+        x ^= x >> 12;
+        x ^= x << 25;
+        x ^= x >> 27;
+        self.0 = x;
+        x.wrapping_mul(0x2545_f491_4f6c_dd1d)
+    }
+
+    /// Uniform in [0, 1) from 24 bits: exact in f32.
+    pub fn f(&mut self) -> f32 {
+        (self.next() >> 40) as f32 / 16_777_216.0
+    }
+
+    pub fn range(&mut self, lo: f32, hi: f32) -> f32 {
+        lo + (hi - lo) * self.f()
+    }
+
+    pub fn below(&mut self, n: u64) -> u64 {
+        self.next() % n
+    }
+}
+
+pub fn fnv64(bytes: &[u8]) -> u64 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for &b in bytes {
+        h ^= b as u64;
+        h = h.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    h
+}
+
+pub fn words_digest(words: &[u32]) -> u64 {
+    let mut bytes = Vec::with_capacity(words.len() * 4);
+    for w in words {
+        bytes.extend_from_slice(&w.to_le_bytes());
+    }
+    fnv64(&bytes)
+}
+
+// ---- shape builders ------------------------------------------------------------------
+
+/// Verbs + points for a shape built with move/line/cubic/close calls.
+#[derive(Clone, Default)]
+pub struct Shape {
+    pub verbs: Vec<u8>,
+    pub pts: Vec<Pt>,
+}
+
+impl Shape {
+    pub fn m(&mut self, x: f32, y: f32) -> &mut Self {
+        self.verbs.push(VERB_MOVE);
+        self.pts.push(pt(x, y));
+        self
+    }
+    pub fn l(&mut self, x: f32, y: f32) -> &mut Self {
+        self.verbs.push(VERB_LINE);
+        self.pts.push(pt(x, y));
+        self
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub fn c(&mut self, x1: f32, y1: f32, x2: f32, y2: f32, x: f32, y: f32) -> &mut Self {
+        self.verbs.push(VERB_CUBIC);
+        self.pts.push(pt(x1, y1));
+        self.pts.push(pt(x2, y2));
+        self.pts.push(pt(x, y));
+        self
+    }
+    pub fn z(&mut self) -> &mut Self {
+        self.verbs.push(VERB_CLOSE);
+        self
+    }
+
+    pub fn entry(&self) -> PathEntry {
+        PathEntry::new(self.verbs.clone(), &[self.pts.clone()], None).expect("valid shape")
+    }
+}
+
+pub fn morph_entry(shapes: &[&Shape]) -> PathEntry {
+    let verbs = shapes[0].verbs.clone();
+    for s in shapes {
+        assert_eq!(s.verbs, verbs, "morph shapes share their verbs");
+    }
+    let pts: Vec<Vec<Pt>> = shapes.iter().map(|s| s.pts.clone()).collect();
+    PathEntry::new(verbs, &pts, None).expect("valid morph")
+}
+
+/// A circle as `k` cubic arcs (k = 4 or 8), clockwise on screen.
+pub fn circle(sh: &mut Shape, cx: f32, cy: f32, r: f32, k: usize) {
+    // Control distance for an arc of 90 / 45 degrees: 4/3 tan(theta/4).
+    let (cos_t, sin_t, h) = if k == 8 {
+        (0.707_106_77f32, 0.707_106_77f32, 0.265_216_45f32)
+    } else {
+        (0.0f32, 1.0f32, 0.552_284_75f32)
+    };
+    // Unit points around the circle by repeated rotation (exact table for k).
+    let mut ux = Vec::new();
+    let mut uy = Vec::new();
+    let (mut x, mut y) = (1.0f32, 0.0f32);
+    for _ in 0..k {
+        ux.push(x);
+        uy.push(y);
+        let nx = x * cos_t - y * sin_t;
+        let ny = x * sin_t + y * cos_t;
+        x = nx;
+        y = ny;
+    }
+    sh.m(cx + r * ux[0], cy + r * uy[0]);
+    for i in 0..k {
+        let j = (i + 1) % k;
+        let (ax, ay, bx, by) = (ux[i], uy[i], ux[j], uy[j]);
+        sh.c(
+            cx + r * (ax - h * ay),
+            cy + r * (ay + h * ax),
+            cx + r * (bx + h * by),
+            cy + r * (by - h * bx),
+            cx + r * bx,
+            cy + r * by,
+        );
+    }
+    sh.z();
+}
+
+/// An 8-cubic flower with the circle's verbs (morphs with `circle(.., 8)`).
+pub fn flower(sh: &mut Shape, cx: f32, cy: f32, r: f32, depth: f32) {
+    let mut c = Shape::default();
+    circle(&mut c, cx, cy, r, 8);
+    // Pull every other on-curve point in and swing the handles outward.
+    let mut pts = c.pts.clone();
+    for (i, p) in pts.iter_mut().enumerate() {
+        let (dx, dy) = (p.x - cx, p.y - cy);
+        let on_curve = i % 3 == 0;
+        let k = if on_curve {
+            if (i / 3) % 2 == 1 {
+                1.0 - depth
+            } else {
+                1.0
+            }
+        } else {
+            1.0 + depth * 0.6
+        };
+        p.x = cx + dx * k;
+        p.y = cy + dy * k;
+    }
+    sh.verbs.extend_from_slice(&c.verbs);
+    sh.pts.extend_from_slice(&pts);
+}
+
+pub fn star(sh: &mut Shape, cx: f32, cy: f32, r: f32, points: usize, step: usize) {
+    // A {points/step} star polygon: self-intersecting, so nonzero and
+    // evenodd differ in its middle. Vertices from repeated rotation.
+    let mut vx = Vec::new();
+    let mut vy = Vec::new();
+    let a = 2.0 * core::f32::consts::PI / points as f32;
+    // cos/sin of the step by the core's own Taylor polynomial (deterministic).
+    let (c, s) = (cos_poly(a), sin_poly(a));
+    let (mut x, mut y) = (0.0f32, -1.0f32);
+    for _ in 0..points {
+        vx.push(x);
+        vy.push(y);
+        let nx = x * c - y * s;
+        let ny = x * s + y * c;
+        x = nx;
+        y = ny;
+    }
+    let mut i = 0usize;
+    sh.m(cx + r * vx[0], cy + r * vy[0]);
+    for _ in 1..points {
+        i = (i + step) % points;
+        sh.l(cx + r * vx[i], cy + r * vy[i]);
+    }
+    sh.z();
+}
+
+/// sin by the 5-term Taylor series `draw.rs` uses, for |x| <= pi/2.
+pub fn sin_poly(r: f32) -> f32 {
+    let x2 = r * r;
+    r * (1.0 + x2 * (-1.0 / 6.0 + x2 * (1.0 / 120.0 + x2 * (-1.0 / 5040.0 + x2 * (1.0 / 362880.0)))))
+}
+
+pub fn cos_poly(r: f32) -> f32 {
+    sin_poly(core::f32::consts::FRAC_PI_2 - r)
+}
+
+/// sin of any angle: fold into [-pi/2, pi/2] first (the `draw.rs` sequence).
+pub fn sin_any(x: f32) -> f32 {
+    sin_poly(wrap(x))
+}
+
+pub fn cos_any(x: f32) -> f32 {
+    sin_any(x + core::f32::consts::FRAC_PI_2)
+}
+
+pub fn affine(a: f32, b: f32, c: f32, d: f32, tx: f32, ty: f32) -> Affine {
+    Affine { a, b, c, d, tx, ty }
+}
+
+pub fn rotation(deg: f32, sx: f32, sy: f32, tx: f32, ty: f32) -> Affine {
+    let r = deg * (core::f32::consts::PI / 180.0);
+    let (s, c) = if deg == 0.0 { (0.0, 1.0) } else { (sin_any(r), cos_any(r)) };
+    affine(c * sx, s * sx, -s * sy, c * sy, tx, ty)
+}
+
+pub fn paint_fill(color: u32, evenodd: bool) -> PathPaint {
+    PathPaint {
+        morph: 0.0,
+        fill: color,
+        evenodd,
+        stroke: 0,
+        stroke_style: StrokeStyle { width: 0.0, join: Join::Miter, cap: Cap::Butt, miter_limit: 4.0 },
+        trim: Trim::NONE,
+    }
+}
+
+pub fn paint_stroke(color: u32, width: f32, join: Join, cap: Cap) -> PathPaint {
+    PathPaint {
+        morph: 0.0,
+        fill: 0,
+        evenodd: false,
+        stroke: color,
+        stroke_style: StrokeStyle { width, join, cap, miter_limit: 4.0 },
+        trim: Trim::NONE,
+    }
+}
+
+pub fn abgr(r: u32, g: u32, b: u32, a: u32) -> u32 {
+    (a << 24) | (b << 16) | (g << 8) | r
+}
+
+/// Emit one path into `words` (box w/h only matter for a viewBox).
+pub fn emit(words: &mut Vec<u32>, entry: &PathEntry, xf: &Affine, paint: &PathPaint, screen: (f32, f32), stats: &mut PathStats) {
+    let mut sc = PathScratch::default();
+    emit_path(words, entry, 0.0, 0.0, xf, paint, screen, &mut sc);
+    stats.chords += sc.stats.chords;
+    stats.vertices += sc.stats.vertices;
+}
+
+/// Rasterise `words` over a cleared `w x h` (logical) frame at `scale`.
+pub fn render(words: &[u32], w: u32, h: u32, scale: u32) -> Vec<u8> {
+    let mut ui = Ui::new();
+    ui.set_viewport(w as f32, h as f32);
+    let mut fb = alloc::vec![0u8; (w * scale * h * scale * 4) as usize];
+    crate::raster::render_scaled(&ui, words, &mut fb, scale);
+    fb
+}
+
+/// A MASK_PUSH of `pts` in logical px: 2 + 2N words, `(x, y)` f32 pairs
+/// (the format since pocket-motion patch 0024).
+pub fn mask_push(words: &mut Vec<u32>, pts: &[(f32, f32)]) {
+    words.push(draw_op::MASK_PUSH);
+    words.push(pts.len() as u32);
+    for &(x, y) in pts {
+        words.push(x.to_bits());
+        words.push(y.to_bits());
+    }
+}
+
+/// An opaque ground the size of the frame, so blends land on opaque pixels.
+pub fn ground(words: &mut Vec<u32>, w: u32, h: u32, color: u32) {
+    words.push(draw_op::RECT);
+    words.push(0);
+    words.push(w | (h << 16));
+    words.push(color);
+}
+
