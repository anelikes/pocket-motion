+#[test]
+fn every_draw_list_walker_steps_over_a_path() {
+    // The compositor's walkers take each op's length from a table of their
+    // own (`compositor::draw_op_len`, `Ui::compositor_surface_frames`), and a
+    // length they do not know ends the walk. A PATH ahead of a surface: the
+    // surface must still be found, and a compositor render with no surface
+    // raster must equal the plain render. Red with PATH dropped from either
+    // table — the frame list comes back empty, or the composite stops at the
+    // path and never draws it.
+    use crate::spec;
+    let mut ui = crate::Ui::new();
+    assert!(ui.load_styles(&styles_with_paths(&[], &[blob_entry()])));
+    path_node(&mut ui);
+    let surface = ui.create_node(spec::NodeType::Surface as u8);
+    for (p, v) in [
+        (spec::prop::WIDTH, 40.0),
+        (spec::prop::HEIGHT, 30.0),
+        (spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64),
+        (spec::prop::INSET_L, 10.0),
+        (spec::prop::INSET_T, 10.0),
+    ] {
+        ui.set_prop(surface, p, v);
+    }
+    ui.set_compositor_surface(surface, 3, false);
+    ui.insert_before(spec::ROOT_ID, surface, 0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    let path_at = words.iter().position(|&w| w == draw_op::PATH).expect("a path op");
+    let quad_at = words.iter().position(|&w| w == draw_op::SURFACE_QUAD).expect("a surface op");
+    assert!(path_at < quad_at, "the path is walked first");
+    assert_eq!(crate::compositor::draw_op_len(&words, path_at), Some(words[path_at + 1] as usize));
+    let frames = ui.compositor_surface_frames();
+    assert_eq!(frames.len(), 1, "the surface after the path is found");
+    assert_eq!(frames[0].handle, 3);
+    let (w, h) = ui.viewport();
+    let mut plain = alloc::vec![0u8; w as usize * h as usize * 4];
+    crate::raster::render(&ui, &words, &mut plain);
+    let mut composed = alloc::vec![0u8; w as usize * h as usize * 4];
+    crate::compositor::render(&ui, &words, &mut composed, 1, &[]);
+    assert!(plain.chunks(4).any(|p| p == [255, 160, 0, 255]), "the path paints");
+    assert!(plain == composed, "the composite draws what the plain render draws");
+}
