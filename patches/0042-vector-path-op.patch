+/// Cost instrumentation (the pathwasm harness): run only the PATH coverage of every op in
+/// `words` (no blending) and count crossings, rows and covered pixels.
+#[cfg(any(test, feature = "path-scenes"))]
+#[doc(hidden)]
+pub fn bench_path_coverage(words: &[u32], w: i32, h: i32, scale: i32) -> (u64, u64, u64, u64) {
+    let clip = Clip { x0: 0, y0: 0, x1: w * scale, y1: h * scale };
+    let mut ras = PathRaster::default();
+    let (mut rows, mut px, mut full, mut edges) = (0u64, 0u64, 0u64, 0u64);
+    let mut i = 0;
+    while i < words.len() {
+        match words[i] {
+            draw_op::RECT => i += 4,
+            draw_op::PATH => {
+                let len = words[i + 1] as usize;
+                let op = &words[i..i + len];
+                path_rows(scale, clip, op, &mut ras, |_, x0, x1, h| {
+                    rows += 1;
+                    px += (x1 - x0) as u64;
+                    if h == 16 {
+                        full += (x1 - x0) as u64;
+                    }
+                });
+                edges += ras.edges.len() as u64;
+                i += len;
+            }
+            _ => break,
+        }
+    }
+    (rows, px, full, edges)
+}
