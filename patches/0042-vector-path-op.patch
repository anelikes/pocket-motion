+#[test]
+fn flattened_curve_stays_within_tolerance() {
+    // Every chord is within FLATTEN_TOL of the cubic over its parameter
+    // span (in f64). Red if Wang's bound is mis-scaled or a chord end is
+    // evaluated at the wrong t.
+    let mut rng = Rng(5150);
+    for _ in 0..200 {
+        let p: Vec<Pt> = (0..4).map(|_| pt(rng.range(-300.0, 300.0), rng.range(-300.0, 300.0))).collect();
+        let mut f = Flat::default();
+        flatten(&[VERB_MOVE, VERB_CUBIC], &p, FLATTEN_TOL, &mut f);
+        // Wang's bound is on the PARAMETRIC deviation: at t between chord
+        // ends i/n and (i+1)/n, the curve is within tol of the chord's lerp.
+        let n = f.pts.len() - 1;
+        let bez = |t: f64| {
+            let mt = 1.0 - t;
+            let b = [mt * mt * mt, 3.0 * mt * mt * t, 3.0 * mt * t * t, t * t * t];
+            ((0..4).map(|k| b[k] * p[k].x as f64).sum::<f64>(), (0..4).map(|k| b[k] * p[k].y as f64).sum::<f64>())
+        };
+        for i in 0..n {
+            for k in 0..=8 {
+                let u = k as f64 / 8.0;
+                let c = bez((i as f64 + u) / n as f64);
+                let (a, b) = (f.pts[i], f.pts[i + 1]);
+                let l = (a.x as f64 + (b.x - a.x) as f64 * u, a.y as f64 + (b.y - a.y) as f64 * u);
+                let d = ((c.0 - l.0).powi(2) + (c.1 - l.1).powi(2)).sqrt();
+                assert!(d <= FLATTEN_TOL as f64 + 1e-3, "chord {i}/{n} deviates {d}");
+            }
+        }
+    }
+}
