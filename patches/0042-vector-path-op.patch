+#[test]
+fn trimmed_length_is_the_window_in_both_modes() {
+    // The pieces' arc length is (end - start) of the measured length, in
+    // Whole over the sum and in Each per subpath; a wrapped window on a
+    // closed subpath is ONE piece through its start. Red if a piece misses
+    // its cut point, duplicates a vertex, or the wrap splits a closed loop.
+    let e = spiral_entry();
+    let mut pts = Vec::new();
+    e.points_at(0.0, &mut pts);
+    let mut flat = Flat::default();
+    flatten(&e.verbs, &pts, FLATTEN_TOL, &mut flat);
+    let (full, nsub) = flat_len(&flat);
+    assert_eq!(nsub, 3);
+    let mut out = Flat::default();
+    let mut cum = Vec::new();
+    for &(s, en, off) in &[(0.1f32, 0.6f32, 0.0f32), (0.0, 0.3, 0.85), (0.25, 0.75, 0.5), (0.05, 0.95, 0.2)] {
+        trim(&flat, &Trim { start: s, end: en, offset: off, mode: TrimMode::Whole }, &mut out, &mut cum);
+        let (l, _) = flat_len(&out);
+        assert!((l - (en - s) * full).abs() < 1e-3 * full, "Whole {s}..{en}+{off}: {l} of {full}");
+        trim(&flat, &Trim { start: s, end: en, offset: off, mode: TrimMode::Each }, &mut out, &mut cum);
+        let (l, n) = flat_len(&out);
+        assert!((l - (en - s) * full).abs() < 1e-3 * full, "Each {s}..{en}+{off}: {l} of {full}");
+        let wraps = s + (off - crate::layout::floorf(off)) >= 1.0 || en + (off - crate::layout::floorf(off)) > 1.0;
+        // Each: the closed circle is one piece even when wrapped; the two
+        // open subpaths are two pieces when wrapped.
+        assert_eq!(n, if wraps { 5 } else { 3 }, "Each {s}..{en}+{off}: pieces");
+    }
+}
