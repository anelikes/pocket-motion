+/// POLY's per-pixel hits over its bbox (tests compare PATH against it).
+#[cfg(test)]
+pub(crate) fn poly_hits_rows(scale: i32, clip: Clip, verts: &[u32], mut emit: impl FnMut(i32, i32, u32)) {
