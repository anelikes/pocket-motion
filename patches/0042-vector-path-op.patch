+fn trim_end_animates_through_the_anim_machinery_and_moves_the_draw_hash() {
+    // A draw-on: trimEnd 0 -> 1 over 30 frames with `animate`. Every frame's
+    // stroke differs from the last and the fill never changes. Red if the
+    // prop is not animatable, not resolved, or not read by the walk.
+    use crate::spec::{self, prop};
+    let mut ui = crate::Ui::new();
+    assert!(ui.load_styles(&styles_with_paths(&[], &[blob_entry()])));
+    let n = path_node(&mut ui);
+    ui.set_prop(n, prop::TRIM_END, 0.0);
+    ui.tick();
+    assert_eq!(ops_of(&ui.draw().words), [draw_op::PATH], "trimmed to nothing: the fill only");
+    assert!(ui.animate(n, prop::TRIM_END, 1.0, 500, spec::Easing::Linear as u8, 0) >= 0, "trimEnd is animatable");
+    let mut last_stroke: Option<Vec<u32>> = None;
+    let mut fill: Option<Vec<u32>> = None;
+    let mut seen = 0;
+    for _ in 0..30 {
+        ui.tick();
+        let w = ui.draw().words.clone();
+        let len = w[1] as usize;
+        let f = w[..len].to_vec();
+        if let Some(prev) = &fill {
+            assert_eq!(&f, prev, "the fill does not move with the trim");
+        }
+        fill = Some(f);
+        if w.len() > len {
+            let s = w[len..].to_vec();
+            if let Some(prev) = &last_stroke {
+                assert_ne!(&s, prev, "every frame of the draw-on is a new stroke");
+            }
+            last_stroke = Some(s);
+            seen += 1;
+        }
+    }
+    assert!(seen >= 28, "the stroke appears and grows: {seen} frames");
+}
