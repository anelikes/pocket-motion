+        let mut ui = Ui::new();
+        // xorshift32 texel bytes; every fifth RGBA texel fully transparent.
+        let mut state = 0x2545_f491u32;
+        let mut next = move || {
+            state ^= state << 13;
+            state ^= state >> 17;
+            state ^= state << 5;
+            state
+        };
+        // At 25, 27, 41 and 100 texels a quad drawn at the texture's own size
+        // puts some linear taps a fraction BELOW a texel centre (41: on the
+        // first column or row, where the tap then leans on the second texel),
+        // which is exactly where a shortcut that assumed centres would differ.
+        let sizes = [(1u32, 1u32), (3, 5), (25, 27), (41, 6), (7, 41), (100, 3)];
+        let mut textures = Vec::new();
+        for &(w, h) in &sizes {
+            let mut rgba = Vec::new();
+            for i in 0..w * h {
+                let v = next();
+                let a = if i % 5 == 4 { 0 } else { (v >> 24) as u8 };
+                rgba.extend_from_slice(&[v as u8, (v >> 8) as u8, (v >> 16) as u8, a]);
+            }
+            let rgb565: Vec<u8> = (0..w * h).flat_map(|_| (next() as u16).to_le_bytes()).collect();
