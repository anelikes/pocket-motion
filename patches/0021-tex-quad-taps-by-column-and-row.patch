+                for (bytes, psm) in [(&rgba, spec::psm::PSM_8888), (&rgb565, spec::psm::PSM_5650)] {
+                    let handle = ui.upload_texture_flags(bytes, w, h, psm, flags);
+                    assert!(handle >= 0, "{w}x{h} psm {psm} flags {flags} uploads");
+                    textures.push((handle, w as i32, h as i32));
+                }
+            }
+        }
