+/// One axis of a texture lookup: the base texel, its clamped neighbour and
+/// the neighbour's 8-bit weight. A nearest lookup is a tap of weight 0.
+#[derive(Clone, Copy)]
+struct AxisTap {
+    i0: u32,
+    i1: u32,
+    f: u32,
+}
+
+/// One axis of [`linear_sample_coordinates`]. The axes never read each
+/// other, which is what lets TEX_QUAD take a column's tap once for every row.
+#[inline]
+fn linear_axis(size: u32, t: f32) -> AxisTap {
+    let max = size as i32 - 1;
+    let tf = (t * size as f32 * 256.0) as i32 - 128;
+    let i0 = (tf >> 8).clamp(0, max);
+    AxisTap {
+        i0: i0 as u32,
+        i1: (i0 + 1).min(max) as u32,
+        f: (tf & 255) as u32,
+    }
+}
+
+/// One axis of a nearest lookup: truncate, clamp, weight 0.
+#[inline]
+fn nearest_axis(size: u32, t: f32) -> AxisTap {
+    let i = ((t * size as f32) as i32).clamp(0, size as i32 - 1) as u32;
+    AxisTap { i0: i, i1: i, f: 0 }
+}
