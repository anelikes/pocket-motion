+    // ---- TEX_QUAD taps by column and row ------------------------------------------------
+
+    /// TEX_QUAD's sampler as it was before its taps were tabled, kept as the
+    /// reference: every pixel evaluates its own (u, v) and, when linear,
+    /// reads and blends all four neighbours through the coordinate
+    /// arithmetic of that time.
+    fn tex_quad_per_pixel<T: RenderTarget>(
+        ui: &Ui,
+        target: &mut T,
+        stride: i32,
+        scale: i32,
+        clip: Clip,
+        p: &[u32],
+    ) {
+        let sample_linear = |view: &TexView, u: f32, v: f32| {
+            let (tw_max, th_max) = (view.w as i32 - 1, view.h as i32 - 1);
+            let uf = (u * view.w as f32 * 256.0) as i32 - 128;
+            let vf = (v * view.h as f32 * 256.0) as i32 - 128;
+            let x0 = (uf >> 8).clamp(0, tw_max);
+            let y0 = (vf >> 8).clamp(0, th_max);
+            let (x1, y1) = ((x0 + 1).min(tw_max), (y0 + 1).min(th_max));
+            let (fx, fy) = ((uf & 255) as u32, (vf & 255) as u32);
+            let w = view.w as i32;
+            let c00 = texel(view, (y0 * w + x0) as usize)?;
+            let c01 = texel(view, (y0 * w + x1) as usize)?;
+            let c10 = texel(view, (y1 * w + x0) as usize)?;
+            let c11 = texel(view, (y1 * w + x1) as usize)?;
+            let lerp8 = |a: u32, b: u32, f: u32| (a * (256 - f) + b * f) >> 8;
+            let mix = |c0: u32, c1: u32, c2: u32, c3: u32| {
+                lerp8(lerp8(c0, c1, fx), lerp8(c2, c3, fx), fy)
+            };
+            Some((
+                mix(c00.0, c01.0, c10.0, c11.0),
+                mix(c00.1, c01.1, c10.1, c11.1),
+                mix(c00.2, c01.2, c10.2, c11.2),
+                mix(c00.3, c01.3, c10.3, c11.3),
+            ))
+        };
+        let handle = p[0] as i32;
+        let (x, y) = xy(p[1], scale);
+        let (w, h) = wh(p[2], scale);
+        let (u0, v0) = (f32::from_bits(p[3]), f32::from_bits(p[4]));
+        let (u1, v1) = (f32::from_bits(p[5]), f32::from_bits(p[6]));
+        let modulate = p[7];
+        if w <= 0 || h <= 0 {
+            return;
+        }
+        let Some(view) = ui.texture(handle) else {
+            return;
+        };
+        let c = clip.intersect(Clip {
+            x0: x,
+            y0: y,
+            x1: x + w,
+            y1: y + h,
+        });
+        if c.x0 >= c.x1 || c.y0 >= c.y1 {
+            return;
+        }
+        let (mr, mg, mb, ma) = channels(modulate);
+        let identity = modulate == 0xffff_ffff;
+        let (twf, thf) = (view.w as f32, view.h as f32);
+        let (tw_max, th_max) = (view.w as i32 - 1, view.h as i32 - 1);
+        let inv_w = 1.0f32 / w as f32;
+        let inv_h = 1.0f32 / h as f32;
+        for py in c.y0..c.y1 {
+            let v = v0 + (v1 - v0) * ((py - y) as f32 + 0.5) * inv_h;
+            let ty = ((v * thf) as i32).clamp(0, th_max);
+            for px in c.x0..c.x1 {
+                let u = u0 + (u1 - u0) * ((px - x) as f32 + 0.5) * inv_w;
+                let sample = if view.linear {
+                    sample_linear(&view, u, v)
+                } else {
+                    let tx = ((u * twf) as i32).clamp(0, tw_max);
+                    texel(&view, (ty * view.w as i32 + tx) as usize)
+                };
+                let Some((mut r, mut g, mut b, mut a)) = sample else {
+                    return;
+                };
+                if !identity {
+                    r = (r * mr + 127) / 255;
+                    g = (g * mg + 127) / 255;
+                    b = (b * mb + 127) / 255;
+                    a = (a * ma + 127) / 255;
+                }
+                target.blend((py * stride + px) as usize, r, g, b, a);
+            }
+        }
+    }
