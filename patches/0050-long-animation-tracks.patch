+/// translateX through `n` two-tick linear segments, segment i going from
+/// i to i + 1 px over ticks [2i, 2i + 2]: the value at tick t is t / 2.
+fn long_anim(n: u16) -> AnimSpec {
+    let segs = (0..n)
+        .map(|i| {
+            SegSpec(2 * i, 2 * i + 2, (i as f32).to_bits(), ((i + 1) as f32).to_bits(), spec::Easing::Linear as u8, None)
+        })
+        .collect();
+    AnimSpec {
+        delay_frames: 0,
+        period_frames: 2 * n,
+        iterations: 1,
+        fill: spec::style_table::ANIM_FILL_BACKWARDS | spec::style_table::ANIM_FILL_FORWARDS,
+        tracks: alloc::vec![(spec::prop::TRANSLATE_X, segs)],
+    }
+}
