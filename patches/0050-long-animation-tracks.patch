+    // Seeded tracks of 1..600 segments with gaps between them, one-tick
+    // segments, eased and bezier segments, colour and scalar payloads,
+    // each sampled at every tick from before the first segment to past
+    // the last, against the walk.
+    let mut seed = 0x9e37_79b9u32;
+    let mut next = move |m: u32| {
+        seed ^= seed << 13;
+        seed ^= seed >> 17;
+        seed ^= seed << 5;
+        seed % m
+    };
+    for case in 0..200 {
+        let n = 1 + next(if case % 10 == 0 { 600 } else { 40 }) as usize;
+        let mut t = next(4) as u16;
+        let mut segs = Vec::new();
+        for _ in 0..n {
+            let t0 = t + next(3) as u16; // a gap of 0..2 ticks
+            let t1 = t0 + 1 + next(5) as u16;
+            let easing = [spec::Easing::Linear as u8, spec::Easing::EaseInOut as u8, spec::Easing::CubicBezier as u8][next(3) as usize];
+            let bezier = [0.25, 0.1, 0.25, 1.0];
+            segs.push(style::Segment { t0, t1, from: next(u32::MAX), to: next(u32::MAX), easing, bezier });
