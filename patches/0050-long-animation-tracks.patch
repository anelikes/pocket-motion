+// A baked track of more than 255 segments (contracts/spec/spec.ts ANIM TABLE,
+// `ANIM_SEG_COUNT_WIDE`): the encoder writes the wide count only above 255,
+// the decoder reads it back, and the keyframe baker no longer stops at the
+// 1-byte count.
+// Run: bun test tests/anim-long-tracks.test.ts
+
+import { describe, expect, test } from "bun:test";
+import {
+  ANIM_FILL_BACKWARDS,
+  ANIM_FILL_FORWARDS,
+  ANIM_MAX_SEGMENTS,
+  ANIM_SEG_COUNT_WIDE,
+  ANIM_SEGMENT_SIZE,
+  ENUMS,
+  PROP,
+  STYLE_HEADER_SIZE,
+  decodeStyleTable,
+  encodeStyleTable,
+  f32Bits,
+  type AnimTimeline,
+} from "../contracts/spec/spec.ts";
+import { parseClassLiteral } from "../framework/compiler/tailwind.ts";
+import { bakedTimelines, registerAnimationTheme } from "../framework/compiler/animation.ts";
+
+/** translateX through `n` two-frame linear segments, segment i from i to i + 1. */
+function longTimeline(n: number): AnimTimeline {
+  return {
+    delayFrames: 0,
+    periodFrames: 2 * n,
+    iterations: 1,
+    fill: ANIM_FILL_BACKWARDS | ANIM_FILL_FORWARDS,
+    tracks: [
+      {
+        prop: PROP.translateX,
+        segments: Array.from({ length: n }, (_, i) => ({
+          t0: 2 * i,
+          t1: 2 * i + 2,
+          from: f32Bits(i),
+          to: f32Bits(i + 1),
+          easing: ENUMS.Easing.Linear,
+        })),
+      },
+    ],
+  };
+}
+
+/** Offset of the one track header in a table holding one style record that
+ *  references one timeline: header, record (flags + 3 + 2), anim entry header. */
+const TRACK = STYLE_HEADER_SIZE + 1 + 3 + 2 + 8;
+
+function table(n: number): Uint8Array {
+  return encodeStyleTable([{ animation: { anims: [0], loopFrames: 0 } }], [longTimeline(n)]);
+}
+
+describe("ANIM TABLE tracks over 255 segments", () => {
+  test("255 segments keep the 1-byte count; 256 take the wide one", () => {
+    const short = table(255);
+    expect(short[TRACK + 1]).toBe(255);
+    expect(short.length).toBe(TRACK + 2 + 255 * ANIM_SEGMENT_SIZE);
+    const wide = table(256);
+    expect(wide[TRACK + 1]).toBe(ANIM_SEG_COUNT_WIDE);
+    expect(wide[TRACK + 2] | (wide[TRACK + 3] << 8)).toBe(256);
+    expect(wide.length).toBe(TRACK + 4 + 256 * ANIM_SEGMENT_SIZE);
+  });
+
+  test("the decoder reads back every segment of a wide track", () => {
+    for (const n of [255, 256, 1000, ANIM_MAX_SEGMENTS >> 1]) {
