+        }
+        let track = style::TimelineTrack { prop: spec::prop::TRANSLATE_X, segments: segs };
+        for is_color in [false, true] {
+            for lt in 0..(t as u32 + 3) {
+                assert_eq!(
+                    crate::anim::sample_track(&track, lt, is_color),
+                    sample_track_by_walking(&track, lt, is_color),
