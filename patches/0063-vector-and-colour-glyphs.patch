+      refused.push({ cp, reason: colour.refused });
+      continue;
+    }
+    let layers: VectorLayer[] = [];
+    if (colour !== null) {
+      colourGlyphs++;
+      if (!metricsOnly) layers = colour;
+    } else if (!metricsOnly) {
+      const outline = outlineOfPath(glyph.getPath(0, 0, px));
+      if (outline.verbs.length > 0) layers = [{ outline, color: null }];
