+    /// so the part past the outline is the declared width; centred, over the
+    /// fill. The hollow outside form, which has no fill to cover a centred
+    /// stroke's inner half, is drawn centred at the declared width — the
+    /// atlas draws it as a ring wholly outside the glyph.
+    #[allow(clippy::too_many_arguments)]
+    fn emit_text_vector(
+        &mut self,
+        dl: &mut DrawList,
+        node: &crate::tree::Node,
+        r: &style::Resolved,
+        world: &Affine,
+        op: f32,
+        clip: &Clip,
+        box_w: f32,
+        run: alloc::string::String,
+        color: u32,
+        paint_grad: bool,
