+// Colour glyphs (pocket-motion): a face's COLR and CPAL tables read into the
+// layered outlines a FONT VECTOR blob carries (contracts/spec/spec.ts, "FONT
+// VECTOR binary format"). COLR version 0 is a list of (glyph, palette entry)
+// layers; version 1 is a paint graph, which is flattened here into the same
+// list: every PaintGlyph becomes one layer, its outline mapped through the
+// transforms above it, its fill a solid colour or a gradient the core draws
+// with PAINT_PUSH (2 to 16 stops, padded, interpolated premultiplied).
+//
+// What the core cannot draw is REFUSED, by name, never approximated: a
+// sweep gradient, a radial gradient whose two circles do not share a centre,
+// a colour line that repeats or reflects or has more than sixteen stops, a
+// composite mode, a variable paint, a clip of one glyph by another. A refused
+// glyph is left out of the slot entirely, so the text that uses it misses,
+// and `check`, `trace` and `render` report the codepoint as tofu
+// (src/text/missing.ts in the motion repository) instead of a picture nobody
+// declared. Angles go through path-data.ts's `cosSinDeg`, never `Math.sin`,
+// so the pak does not depend on the host's libm.
+
+import { PAINT_MAX_STOPS } from "../../contracts/spec/spec.ts";
+import { cosSinDeg } from "./path-data.ts";
+
+/** x' = a x + c y + e, y' = b x + d y + f — COLR's Affine2x3 (xx, yx, xy, yy, dx, dy). */
+export type Affine = readonly [number, number, number, number, number, number];
+
+const IDENTITY: Affine = [1, 0, 0, 1, 0, 0];
+
+/** m after t: t applied first. */
+export function compose(m: Affine, t: Affine): Affine {
+  return [
+    m[0] * t[0] + m[2] * t[1],
+    m[1] * t[0] + m[3] * t[1],
+    m[0] * t[2] + m[2] * t[3],
+    m[1] * t[2] + m[3] * t[3],
+    m[0] * t[4] + m[2] * t[5] + m[4],
+    m[1] * t[4] + m[3] * t[5] + m[5],
+  ];
+}
+
+function invert(m: Affine): Affine | null {
+  const det = m[0] * m[3] - m[1] * m[2];
+  if (det === 0 || !Number.isFinite(det)) return null;
+  return [
+    m[3] / det,
+    -m[1] / det,
+    -m[2] / det,
+    m[0] / det,
+    (m[2] * m[5] - m[3] * m[4]) / det,
+    (m[1] * m[4] - m[0] * m[5]) / det,
+  ];
+}
+
+/** The fill of one layer, before it is mapped to the glyph's px. */
+export type ColrFill =
+  | { readonly kind: "foreground" }
+  | { readonly kind: "solid"; readonly color: number }
+  | {
+      readonly kind: "linear" | "radial";
+      /** Gradient space -> font units. */
+      readonly transform: Affine;
+      /** linear: p0, p1, p2; radial: c0, r0, c1, r1 (gradient space). */
+      readonly geometry: readonly number[];
+      /** (ABGR straight, offset), ascending. */
+      readonly stops: readonly (readonly [number, number])[];
+    };
+
+/** One layer of a colour glyph: a glyph id's outline under `transform`
+ *  (glyph units -> font units), and its fill. */
+export interface ColrLayer {
+  readonly gid: number;
+  readonly transform: Affine;
+  readonly fill: ColrFill;
+}
+
+export type ColrGlyph = { readonly layers: readonly ColrLayer[] } | { readonly refused: string };
+
+export interface ColourTables {
+  /** The COLR version the face carries. */
+  readonly version: number;
+  /** Layers for a base glyph id, a refusal naming why, or null when the face
+   *  has no colour entry for it (a plain glyph). */
+  glyph(gid: number): ColrGlyph | null;
+}
+
+class Refused extends Error {}
+
+/** PaintComposite's modes, by number (OpenType COLR, CompositeMode). */
+const COMPOSITE_MODES = [
+  "clear", "src", "dest", "src-over", "dest-over", "src-in", "dest-in", "src-out", "dest-out",
+  "src-atop", "dest-atop", "xor", "plus", "screen", "overlay", "darken", "lighten", "color-dodge",
+  "color-burn", "hard-light", "soft-light", "difference", "exclusion", "multiply", "hue",
+  "saturation", "color", "luminosity",
+];
+
+const composite = (mode: number): string => `a ${COMPOSITE_MODES[mode] ?? `mode ${mode}`} composite`;
+
+/** The face's COLR and CPAL tables, or null when it has no COLR. */
+export function readColourTables(bytes: Uint8Array): ColourTables | null {
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const u8 = (o: number) => view.getUint8(o);
+  const u16 = (o: number) => view.getUint16(o);
+  const i16 = (o: number) => view.getInt16(o);
+  const u24 = (o: number) => (view.getUint8(o) << 16) | view.getUint16(o + 1);
+  const u32 = (o: number) => view.getUint32(o);
+  const f2dot14 = (o: number) => view.getInt16(o) / 16384;
+  const fixed = (o: number) => view.getInt32(o) / 65536;
+
+  // The sfnt table directory. A collection (ttcf) is not a face.
+  const tables = new Map<string, number>();
+  const numTables = u16(4);
+  for (let t = 0; t < numTables; t++) {
+    const rec = 12 + t * 16;
+    const tag = String.fromCharCode(u8(rec), u8(rec + 1), u8(rec + 2), u8(rec + 3));
+    tables.set(tag, u32(rec + 8));
+  }
+  const colr = tables.get("COLR");
+  if (colr === undefined) return null;
+  const cpal = tables.get("CPAL");
+  if (cpal === undefined) throw new Error("PocketJS bake-font: the face has COLR and no CPAL — its colours are named nowhere");
+
+  // CPAL palette 0, as ABGR straight alpha.
+  const colorRecords = cpal + u32(cpal + 8);
+  const first0 = u16(cpal + 12);
+  const numEntries = u16(cpal + 2);
+  const palette = (index: number): number => {
+    if (index >= numEntries) throw new Refused(`palette entry ${index} past the ${numEntries} CPAL holds`);
+    const o = colorRecords + (first0 + index) * 4;
+    const [b, g, r, a] = [u8(o), u8(o + 1), u8(o + 2), u8(o + 3)];
+    return ((a << 24) | (b << 16) | (g << 8) | r) >>> 0;
+  };
+  /** A palette colour with an extra alpha factor; 0xFFFF is the text colour. */
+  const colourOf = (index: number, alpha: number): number | "foreground" => {
+    if (index === 0xffff) {
+      if (alpha !== 1) throw new Refused("the text colour at an alpha of its own");
+      return "foreground";
+    }
+    const c = palette(index);
+    const a = Math.round(((c >>> 24) & 0xff) * Math.min(1, Math.max(0, alpha)));
+    return ((a << 24) | (c & 0xffffff)) >>> 0;
+  };
+
+  const version = u16(colr);
+  // Version 0 records.
+  const numBase = u16(colr + 2);
+  const baseRecords = colr + u32(colr + 4);
+  const layerRecords = colr + u32(colr + 8);
+  const v0 = new Map<number, [number, number]>();
+  for (let k = 0; k < numBase; k++) {
+    const o = baseRecords + k * 6;
+    v0.set(u16(o), [u16(o + 2), u16(o + 4)]);
+  }
+  // Version 1 lists.
+  const v1 = new Map<number, number>();
+  let layerList = 0;
+  if (version >= 1) {
+    const baseList = u32(colr + 14) === 0 ? 0 : colr + u32(colr + 14);
+    layerList = u32(colr + 18) === 0 ? 0 : colr + u32(colr + 18);
+    if (baseList !== 0) {
+      const n = u32(baseList);
+      for (let k = 0; k < n; k++) {
+        const o = baseList + 4 + k * 6;
+        v1.set(u16(o), baseList + u32(o + 2));
+      }
+    }
+  }
+
+  const colorLine = (at: number): (readonly [number, number])[] | "foreground" => {
+    const extend = u8(at);
+    if (extend !== 0) throw new Refused(`a colour line that ${extend === 1 ? "repeats" : "reflects"} (the paint pads)`);
+    const n = u16(at + 1);
+    if (n < 1) throw new Refused("a colour line with no stops");
+    const stops: [number, number][] = [];
+    for (let k = 0; k < n; k++) {
+      const o = at + 3 + k * 6;
+      const c = colourOf(u16(o + 2), f2dot14(o + 4));
+      if (c === "foreground") throw new Refused("the text colour in a gradient");
+      stops.push([c, f2dot14(o)]);
+    }
+    stops.sort((a, b) => a[1] - b[1]);
+    return stops;
+  };
+
+  /** A PaintGlyph's fill: solid or a gradient, through the transforms above it. */
+  const fill = (at: number, m: Affine, depth: number): ColrFill => {
+    if (depth > 64) throw new Refused("a paint graph deeper than 64");
+    const format = u8(at);
+    switch (format) {
+      case 2: {
+        const c = colourOf(u16(at + 1), f2dot14(at + 3));
+        return c === "foreground" ? { kind: "foreground" } : { kind: "solid", color: c };
+      }
+      case 4: {
+        const stops = colorLine(at + u24(at + 1));
+        if (stops === "foreground") throw new Refused("the text colour in a gradient");
+        const g = [i16(at + 4), i16(at + 6), i16(at + 8), i16(at + 10), i16(at + 12), i16(at + 14)];
+        return { kind: "linear", transform: m, geometry: g, stops };
+      }
+      case 6: {
+        const stops = colorLine(at + u24(at + 1));
+        if (stops === "foreground") throw new Refused("the text colour in a gradient");
+        const g = [i16(at + 4), i16(at + 6), u16(at + 8), i16(at + 10), i16(at + 12), u16(at + 14)];
+        return { kind: "radial", transform: m, geometry: g, stops };
+      }
+      case 8:
+        throw new Refused("a sweep gradient");
+      case 10:
+      case 11:
+        throw new Refused("a glyph clipped by another glyph");
+      case 32:
+        throw new Refused(composite(u8(at + 4)));
+      default: {
+        const t = transformOf(at, format);
+        if (t === null) throw new Refused(format % 2 === 1 && format <= 31 ? `a variable paint (format ${format})` : `paint format ${format}`);
+        return fill(at + u24(at + 1), compose(m, t), depth + 1);
+      }
+    }
+  };
+
+  /** The transform a transform-family paint applies to its child, or null. */
+  const transformOf = (at: number, format: number): Affine | null => {
+    const around = (t: Affine, cx: number, cy: number): Affine =>
+      compose(compose([1, 0, 0, 1, cx, cy], t), [1, 0, 0, 1, -cx, -cy]);
+    switch (format) {
+      case 12: {
+        const o = at + u24(at + 4);
+        return [fixed(o), fixed(o + 4), fixed(o + 8), fixed(o + 12), fixed(o + 16), fixed(o + 20)];
+      }
+      case 14:
+        return [1, 0, 0, 1, i16(at + 4), i16(at + 6)];
+      case 16:
+        return [f2dot14(at + 4), 0, 0, f2dot14(at + 6), 0, 0];
+      case 18:
+        return around([f2dot14(at + 4), 0, 0, f2dot14(at + 6), 0, 0], i16(at + 8), i16(at + 10));
+      case 20:
+        return [f2dot14(at + 4), 0, 0, f2dot14(at + 4), 0, 0];
+      case 22:
+        return around([f2dot14(at + 4), 0, 0, f2dot14(at + 4), 0, 0], i16(at + 6), i16(at + 8));
+      case 24:
+      case 26: {
+        // The angle is in half-turns; counter-clockwise in y-up font space.
+        const [c, s] = cosSinDeg(f2dot14(at + 4) * 180);
+        const r: Affine = [c, s, -s, c, 0, 0];
+        return format === 24 ? r : around(r, i16(at + 6), i16(at + 8));
+      }
+      case 28:
+      case 30: {
+        const [cx, sx] = cosSinDeg(f2dot14(at + 4) * 180);
+        const [cy, sy] = cosSinDeg(f2dot14(at + 6) * 180);
+        if (cx === 0 || cy === 0) throw new Refused("a skew of a quarter turn");
+        // x skew is clockwise from the y axis: x' = x - tan(a) y.
+        const k: Affine = [1, sy / cy, -sx / cx, 1, 0, 0];
+        return format === 28 ? k : around(k, i16(at + 8), i16(at + 10));
+      }
+      default:
+        return null;
+    }
+  };
+
+  /** Every layer a paint draws, in paint order. */
+  const walk = (at: number, m: Affine, depth: number, out: ColrLayer[]): void => {
+    if (depth > 64) throw new Refused("a paint graph deeper than 64");
+    const format = u8(at);
+    switch (format) {
+      case 1: {
+        const n = u8(at + 1);
+        const first = u32(at + 2);
+        if (layerList === 0) throw new Refused("PaintColrLayers with no LayerList");
+        for (let k = 0; k < n; k++) walk(layerList + u32(layerList + 4 + (first + k) * 4), m, depth + 1, out);
+        return;
+      }
+      case 10:
+        out.push({ gid: u16(at + 4), transform: m, fill: fill(at + u24(at + 1), IDENTITY, depth + 1) });
+        return;
+      case 11: {
+        const base = v1.get(u16(at + 1));
+        if (base === undefined) throw new Refused(`PaintColrGlyph names glyph ${u16(at + 1)}, which has no paint`);
+        walk(base, m, depth + 1, out);
+        return;
+      }
+      case 32:
+        throw new Refused(composite(u8(at + 4)));
+      case 2:
+      case 4:
+      case 6:
+      case 8:
+        throw new Refused("a fill with no glyph to bound it");
+      default: {
+        const t = transformOf(at, format);
+        if (t === null) throw new Refused(format % 2 === 1 && format <= 31 ? `a variable paint (format ${format})` : `paint format ${format}`);
+        walk(at + u24(at + 1), compose(m, t), depth + 1, out);
+      }
+    }
+  };
+
+  // A glyph's own paint transform composes with the transforms above a fill
+  // in the order they nest: a PaintGlyph's fill is in the PaintGlyph's own
+  // space, so its gradient is mapped by the outer transform too.
+  const flatten = (layers: ColrLayer[]): ColrLayer[] =>
+    layers.map((l) => (l.fill.kind === "linear" || l.fill.kind === "radial" ? { ...l, fill: { ...l.fill, transform: compose(l.transform, l.fill.transform) } } : l));
+
+  return {
+    version,
+    glyph(gid: number): ColrGlyph | null {
+      const paint = v1.get(gid);
+      try {
+        if (paint !== undefined) {
+          const out: ColrLayer[] = [];
+          walk(paint, IDENTITY, 0, out);
+          return { layers: flatten(out) };
+        }
+        const rec = v0.get(gid);
+        if (rec === undefined) return null;
+        const out: ColrLayer[] = [];
+        for (let k = 0; k < rec[1]; k++) {
+          const o = layerRecords + (rec[0] + k) * 4;
+          const c = colourOf(u16(o + 2), 1);
+          out.push({ gid: u16(o), transform: IDENTITY, fill: c === "foreground" ? { kind: "foreground" } : { kind: "solid", color: c } });
+        }
+        return { layers: out };
+      } catch (e) {
+        if (e instanceof Refused) return { refused: e.message };
+        throw e;
+      }
+    },
+  };
+}
+
+/**
+ * A gradient fill as PAINT_PUSH coefficients over the glyph's px, where
+ * `toPx` maps font units to px (y down). Linear: t is the signed distance
+ * from the line through p0 along p0->p2, over the same distance of p1, as
+ * COLRv1 defines it. Radial: the two circles must share a centre; t' =
+ * |g - c| / max(r0, r1), and each stop moves to where its circle lies on
+ * that scale. Null with the reason when the core cannot draw it.
+ */
+export function gradientCoefficients(
+  f: Extract<ColrFill, { kind: "linear" | "radial" }>,
+  toPx: Affine,
+): { kind: 1 | 2; coef: [number, number, number, number, number, number]; stops: [number, number][] } | { refused: string } {
+  const inv = invert(compose(toPx, f.transform));
+  if (inv === null) return { refused: "a gradient under a transform that collapses it" };
+  if (f.stops.length > PAINT_MAX_STOPS) return { refused: `a gradient of ${f.stops.length} stops (the paint holds ${PAINT_MAX_STOPS})` };
+  const g = f.geometry;
+  // An affine row over gradient space, mapped to px: row(G^-1(P)).
+  const mapped = (l0: number, l1: number, l2: number): [number, number, number] => [
+    l0 * inv[0] + l1 * inv[1],
+    l0 * inv[2] + l1 * inv[3],
+    l0 * inv[4] + l1 * inv[5] + l2,
+  ];
+  const stops = f.stops.map(([c, o]) => [c, o] as [number, number]);
+  if (f.kind === "linear") {
+    const [x0, y0, x1, y1, x2, y2] = g as [number, number, number, number, number, number];
+    const dx = x2 - x0;
+    const dy = y2 - y0;
+    const den = dx * (y1 - y0) - dy * (x1 - x0);
+    if (den === 0) return { refused: "a linear gradient whose p1 lies on the line through p0 and p2" };
+    const row = mapped(-dy / den, dx / den, (dy * x0 - dx * y0) / den);
+    if (stops.some(([, o]) => o < 0 || o > 1)) return { refused: "a colour stop outside 0..1" };
+    return { kind: 1, coef: [...row, 0, 0, 0], stops: padStops(stops) };
+  }
+  const [cx0, cy0, r0, cx1, cy1, r1] = g as [number, number, number, number, number, number];
+  if (cx0 !== cx1 || cy0 !== cy1) return { refused: "a radial gradient whose circles do not share a centre" };
+  const r = Math.max(r0, r1);
+  if (!(r > 0)) return { refused: "a radial gradient of radius 0" };
+  const u = mapped(1 / r, 0, -cx0 / r);
+  const v = mapped(0, 1 / r, -cy0 / r);
+  let moved = stops.map(([c, o]) => [c, (r0 + o * (r1 - r0)) / r] as [number, number]);
+  if (moved.some(([, o]) => o < 0 || o > 1)) return { refused: "a colour stop outside the gradient's circles" };
+  moved = moved.sort((a, b) => a[1] - b[1]);
+  return { kind: 2, coef: [...u, ...v], stops: padStops(moved) };
+}
+
+/** PAINT_PUSH takes 2 or more stops: one stop is a flat colour across. */
+function padStops(stops: [number, number][]): [number, number][] {
+  return stops.length === 1 ? [[stops[0]![0], 0], [stops[0]![0], 1]] : stops;
+}
