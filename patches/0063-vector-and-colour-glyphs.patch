+/** The tofu box as an outline: the atlas's tofu rectangle, a one-pixel ring
+ *  standing on the baseline. */
+function tofuOutline(px: number): VectorOutline {
+  const w = Math.max(4, Math.round(px * 0.55));
+  const h = Math.max(5, Math.round(px * 0.7));
+  const ring = (x0: number, y0: number, x1: number, y1: number, cw: boolean): number[] =>
+    cw ? [x0, y0, x1, y0, x1, y1, x0, y1] : [x0, y0, x0, y1, x1, y1, x1, y0];
+  const outer = ring(0, -h, w, 0, true);
+  const inner = ring(1, -h + 1, w - 1, -1, false);
+  return {
+    verbs: [VERB_MOVE, VERB_LINE, VERB_LINE, VERB_LINE, VERB_CLOSE, VERB_MOVE, VERB_LINE, VERB_LINE, VERB_LINE, VERB_CLOSE],
+    pts: [...outer, ...inner],
   };
 }
 
+/**
+ * Bake one slot as a FONT VECTOR face. Metrics are `bakeSlot`'s, written in
+ * u16/i16 instead of u8/i8: baseline `round(ascent)`, cell `baseline +
+ * ceil(descent)`, line height `round(ascent + descent + lineGap)`, each
+ * advance `round(advanceWidth * px / unitsPerEm)` of the face that supplies
+ * the glyph, each kern pair `round(units * px / unitsPerEm)`, the tofu
+ * advance `max(4, round(0.55 px)) + 2`.
+ */
+export function bakeVectorSlot(
+  font: Font,
+  slot: number,
+  px: number,
+  bold: boolean,
+  chars: number[],
+  fallbacks: readonly Font[] = [],
+  metricsOnly = false,
+  colourLayersOf: ColourLayersOf = colrLayersOf,
+): { bytes: Uint8Array; colourGlyphs: number; refused: { cp: number; reason: string }[] } {
+  const upm = font.unitsPerEm;
+  const scale = px / upm;
+  const ascent = font.ascender * scale;
+  const descent = -font.descender * scale;
+  const baseline = Math.round(ascent);
+  const cellH = Math.max(1, baseline + Math.ceil(descent));
