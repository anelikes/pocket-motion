 export const FONT_FLAG_METRICS_ONLY = 1 << 1;
 
+// ---------------------------------------------------------------------------
+// FONT VECTOR binary format (pocket-motion)
+// ---------------------------------------------------------------------------
+// Glyph outlines a slot draws as PATH ops (DRAW_OP.path) instead of atlas
+// cells. Two uses share the one format:
+//
+//   - a VECTOR SLOT: the whole slot is outlines. The build bakes one where the
+//     atlas cannot hold the size (its cell would exceed the header's u8) or
+//     where the literal says `text-vector`. Its metrics are the atlas's
+//     formulas without the u8 bound, so at a size both can bake, the two lay
+//     a string out identically (advances, kerning, baseline, line height).
+//   - a SUPPLEMENT (flag bit 2): the colour glyphs of an ATLAS slot, keyed
+//     `ui:font.<slot>.v` beside the atlas `ui:font.<slot>`. Metrics come from
+//     the atlas; the supplement says which codepoints draw as layered paths.
+//
+// The framework feeds every `ui:font.` pak entry to the same loader, which
+// dispatches on the magic.
+//
+//   Header (36 bytes):
+//     off  0  u32  magic      = 0x56464344  bytes 'D','C','F','V'
+//     off  4  u16  version    = 1
+//     off  6  u16  flags      bit 0 bold, bit 1 metrics only (no layers or
+//                             outlines; a measurement artifact), bit 2 supplement
+//     off  8  u16  cellH      LOGICAL px, baseline + ceil(descent), as the atlas
+//     off 10  u16  baseline   LOGICAL px from cell top to the baseline
+//     off 12  u8   fontSlot   (the same byte the atlas header keeps it in)
+//     off 13  u8   reserved   (0)
+//     off 14  u16  lineHeight LOGICAL px
+//     off 16  u32  glyphCount cmap entries = glyph-table entries
+//     off 20  u32  pairCount
+//     off 24  u32  layerCount
+//     off 28  u32  outlineCount
+//     off 32  u32  gradientCount
+//
+//   cmap (glyphCount x 8), sorted ascending by codepoint; gid 0 is the tofu
+//   box of a vector slot (a supplement has none):
+//     +0 u32 codepoint  +4 u16 gid  +6 u16 advance (LOGICAL px)
+//   glyph table (glyphCount x 8), indexed by gid:
+//     +0 u32 firstLayer  +4 u16 layerCount  +6 u16 reserved (0)
+//   kern (pairCount x 6), sorted ascending by (left << 16) | right:
+//     +0 u16 left gid  +2 u16 right gid  +4 i16 delta (LOGICAL px)
+//   layers (layerCount x 8), painted in order:
+//     +0 u32 outline index; bit 31 set = the run's text colour; bit 30 set =
+//            the gradient +4 names; neither = the colour +4 holds
+//     +4 u32 colour ABGR (straight alpha), or a gradient index
+//   gradients, gradientCount records, back to back:
+//     +0 u8 kind (GradKind: 1 linear, 2 radial)  +1 u8 stopCount
+//     (2..PAINT_MAX_STOPS)
+//     +2 u16 reserved (0)  +4 6 x f32 coefficients over the glyph's own
+//     LOGICAL px (origin on the baseline at the pen, y down): linear
+//     t = c0 x + c1 y + c2; radial u = c0 x + c1 y + c2, v = c3 x + c4 y + c5,
+//     t = sqrt(u^2 + v^2); then stopCount x (u32 colour ABGR, f32 position
+//     0..1, ascending). The draw maps them through the glyph's world into a
+//     PAINT_PUSH, so t outside 0..1 pads as the paint does.
+//   outlines, outlineCount records, back to back (the kern section's 6-byte
+//   pairs leave them unaligned, so every field is read bytewise):
+//     u32 verbCount, u32 pointCount, verbCount verbs (VERB_* of the PATH
+//     TABLE: move, line, cubic, close) padded with zeros to a multiple of 4
+//     bytes, then pointCount
+//     (x, y) f32 pairs in LOGICAL px, y down, origin on the baseline at the
+//     pen. Filled nonzero.
+
+export const FONT_VECTOR_MAGIC = 0x56464344; // 'DCFV' LE
+export const FONT_VECTOR_VERSION = 1;
+export const FONT_VECTOR_HEADER_SIZE = 36;
+export const FONT_VECTOR_CMAP_ENTRY_SIZE = 8;
+export const FONT_VECTOR_GLYPH_SIZE = 8;
+export const FONT_VECTOR_KERN_PAIR_SIZE = 6;
+export const FONT_VECTOR_LAYER_SIZE = 8;
+export const FONT_VECTOR_FLAG_SUPPLEMENT = 1 << 2;
+/** Layer outline word bit: paint this layer in the run's text colour. */
+export const FONT_VECTOR_LAYER_FOREGROUND = 0x8000_0000;
+/** Layer outline word bit: the colour word is a gradient index. */
+export const FONT_VECTOR_LAYER_GRADIENT = 0x4000_0000;
+
