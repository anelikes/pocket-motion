+    const ch = String.fromCodePoint(cp);
+    let source = font;
+    let gi = font.charToGlyphIndex(ch);
+    for (let f = 0; gi <= 0 && f < fallbacks.length; f++) {
+      const candidate = fallbacks[f]!.charToGlyphIndex(ch);
+      if (candidate > 0) {
+        source = fallbacks[f]!;
+        gi = candidate;
+      }
+    }
+    if (gi <= 0) continue;
+    const glyph = source.glyphs.get(gi);
+    const sourceScale = source === font ? scale : px / source.unitsPerEm;
+    const advance = Math.max(0, Math.min(0xffff, Math.round((glyph.advanceWidth ?? 0) * sourceScale)));
+    // A colour face's glyph is its layers, or refused and left out (so the
+    // text misses and is reported); asked in a metrics-only bake too, so a
+    // measurement lays out what the drawing bake will.
+    const sequence = colourTables.has(source) ? sequenceOnly(cp) : null;
+    const colour = sequence === null ? colourLayersOf(source, gi, px) : { refused: sequence };
