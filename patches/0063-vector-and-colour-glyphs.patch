+
+    /// Placed glyphs drawn from a FONT VECTOR face (pocket-motion): every
+    /// layer of each glyph the face carries filled as one PATH op, in the
+    /// face's paint order — the run's text colour for a foreground layer,
+    /// the layer's own colour under the subtree opacity for a colour one.
+    /// With `stroke`, the foreground layers are stroked instead (round joins
+    /// and caps) and colour layers are not drawn.
+    ///
+    /// A glyph's origin is its pen on the baseline: the atlas places its
+    /// cell at `pen - xoff`, and `layout_run`'s `x` is that cell's left. On
+    /// the path GLYPH_RUN takes — an axis-aligned world of scale 1 — the
+    /// cell's anchor is rounded to a whole pixel as GLYPH_RUN rounds it, so
+    /// an outline lands where the atlas would have put the same glyph.
+    /// Under any other world the origin is mapped unrounded.
+    #[allow(clippy::too_many_arguments)]
+    fn emit_vector_glyphs(
+        &mut self,
+        dl: &mut DrawList,
+        face: &crate::text::VectorFace,
+        atlas: Option<&crate::text::Atlas>,
+        glyphs: &[crate::text::GlyphPos],
+        world: &Affine,
+        clip: &Clip,
+        baseline: f32,
+        color: u32,
+        op: f32,
+        stroke: Option<(u32, f32)>,
+    ) {
+        use crate::path;
+        let supplement = face.is_supplement();
+        let snap = world.is_axis_aligned() && world.a == 1.0 && world.d == 1.0;
+        let pad = stroke.map_or(0.0, |(_, w)| w * 0.5) + 1.0;
+        let mut sc = core::mem::take(&mut self.path_scratch);
+        for g in glyphs {
+            let gid = if supplement {
+                match face.lookup(g.codepoint) {
+                    Some((gid, _)) => gid,
+                    None => continue,
+                }
+            } else {
+                g.gid
+            };
+            let b = face.bounds(gid);
+            if !(b[0] <= b[2]) {
+                continue;
+            }
+            let xoff = atlas.and_then(|a| a.lookup_entry(g.codepoint)).map_or(0.0, |e| e.xoff as f32);
+            let xf = if snap {
+                let (sx, sy) = world.apply(g.x, g.y);
+                Affine::translate(roundf(sx) + xoff, roundf(sy) + baseline)
+            } else {
+                world.then(&Affine::translate(g.x + xoff, g.y + baseline))
+            };
+            let (mut x0, mut y0, mut x1, mut y1) = (f32::MAX, f32::MAX, f32::MIN, f32::MIN);
+            for (px, py) in [(b[0], b[1]), (b[2], b[1]), (b[0], b[3]), (b[2], b[3])] {
+                let (x, y) = xf.apply(px, py);
+                x0 = x0.min(x);
+                y0 = y0.min(y);
+                x1 = x1.max(x);
+                y1 = y1.max(y);
+            }
+            if x1 + pad <= clip.x0 || x0 - pad >= clip.x1 || y1 + pad <= clip.y0 || y0 - pad >= clip.y1 {
+                continue;
+            }
+            let s = path::scale_bound(&xf);
+            if !(s > 0.0) || !s.is_finite() {
+                continue;
+            }
+            let tol = path::FLATTEN_TOL / s;
+            for (outline, paint) in face.layers(gid) {
+                use crate::text::LayerPaint;
