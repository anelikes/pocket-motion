+
+/// A FONT VECTOR blob (spec.ts "FONT VECTOR binary format", pocket-motion):
+/// a slot's glyphs as layered outlines the draw emits as PATH ops. A
+/// SUPPLEMENT carries only an atlas slot's colour glyphs; its metrics are
+/// unused, the atlas's apply.
+pub struct VectorFace {
+    pub slot: u8,
+    pub flags: u16,
+    pub cell_h: u32,
+    pub baseline: u32,
+    pub line_height: u32,
+    /// (codepoint, gid, advance), sorted by codepoint.
+    cmap: Vec<(u32, u16, u16)>,
+    /// Per gid: (first layer, layer count, ink bounds [x0, y0, x1, y1] over
+    /// every layer's points, relative to the glyph origin; empty = no ink).
+    glyphs: Vec<(u32, u16, [f32; 4])>,
+    kern: Vec<(u32, i16)>,
+    /// (outline index | LAYER_FOREGROUND | LAYER_GRADIENT, colour ABGR or
+    /// gradient index).
+    layers: Vec<(u32, u32)>,
+    pub outlines: Vec<VectorOutline>,
+    gradients: Vec<VectorGradient>,
+}
+
+#[inline]
+fn rd_f32(b: &[u8], off: usize) -> Option<f32> {
+    rd_u32(b, off).map(f32::from_bits)
+}
+
+impl VectorFace {
+    /// Parse a FONT VECTOR blob (copies what it keeps). `None` on bad magic,
+    /// version or slot, truncation, an unsorted cmap or kern section, a gid
+    /// or layer or outline index out of range, a verb stream that does not
+    /// start with a move or does not consume its points, or a point that is
+    /// not finite.
+    pub fn parse(bytes: &[u8]) -> Option<VectorFace> {
+        use spec::font_vector as fv;
+        if rd_u32(bytes, 0)? != fv::MAGIC || rd_u16(bytes, 4)? != fv::VERSION {
+            return None;
+        }
+        let flags = rd_u16(bytes, 6)?;
+        let cell_h = rd_u16(bytes, 8)? as u32;
+        let baseline = rd_u16(bytes, 10)? as u32;
+        let slot = *bytes.get(12)?;
+        let line_height = rd_u16(bytes, 14)? as u32;
+        let glyph_count = rd_u32(bytes, 16)? as usize;
+        let pair_count = rd_u32(bytes, 20)? as usize;
+        let layer_count = rd_u32(bytes, 24)? as usize;
+        let outline_count = rd_u32(bytes, 28)? as usize;
+        let gradient_count = rd_u32(bytes, 32)? as usize;
+        if slot as usize >= spec::MAX_FONT_SLOTS || glyph_count > u16::MAX as usize + 1 {
+            return None;
+        }
+        let mut o = fv::HEADER_SIZE;
+        let mut cmap = Vec::with_capacity(glyph_count);
+        for _ in 0..glyph_count {
+            let cp = rd_u32(bytes, o)?;
+            let gid = rd_u16(bytes, o + 4)?;
+            if gid as usize >= glyph_count || cmap.last().is_some_and(|&(prev, _, _)| cp <= prev) {
+                return None;
+            }
+            cmap.push((cp, gid, rd_u16(bytes, o + 6)?));
+            o += fv::CMAP_ENTRY_SIZE;
+        }
+        let mut glyphs = Vec::with_capacity(glyph_count);
+        for _ in 0..glyph_count {
+            let first = rd_u32(bytes, o)?;
+            let count = rd_u16(bytes, o + 4)?;
+            if (first as usize).checked_add(count as usize)? > layer_count {
+                return None;
+            }
+            glyphs.push((first, count, [0.0f32; 4]));
+            o += fv::GLYPH_SIZE;
+        }
+        let mut kern = Vec::with_capacity(pair_count);
+        for _ in 0..pair_count {
+            let left = rd_u16(bytes, o)?;
+            let right = rd_u16(bytes, o + 2)?;
+            let delta = rd_u16(bytes, o + 4)? as i16;
+            if left as usize >= glyph_count || right as usize >= glyph_count {
+                return None;
+            }
+            let key = ((left as u32) << 16) | right as u32;
+            if kern.last().is_some_and(|&(prev, _)| key <= prev) {
+                return None;
+            }
+            kern.push((key, delta));
+            o += fv::KERN_PAIR_SIZE;
+        }
+        let index_bits = fv::LAYER_FOREGROUND | fv::LAYER_GRADIENT;
+        let mut layers = Vec::with_capacity(layer_count);
+        for _ in 0..layer_count {
+            let outline = rd_u32(bytes, o)?;
+            let colour = rd_u32(bytes, o + 4)?;
+            let both = fv::LAYER_FOREGROUND | fv::LAYER_GRADIENT;
+            if (outline & !index_bits) as usize >= outline_count
+                || outline & both == both
+                || (outline & fv::LAYER_GRADIENT != 0 && colour as usize >= gradient_count)
+            {
+                return None;
+            }
+            layers.push((outline, colour));
+            o += fv::LAYER_SIZE;
+        }
+        let mut gradients = Vec::with_capacity(gradient_count);
+        for _ in 0..gradient_count {
+            let kind = *bytes.get(o)? as u32;
+            let n = *bytes.get(o + 1)? as usize;
+            if !(kind == spec::GradKind::Linear as u32 || kind == spec::GradKind::Radial as u32)
+                || !(2..=spec::draw_op::PAINT_MAX_STOPS).contains(&n)
+            {
+                return None;
+            }
+            let mut coef = [0.0f32; 6];
+            for (k, c) in coef.iter_mut().enumerate() {
+                *c = rd_f32(bytes, o + 4 + 4 * k)?;
+                if !c.is_finite() {
+                    return None;
+                }
+            }
+            o += 28;
+            let mut stops = Vec::with_capacity(n);
+            for _ in 0..n {
+                let pos = rd_f32(bytes, o + 4)?;
+                if !(0.0..=1.0).contains(&pos) || stops.last().is_some_and(|&(_, p): &(u32, f32)| pos < p) {
+                    return None;
+                }
+                stops.push((rd_u32(bytes, o)?, pos));
+                o += 8;
+            }
+            gradients.push(VectorGradient { kind, coef, stops });
+        }
+        let mut outlines = Vec::with_capacity(outline_count);
+        for _ in 0..outline_count {
+            let verb_count = rd_u32(bytes, o)? as usize;
+            let point_count = rd_u32(bytes, o + 4)? as usize;
+            o += 8;
+            let verbs = bytes.get(o..o.checked_add(verb_count)?)?.to_vec();
+            o += (verb_count + 3) & !3;
+            if verbs.first().is_some_and(|&v| v != crate::path::VERB_MOVE) {
+                return None;
+            }
+            let mut need = 0usize;
+            for &v in &verbs {
+                if v > crate::path::VERB_CLOSE {
+                    return None;
+                }
+                need += crate::path::verb_points(v);
+            }
+            if need != point_count {
+                return None;
+            }
+            let mut pts = Vec::with_capacity(point_count);
+            for _ in 0..point_count {
+                let (x, y) = (rd_f32(bytes, o)?, rd_f32(bytes, o + 4)?);
+                if !x.is_finite() || !y.is_finite() {
+                    return None;
+                }
+                pts.push(crate::path::pt(x, y));
+                o += 8;
+            }
+            outlines.push(VectorOutline { verbs, pts });
+        }
+        if o != bytes.len() {
+            return None;
+        }
+        // Ink bounds per glyph, so a run culls a glyph before flattening it.
+        for g in glyphs.iter_mut() {
+            let mut b = [f32::INFINITY, f32::INFINITY, f32::NEG_INFINITY, f32::NEG_INFINITY];
+            for &(outline, _) in &layers[g.0 as usize..(g.0 + g.1 as u32) as usize] {
+                for p in &outlines[(outline & !index_bits) as usize].pts {
+                    b = [b[0].min(p.x), b[1].min(p.y), b[2].max(p.x), b[3].max(p.y)];
+                }
+            }
+            g.2 = b;
+        }
+        Some(VectorFace { slot, flags, cell_h, baseline, line_height, cmap, glyphs, kern, layers, outlines, gradients })
+    }
+
+    /// A supplement carries an atlas slot's colour glyphs and no metrics of
+    /// its own.
+    #[inline]
+    pub fn is_supplement(&self) -> bool {
+        self.flags & spec::font_vector::FLAG_SUPPLEMENT != 0
+    }
+
+    /// (gid, advance) for a codepoint.
+    pub fn lookup(&self, cp: u32) -> Option<(u16, u16)> {
+        self.cmap
+            .binary_search_by(|e| e.0.cmp(&cp))
+            .ok()
+            .map(|i| (self.cmap[i].1, self.cmap[i].2))
+    }
+
+    /// Logical-px pair adjustment, 0 when absent.
+    pub fn kern(&self, left: u16, right: u16) -> i32 {
+        let key = ((left as u32) << 16) | (right as u32);
+        match self.kern.binary_search_by(|p| p.0.cmp(&key)) {
+            Ok(i) => self.kern[i].1 as i32,
+            Err(_) => 0,
+        }
+    }
+
+    /// The tofu advance: gid 0's entry, which a vector slot always carries.
+    fn tofu_advance(&self) -> f32 {
+        self.cmap.iter().find(|e| e.1 == 0).map_or(0.0, |e| e.2 as f32)
+    }
+
+    /// A glyph's layers: (outline, paint), in paint order.
+    pub fn layers(&self, gid: u16) -> impl Iterator<Item = (&VectorOutline, LayerPaint<'_>)> + '_ {
+        use spec::font_vector as fv;
+        let (first, count) = self.glyphs.get(gid as usize).map_or((0, 0), |g| (g.0 as usize, g.1 as usize));
+        self.layers[first..first + count].iter().map(move |&(o, colour)| {
+            let paint = if o & fv::LAYER_FOREGROUND != 0 {
+                LayerPaint::Foreground
+            } else if o & fv::LAYER_GRADIENT != 0 {
+                LayerPaint::Gradient(&self.gradients[colour as usize])
+            } else {
+                LayerPaint::Solid(colour)
+            };
+            (&self.outlines[(o & !(fv::LAYER_FOREGROUND | fv::LAYER_GRADIENT)) as usize], paint)
+        })
+    }
+
+    /// A glyph's ink bounds relative to its origin; x0 > x1 when it has none.
+    pub fn bounds(&self, gid: u16) -> [f32; 4] {
+        self.glyphs.get(gid as usize).map_or([1.0, 1.0, 0.0, 0.0], |g| g.2)
+    }
+}
