+/** The cell height an atlas at this size would need — what decides whether
+ *  the size fits the FONT ATLAS header at all. */
+export function atlasCellHeight(font: Font, px: number): number {
+  const scale = px / font.unitsPerEm;
+  return Math.max(1, Math.round(font.ascender * scale) + Math.ceil(-font.descender * scale));
+}
+
+/** Colour layers a face carries for one of its glyphs at a size, a refusal
+ *  naming why it cannot be drawn, or null for a plain glyph. */
+export type ColourLayersOf = (face: Font, gid: number, px: number) => VectorLayer[] | { refused: string } | null;
+
+/**
+ * Codepoints that draw as a single picture only inside a sequence the font
+ * forms by shaping — a flag from two regional indicators, a family joined by
+ * ZWJ, a skin tone after its emoji, a keycap, a subdivision flag's tags. The
+ * core does not shape, so a colour face's glyph for one of these, drawn on
+ * its own, is a part of the picture the text asked for: refused, so the text
+ * misses and is reported, rather than drawn as its pieces.
+ */
+export function sequenceOnly(cp: number): string | null {
+  if (cp >= 0x1f1e6 && cp <= 0x1f1ff) return "a regional indicator: a flag is a pair the core does not shape";
+  if (cp === 0x200d) return "a zero-width joiner: the sequence it joins is formed by shaping, which the core does not do";
+  if (cp >= 0x1f3fb && cp <= 0x1f3ff) return "a skin-tone modifier: it combines with the emoji before it only by shaping";
+  if (cp === 0x20e3) return "a combining keycap: it combines only by shaping";
+  if (cp >= 0xe0020 && cp <= 0xe007f) return "a tag character: subdivision flags are formed by shaping";
+  return null;
+}
+
+/** COLR/CPAL of the faces a build loaded, by face. */
+const colourTables = new WeakMap<Font, ColourTables>();
+
+/** Colour layers of a face that carries COLR, mapped to the slot's px. */
+export const colrLayersOf: ColourLayersOf = (face, gid, px) => {
+  const tables = colourTables.get(face);
+  if (tables === undefined) return null;
+  const g = tables.glyph(gid);
+  if (g === null) return null;
+  if ("refused" in g) return g;
+  const s = px / face.unitsPerEm;
+  // Font units (y up) -> the glyph's px (y down, origin on the baseline).
+  const toPx: Affine = [s, 0, 0, -s, 0, 0];
+  const out: VectorLayer[] = [];
+  for (const l of g.layers) {
+    const glyph = face.glyphs.get(l.gid);
+    // getPath at the face's own unitsPerEm is font units with y negated.
+    const path = glyph.getPath(0, 0, face.unitsPerEm);
+    const m = compose(toPx, l.transform);
+    const map = (x: number, y: number): [number, number] => [m[0] * x - m[2] * y + m[4], m[1] * x - m[3] * y + m[5]];
+    for (const cmd of path.commands as any[]) {
+      if ("x" in cmd) [cmd.x, cmd.y] = map(cmd.x, cmd.y);
+      if ("x1" in cmd) [cmd.x1, cmd.y1] = map(cmd.x1, cmd.y1);
+      if ("x2" in cmd) [cmd.x2, cmd.y2] = map(cmd.x2, cmd.y2);
+    }
+    const outline = outlineOfPath(path);
+    if (outline.verbs.length === 0) continue;
+    if (l.fill.kind === "foreground") out.push({ outline, color: null });
+    else if (l.fill.kind === "solid") out.push({ outline, color: l.fill.color });
+    else {
+      const gr = gradientCoefficients(l.fill, toPx);
+      if ("refused" in gr) return gr;
+      out.push({ outline, color: gr });
+    }
+  }
+  return out;
+};
+
+/** Serialise a FONT VECTOR blob (spec.ts "FONT VECTOR binary format"). */
+function writeVectorBlob(
+  slot: number,
+  flags: number,
+  metrics: { cellH: number; baseline: number; lineHeight: number },
+  cmap: { cp: number; gid: number; advance: number }[],
+  glyphLayers: VectorLayer[][],
+  pairs: { left: number; right: number; delta: number }[],
+): Uint8Array {
+  const outlines: VectorOutline[] = [];
+  const gradients: VectorGradient[] = [];
+  const layerWords: [number, number][] = [];
+  const firstLayer: number[] = [];
+  for (const layers of glyphLayers) {
+    firstLayer.push(layerWords.length);
+    for (const l of layers) {
+      if (l.color === null) {
+        layerWords.push([outlines.length | FONT_VECTOR_LAYER_FOREGROUND, 0]);
+      } else if (typeof l.color === "number") {
+        layerWords.push([outlines.length, l.color]);
+      } else {
+        layerWords.push([outlines.length | FONT_VECTOR_LAYER_GRADIENT, gradients.length]);
+        gradients.push(l.color);
+      }
+      outlines.push(l.outline);
+    }
+  }
+  let size = FONT_VECTOR_HEADER_SIZE + cmap.length * (FONT_VECTOR_CMAP_ENTRY_SIZE + FONT_VECTOR_GLYPH_SIZE) +
+    pairs.length * FONT_VECTOR_KERN_PAIR_SIZE + layerWords.length * FONT_VECTOR_LAYER_SIZE;
+  for (const g of gradients) size += 28 + g.stops.length * 8;
+  for (const o of outlines) size += 8 + ((o.verbs.length + 3) & ~3) + o.pts.length * 4;
+  const out = new Uint8Array(size);
+  const dv = new DataView(out.buffer);
+  const u16 = (v: number, what: string) => {
+    if (!Number.isInteger(v) || v < 0 || v > 0xffff) throw new Error(`PocketJS bake-font: ${what} ${v} does not fit the FONT VECTOR header's u16`);
+    return v;
+  };
+  dv.setUint32(0, FONT_VECTOR_MAGIC, true);
+  dv.setUint16(4, FONT_VECTOR_VERSION, true);
+  dv.setUint16(6, flags, true);
+  dv.setUint16(8, u16(metrics.cellH, "cell height"), true);
+  dv.setUint16(10, u16(metrics.baseline, "baseline"), true);
+  out[12] = slot;
+  dv.setUint16(14, u16(metrics.lineHeight, "line height"), true);
+  dv.setUint32(16, cmap.length, true);
+  dv.setUint32(20, pairs.length, true);
+  dv.setUint32(24, layerWords.length, true);
+  dv.setUint32(28, outlines.length, true);
+  dv.setUint32(32, gradients.length, true);
+  let o = FONT_VECTOR_HEADER_SIZE;
+  for (const e of cmap) {
+    dv.setUint32(o, e.cp, true);
+    dv.setUint16(o + 4, e.gid, true);
+    dv.setUint16(o + 6, u16(e.advance, "advance"), true);
+    o += FONT_VECTOR_CMAP_ENTRY_SIZE;
+  }
+  glyphLayers.forEach((layers, gid) => {
+    dv.setUint32(o, firstLayer[gid]!, true);
+    dv.setUint16(o + 4, layers.length, true);
+    o += FONT_VECTOR_GLYPH_SIZE;
+  });
+  for (const p of pairs) {
+    dv.setUint16(o, p.left, true);
+    dv.setUint16(o + 2, p.right, true);
+    dv.setInt16(o + 4, p.delta, true);
+    o += FONT_VECTOR_KERN_PAIR_SIZE;
+  }
+  for (const [outline, color] of layerWords) {
+    dv.setUint32(o, outline >>> 0, true);
+    dv.setUint32(o + 4, color >>> 0, true);
+    o += FONT_VECTOR_LAYER_SIZE;
+  }
+  for (const g of gradients) {
+    if (g.stops.length < 2 || g.stops.length > PAINT_MAX_STOPS) throw new Error(`PocketJS bake-font: a gradient layer has ${g.stops.length} stops; PAINT_PUSH takes 2 to ${PAINT_MAX_STOPS}`);
+    out[o] = g.kind;
+    out[o + 1] = g.stops.length;
+    g.coef.forEach((c, k) => dv.setFloat32(o + 4 + 4 * k, c, true));
+    o += 28;
+    for (const [color, pos] of g.stops) {
+      dv.setUint32(o, color >>> 0, true);
+      dv.setFloat32(o + 4, pos, true);
+      o += 8;
+    }
+  }
+  for (const ol of outlines) {
+    dv.setUint32(o, ol.verbs.length, true);
+    dv.setUint32(o + 4, ol.pts.length / 2, true);
+    o += 8;
+    out.set(ol.verbs, o);
+    o += (ol.verbs.length + 3) & ~3;
+    for (const v of ol.pts) {
+      dv.setFloat32(o, v, true);
+      o += 4;
+    }
+  }
+  if (o !== size) throw new Error("PocketJS bake-font: FONT VECTOR size mismatch");
+  return out;
+}
