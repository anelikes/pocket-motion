+/** A gradient a colour layer is painted with: PAINT_PUSH's kind (1 linear,
+ *  2 radial), its six coefficients over the glyph's own px (origin on the
+ *  baseline at the pen, y down), and 2 to PAINT_MAX_STOPS stops (ABGR
+ *  straight, position 0..1 ascending). */
+export interface VectorGradient {
+  kind: 1 | 2;
+  coef: [number, number, number, number, number, number];
+  stops: [number, number][];
+}
+
+/** A colour glyph's layer: an outline in a solid colour (ABGR, straight
+ *  alpha), a gradient, or the run's text colour. */
+export interface VectorLayer {
+  outline: VectorOutline;
+  /** null: the run's text colour (COLR palette index 0xFFFF). */
+  color: number | VectorGradient | null;
+}
+
+/** Where a glyph of a vector or supplement blob comes from. */
+interface VectorGlyph {
+  cp: number;
+  fontGid: number;
+  advance: number;
+  layers: VectorLayer[];
+}
