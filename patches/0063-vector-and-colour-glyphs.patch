+/** One outline as PATH TABLE verbs and (x, y) pairs, y down, origin on the baseline at the pen. */
+interface VectorOutline {
+  verbs: number[];
+  pts: number[];
+}
+
+/**
+ * An opentype.js path (already scaled to px, y down) as move/line/cubic/close.
+ * A quadratic becomes the cubic that traces the same curve exactly:
+ * c1 = p0 + 2/3 (q - p0), c2 = p + 2/3 (q - p). Every contour is closed with a
+ * close verb — opentype.js writes none for a CFF contour and a TrueType one
+ * merely ends on its start — so a stroke joins at the start instead of
+ * capping it.
+ */
+export function outlineOfPath(path: Path): VectorOutline {
+  const verbs: number[] = [];
+  const pts: number[] = [];
+  let open = false;
+  let cx = 0;
+  let cy = 0;
+  let sx = 0;
+  let sy = 0;
+  const close = () => {
+    if (open) verbs.push(VERB_CLOSE);
+    open = false;
+    cx = sx;
+    cy = sy;
+  };
+  for (const cmd of path.commands as any[]) {
+    switch (cmd.type) {
+      case "M":
+        close();
+        verbs.push(VERB_MOVE);
+        pts.push(cmd.x, cmd.y);
+        sx = cx = cmd.x;
+        sy = cy = cmd.y;
+        open = true;
+        break;
+      case "L":
+        verbs.push(VERB_LINE);
+        pts.push(cmd.x, cmd.y);
+        cx = cmd.x;
+        cy = cmd.y;
+        break;
+      case "Q":
+        verbs.push(VERB_CUBIC);
+        pts.push(
+          cx + (2 / 3) * (cmd.x1 - cx),
+          cy + (2 / 3) * (cmd.y1 - cy),
+          cmd.x + (2 / 3) * (cmd.x1 - cmd.x),
+          cmd.y + (2 / 3) * (cmd.y1 - cmd.y),
+          cmd.x,
+          cmd.y,
+        );
+        cx = cmd.x;
+        cy = cmd.y;
+        break;
+      case "C":
+        verbs.push(VERB_CUBIC);
+        pts.push(cmd.x1, cmd.y1, cmd.x2, cmd.y2, cmd.x, cmd.y);
+        cx = cmd.x;
+        cy = cmd.y;
+        break;
+      case "Z":
+        close();
+        break;
+      default:
+        throw new Error(`PocketJS bake-font: unknown outline command ${JSON.stringify(cmd.type)}`);
+    }
+  }
+  close();
+  return { verbs, pts };
+}
