+/// A colour glyph layer's gradient as one PAINT_PUSH (pocket-motion FONT
+/// VECTOR). Its coefficients are over the glyph's own logical px; the paint
+/// is evaluated at screen points, so each row is composed with the inverse
+/// of `xf`, the glyph-to-screen affine. False, emitting nothing, for a
+/// transform that collapses the glyph.
+fn push_glyph_paint(dl: &mut DrawList, g: &crate::text::VectorGradient, xf: &Affine) -> bool {
+    let det = xf.a * xf.d - xf.b * xf.c;
+    if det == 0.0 || !det.is_finite() {
+        return false;
+    }
+    // local = inverse(xf)(x, y) = (p*x + q*y + u, s*x + t*y + v)
+    let (p, q) = (xf.d / det, -xf.c / det);
+    let u = (xf.c * xf.ty - xf.d * xf.tx) / det;
+    let (s, t) = (-xf.b / det, xf.a / det);
+    let v = (xf.b * xf.tx - xf.a * xf.ty) / det;
+    let row = |c0: f32, c1: f32, c2: f32| [c0 * p + c1 * s, c0 * q + c1 * t, c0 * u + c1 * v + c2];
+    let a = row(g.coef[0], g.coef[1], g.coef[2]);
+    let b = row(g.coef[3], g.coef[4], g.coef[5]);
+    let coef = [a[0], a[1], a[2], b[0], b[1], b[2]];
+    if coef.iter().any(|c| !c.is_finite()) {
+        return false;
+    }
+    dl.words.push(spec::draw_op::PAINT_PUSH);
+    dl.words.push(g.kind);
+    dl.words.push(g.stops.len() as u32);
+    for c in coef {
+        dl.words.push(c.to_bits());
+    }
+    for &(colour, pos) in &g.stops {
+        dl.words.push(colour);
+        dl.words.push(pos.to_bits());
+    }
+    true
+}
