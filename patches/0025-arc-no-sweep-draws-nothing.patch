+/// Every op in `words` that puts pixels down, as (op, word index).
+fn paint_ops(words: &[u32]) -> Vec<(u32, usize)> {
+    let mut out = Vec::new();
+    let mut i = 0usize;
+    for op in op_sequence(words) {
+        if ![spec::draw_op::SCISSOR, spec::draw_op::SCISSOR_POP, spec::draw_op::MASK_PUSH, spec::draw_op::MASK_POP]
+            .contains(&op)
+        {
+            out.push((op, i));
+        }
+        i += match op {
+            spec::draw_op::RECT => 4,
+            spec::draw_op::GRAD_RECT => 6,
+            spec::draw_op::GLYPH_RUN => 3 + 2 * ((words[i + 1] >> 16) as usize),
+            spec::draw_op::TEX_QUAD => 9,
+            spec::draw_op::SCISSOR => 3,
+            spec::draw_op::SCISSOR_POP => 1,
+            spec::draw_op::TRI => 7,
+            spec::draw_op::TEX_TRI => 12,
+            spec::draw_op::POLY => 3 + words[i + 1] as usize,
+            spec::draw_op::MASK_PUSH => 2 + 2 * words[i + 1] as usize,
+            _ => 1,
+        };
+    }
+    out
+}
+
+#[test]
+fn an_arc_with_no_sweep_draws_nothing() {
+    // `arc-width` makes the node an arc; the sweep says how much of it. A
+    // sweep of 0 is the first frame of every drawn-on stroke, and it used to
+    // fall through to the box painter: the node's whole ground, a full disc
+    // on a `rounded-full` node, for one frame before the arc started. Under
+    // a sweep of 0 there is no arc and no box. The same node with any other
+    // sweep, and with no arc width at all, still paints.
+    let scene = |sweep: f32, width: f32| {
+        let mut ui = Ui::new();
+        let n = place_box(&mut ui, 40.0, 40.0, 10.0, 10.0);
+        ui.set_prop(n, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+        ui.set_prop(n, spec::prop::RADIUS, 20.0);
+        ui.set_prop(n, spec::prop::ARC_START, 30.0);
+        ui.set_prop(n, spec::prop::ARC_SWEEP, sweep as f64);
+        ui.set_prop(n, spec::prop::ARC_WIDTH, width as f64);
+        ui.tick();
+        let words = ui.draw().words.clone();
+        validate_drawlist(&words);
+        paint_ops(&words).len()
+    };
+    assert_eq!(scene(0.0, 5.0), 0, "an arc with no sweep paints nothing");
+    assert!(scene(90.0, 5.0) > 0, "a quarter arc paints");
+    assert!(scene(-90.0, 5.0) > 0, "a counter-clockwise quarter arc paints");
+    assert!(scene(0.0, 0.0) > 0, "no arc width: the node is a box and paints its ground");
+}
