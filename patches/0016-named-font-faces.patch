+describe("named faces", () => {
+  test("a face slot bakes from the face's file, and an undeclared face is refused", async () => {
+    const { compileClasses } = await import("../framework/compiler/tailwind.ts");
+    const { PROP } = await import("../contracts/spec/spec.ts");
+    const { bakeAtlases, DEFAULT_REGULAR: reg, DEFAULT_BOLD: bold } = await import("../framework/compiler/bake-font.ts");
+    const { join, dirname } = await import("node:path");
+    const displayRegular = join(dirname(reg), "InterDisplay-Regular.ttf");
+    const displayBold = join(dirname(bold), "InterDisplay-Bold.ttf");
+    const c = compileClasses(["text-[40px] font-[display]", "text-[40px]"]);
+    const faceSlot = c.records[c.ids["text-[40px] font-[display]"]!]!.base!.find((p) => p.prop === PROP.fontSlot)!.value;
+    const plainSlot = c.records[c.ids["text-[40px]"]!]!.base!.find((p) => p.prop === PROP.fontSlot)!.value;
+    const atlases = await bakeAtlases({
+      codepoints: [..."Hamburgefonstiv"].map((ch) => ch.codePointAt(0)!),
+      slots: [faceSlot, plainSlot],
+      faces: { display: { regular: displayRegular, bold: displayBold } },
+    });
+    const bySlot = new Map(atlases.map((a) => [a.slot, a]));
+    expect(bySlot.get(faceSlot)!.face).toBe("display");
+    expect(bySlot.get(plainSlot)!.face).toBeUndefined();
+    // Two different faces at one size: the coverage differs.
+    expect(Buffer.compare(bySlot.get(faceSlot)!.bytes, bySlot.get(plainSlot)!.bytes)).not.toBe(0);
+    await expect(
+      bakeAtlases({ codepoints: [65], slots: [faceSlot] }),
+    ).rejects.toThrow("names a face this build does not declare");
+  });
+});
