+#[test]
+fn a_translucent_image_in_perspective_draws_each_pixel_once() {
+    // An image under a perspective root is TEX_TRI cells, two triangles a
+    // cell, and the cells share their edges. A pixel centre exactly on a
+    // shared edge was drawn by both triangles; under a translucent texture
+    // (a dark disc at 82 % alpha over a bright ground) that was a darker
+    // line along every cell's diagonal — a full line where the diagonal runs
+    // at 45 degrees through pixel centres, a dashed one at any other scale.
+    // A uniform half-alpha black texture over white must show one colour.
+    let mut tex_px = alloc::vec![0u8; 8 * 8 * 4];
+    for px in tex_px.chunks_exact_mut(4) {
+        px[3] = 128;
+    }
+    let white = [255u8, 255, 255, 255];
+    for &(z, rot_y) in &[(0.0f64, 0.0f64), (-300.0, 0.0), (-120.0, 30.0)] {
+        let mut ui = Ui::new();
+        ui.set_prop(spec::ROOT_ID, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+        let tex = ui.upload_texture(&tex_px, 8, 8, spec::psm::PSM_8888);
+        assert!(tex >= 0);
+        let stage = place_box(&mut ui, 480.0, 272.0, 0.0, 0.0);
+        ui.set_prop(stage, spec::prop::PERSPECTIVE, 2600.0);
+        let img = ui.create_node(spec::NodeType::Image as u8);
+        ui.set_prop(img, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+        ui.set_prop(img, spec::prop::INSET_L, 140.0);
+        ui.set_prop(img, spec::prop::INSET_T, 36.0);
+        ui.set_prop(img, spec::prop::WIDTH, 200.0);
+        ui.set_prop(img, spec::prop::HEIGHT, 200.0);
+        ui.set_prop(img, spec::prop::TRANSLATE_Z, z);
+        if rot_y != 0.0 {
+            ui.set_prop(img, spec::prop::ROTATE_Y, rot_y);
+        }
+        ui.set_image(img, tex);
+        ui.insert_before(stage, img, 0);
+        ui.tick();
+        let words = ui.draw().words.clone();
+        let counts = validate_drawlist(&words);
+        assert!(counts[spec::draw_op::TEX_TRI as usize] >= 2, "z {z} rotateY {rot_y}: an image in perspective is TEX_TRI cells");
+        let fb = raster_fb(&mut ui);
+        let seen = colours_besides(&fb, white);
+        assert_eq!(seen.len(), 1, "z {z} rotateY {rot_y}: {} colours where one texel colour is drawn: {seen:?}", seen.len());
+    }
+    // The same for a TRI fan: a turned box with a two-stop gradient whose
+    // stops are one translucent colour.
+    let mut ui = Ui::new();
+    ui.set_prop(spec::ROOT_ID, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    let b = place_box(&mut ui, 160.0, 120.0, 160.0, 76.0);
+    ui.set_prop(b, spec::prop::ROTATE, 45.0);
+    ui.set_prop(b, spec::prop::GRAD_DIR, spec::GradDir::ToRight as u32 as f64);
+    ui.set_prop(b, spec::prop::GRAD_FROM, abgr(0, 0, 0, 128) as f64);
+    ui.set_prop(b, spec::prop::GRAD_TO, abgr(0, 0, 0, 128) as f64);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    assert!(validate_drawlist(&words)[spec::draw_op::TRI as usize] >= 2, "a turned gradient box is a TRI fan");
+    let seen = colours_besides(&raster_fb(&mut ui), white);
+    assert_eq!(seen.len(), 1, "a turned translucent gradient: {seen:?}");
+}
