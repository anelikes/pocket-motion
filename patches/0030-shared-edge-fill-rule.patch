+/// Distinct colours in a frame other than `ground`.
+fn colours_besides(fb: &[u8], ground: [u8; 4]) -> alloc::collections::BTreeSet<[u8; 4]> {
+    let mut seen = alloc::collections::BTreeSet::new();
+    for y in 0..spec::SCREEN_H as usize {
+        for x in 0..spec::SCREEN_W as usize {
+            let c = sample_rgba(fb, x, y);
+            if c != ground {
+                seen.insert(c);
+            }
+        }
+    }
+    seen
+}
