+/// A 120 square `overflow-mask` window turned about its bottom-left corner,
+/// holding a full-frame white box offset back to the screen origin — a
+/// poster seen through a tile of itself, the shape a film rolls across its
+/// grid with per-tick translate and rotate keyframes — over black. `(tx, ty)`
+/// is placed by layout at whole pixels plus a fractional translate, because
+/// layout rounds a position and a translate is not rounded. Returns the frame
+/// and the window's four corners in f64.
+fn corner_turned_window(a: f64, tx: f64, ty: f64) -> (alloc::vec::Vec<u8>, [(f64, f64); 4]) {
+    let mut ui = Ui::new();
+    ui.set_prop(spec::ROOT_ID, spec::prop::BG_COLOR, abgr(0, 0, 0, 255) as f64);
+    let (ix, iy) = (tx.floor(), ty.floor());
+    let wrap = place_box(&mut ui, 120.0, 120.0, ix, iy);
+    ui.set_prop(wrap, spec::prop::TRANSLATE_X, tx - ix);
+    ui.set_prop(wrap, spec::prop::TRANSLATE_Y, ty - iy);
+    ui.set_prop(wrap, spec::prop::ORIGIN_X, -0.5);
+    ui.set_prop(wrap, spec::prop::ORIGIN_Y, 0.5);
+    if a != 0.0 {
+        ui.set_prop(wrap, spec::prop::ROTATE, a);
+    }
+    let win = ui.create_node(0);
+    ui.set_prop(win, spec::prop::WIDTH, 120.0);
+    ui.set_prop(win, spec::prop::HEIGHT, 120.0);
+    ui.set_prop(win, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(win, spec::prop::OVERFLOW, spec::Overflow::Mask as u32 as f64);
+    ui.insert_before(wrap, win, 0);
+    let c = ui.create_node(0);
+    ui.set_prop(c, spec::prop::WIDTH, spec::SCREEN_W as f64);
+    ui.set_prop(c, spec::prop::HEIGHT, spec::SCREEN_H as f64);
+    ui.set_prop(c, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(c, spec::prop::INSET_L, -ix);
+    ui.set_prop(c, spec::prop::INSET_T, -iy);
+    ui.set_prop(c, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.insert_before(win, c, 0);
+    ui.tick();
+    let fb = raster_fb(&mut ui);
+    // The corners in f64 from the same rotation the core applies: about
+    // local (0, 120), the wrapper's bottom-left corner.
+    let rad = a.to_radians();
+    let (s, co) = (rad.sin(), rad.cos());
+    let corner = |lx: f64, ly: f64| {
+        let (dx, dy) = (lx, ly - 120.0);
+        (tx + co * dx - s * dy, ty + 120.0 + s * dx + co * dy)
+    };
+    (fb, [corner(0.0, 0.0), corner(120.0, 0.0), corner(120.0, 120.0), corner(0.0, 120.0)])
+}
+
+/// Signed distance of a point inside a convex quad (positive inside), the
+/// quad wound clockwise on a y-down screen.
+fn quad_depth(q: &[(f64, f64); 4], px: f64, py: f64) -> f64 {
+    let mut depth = f64::INFINITY;
+    for i in 0..4 {
+        let (ax, ay) = q[i];
+        let (bx, by) = q[(i + 1) % 4];
+        let (ex, ey) = (bx - ax, by - ay);
+        let d = (ex * (py - ay) - ey * (px - ax)) / (ex * ex + ey * ey).sqrt();
+        depth = depth.min(d);
+    }
+    depth
+}
