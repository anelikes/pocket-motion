+/// MASK_PUSH's vertices are `(x, y)` f32 pairs (pocket-motion patch 0023):
+/// the pixels they touch, floor of the low edge to ceil of the high one.
+fn sub_pixel_polygon_bounds(pairs: &[u32], clip: DamageRect) -> DamageRect {
+    if pairs.len() < 2 {
+        return DamageRect::empty();
+    }
+    let (mut min_x, mut min_y) = (f32::INFINITY, f32::INFINITY);
+    let (mut max_x, mut max_y) = (f32::NEG_INFINITY, f32::NEG_INFINITY);
+    for v in pairs.chunks_exact(2) {
+        let (x, y) = (f32::from_bits(v[0]), f32::from_bits(v[1]));
+        if !x.is_finite() || !y.is_finite() {
+            return clip;
+        }
+        min_x = min_x.min(x);
+        min_y = min_y.min(y);
+        max_x = max_x.max(x);
+        max_y = max_y.max(y);
+    }
+    let lo = |v: f32| crate::layout::floorf(v.clamp(-32768.0, 32767.0)) as i32;
+    let hi = |v: f32| -(crate::layout::floorf(-v.clamp(-32768.0, 32767.0)) as i32);
+    DamageRect::new(lo(min_x), lo(min_y), hi(max_x), hi(max_y)).intersect(clip)
+}
