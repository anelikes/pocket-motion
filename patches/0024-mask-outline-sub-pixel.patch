+#[test]
+fn a_mask_turned_about_its_corner_leaves_no_ink_outside_its_outline() {
+    // The pixels a mask may ink are the ones with at least one of their 16
+    // samples inside the node's outline; the outline is the window's own
+    // corners, not those corners rounded to whole pixels. Rounded, every
+    // edge moved by up to half a pixel per axis, and where the content has
+    // an edge on the window's edge (the frame above, at every angle) that
+    // was a band of full-coverage pixels outside the window as long as its
+    // side. TOL is the sixteenth-pixel quantum MASK_PUSH is sampled at, with
+    // the f32 transform's own error inside it.
+    const TOL: f64 = 1.0 / 16.0;
+    const OFF: [f64; 4] = [-0.375, -0.125, 0.125, 0.375];
+    let mut checked = 0usize;
+    let mut outside = alloc::vec::Vec::new();
+    let mut short = alloc::vec::Vec::new();
+    let mut k = -360i32;
+    while k <= 360 {
+        let a = k as f64 * 0.25;
+        // Sub-pixel positions, as per-tick translate keyframes leave them;
+        // 0 degrees at a fractional position is the AABB case.
+        let fr = [0.0, 0.3, 0.55, 0.9][(k.rem_euclid(4)) as usize];
+        let (tx, ty) = (180.0 + fr, 76.0 + (1.0 - fr) * 0.5);
+        let (fb, q) = corner_turned_window(a, tx, ty);
+        // Only the window's bbox and a margin can hold a sample inside it;
+        // everything else must be the black root.
+        let lo_x = q.iter().map(|p| p.0).fold(f64::INFINITY, f64::min).floor() as i64 - 2;
+        let hi_x = q.iter().map(|p| p.0).fold(f64::NEG_INFINITY, f64::max).ceil() as i64 + 2;
+        let lo_y = q.iter().map(|p| p.1).fold(f64::INFINITY, f64::min).floor() as i64 - 2;
+        let hi_y = q.iter().map(|p| p.1).fold(f64::NEG_INFINITY, f64::max).ceil() as i64 + 2;
+        for y in 0..spec::SCREEN_H as usize {
+            for x in 0..spec::SCREEN_W as usize {
+                let near = (lo_x..hi_x).contains(&(x as i64)) && (lo_y..hi_y).contains(&(y as i64));
+                if !near {
+                    let v = sample_rgba(&fb, x, y)[0];
+                    if v > 0 {
+                        outside.push((a, x, y, v, f64::NEG_INFINITY));
+                    }
+                    continue;
+                }
+                let (cx, cy) = (x as f64 + 0.5, y as f64 + 0.5);
+                // A sample is within 0.375 * sqrt(2) < 0.54 of the centre, so
+                // only a pixel whose centre is within that of an edge needs
+                // its 16 samples read.
+                let centre = quad_depth(&q, cx, cy);
+                let (mut deepest, mut shallowest) = (centre + 0.54, centre - 0.54);
+                if centre.abs() < 0.54 + TOL {
+                    deepest = f64::NEG_INFINITY;
+                    shallowest = f64::INFINITY;
+                    for oy in OFF {
+                        for ox in OFF {
+                            let d = quad_depth(&q, cx + ox, cy + oy);
+                            deepest = deepest.max(d);
+                            shallowest = shallowest.min(d);
+                        }
+                    }
+                }
+                let v = sample_rgba(&fb, x, y)[0];
+                if v > 0 && deepest < -TOL {
+                    outside.push((a, x, y, v, deepest));
+                }
+                if shallowest > TOL && v != 255 {
+                    short.push((a, x, y, v));
+                }
+            }
+        }
+        checked += 1;
+        k += 1;
+    }
+    assert_eq!(checked, 721);
+    assert!(
+        outside.is_empty(),
+        "{} pixels inked with every sample outside the window, at {} angles; first {:?}",
+        outside.len(),
+        {
+            let mut angles: alloc::vec::Vec<i64> = outside.iter().map(|o| (o.0 * 4.0) as i64).collect();
+            angles.dedup();
+            angles.len()
+        },
+        &outside[..outside.len().min(4)]
+    );
+    assert!(short.is_empty(), "pixels wholly inside the window not full: first {:?}", &short[..short.len().min(4)]);
+}
