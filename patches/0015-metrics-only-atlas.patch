+describe("metrics-only atlases", () => {
+  test("carry the full bake's advances, kerning and line metrics in a 1x1 cell", () => {
+    const cps = [..."ATVWYaovyfi.,'"].map((c) => c.codePointAt(0)!); // kern pairs among them
+    const full = bakeSlot(font, 3, 24, false, cps, 1);
+    const thin = bakeSlot(font, 3, 24, false, cps, 1, [], true);
+    expect(thin.metricsOnly).toBe(true);
+    expect(full.metricsOnly).toBe(false);
+    expect([thin.cellW, thin.cellH]).toEqual([1, 1]);
+    expect(thin.bytes[13]! & 2).toBe(2);
+    expect(full.bytes[13]! & 2).toBe(0);
+    // baseline, line height, slot: bytes 10..12 identical.
+    expect([...thin.bytes.subarray(10, 13)]).toEqual([...full.bytes.subarray(10, 13)]);
+    expect(thin.glyphCount).toBe(full.glyphCount);
+    // Every cmap entry: same codepoint, gid and ADVANCE. xoff (byte +7) is the
+    // ink's left-bearing shift and is 0 in a bake that read no outline.
+    const cmapEnd = FONT_HEADER_SIZE + full.glyphCount * FONT_CMAP_ENTRY_SIZE;
+    for (let o = FONT_HEADER_SIZE; o < cmapEnd; o += FONT_CMAP_ENTRY_SIZE) {
+      expect([...thin.bytes.subarray(o, o + 7)]).toEqual([...full.bytes.subarray(o, o + 7)]);
+    }
+    // The kern section is byte-identical, and the whole blob is header + cmap
+    // + one byte per glyph + kern.
+    const fullKern = cmapEnd + full.glyphCount * full.coverageW * full.coverageH;
+    const thinKern = cmapEnd + thin.glyphCount;
+    expect(thin.pairCount).toBe(full.pairCount);
+    expect(full.pairCount).toBeGreaterThan(0);
+    expect([...thin.bytes.subarray(thinKern)]).toEqual([...full.bytes.subarray(fullKern)]);
+    expect(thin.bytes.length).toBe(thinKern + 4 + thin.pairCount * FONT_KERN_PAIR_SIZE);
+    expect(full.bytes.length).toBeGreaterThan(thin.bytes.length * 20);
+  });
+});
