diff --git a/engine/core/src/text_fit.rs b/engine/core/src/text_fit.rs
new file mode 100644
index 00000000..7525bf1b
--- /dev/null
+++ b/engine/core/src/text_fit.rs
@@ -0,0 +1,361 @@
+//! Fit and clamp: a text run laid out against the box layout gives it.
+//!
+//! A node may declare three things about its run (spec.ts PROP.textFit0..
+//! textWrap): a LADDER of baked font slots, largest first; WRAPPING at the
+//! break opportunities the run carries; and a CLAMP to a line count. Layout
+//! evaluates them here, against the content box the solver offers, and the
+//! answer is a pure function of (run, declaration, box, atlases):
+//!
+//! - **Break opportunities are the run's own.** A run of spaces, and U+200B,
+//!   which the generator writes where its language allows a break (CJK, Thai)
+//!   and which is never drawn or looked up. `'\n'` always breaks. No language
+//!   rule is applied here: where a line may end is decided by whoever wrote
+//!   the run, and a segmenter's answer reaches the core as U+200B.
+//! - **A rung holds** when its block's widest line fits the width, its line
+//!   count times the line height fits the height bound, the clamp's line count
+//!   is not exceeded, and no segment had to be cut between two of its own
+//!   characters. The first rung that holds is taken; when none does, the last
+//!   (smallest), and `fitted` is false.
+//! - **A cut inside a segment** happens only when a segment is wider than the
+//!   whole line at the rung taken. It is counted (`split`), never preferred:
+//!   a rung that needs one does not hold, so a smaller rung is tried first.
+//! - **A clamp** keeps its first N lines and ends the last with an ellipsis
+//!   (U+2026, or "..." when the face maps no U+2026), removing characters
+//!   from that line's end until the ellipsis fits. A combining mark is removed
+//!   with the character it sits on. What it removed is counted (`dropped`), so
+//!   text that is not drawn is a number a reader can ask for.
+//!
+//! Widths are summed exactly as [`Fonts::measure_run`] sums them, per line,
+//! in order — pair adjustment, advance and tracking per glyph — so the box
+//! layout reserves for a fitted run is the box its laid-out text measures.
+
+use alloc::string::String;
+use alloc::vec::Vec;
+
+use crate::spec;
+use crate::text::{Atlas, Fonts};
+
+/// U+200B ZERO WIDTH SPACE: a break opportunity the run's author placed.
+pub const BREAK_MARK: char = '\u{200B}';
+/// U+2026 HORIZONTAL ELLIPSIS, ending a clamped run's last kept line.
+pub const ELLIPSIS: char = '\u{2026}';
+
+/// What a node declares about fitting its run.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct FitSpec {
+    /// Font slots, largest rung first; `rungs` of them are meaningful.
+    pub slots: [u8; spec::TEXT_FIT_MAX_RUNGS],
+    pub rungs: u8,
+    /// The ladder was declared (`text-fit-[..]`). Without one the single rung
+    /// is the node's own font slot.
+    pub ladder: bool,
+    /// Lines kept (0 = no clamp).
+    pub clamp: u16,
+    pub wrap: bool,
+}
+
+impl FitSpec {
+    /// The declaration a resolved style carries, or None when it declares
+    /// nothing — the run then lays out as it always has.
+    pub fn of(font_slot: u8, fit0: u32, fit1: u32, clamp: u32, wrap: u8) -> Option<FitSpec> {
+        let mut slots = [0u8; spec::TEXT_FIT_MAX_RUNGS];
+        let mut rungs = 0u8;
+        let bytes = [fit0.to_le_bytes(), fit1.to_le_bytes()];
+        // Slot + 1 per byte; the first 0 ends the ladder.
+        for byte in bytes.iter().flatten().copied().take(spec::TEXT_FIT_MAX_RUNGS) {
+            if byte == 0 {
+                break;
+            }
+            slots[rungs as usize] = byte - 1;
+            rungs += 1;
+        }
+        let ladder = rungs > 0;
+        if !ladder && clamp == 0 && wrap == 0 {
+            return None;
+        }
+        if !ladder {
+            slots[0] = font_slot;
+            rungs = 1;
+        }
+        Some(FitSpec {
+            slots,
+            rungs,
+            ladder,
+            clamp: clamp.min(u16::MAX as u32) as u16,
+            wrap: wrap != 0,
+        })
+    }
+}
+
+/// What layout chose for one run in one box.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Fitted {
+    /// The slot the run is drawn with.
+    pub slot: u8,
+    /// Its index in the ladder (0 = the largest).
+    pub rung: u8,
+    /// A rung held the box. False when the smallest did not, and the run was
+    /// laid out at it anyway.
+    pub fitted: bool,
+    /// The run as laid out: lines joined by '\n', break spaces and U+200B
+    /// removed, the ellipsis appended to a clamped run.
+    pub text: String,
+    pub width: f32,
+    pub height: f32,
+    pub lines_kept: u16,
+    /// Lines the run wrapped to at the slot taken, before the clamp.
+    pub lines_total: u16,
+    /// Characters of the run the clamp left out (break spaces and U+200B not
+    /// counted).
+    pub dropped: u32,
+    /// Line breaks placed between two characters of one segment.
+    pub split: u16,
+}
+
+/// One rung's wrap: lines and their widths.
+struct Wrapped {
+    lines: Vec<String>,
+    widths: Vec<f32>,
+    split: u16,
+}
+
+/// Combining marks the clamp keeps with their base: the general-purpose
+/// combining blocks, ZWJ and the variation selectors. Not a Unicode table;
+/// the blocks a Latin, Cyrillic or Greek run carries marks from.
+fn is_mark(c: char) -> bool {
+    matches!(c as u32,
+        0x0300..=0x036F | 0x1AB0..=0x1AFF | 0x1DC0..=0x1DFF | 0x20D0..=0x20FF
+        | 0xFE20..=0xFE2F | 0x200D | 0xFE00..=0xFE0F)
+}
+
+/// Sums widths exactly as `Fonts::measure_run` does for one line.
+#[derive(Clone)]
+struct Pen<'a> {
+    fonts: &'a Fonts,
+    atlas: &'a Atlas,
+    tracking: f32,
+    width: f32,
+    prev: Option<u16>,
+}
+
+impl<'a> Pen<'a> {
+    fn new(fonts: &'a Fonts, atlas: &'a Atlas, tracking: f32) -> Self {
+        Pen { fonts, atlas, tracking, width: 0.0, prev: None }
+    }
+
+    /// The width after `c`, without moving the pen.
+    fn after(&self, c: char) -> (f32, u16) {
+        let (gid, adv) = self.fonts.glyph_quiet(self.atlas, c as u32);
+        let pair = match self.prev {
+            Some(prev) => self.atlas.kern(prev, gid) as f32,
+            None => 0.0,
+        };
+        (self.width + (pair + adv + self.tracking), gid)
+    }
+
+    fn push(&mut self, c: char) {
+        let (width, gid) = self.after(c);
+        self.width = width;
+        self.prev = Some(gid);
+    }
+}
+
+fn width_of(fonts: &Fonts, atlas: &Atlas, tracking: f32, line: &str) -> f32 {
+    let mut pen = Pen::new(fonts, atlas, tracking);
+    for c in line.chars() {
+        pen.push(c);
+    }
+    pen.width
+}
+
+/// Lay one rung's lines out. `cut` allows a segment wider than the line to be
+/// cut between its characters; without it the segment overflows its line,
+/// which is what a min-content measurement asks for.
+fn wrap(fonts: &Fonts, atlas: &Atlas, tracking: f32, text: &str, wrap: bool, max_w: f32, cut: bool) -> Wrapped {
+    let mut out = Wrapped { lines: Vec::new(), widths: Vec::new(), split: 0 };
+    for hard in text.split('\n') {
+        if !wrap {
+            let line: String = hard.chars().filter(|&c| c != BREAK_MARK).collect();
+            out.widths.push(width_of(fonts, atlas, tracking, &line));
+            out.lines.push(line);
+            continue;
+        }
+        let mut line = String::new();
+        let mut pen = Pen::new(fonts, atlas, tracking);
+        // Spaces seen since the last segment: drawn if the next segment
+        // joins this line, dropped if it starts the next one. At the start of
+        // a hard line they are the author's indent and are kept.
+        let mut spaces = String::new();
+        let mut at_start = true;
+        let mut chars = hard.chars().peekable();
+        while let Some(&c) = chars.peek() {
+            if c == ' ' {
+                spaces.push(c);
+                chars.next();
+                continue;
+            }
+            if c == BREAK_MARK {
+                chars.next();
+                continue;
+            }
+            let mut segment = String::new();
+            while let Some(&c) = chars.peek() {
+                if c == ' ' || c == BREAK_MARK {
+                    break;
+                }
+                segment.push(c);
+                chars.next();
+            }
+            // Try the segment on this line, spaces first.
+            let mut trial = pen.clone();
+            let lead = if line.is_empty() && !at_start { "" } else { spaces.as_str() };
+            for s in lead.chars().chain(segment.chars()) {
+                trial.push(s);
+            }
+            if line.is_empty() || trial.width <= max_w {
+                line.push_str(lead);
+                line.push_str(&segment);
+                pen = trial;
+            } else {
+                out.widths.push(pen.width);
+                out.lines.push(core::mem::take(&mut line));
+                pen = Pen::new(fonts, atlas, tracking);
+                for s in segment.chars() {
+                    pen.push(s);
+                }
+                line = segment.clone();
+            }
+            spaces.clear();
+            at_start = false;
+            if cut && pen.width > max_w && line.chars().count() > 1 {
+                // The line is (indent and) one segment wider than the line:
+                // cut it between characters, each piece as wide as fits.
+                let source = core::mem::take(&mut line);
+                pen = Pen::new(fonts, atlas, tracking);
+                for c in source.chars() {
+                    let (w, _) = pen.after(c);
+                    // Never between a mark and the character it sits on.
+                    if !line.is_empty() && w > max_w && !is_mark(c) {
+                        out.widths.push(pen.width);
+                        out.lines.push(core::mem::take(&mut line));
+                        out.split = out.split.saturating_add(1);
+                        pen = Pen::new(fonts, atlas, tracking);
+                    }
+                    pen.push(c);
+                    line.push(c);
+                }
+            }
+        }
+        if !spaces.is_empty() && line.is_empty() && at_start {
+            // A hard line of nothing but spaces keeps them, as unwrapped.
+            for s in spaces.chars() {
+                pen.push(s);
+            }
+            line.push_str(&spaces);
+        }
+        out.widths.push(pen.width);
+        out.lines.push(line);
+    }
+    out
+}
+
+impl Fonts {
+    /// Fit `text` to a content box `max_w` x `max_h` (either may be
+    /// `f32::INFINITY`). `cut` false is the min-content measurement: segments
+    /// are never cut, so the widest segment is the width.
+    pub fn fit_run(
+        &self,
+        text: &str,
+        spec: &FitSpec,
+        tracking: f32,
+        line_h_override: f32,
+        max_w: f32,
+        max_h: f32,
+        cut: bool,
+    ) -> Fitted {
+        let mut chosen: Option<(u8, Wrapped, f32, bool)> = None;
+        for rung in 0..spec.rungs {
+            let Some(atlas) = self.atlas(spec.slots[rung as usize]) else {
+                continue;
+            };
+            let lh = if line_h_override.is_nan() { atlas.line_height as f32 } else { line_h_override };
+            let w = wrap(self, atlas, tracking, text, spec.wrap, max_w, cut);
+            let widest = w.widths.iter().fold(0.0f32, |a, &b| a.max(b));
+            let lines = w.lines.len();
+            let holds = widest <= max_w
+                && lines as f32 * lh <= max_h
+                && (spec.clamp == 0 || lines <= spec.clamp as usize)
+                && w.split == 0;
+            let last = rung + 1 == spec.rungs;
+            if holds || last {
+                chosen = Some((rung, w, lh, holds));
+                break;
+            }
+            chosen = Some((rung, w, lh, false));
+        }
+        let Some((rung, mut w, lh, fitted)) = chosen else {
+            return Fitted {
+                slot: spec.slots[0],
+                rung: 0,
+                fitted: false,
+                text: String::new(),
+                width: 0.0,
+                height: 0.0,
+                lines_kept: 0,
+                lines_total: 0,
+                dropped: 0,
+                split: 0,
+            };
+        };
+        let slot = spec.slots[rung as usize];
+        let atlas = self.atlas(slot).expect("chosen rung has an atlas");
+        let lines_total = w.lines.len();
+        let mut dropped = 0u32;
+        let clamp = spec.clamp as usize;
+        if clamp > 0 && lines_total > clamp {
+            for line in &w.lines[clamp..] {
+                dropped += line.chars().filter(|&c| c != ' ').count() as u32;
+            }
+            w.lines.truncate(clamp);
+            w.widths.truncate(clamp);
+            let ellipsis: &str = if atlas.lookup_entry(ELLIPSIS as u32).is_some() { "\u{2026}" } else { "..." };
+            let mut last = w.lines.pop().unwrap_or_default();
+            w.widths.pop();
+            loop {
+                let kept = last.trim_end_matches(' ');
+                let mut candidate = String::with_capacity(kept.len() + ellipsis.len());
+                candidate.push_str(kept);
+                candidate.push_str(ellipsis);
+                let width = width_of(self, atlas, tracking, &candidate);
+                if width <= max_w || kept.is_empty() {
+                    w.lines.push(candidate);
+                    w.widths.push(width);
+                    break;
+                }
+                // Remove the last character, and a mark with its base.
+                while let Some(c) = last.pop() {
+                    if c != ' ' {
+                        dropped += 1;
+                    }
+                    if !is_mark(c) {
+                        break;
+                    }
+                }
+            }
+        }
+        let width = w.widths.iter().fold(0.0f32, |a, &b| a.max(b));
+        let lines_kept = w.lines.len();
+        Fitted {
+            slot,
+            rung,
+            fitted,
+            text: w.lines.join("\n"),
+            width,
+            height: lines_kept as f32 * lh,
+            lines_kept: lines_kept.min(u16::MAX as usize) as u16,
+            lines_total: lines_total.min(u16::MAX as usize) as u16,
+            dropped,
+            split: w.split,
+        }
+    }
+}
diff --git a/engine/core/src/text_fit_tests.rs b/engine/core/src/text_fit_tests.rs
new file mode 100644
index 00000000..25c81372
--- /dev/null
+++ b/engine/core/src/text_fit_tests.rs
@@ -0,0 +1,240 @@
+//! Fit and clamp (`text_fit.rs`) against synthetic atlases whose advances
+//! make every width a small integer, so each expectation is arithmetic.
+
+use alloc::string::String;
+use alloc::vec::Vec;
+
+use crate::spec;
+use crate::text::Fonts;
+use crate::text_fit::{FitSpec, ELLIPSIS};
+use crate::Ui;
+
+/// A v4 atlas: `glyphs` are (codepoint, advance), gids in order from 1 after
+/// the tofu cell; `pairs` are (left codepoint, right codepoint, delta).
+fn atlas(slot: u8, line_height: u8, glyphs: &[(char, u8)], pairs: &[(char, char, i8)]) -> Vec<u8> {
+    let mut cmap: Vec<(u32, u16, u8)> = alloc::vec![(0xfffd, 0, 8)];
+    for (i, &(c, adv)) in glyphs.iter().enumerate() {
+        cmap.push((c as u32, i as u16 + 1, adv));
+    }
+    cmap.sort_by_key(|e| e.0);
+    let gid = |c: char| cmap.iter().find(|e| e.0 == c as u32).unwrap().1;
+    let mut kern: Vec<(u16, u16, i8)> = pairs.iter().map(|&(l, r, d)| (gid(l), gid(r), d)).collect();
+    kern.sort_by_key(|p| ((p.0 as u32) << 16) | p.1 as u32);
+    let (cell_w, cell_h) = (8u8, 8u8);
+    let mut out = Vec::new();
+    out.extend_from_slice(&spec::font_atlas::MAGIC.to_le_bytes());
+    out.extend_from_slice(&4u16.to_le_bytes());
+    out.extend_from_slice(&(cmap.len() as u16).to_le_bytes());
+    out.extend_from_slice(&[cell_w, cell_h, 7, line_height, slot, 0, 1, 0]);
+    for &(cp, g, adv) in &cmap {
+        out.extend_from_slice(&cp.to_le_bytes());
+        out.extend_from_slice(&g.to_le_bytes());
+        out.push(adv);
+        out.push(0);
+    }
+    out.extend_from_slice(&alloc::vec![0u8; cmap.len() * cell_w as usize * cell_h as usize]);
+    out.extend_from_slice(&(kern.len() as u32).to_le_bytes());
+    for (l, r, d) in kern {
+        out.extend_from_slice(&l.to_le_bytes());
+        out.extend_from_slice(&r.to_le_bytes());
+        out.push(d as u8);
+    }
+    out
+}
+
+/// Slot 2: every letter 10 px, a space 10, line height 20. Slot 3: half of
+/// that. Both map U+2026 at the width of one letter.
+fn fonts() -> Fonts {
+    let mut f = Fonts::new();
+    // The mark is given an advance so that removing it alone would change
+    // a width (a spacing mark does carry one).
+    let big = [('A', 10), ('B', 10), (' ', 10), ('.', 10), ('\u{301}', 5), (ELLIPSIS, 10)];
+    let small = [('A', 5), ('B', 5), (' ', 5), ('.', 5), ('\u{301}', 0), (ELLIPSIS, 5)];
+    assert!(f.load(&atlas(2, 20, &big, &[])));
+    assert!(f.load(&atlas(3, 10, &small, &[])));
+    f
+}
+
+fn ladder(slots: &[u8], clamp: u16, wrap: bool) -> FitSpec {
+    let mut s = [0u8; spec::TEXT_FIT_MAX_RUNGS];
+    s[..slots.len()].copy_from_slice(slots);
+    FitSpec { slots: s, rungs: slots.len() as u8, ladder: true, clamp, wrap }
+}
+
+const INF: f32 = f32::INFINITY;
+
+#[test]
+fn the_largest_rung_that_holds_is_taken() {
+    let f = fonts();
+    let fit = f.fit_run("AAAA", &ladder(&[2, 3], 0, false), 0.0, f32::NAN, 100.0, INF, true);
+    assert_eq!((fit.slot, fit.rung, fit.fitted), (2, 0, true));
+    assert_eq!((fit.width, fit.height), (40.0, 20.0));
+    // Too wide at slot 2, wide enough at slot 3.
+    let fit = f.fit_run("AAAA", &ladder(&[2, 3], 0, false), 0.0, f32::NAN, 30.0, INF, true);
+    assert_eq!((fit.slot, fit.rung, fit.fitted, fit.width), (3, 1, true, 20.0));
+    // Neither holds: the smallest, marked.
+    let fit = f.fit_run("AAAA", &ladder(&[2, 3], 0, false), 0.0, f32::NAN, 10.0, INF, true);
+    assert_eq!((fit.slot, fit.rung, fit.fitted), (3, 1, false));
+}
+
+/// Red with the height test removed from `holds`: slot 2 wraps to two lines
+/// of 20 in a 20 px box and is taken anyway.
+#[test]
+fn a_block_too_tall_for_its_box_gives_way_to_the_next_rung() {
+    let f = fonts();
+    let fit = f.fit_run("AAAA AAAA", &ladder(&[2, 3], 0, true), 0.0, f32::NAN, 50.0, 20.0, true);
+    assert_eq!((fit.slot, fit.text.as_str(), fit.lines_total), (3, "AAAA AAAA", 1));
+    assert_eq!((fit.width, fit.height), (45.0, 10.0));
+}
+
+/// Red with `&& w.split == 0` removed from `holds`: slot 2 cuts "AAAAAA"
+/// into two lines that fit 40 x 40 and is taken.
+#[test]
+fn a_rung_that_must_cut_a_segment_does_not_hold() {
+    let f = fonts();
+    let fit = f.fit_run("AAAAAA", &ladder(&[2, 3], 0, true), 0.0, f32::NAN, 40.0, 40.0, true);
+    assert_eq!((fit.slot, fit.split, fit.lines_total), (3, 0, 1));
+    assert_eq!(fit.text, "AAAAAA");
+    // With no smaller rung, the cut is made and counted.
+    let fit = f.fit_run("AAAAAA", &ladder(&[2], 0, true), 0.0, f32::NAN, 40.0, INF, true);
+    assert_eq!((fit.text.as_str(), fit.split, fit.fitted), ("AAAA\nAA", 1, false));
+    // A min-content measurement never cuts: the segment is its own width.
+    let fit = f.fit_run("AAAAAA AA", &ladder(&[2], 0, true), 0.0, f32::NAN, 0.0, INF, false);
+    assert_eq!((fit.text.as_str(), fit.width, fit.split), ("AAAAAA\nAA", 60.0, 0));
+}
+
+/// Red with U+200B read as part of a segment: the run is one segment, cut
+/// between letters.
+#[test]
+fn a_line_breaks_at_spaces_and_u200b_and_u200b_is_never_drawn() {
+    let f = fonts();
+    let spec = ladder(&[2], 0, true);
+    let fit = f.fit_run("AA\u{200B}BB\u{200B}AA", &spec, 0.0, f32::NAN, 40.0, INF, true);
+    assert_eq!((fit.text.as_str(), fit.split), ("AABB\nAA", 0));
+    // Spaces at a break are dropped; an indent at a hard line's start is kept.
+    let fit = f.fit_run("  AA BB\nAA", &spec, 0.0, f32::NAN, 40.0, INF, true);
+    assert_eq!(fit.text, "  AA\nBB\nAA");
+    // Without wrapping only '\n' breaks, and U+200B still is not drawn.
+    let fit = f.fit_run("AA\u{200B}BB", &ladder(&[2], 0, false), 0.0, f32::NAN, 10.0, INF, true);
+    assert_eq!((fit.text.as_str(), fit.width), ("AABB", 40.0));
+}
+
+/// Red with the dropped count left at zero, and with the ellipsis loop
+/// removed (the last line keeps its full width).
+#[test]
+fn a_clamp_keeps_its_lines_ends_with_an_ellipsis_and_counts_what_it_left_out() {
+    let f = fonts();
+    let spec = ladder(&[2], 2, true);
+    let fit = f.fit_run("AAA BBB AAA BBB", &spec, 0.0, f32::NAN, 35.0, INF, true);
+    // Four lines of three; two kept; "BBB\u{2026}" is 40, so "BBB" loses its
+    // last letter to the ellipsis, which then fits in 35.
+    assert_eq!(fit.text, "AAA\nBB\u{2026}");
+    assert_eq!((fit.lines_kept, fit.lines_total), (2, 4));
+    assert_eq!(fit.dropped, 3 + 3 + 1);
+    assert_eq!((fit.width, fit.height), (30.0, 40.0));
+    // A mark goes with its base: "AAB\u{301}\u{2026}" is 45 in a 40 box, and
+    // "AAB\u{2026}" would fit, but B without its accent is another letter.
+    let fit = f.fit_run("AAB\u{301} AAA", &ladder(&[2], 1, true), 0.0, f32::NAN, 40.0, INF, true);
+    assert_eq!(fit.text, "AA\u{2026}");
+    assert_eq!(fit.dropped, 3 + 2);
+}
+
+#[test]
+fn a_face_with_no_ellipsis_ends_a_clamp_with_three_periods() {
+    let mut f = Fonts::new();
+    assert!(f.load(&atlas(4, 20, &[('A', 10), (' ', 10), ('.', 4)], &[])));
+    let fit = f.fit_run("AAAA AAAA", &ladder(&[4], 1, true), 0.0, f32::NAN, 60.0, INF, true);
+    assert_eq!(fit.text, "AAAA...");
+}
+
+/// The box layout reserves is the laid-out text measured: per line, in
+/// order, pair adjustments, advances and tracking. Red with tracking left
+/// out of `Pen`, or with a pair read across a removed U+200B as zero.
+#[test]
+fn a_fitted_block_measures_as_its_laid_out_text() {
+    let mut f = Fonts::new();
+    let glyphs = [('A', 9), ('V', 11), ('W', 13), (' ', 4), (ELLIPSIS, 7)];
+    let pairs = [('A', 'V', -2), ('V', 'A', -1), ('W', 'A', -3), ('A', 'W', 1)];
+    assert!(f.load(&atlas(5, 17, &glyphs, &pairs)));
+    let runs = ["AVAW VAWA WAVA AVWA", "AV\u{200B}AW\u{200B}VA\u{200B}WA", "A V A W A V A W A V"];
+    for run in runs {
+        for clamp in [0u16, 1, 2] {
+            for tracking in [0.0f32, 1.5] {
+                for w in [20.0f32, 37.5, 52.0, 80.0, 1000.0] {
+                    let fit = f.fit_run(run, &ladder(&[5], clamp, true), tracking, f32::NAN, w, INF, true);
+                    let (mw, mh) = f.measure_run(&fit.text, 5, tracking, f32::NAN);
+                    assert_eq!((fit.width, fit.height), (mw, mh), "{run:?} clamp {clamp} tracking {tracking} w {w}");
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn the_ladder_unpacks_from_its_two_words() {
+    // Slots 21, 22, 23, 24 | 25: one byte each, slot + 1.
+    let fit0 = 22 | (23 << 8) | (24 << 16) | (25 << 24);
+    let spec = FitSpec::of(9, fit0, 26, 0, 0).unwrap();
+    assert_eq!(&spec.slots[..spec.rungs as usize], &[21, 22, 23, 24, 25]);
+    assert!(spec.ladder);
+    // No ladder, a clamp: the one rung is the node's own slot.
+    let spec = FitSpec::of(9, 0, 0, 3, 0).unwrap();
+    assert_eq!((spec.slots[0], spec.rungs, spec.ladder, spec.clamp), (9, 1, false, 3));
+    assert_eq!(FitSpec::of(9, 0, 0, 0, 0), None);
+}
+
+/// Text nodes in a 1:1 Ui: the record layout writes, what paint draws, and
+/// the export a host reads. Red with `emit_text` drawing the style's slot.
+#[test]
+fn layout_records_the_fit_and_paint_draws_it() {
+    let mut ui = Ui::new();
+    ui.set_viewport(400.0, 300.0);
+    let big = [('A', 10), ('B', 10), (' ', 10), (ELLIPSIS, 10)];
+    let small = [('A', 5), ('B', 5), (' ', 5), (ELLIPSIS, 5)];
+    assert!(ui.load_font_atlas(&atlas(2, 20, &big, &[])));
+    assert!(ui.load_font_atlas(&atlas(3, 10, &small, &[])));
+    let text = ui.create_node(spec::NodeType::Text as u8);
+    ui.insert_before(spec::ROOT_ID, text, 0);
+    ui.set_prop(text, spec::prop::WIDTH, 50.0);
+    ui.set_prop(text, spec::prop::HEIGHT, 20.0);
+    ui.set_prop(text, spec::prop::FONT_SLOT, 2.0);
+    ui.set_prop(text, spec::prop::TEXT_FIT0, (3 | (4 << 8)) as f64);
+    ui.set_prop(text, spec::prop::TEXT_WRAP, 1.0);
+    ui.set_prop(text, spec::prop::TEXT_COLOR, 0xffff_ffffu32 as f64);
+    ui.set_text(text, "AAAA AAAA");
+    ui.tick();
+    let words = ui.draw().words.clone();
+    // One GLYPH_RUN, on slot 3: nine glyphs on one line.
+    let at = words.iter().position(|&w| w == spec::draw_op::GLYPH_RUN).expect("a glyph run");
+    assert_eq!(words[at + 1] & 0xff, 3);
+    assert_eq!(words[at + 1] >> 16, 9);
+    let summary = ui.debug_text_fit(text);
+    assert_eq!(summary & 0xff, 3, "slot drawn");
+    assert_eq!((summary >> 8) & 0xf, 1, "rung");
+    assert_eq!((summary >> 12) & 0xf, 2, "rungs");
+    assert_eq!((summary >> 16) & 7, 0b111, "fitted, ladder, wraps");
+    assert_eq!(ui.debug_text_fit_word(0), 1 | (1 << 16));
+    assert_eq!((ui.debug_text_fit_word(8), ui.debug_text_fit_word(9), ui.debug_text_fit_word(10)), (2, 3, -1));
+    // A node that declares nothing holds no record.
+    let plain = ui.create_node(spec::NodeType::Text as u8);
+    ui.insert_before(spec::ROOT_ID, plain, 0);
+    ui.set_prop(plain, spec::prop::FONT_SLOT, 2.0);
+    ui.set_text(plain, "AB");
+    ui.tick();
+    ui.draw();
+    assert_eq!(ui.debug_text_fit(plain), -1);
+    // The clamp's count reaches the export.
+    ui.set_prop(text, spec::prop::LINE_CLAMP, 1.0);
+    ui.set_prop(text, spec::prop::TEXT_FIT0, 0.0);
+    ui.set_text(text, "AAAA BBBB AAAA");
+    ui.tick();
+    ui.draw();
+    assert!(ui.debug_text_fit(text) >= 0);
+    let lines = ui.debug_text_fit_word(0);
+    assert_eq!((lines & 0xffff, lines >> 16), (1, 3));
+    // "AAAA\u{2026}" is 50 px, the box's width, so no letter gives way.
+    assert_eq!(ui.debug_text_fit_word(1), 4 + 4);
+    let mut drawn = String::new();
+    drawn.push_str("AAAA\u{2026}");
+    assert_eq!(ui.tree.get(text).unwrap().text_fit.as_ref().unwrap().text, drawn);
+}
