+// ---- transform origin as a length (patch 0066) ----------------------------------------
+
+/// The words of a 100x40 box at (60, 60) turned about an origin of
+/// fraction `fx` and length `px` on x (the y origin is the box's top), in 2D
+/// or under a perspective root.
+fn turned_about(fx: f64, px: f64, three_d: bool) -> Vec<u32> {
+    turned_box(fx, px, three_d).2
+}
+
+/// `turned_about`'s scene: the Ui, the box and its words.
+fn turned_box(fx: f64, px: f64, three_d: bool) -> (Ui, i32, Vec<u32>) {
+    let mut ui = Ui::new();
+    let g = ui.create_node(0);
+    ui.set_prop(g, spec::prop::WIDTH, 300.0);
+    ui.set_prop(g, spec::prop::HEIGHT, 200.0);
+    ui.set_prop(g, spec::prop::BG_COLOR, abgr(0, 0, 0, 255) as f64);
+    if three_d {
+        ui.set_prop(g, spec::prop::PERSPECTIVE, 600.0);
+    }
+    ui.insert_before(spec::ROOT_ID, g, 0);
+    let b = ui.create_node(0);
+    ui.set_prop(b, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(b, spec::prop::INSET_L, 60.0);
+    ui.set_prop(b, spec::prop::INSET_T, 60.0);
+    ui.set_prop(b, spec::prop::WIDTH, 100.0);
+    ui.set_prop(b, spec::prop::HEIGHT, 40.0);
+    ui.set_prop(b, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.set_prop(b, if three_d { spec::prop::ROTATE_Y } else { spec::prop::ROTATE }, 30.0);
+    ui.set_prop(b, spec::prop::ORIGIN_X, fx);
+    ui.set_prop(b, spec::prop::ORIGIN_X_PX, px);
+    ui.set_prop(b, spec::prop::ORIGIN_Y, -0.5);
+    ui.insert_before(g, b, 0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    validate_drawlist(&words);
+    (ui, b, words)
+}
+
+#[test]
+fn an_origin_animates_its_fraction_and_its_length() {
+    // Both halves of the origin take a tween; linear over 200 ms they pass
+    // through the quarter-box pivot on their way, and land on their targets.
+    for (prop, to, end) in [(spec::prop::ORIGIN_X_PX, 50.0, (-0.5, 50.0)), (spec::prop::ORIGIN_X, 0.0, (0.0, 0.0))] {
+        let (mut ui, b, _) = turned_box(-0.5, 0.0, false);
+        assert!(ui.animate(b, prop, to, 200, spec::Easing::Linear as u8, 0) >= 0, "prop {prop} is animatable");
+        let quarter = turned_about(-0.25, 0.0, false);
+        let mut passed = false;
+        for _ in 0..30 {
+            ui.tick();
+            passed |= ui.draw().words == quarter;
+        }
+        assert!(passed, "prop {prop} passes the quarter pivot");
+        assert_eq!(ui.draw().words, turned_about(end.0, end.1, false), "prop {prop} lands");
+    }
+}
+
+#[test]
+fn an_origin_length_is_the_fraction_it_equals() {
+    // 25 px into a 100 px box is a quarter of it: the fraction -0.25 from
+    // the centre, the left edge plus 25 px, or the centre less 25 px — every
+    // value here exact in binary, so the words agree to the bit.
+    for three_d in [false, true] {
+        let quarter = turned_about(-0.25, 0.0, three_d);
+        assert_eq!(turned_about(-0.5, 25.0, three_d), quarter, "3D: {three_d}");
+        assert_eq!(turned_about(0.0, -25.0, three_d), quarter, "3D: {three_d}");
+        assert_ne!(turned_about(-0.5, 0.0, three_d), quarter, "the length moves the pivot, 3D: {three_d}");
+    }
+}
