+/** One axis of a transform origin: a fraction of the box from its centre
+ *  (PROP.originX's unit) and a length in px beside it. */
+export interface OriginAxis {
+  fraction: number;
+  px: number;
+}
+
+/** A CSS `<length-percentage>` an origin can take: `30%`, `12px`, `0`, or
+ *  `calc()` of those added and subtracted. As a fraction of the box from its
+ *  centre, which a percentage is offset by one half to become. */
+function originLength(t: string): OriginAxis | null {
+  const term = (u: string): OriginAxis | null => {
+    if (/^[+-]?0*\.?0+$/.test(u)) return { fraction: 0, px: 0 };
+    const m = /^([+-]?\d*\.?\d+)(%|px)$/.exec(u);
+    if (!m) return null;
+    const v = parseFloat(m[1]!);
+    return m[2] === "%" ? { fraction: v / 100, px: 0 } : { fraction: 0, px: v };
+  };
+  const calc = /^calc\((.*)\)$/.exec(t);
+  let sum: OriginAxis | null;
+  if (calc) {
+    // CSS requires whitespace round a binary + and -.
+    const parts = calc[1]!.trim().split(/\s+([+-])\s+/);
+    sum = term(parts[0]!);
+    for (let i = 1; sum !== null && i < parts.length; i += 2) {
+      const next = term(parts[i + 1] ?? "");
+      if (next === null) return null;
+      const k = parts[i] === "-" ? -1 : 1;
+      sum = { fraction: sum.fraction + k * next.fraction, px: sum.px + k * next.px };
+    }
+  } else {
+    sum = term(t);
+  }
+  return sum === null ? null : { fraction: sum.fraction - 0.5, px: sum.px };
+}
+
+const ORIGIN_X_WORDS: Record<string, number> = { left: -0.5, center: 0, right: 0.5 };
+const ORIGIN_Y_WORDS: Record<string, number> = { top: -0.5, center: 0, bottom: 0.5 };
+
+/**
+ * CSS `transform-origin` in two dimensions (pocket-motion patch 0066): one
+ * or two of `left|center|right|top|bottom` and `<length-percentage>`, with
+ * CSS's rules — one value is x unless it is `top` or `bottom`, the other
+ * axis then centred; two keywords in either order; a length or percentage
+ * pins its value to the position it is written in, x first. A third value
+ * (z) is not drawn by a 2D origin and is null, as anything else unparsed.
+ */
+export function parseTransformOrigin(text: string): { x: OriginAxis; y: OriginAxis } | null {
+  const tokens = text.trim().match(/calc\([^()]*\)|[^\s]+/g) ?? [];
+  const word = (t: string, words: Record<string, number>): OriginAxis | null =>
+    t in words ? { fraction: words[t]!, px: 0 } : null;
+  const centre: OriginAxis = { fraction: 0, px: 0 };
+  if (tokens.length === 1) {
+    const t = tokens[0]!;
+    if (t === "top" || t === "bottom") return { x: centre, y: word(t, ORIGIN_Y_WORDS)! };
+    const x = word(t, ORIGIN_X_WORDS) ?? originLength(t);
+    return x === null ? null : { x, y: centre };
+  }
+  if (tokens.length !== 2) return null;
+  const [a, b] = tokens as [string, string];
