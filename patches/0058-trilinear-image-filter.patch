+                            let (qw, qh) = wh(p[2], scale);
+                            let (mr, mg, mb, ma) = channels(modulate);
+                            let c = clip.intersect(Clip { x0: x, y0: y, x1: x + qw, y1: y + qh });
+                            for py in c.y0..c.y1 {
+                                let v = v0 + (v1 - v0) * ((py - y) as f32 + 0.5) * (1.0 / qh as f32);
+                                for px in c.x0..c.x1 {
+                                    let u = u0 + (u1 - u0) * ((px - x) as f32 + 0.5) * (1.0 / qw as f32);
+                                    let (mut r, mut g, mut b, mut a) = trilinear_reference(&view, mips, rho, scale, u, v);
+                                    if modulate != 0xffff_ffff {
+                                        r = (r * mr + 127) / 255;
+                                        g = (g * mg + 127) / 255;
+                                        b = (b * mb + 127) / 255;
+                                        a = (a * ma + 127) / 255;
+                                    }
+                                    RgbaTarget::<false> { bytes: &mut want }.blend((py * sw + px) as usize, r, g, b, a);
+                                }
+                            }
+                            assert!(want == got, "{w}x{h} rho {rho} scale {scale} quad {qx},{qy} {qw}x{qh}");
+                            assert!(want != ground);
+                            compared += 1;
+                            blended += usize::from(crate::mip::pick(rho, scale, mips.len()).1 > 0);
+                        }
+                    }
+                }
+            }
+            // The triangle's sampler, at scattered points.
+            for &rho in &[1.3f32, 2.7, 13.0] {
+                let read = MipRead::new(view, mips, rho, 1);
+                for _ in 0..200 {
+                    let (u, v) = ((next() % 1000) as f32 / 999.0, (next() % 1000) as f32 / 999.0);
+                    assert_eq!(read.sample(u, v), Some(trilinear_reference(&view, mips, rho, 1, u, v)), "{w}x{h} rho {rho} at {u},{v}");
+                }
+            }
+        }
+        assert_eq!(compared, 4 * 7 * 2 * 3 * 2);
+        assert!(blended * 2 > compared, "most reads blend two levels: {blended} of {compared}");
+    }
 }
 
