index 00000000..717d457a
--- /dev/null
+++ b/engine/core/src/mip.rs
@@ -0,0 +1,370 @@
+//! Mip chains and texture-space footprints for trilinear image sampling
+//! (`image-filter-trilinear`, pocket-motion).
+//!
+//! A chain is a pure function of a texture's bytes. Level k + 1 is level k
+//! reduced to `max(1, floor(w/2)) x max(1, floor(h/2))` by an exact area
+//! average: each output texel's span is cut against each source texel's in
+//! units of 1/dst of a source texel, so every weight is an integer, a side
+//! that halves evenly is the 2x2 box, and an odd side spreads three texels
+//! over two. Texels are averaged premultiplied and stored straight, so a
+//! transparent neighbour lends a level its coverage and none of its colour.
+//! Integer arithmetic throughout (u64 sums, round half up): the same bytes on
+//! every host.
+//!
+//! The core builds a chain the first time a draw needs a level below the
+//! texture's own (`Walker`, `draw.rs`), keyed by the texture's revision, so a
+//! texture never drawn below its size costs nothing and one whose bytes are
+//! overwritten in place is reduced again from the new bytes.
+
+use alloc::vec::Vec;
+
+use crate::fmath::sqrtf;
+use crate::{spec, TexView};
+
+/// One reduced level: straight-alpha RGBA8888, row-major.
+pub struct MipLevel {
+    pub w: u32,
+    pub h: u32,
+    pub rgba: Vec<u8>,
+}
+
+impl MipLevel {
+    pub fn view(&self) -> TexView<'_> {
+        TexView {
+            pixels: &self.rgba,
+            w: self.w,
+            h: self.h,
+            psm: spec::psm::PSM_8888,
+            palette: None,
+            linear: true,
+        }
+    }
+}
+
+/// The levels below a texture's own, and the texture revision they were
+/// reduced from. Empty until a draw asks for one.
+#[derive(Default)]
+pub struct MipChain {
+    revision: Option<u64>,
+    levels: Vec<MipLevel>,
+}
+
+impl MipChain {
+    /// The levels, when they were reduced from the bytes at `revision`;
+    /// empty otherwise.
+    pub fn levels(&self, revision: u64) -> &[MipLevel] {
+        if self.revision == Some(revision) {
+            &self.levels
+        } else {
+            &[]
+        }
+    }
+
+    /// Reduce `base` down to 1x1 unless the levels for `revision` are here.
+    pub fn ensure(&mut self, base: &TexView, revision: u64) {
+        if self.revision == Some(revision) {
+            return;
+        }
+        self.levels.clear();
+        let (mut w, mut h) = (base.w, base.h);
+        while w > 1 || h > 1 {
+            let (dw, dh) = ((w / 2).max(1), (h / 2).max(1));
+            let rgba = match self.levels.last() {
+                Some(prev) => reduce(&prev.view(), dw, dh),
+                None => reduce(base, dw, dh),
+            };
+            self.levels.push(MipLevel { w: dw, h: dh, rgba });
+            (w, h) = (dw, dh);
+        }
+        self.revision = Some(revision);
+    }
+
+    /// Bytes the levels hold.
+    pub fn bytes(&self) -> usize {
+        self.levels.iter().map(|l| l.rgba.len()).sum()
+    }
+}
+
+/// The source texels output texel `i` covers on one axis of a `src` -> `dst`
+/// reduction, with integer weights summing to `src`: output `i` spans
+/// `[i*src, (i+1)*src)` and source `s` spans `[s*dst, (s+1)*dst)`. With `dst`
+/// at least half of `src` a span touches at most three texels.
+fn axis_taps(src: u32, dst: u32, i: u32) -> ([(u32, u64); 3], usize) {
+    let mut taps = [(0u32, 0u64); 3];
+    let mut n = 0;
+    let (lo, hi) = (i as u64 * src as u64, (i as u64 + 1) * src as u64);
+    let mut s = (lo / dst as u64) as u32;
+    while (s as u64) * (dst as u64) < hi && s < src {
+        let (s0, s1) = (s as u64 * dst as u64, (s as u64 + 1) * dst as u64);
+        let w = s1.min(hi) - s0.max(lo);
+        if w > 0 && n < 3 {
+            taps[n] = (s, w);
+            n += 1;
+        }
+        s += 1;
+    }
+    (taps, n)
+}
+
+/// `src` reduced to `dw` x `dh` by the area average the module comment
+/// describes. `src` may be any psm `texel` reads; the result is RGBA8888.
+pub fn reduce(src: &TexView, dw: u32, dh: u32) -> Vec<u8> {
+    let mut out = alloc::vec![0u8; dw as usize * dh as usize * 4];
+    let denom = src.w as u64 * src.h as u64;
+    let cols: Vec<([(u32, u64); 3], usize)> = (0..dw).map(|i| axis_taps(src.w, dw, i)).collect();
+    for j in 0..dh {
+        let (rows, nr) = axis_taps(src.h, dh, j);
+        for (i, &(taps, nc)) in cols.iter().enumerate() {
+            let (mut sa, mut sr, mut sg, mut sb) = (0u64, 0u64, 0u64, 0u64);
+            for &(y, wy) in &rows[..nr] {
+                for &(x, wx) in &taps[..nc] {
+                    let idx = y as usize * src.w as usize + x as usize;
+                    let Some((r, g, b, a)) = crate::raster::texel(src, idx) else {
+                        return out;
+                    };
+                    let wa = wx * wy * a as u64;
+                    sa += wa;
+                    sr += wa * r as u64;
+                    sg += wa * g as u64;
+                    sb += wa * b as u64;
+                }
+            }
+            let o = (j as usize * dw as usize + i) * 4;
+            if sa > 0 {
+                out[o] = ((sr + sa / 2) / sa) as u8;
+                out[o + 1] = ((sg + sa / 2) / sa) as u8;
+                out[o + 2] = ((sb + sa / 2) / sa) as u8;
+                out[o + 3] = ((sa + denom / 2) / denom) as u8;
+            }
+        }
+    }
+    out
+}
+
+/// Texels per logical px along the screen axis that crosses the most of
+/// them, for a `tw` x `th` texture under a screen-to-UV map whose partial
+/// derivatives (normalised UV per logical px) are `dudx` .. `dvdy`. The
+/// isotropic footprint: the longer of the two image-space columns of the
+/// Jacobian, so a squeeze along one axis is filtered for that axis.
+pub fn footprint(tw: u32, th: u32, dudx: f32, dudy: f32, dvdx: f32, dvdy: f32) -> f32 {
+    let (tw, th) = (tw as f32, th as f32);
+    let (ax, ay) = (dudx * tw, dvdx * th);
+    let (bx, by) = (dudy * tw, dvdy * th);
+    let r2 = (ax * ax + ay * ay).max(bx * bx + by * by);
+    if r2.is_finite() {
+        sqrtf(r2)
+    } else {
+        f32::MAX
+    }
+}
+
+/// [`footprint`] of the affine map a screen-space triangle and its UVs
+/// define, or None when the triangle has no area.
+pub fn triangle_footprint(tw: u32, th: u32, p: [(f32, f32); 3], uv: [(f32, f32); 3]) -> Option<f32> {
+    let (e1x, e1y) = (p[1].0 - p[0].0, p[1].1 - p[0].1);
+    let (e2x, e2y) = (p[2].0 - p[0].0, p[2].1 - p[0].1);
+    let det = e1x * e2y - e2x * e1y;
+    if det == 0.0 || !det.is_finite() {
+        return None;
+    }
+    let (du1, dv1) = (uv[1].0 - uv[0].0, uv[1].1 - uv[0].1);
+    let (du2, dv2) = (uv[2].0 - uv[0].0, uv[2].1 - uv[0].1);
+    let dudx = (du1 * e2y - du2 * e1y) / det;
+    let dudy = (du2 * e1x - du1 * e2x) / det;
+    let dvdx = (dv1 * e2y - dv2 * e1y) / det;
+    let dvdy = (dv2 * e1x - dv1 * e2x) / det;
+    Some(footprint(tw, th, dudx, dudy, dvdx, dvdy))
+}
+
+/// The two levels a footprint of `rho` texels per logical px falls between at
+/// raster scale `scale`, for a chain of `levels` below the texture's own:
+/// `(level, t)` reads `level` and, when `t > 0`, `level + 1` weighted `t/256`.
+/// `r = rho / scale` at or below one is level 0 alone. Above it the level is
+/// `floor(log2 r)` from r's exponent and `t` the top eight bits of its
+/// mantissa — `r / 2^level - 1`, linear between the powers of two and
+/// continuous across them — so no transcendental reaches a pixel.
+pub fn pick(rho: f32, scale: i32, levels: usize) -> (usize, u32) {
+    let r = rho / scale.max(1) as f32;
+    if !(r > 1.0) {
+        return (0, 0);
+    }
+    let bits = r.to_bits();
+    let level = (((bits >> 23) & 0xff) - 127) as usize;
+    if level >= levels {
+        return (levels, 0);
+    }
+    (level, (bits >> 15) & 0xff)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// xorshift32, so every texture here is the same on every run.
+    fn rng(mut state: u32) -> impl FnMut() -> u32 {
+        move || {
+            state ^= state << 13;
+            state ^= state >> 17;
+            state ^= state << 5;
+            state
+        }
+    }
+
+    /// The reduction by another route: replicate every source texel into a
+    /// `dw` x `dh` block, so the source becomes `w*dw` x `h*dh` cells, and
+    /// average the `w` x `h` block of cells under each output texel —
+    /// premultiplied, rounded half up. No overlap arithmetic.
+    fn replicated(src: &TexView, dw: u32, dh: u32) -> Vec<u8> {
+        let (w, h) = (src.w, src.h);
+        let mut out = alloc::vec![0u8; (dw * dh * 4) as usize];
+        for j in 0..dh {
+            for i in 0..dw {
+                let (mut sa, mut sr, mut sg, mut sb) = (0u64, 0u64, 0u64, 0u64);
+                for gy in j * h..(j + 1) * h {
+                    for gx in i * w..(i + 1) * w {
+                        let idx = (gy / dh) as usize * w as usize + (gx / dw) as usize;
+                        let (r, g, b, a) = crate::raster::texel(src, idx).unwrap();
+                        let a = a as u64;
+                        sa += a;
+                        sr += a * r as u64;
+                        sg += a * g as u64;
+                        sb += a * b as u64;
+                    }
+                }
+                let o = ((j * dw + i) * 4) as usize;
+                let n = (w * h) as u64;
+                if sa > 0 {
+                    out[o] = ((sr + sa / 2) / sa) as u8;
+                    out[o + 1] = ((sg + sa / 2) / sa) as u8;
+                    out[o + 2] = ((sb + sa / 2) / sa) as u8;
+                    out[o + 3] = ((sa + n / 2) / n) as u8;
+                }
+            }
+        }
+        out
+    }
+
+    #[test]
+    fn reduce_is_the_area_average_of_the_replicated_texture() {
+        let mut next = rng(0x9e37_79b9);
+        let palette: Vec<u8> = (0..1024).map(|_| next() as u8).collect();
+        let sizes = [(2u32, 2u32), (3, 1), (1, 5), (5, 7), (7, 3), (8, 8), (13, 6), (33, 17), (2, 9)];
+        let mut checked = 0;
+        for &(w, h) in &sizes {
+            let n = (w * h) as usize;
+            // Every fifth RGBA texel transparent, the rest any alpha.
+            let rgba: Vec<u8> = (0..n)
+                .flat_map(|i| {
+                    let v = next();
+                    let a = if i % 5 == 4 { 0 } else { (v >> 24) as u8 };
+                    [v as u8, (v >> 8) as u8, (v >> 16) as u8, a]
+                })
+                .collect();
+            let two: Vec<u8> = (0..n).flat_map(|_| (next() as u16).to_le_bytes()).collect();
+            let idx: Vec<u8> = (0..n).map(|_| next() as u8).collect();
+            let views = [
+                TexView { pixels: &rgba, w, h, psm: spec::psm::PSM_8888, palette: None, linear: false },
+                TexView { pixels: &two, w, h, psm: spec::psm::PSM_5650, palette: None, linear: false },
+                TexView { pixels: &two, w, h, psm: spec::psm::PSM_4444, palette: None, linear: false },
+                TexView { pixels: &idx, w, h, psm: spec::psm::PSM_T8, palette: Some(&palette), linear: false },
+            ];
+            for view in &views {
+                let (dw, dh) = ((w / 2).max(1), (h / 2).max(1));
+                assert_eq!(reduce(view, dw, dh), replicated(view, dw, dh), "{w}x{h} psm {}", view.psm);
+                checked += 1;
+            }
+        }
+        assert_eq!(checked, sizes.len() * 4);
+    }
+
+    #[test]
+    fn a_transparent_neighbour_lends_a_level_no_colour() {
+        // Opaque red on transparent black, in a pattern that leaves every
+        // reduced texel some of each at every level of an odd-sided chain.
+        let (w, h) = (45u32, 27u32);
+        let rgba: Vec<u8> = (0..w * h)
+            .flat_map(|i| if (i % w + i / w) % 3 == 0 { [255, 0, 0, 255] } else { [0, 0, 0, 0] })
+            .collect();
+        let view = TexView { pixels: &rgba, w, h, psm: spec::psm::PSM_8888, palette: None, linear: false };
+        let mut chain = MipChain::default();
+        chain.ensure(&view, 0);
+        let mut partial = 0;
+        for level in chain.levels(0) {
+            for px in level.rgba.chunks_exact(4) {
+                assert!(px[3] > 0, "{}x{}: a third of every span is red", level.w, level.h);
+                assert_eq!(&px[..3], &[255, 0, 0], "{}x{}: alpha {}", level.w, level.h, px[3]);
+                partial += usize::from(px[3] < 255);
+            }
