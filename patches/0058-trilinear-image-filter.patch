+#[test]
+fn a_trilinear_image_in_perspective_carries_each_cells_footprint() {
+    // Turned away about Y, the image's far side crosses more texels a pixel
+    // than its near side; each cell carries its own.
+    let (tw, th) = (256u32, 256u32);
+    let px = alloc::vec![200u8; (tw * th * 4) as usize];
+    let mut ui = Ui::new();
+    let tex = ui.upload_texture(&px, tw, th, spec::psm::PSM_8888);
+    let stage = place_box(&mut ui, 480.0, 272.0, 0.0, 0.0);
+    ui.set_prop(stage, spec::prop::PERSPECTIVE, 400.0);
+    let img = trilinear_image(&mut ui, tex, stage, 140.0, 36.0, 200.0, 200.0);
+    ui.set_prop(img, spec::prop::ROTATE_Y, 60.0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    validate_drawlist(&words);
+    let ops = mip_footprints(&words);
+    assert!(ops.len() >= 4 && ops.iter().all(|&(op, _)| op == spec::draw_op::TEX_TRI_MIP), "{ops:?}");
+    let lo = ops.iter().map(|o| o.1).fold(f32::MAX, f32::min);
+    let hi = ops.iter().map(|o| o.1).fold(0.0f32, f32::max);
+    // Unturned it is 1.28 texels a pixel; turned, every cell is narrower
+    // than that and the far ones narrowest (1.74 and 3.68 when written).
+    assert!(lo > 1.28 && hi > lo * 1.5, "footprints {lo}..{hi}");
+    assert!(!ui.texture_mips(tex).is_empty());
+}
