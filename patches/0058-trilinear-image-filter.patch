+    }
+
+    #[test]
+    fn a_chain_halves_to_one_texel_and_costs_at_most_a_third() {
+        let (w, h) = (1000u32, 1500u32);
+        let rgba: Vec<u8> = (0..w * h).flat_map(|_| [10u8, 200, 30, 77]).collect();
+        let view = TexView { pixels: &rgba, w, h, psm: spec::psm::PSM_8888, palette: None, linear: false };
+        let mut chain = MipChain::default();
+        assert!(chain.levels(0).is_empty(), "nothing until a draw asks");
+        chain.ensure(&view, 0);
+        let dims: Vec<(u32, u32)> = chain.levels(0).iter().map(|l| (l.w, l.h)).collect();
+        assert_eq!(
+            dims,
+            [(500, 750), (250, 375), (125, 187), (62, 93), (31, 46), (15, 23), (7, 11), (3, 5), (1, 2), (1, 1)]
