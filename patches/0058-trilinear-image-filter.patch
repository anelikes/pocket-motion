+        for level in chain.levels(0) {
+            assert!(level.rgba.chunks_exact(4).all(|px| px == [10, 200, 30, 77]), "{}x{}", level.w, level.h);
+        }
+        assert!(chain.bytes() * 3 <= rgba.len(), "{} bytes over a {}-byte base", chain.bytes(), rgba.len());
+        assert!(chain.levels(1).is_empty(), "levels reduced from revision 0 are not revision 1's");
+    }
+
+    #[test]
+    fn a_new_revision_is_reduced_again() {
+        let (w, h) = (6u32, 4u32);
+        let a: Vec<u8> = (0..w * h).flat_map(|_| [255u8, 255, 255, 255]).collect();
+        let b: Vec<u8> = (0..w * h).flat_map(|_| [0u8, 0, 255, 255]).collect();
+        let mut chain = MipChain::default();
+        chain.ensure(&TexView { pixels: &a, w, h, psm: spec::psm::PSM_8888, palette: None, linear: false }, 3);
+        assert_eq!(&chain.levels(3)[0].rgba[..4], &[255, 255, 255, 255]);
+        chain.ensure(&TexView { pixels: &b, w, h, psm: spec::psm::PSM_8888, palette: None, linear: false }, 4);
+        assert!(chain.levels(3).is_empty());
+        assert_eq!(&chain.levels(4)[0].rgba[..4], &[0, 0, 255, 255]);
+    }
+
+    #[test]
+    fn pick_reads_the_exponent_and_the_mantissa() {
+        // (rho, scale, levels) -> (level, t)
+        let cases = [
+            (0.5f32, 1, 8, (0usize, 0u32)),
+            (1.0, 1, 8, (0, 0)),
+            (1.5, 1, 8, (0, 128)),
+            (2.0, 1, 8, (1, 0)),
+            (3.0, 1, 8, (1, 128)),
+            (6.0, 2, 8, (1, 128)),
+            (8.0, 4, 8, (1, 0)),
+            (2.0, 2, 8, (0, 0)),
+            (1000.0, 1, 3, (3, 0)),
+            (f32::MAX, 1, 5, (5, 0)),
+            (f32::NAN, 1, 5, (0, 0)),
+            (-4.0, 1, 5, (0, 0)),
+        ];
+        for &(rho, scale, levels, want) in &cases {
+            assert_eq!(pick(rho, scale, levels), want, "rho {rho} scale {scale} levels {levels}");
+        }
+        // Continuous across every power of two: read as one number, level
+        // and weight never step back and move by at most one weight unit
+        // when r grows by 1/512 of itself — half a unit within a level, and
+        // 255 -> the next level's 0 across a power of two.
+        let mut prev = 0u32;
+        let mut r = 1.0f32;
+        while r < 300.0 {
+            let (level, t) = pick(r, 1, 16);
+            let e = level as u32 * 256 + t;
+            assert!(e >= prev && e - prev <= 1, "r {r}: {prev} -> {e}");
+            prev = e;
+            r += r / 512.0;
+        }
+        assert_eq!(prev >> 8, 8, "the walk reached level 8");
+    }
+}
