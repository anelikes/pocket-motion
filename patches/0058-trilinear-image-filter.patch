+    fn trilinear_reference(base: &TexView, mips: &[crate::mip::MipLevel], rho: f32, scale: i32, u: f32, v: f32) -> (u32, u32, u32, u32) {
+        let level_view = |k: usize| if k == 0 { *base } else { mips[k - 1].view() };
+        let bil = |view: &TexView, u: f32, v: f32| {
+            let (tw_max, th_max) = (view.w as i32 - 1, view.h as i32 - 1);
+            let uf = (u * view.w as f32 * 256.0) as i32 - 128;
+            let vf = (v * view.h as f32 * 256.0) as i32 - 128;
+            let x0 = (uf >> 8).clamp(0, tw_max);
+            let y0 = (vf >> 8).clamp(0, th_max);
+            let (x1, y1) = ((x0 + 1).min(tw_max), (y0 + 1).min(th_max));
+            let (fx, fy) = ((uf & 255) as u32, (vf & 255) as u32);
+            let w = view.w as i32;
+            let c = |x: i32, y: i32| texel(view, (y * w + x) as usize).unwrap();
+            let (c00, c01, c10, c11) = (c(x0, y0), c(x1, y0), c(x0, y1), c(x1, y1));
+            let lerp8 = |a: u32, b: u32, f: u32| (a * (256 - f) + b * f) >> 8;
+            let mix = |a: u32, b: u32, c: u32, d: u32| lerp8(lerp8(a, b, fx), lerp8(c, d, fx), fy);
+            [mix(c00.0, c01.0, c10.0, c11.0), mix(c00.1, c01.1, c10.1, c11.1), mix(c00.2, c01.2, c10.2, c11.2), mix(c00.3, c01.3, c10.3, c11.3)]
+        };
+        let (level, t) = crate::mip::pick(rho, scale, mips.len());
+        let a = bil(&level_view(level), u, v);
+        let out = if t == 0 {
+            a
+        } else {
+            let b = bil(&level_view(level + 1), u, v);
+            core::array::from_fn(|i| (a[i] * (256 - t) + b[i] * t) >> 8)
+        };
+        (out[0], out[1], out[2], out[3])
+    }
