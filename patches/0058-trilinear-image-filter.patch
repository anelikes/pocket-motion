+#[test]
+fn a_chain_is_reduced_when_a_draw_reads_below_the_texture_and_again_when_its_bytes_change() {
+    let (tw, th) = (64u32, 64u32);
+    let palette = |rgba: [u8; 4]| -> Vec<u8> { (0..256).flat_map(|_| rgba).collect() };
+    let mut blob = palette([90, 90, 90, 255]);
+    blob.extend(alloc::vec![7u8; (tw * th) as usize]);
+    let mut ui = Ui::new();
+    let tex = ui.upload_texture(&blob, tw, th, spec::psm::PSM_T8);
+    assert!(tex >= 0);
+    // At its own size: one texel a pixel, no level below it is read.
+    let img = trilinear_image(&mut ui, tex, spec::ROOT_ID, 10.0, 10.0, 64.0, 64.0);
+    ui.tick();
+    let ops = mip_footprints(&ui.draw().words.clone());
+    assert!(ops.len() == 1 && close(ops[0].1, 1.0), "{ops:?}");
+    assert!(ui.texture_mips(tex).is_empty(), "drawn at its size: nothing reduced");
+    // A quarter of its size: four texels a pixel, six levels to 1x1.
+    ui.set_prop(img, spec::prop::WIDTH, 16.0);
+    ui.set_prop(img, spec::prop::HEIGHT, 16.0);
+    ui.tick();
+    ui.draw();
+    let levels = ui.texture_mips(tex);
+    assert_eq!(levels.len(), 6);
+    assert_eq!(&levels[0].rgba[..4], &[90, 90, 90, 255]);
+    // New bytes in place: the old levels are gone at once and the next draw
+    // reduces the new ones.
+    assert!(ui.update_texture_t8(tex, &palette([200, 10, 40, 255]), &alloc::vec![7u8; (tw * th) as usize]));
+    assert!(ui.texture_mips(tex).is_empty());
+    ui.draw();
+    let levels = ui.texture_mips(tex);
+    assert_eq!(levels.len(), 6);
+    assert!(levels.iter().all(|l| l.rgba.chunks_exact(4).all(|p| p == [200, 10, 40, 255])));
+    let fb = raster_fb(&mut ui);
+    assert_eq!(sample_rgba(&fb, 18, 18), [200, 10, 40, 255]);
+}
