+// ---- image-filter-trilinear (pocket-motion, mip.rs) ---------------------------------
+
+/// Every trilinear op's code and footprint, in draw order.
+fn mip_footprints(words: &[u32]) -> Vec<(u32, f32)> {
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < words.len() {
+        let len = crate::compositor::draw_op_len(words, i).expect("known op");
+        match words[i] {
+            spec::draw_op::TEX_QUAD_MIP | spec::draw_op::TEX_TRI_MIP => {
+                out.push((words[i], f32::from_bits(words[i + len - 1])))
+            }
+            _ => {}
+        }
+        i += len;
+    }
+    out
+}
+
+fn trilinear_image(ui: &mut Ui, tex: i32, parent: i32, x: f64, y: f64, w: f64, h: f64) -> i32 {
+    let img = ui.create_node(spec::NodeType::Image as u8);
+    ui.set_prop(img, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(img, spec::prop::INSET_L, x);
+    ui.set_prop(img, spec::prop::INSET_T, y);
+    ui.set_prop(img, spec::prop::WIDTH, w);
+    ui.set_prop(img, spec::prop::HEIGHT, h);
+    ui.set_prop(img, spec::prop::IMAGE_FILTER, spec::ImageFilter::Trilinear as u32 as f64);
+    ui.set_image(img, tex);
+    ui.insert_before(parent, img, 0);
+    img
+}
+
+fn close(a: f32, b: f32) -> bool {
+    (a - b).abs() <= b.abs() * 1e-5
+}
+
+#[test]
+fn a_trilinear_image_carries_its_footprint_under_any_affine_world() {
+    let (tw, th) = (400u32, 300u32);
+    let px = alloc::vec![200u8; (tw * th * 4) as usize];
+    // Drawn 100 x 75: four texels a logical pixel on both axes.
+    for &turn in &[0.0f64, 30.0, 90.0, 135.0, 200.0, -45.0] {
+        let mut ui = Ui::new();
+        let tex = ui.upload_texture(&px, tw, th, spec::psm::PSM_8888);
+        let img = trilinear_image(&mut ui, tex, spec::ROOT_ID, 190.0, 100.0, 100.0, 75.0);
+        if turn != 0.0 {
+            ui.set_prop(img, spec::prop::ROTATE, turn);
+        }
+        ui.tick();
+        let words = ui.draw().words.clone();
+        let counts = validate_drawlist(&words);
+        let ops = mip_footprints(&words);
+        let want_op = if turn == 0.0 { spec::draw_op::TEX_QUAD_MIP } else { spec::draw_op::TEX_TRI_MIP };
+        assert!(!ops.is_empty() && ops.iter().all(|&(op, rho)| op == want_op && close(rho, 4.0)), "rotate {turn}: {ops:?}");
+        assert_eq!(counts[spec::draw_op::TEX_QUAD as usize] + counts[spec::draw_op::TEX_TRI as usize], 0);
+        // 200x150, 100x75, 50x37, 25x18, 12x9, 6x4, 3x2, 1x1.
+        assert_eq!(ui.texture_mips(tex).len(), 8, "rotate {turn}");
+    }
+    // Squeezed on one axis, the footprint is the squeezed axis's: 400
+    // texels over 50 px.
+    let mut ui = Ui::new();
+    let tex = ui.upload_texture(&px, tw, th, spec::psm::PSM_8888);
+    let img = trilinear_image(&mut ui, tex, spec::ROOT_ID, 190.0, 100.0, 100.0, 75.0);
+    ui.set_prop(img, spec::prop::SCALE_X, 0.5);
+    ui.tick();
+    let ops = mip_footprints(&ui.draw().words.clone());
+    assert!(ops.len() == 1 && close(ops[0].1, 8.0), "{ops:?}");
+    // A sub-rect footprint is the sub-rect's texels: a quarter of the
+    // texture's width over the same 100 px.
+    ui.set_image_uv(img, 0.0, 0.0, 0.25, 1.0);
+    ui.set_prop(img, spec::prop::SCALE_X, 1.0);
+    ui.tick();
+    let ops = mip_footprints(&ui.draw().words.clone());
+    assert!(ops.len() == 1 && close(ops[0].1, 4.0), "{ops:?}");
+    // The same image without the class draws as it always did.
+    let mut ui = Ui::new();
+    let tex = ui.upload_texture(&px, tw, th, spec::psm::PSM_8888);
+    let img = trilinear_image(&mut ui, tex, spec::ROOT_ID, 190.0, 100.0, 100.0, 75.0);
+    ui.set_prop(img, spec::prop::IMAGE_FILTER, spec::ImageFilter::Texture as u32 as f64);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    assert_eq!(validate_drawlist(&words)[spec::draw_op::TEX_QUAD as usize], 1);
+    assert!(mip_footprints(&words).is_empty());
+    assert!(ui.texture_mips(tex).is_empty(), "no trilinear draw, no chain");
+}
