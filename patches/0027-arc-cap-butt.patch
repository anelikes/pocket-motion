+/// A quarter arc as wide as its 40 px radius, from 12 o'clock clockwise,
+/// centred on the screen, under a wrapper turned `rotate` degrees.
+fn quarter_pie(cap: Option<spec::ArcCap>, rotate: f64) -> alloc::vec::Vec<u8> {
+    let mut ui = Ui::new();
+    let wrap = place_box(&mut ui, 80.0, 80.0, 200.0, 96.0);
+    if rotate != 0.0 {
+        ui.set_prop(wrap, spec::prop::ROTATE, rotate);
+    }
+    let arc = ui.create_node(0);
+    ui.set_prop(arc, spec::prop::WIDTH, 80.0);
+    ui.set_prop(arc, spec::prop::HEIGHT, 80.0);
+    ui.set_prop(arc, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(arc, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.set_prop(arc, spec::prop::ARC_START, 0.0);
+    ui.set_prop(arc, spec::prop::ARC_SWEEP, 90.0);
+    ui.set_prop(arc, spec::prop::ARC_WIDTH, 40.0);
+    if let Some(cap) = cap {
+        ui.set_prop(arc, spec::prop::ARC_CAP, cap as u32 as f64);
+    }
+    ui.insert_before(wrap, arc, 0);
+    ui.tick();
+    raster_fb(&mut ui)
+}
+
+#[test]
+fn a_butt_capped_arc_as_wide_as_its_radius_is_a_pie_sector() {
+    // Round caps put a half-disc of the stroke's width on each end, so an
+    // arc as wide as its radius was a sector with two blobs on it, and a
+    // radar wedge or a pie chart had to be an image. `arc-cap-butt` ends the
+    // band on the two radii: the quarter from 12 to 3 o'clock, and nothing
+    // in the other three quadrants. Under a 90 degree parent the same
+    // quarter runs from 3 to 6.
+    let pie = core::f64::consts::PI * 40.0 * 40.0 / 4.0;
+    for &(turn, (qx, qy)) in &[(0.0f64, (1.0f64, -1.0f64)), (90.0, (1.0, 1.0))] {
+        let fb = quarter_pie(Some(spec::ArcCap::Butt), turn);
+        let (area, _, _) = ink_reading(&fb);
+        assert!((area - pie).abs() < pie * 0.015, "turn {turn}: area {area}, a quarter disc is {pie}");
+        for y in 0..spec::SCREEN_H as usize {
+            for x in 0..spec::SCREEN_W as usize {
+                // A pixel wholly in another quadrant (its centre at least a
+                // pixel from both axes, on the wrong side of either) is bare.
+                let (dx, dy) = (x as f64 + 0.5 - 240.0, y as f64 + 0.5 - 136.0);
+                let wrong = dx * qx < -1.0 || dy * qy < -1.0;
+                if wrong {
+                    assert_eq!(sample_rgba(&fb, x, y)[3], 0, "turn {turn}: ink at ({x},{y}) outside the sector");
+                }
+            }
+        }
+    }
+    // The default is still round, and `arc-cap-round` says so explicitly.
+    let (round, _, _) = ink_reading(&quarter_pie(None, 0.0));
+    let (named, _, _) = ink_reading(&quarter_pie(Some(spec::ArcCap::Round), 0.0));
+    assert!(round > pie * 1.5, "round caps add two half-discs: {round} against {pie}");
+    assert_eq!(round, named);
+}
