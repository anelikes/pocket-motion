+                    [0.349 - 0.349 * g, 0.686 + 0.314 * g, 0.168 - 0.168 * g],
+                    [0.272 - 0.272 * g, 0.534 - 0.534 * g, 0.131 + 0.869 * g],
+                ],
+                0.0,
+            )
+        }
+        "saturate" => apply(
+            [
+                [0.213 + 0.787 * a, 0.715 - 0.715 * a, 0.072 - 0.072 * a],
+                [0.213 - 0.213 * a, 0.715 + 0.285 * a, 0.072 - 0.072 * a],
+                [0.213 - 0.213 * a, 0.715 - 0.715 * a, 0.072 + 0.928 * a],
+            ],
+            0.0,
+        ),
+        "hue-rotate" => {
+            let (s, k) = a.to_radians().sin_cos();
+            apply(
+                [
+                    [0.213 + 0.787 * k - 0.213 * s, 0.715 - 0.715 * k - 0.715 * s, 0.072 - 0.072 * k + 0.928 * s],
+                    [0.213 - 0.213 * k + 0.143 * s, 0.715 + 0.285 * k + 0.140 * s, 0.072 - 0.072 * k - 0.283 * s],
+                    [0.213 - 0.213 * k - 0.787 * s, 0.715 - 0.715 * k + 0.715 * s, 0.072 + 0.928 * k + 0.072 * s],
+                ],
+                0.0,
+            )
+        }
+        _ => unreachable!("{name}"),
+    }
+}
+
+/// The prop each CSS function name sets.
+fn color_filter_prop(name: &str) -> u8 {
+    match name {
+        "brightness" => spec::prop::BRIGHTNESS,
+        "contrast" => spec::prop::CONTRAST,
+        "grayscale" => spec::prop::GRAYSCALE,
+        "hue-rotate" => spec::prop::HUE_ROTATE,
+        "invert" => spec::prop::INVERT,
+        "saturate" => spec::prop::SATURATE,
+        "sepia" => spec::prop::SEPIA,
+        _ => unreachable!("{name}"),
+    }
+}
+
+/// `filters` applied to an 8-bit colour by the reference, in the order
+/// given: 0..255, unrounded.
+fn css_color_filters(filters: &[(&str, f64)], rgb: [u8; 3]) -> [f64; 3] {
+    let mut c = rgb.map(|v| v as f64 / 255.0);
+    for &(name, a) in filters {
+        c = css_color_filter(name, a, c);
+    }
+    c.map(|v| v * 255.0)
+}
+
+/// How far the rasteriser may land from the exact CSS value, in levels:
+/// half a level for its own rounding, and a twentieth for the 1/16384
+/// coefficients and the 1/257-level steps between filters. Measured worst
+/// over the two tests below (2026-11-05): 0.504 for one filter, 0.505 for a
+/// chain.
+const CSS_LEVEL_TOLERANCE: f64 = 0.55;
+
+/// An opaque box of `rgb` on an opaque ground with `filters` set on it: the
+/// box's pixel.
+fn color_filtered(filters: &[(&str, f64)], rgb: [u8; 3]) -> [u8; 4] {
+    let fx: Vec<(u8, f64)> = filters.iter().map(|&(n, a)| (color_filter_prop(n), a)).collect();
+    let (mut ui, _, words) = filtered_box(abgr(17, 34, 51, 255), abgr(rgb[0], rgb[1], rgb[2], 255), &fx);
+    assert_eq!(validate_drawlist(&words)[spec::draw_op::LAYER_PUSH as usize], 1);
+    let fb = raster_fb(&mut ui);
+    assert_eq!(sample_rgba(&fb, 10, 10), [17, 34, 51, 255], "the ground is not filtered");
+    sample_rgba(&fb, 100, 100)
+}
+
+const FILTER_COLOURS: [[u8; 3]; 7] =
+    [[200, 100, 50], [255, 0, 0], [0, 255, 0], [10, 200, 90], [255, 255, 255], [0, 0, 0], [128, 128, 128]];
+
+#[test]
+fn each_colour_filter_is_its_css_matrix_to_a_level() {
+    let cases: &[(&str, &[f64])] = &[
+        ("brightness", &[0.0, 0.5, 1.5, 3.0]),
+        ("contrast", &[0.0, 0.5, 2.0, 40.0]),
+        ("grayscale", &[0.25, 0.5, 1.0]),
+        ("hue-rotate", &[30.0, 90.0, 180.0, 270.0, 333.3]),
+        ("invert", &[0.25, 0.5, 1.0]),
+        ("saturate", &[0.0, 0.5, 2.0, 5.0]),
+        ("sepia", &[0.25, 0.75, 1.0]),
+    ];
+    for &(name, amounts) in cases {
+        for &a in amounts {
+            for rgb in FILTER_COLOURS {
+                let got = color_filtered(&[(name, a)], rgb);
+                let want = css_color_filters(&[(name, a)], rgb);
+                assert_eq!(got[3], 255, "{name}({a}) leaves alpha");
+                for ch in 0..3 {
+                    let d = (got[ch] as f64 - want[ch]).abs();
+                    assert!(d <= CSS_LEVEL_TOLERANCE, "{name}({a}) of {rgb:?}: {got:?}, CSS {want:?}");
+                }
+            }
+        }
+    }
+    // Known values a reader can check by hand: grayscale(1) of red is its
+    // luminance, 0.2126 * 255; hue-rotate(180deg) of red is a dark cyan.
+    assert_eq!(color_filtered(&[("grayscale", 1.0)], [255, 0, 0]), [54, 54, 54, 255]);
+    assert_eq!(color_filtered(&[("hue-rotate", 180.0)], [255, 0, 0]), [0, 109, 109, 255]);
+    assert_eq!(color_filtered(&[("invert", 1.0)], [10, 200, 90]), [245, 55, 165, 255]);
+}
+
+#[test]
+fn colour_filters_apply_in_tailwinds_order_each_clamped() {
+    // brightness(2) then contrast(0.5) on grey 200: 400 clamps to 255, then
+    // 0.5 * 255 + 63.75 = 191. One matrix with no clamp between would give
+    // 0.5 * 400 + 63.75, white.
+    assert_eq!(color_filtered(&[("brightness", 2.0), ("contrast", 0.5)], [200, 200, 200]), [191, 191, 191, 255]);
+    // Brightness before sepia, whatever order the props were set in: white
+    // halved then sepia is (172, 153, 119); sepia first would be (128, 128, 119).
+    let order = ["brightness", "contrast", "grayscale", "hue-rotate", "invert", "saturate", "sepia"];
+    let want = |set: &[(&'static str, f64)]| -> Vec<(&'static str, f64)> {
+        let mut sorted = set.to_vec();
+        sorted.sort_by_key(|(n, _)| order.iter().position(|o| o == n).unwrap());
+        sorted
+    };
+    for set in [
+        &[("sepia", 1.0), ("brightness", 0.5)][..],
+        &[("invert", 0.8), ("hue-rotate", 120.0), ("saturate", 3.0)][..],
+        &[("sepia", 0.6), ("grayscale", 0.4), ("contrast", 1.8), ("brightness", 1.3)][..],
+        &[("saturate", 0.2), ("invert", 1.0), ("hue-rotate", 45.0), ("grayscale", 0.3), ("contrast", 0.7), ("brightness", 0.9), ("sepia", 0.5)][..],
+    ] {
+        for rgb in FILTER_COLOURS {
+            let got = color_filtered(set, rgb);
+            let canon = css_color_filters(&want(set), rgb);
+            for ch in 0..3 {
+                let d = (got[ch] as f64 - canon[ch]).abs();
+                assert!(d <= CSS_LEVEL_TOLERANCE, "{set:?} of {rgb:?}: {got:?}, in order {canon:?}");
+            }
+        }
+    }
+    assert_eq!(color_filtered(&[("sepia", 1.0), ("brightness", 0.5)], [255, 255, 255]), [172, 153, 119, 255]);
+}
