+#[test]
+fn a_colour_filter_leaves_alpha_and_the_shadow_alone() {
+    // Red at half alpha inverted is cyan at half alpha: the same pixels as
+    // a cyan box drawn so, shadow included — the shadow is made from alpha,
+    // and keeps its own colour.
+    let white = abgr(255, 255, 255, 255);
+    let shadow = [
+        (spec::prop::DROP_SHADOW_X, 12.0),
+        (spec::prop::DROP_SHADOW_Y, 9.0),
+        (spec::prop::DROP_SHADOW_BLUR, 6.0),
+        (spec::prop::DROP_SHADOW_COLOR, abgr(0, 160, 0, 255) as f64),
+    ];
+    let mut fx = shadow.to_vec();
+    fx.push((spec::prop::INVERT, 1.0));
+    let (mut inverted, _, _) = filtered_box(white, abgr(255, 0, 0, 128), &fx);
+    let (mut cyan, _, _) = filtered_box(white, abgr(0, 255, 255, 128), &shadow);
+    let (a, b) = (raster_fb(&mut inverted), raster_fb(&mut cyan));
+    assert!(a == b, "inverting the content touched its alpha or its shadow");
+    assert_ne!(sample_rgba(&a, 126, 123), [255, 255, 255, 255], "the shadow is there to be compared");
+}
