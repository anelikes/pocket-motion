+#[test]
+fn a_colour_filter_at_identity_is_no_layer_and_a_whole_turn_is_identity() {
+    let ground = abgr(0, 0, 0, 255);
+    let white = abgr(255, 255, 255, 255);
+    let (mut plain, _, words) = filtered_box(ground, white, &[]);
+    for fx in [
+        &[(spec::prop::BRIGHTNESS, 1.0), (spec::prop::CONTRAST, 1.0), (spec::prop::SATURATE, 1.0)][..],
+        &[(spec::prop::GRAYSCALE, 0.0), (spec::prop::INVERT, 0.0), (spec::prop::SEPIA, 0.0)][..],
+        &[(spec::prop::HUE_ROTATE, 360.0)][..],
+        &[(spec::prop::HUE_ROTATE, -720.0)][..],
+        &[(spec::prop::GRAYSCALE, -0.5)][..],
+    ] {
+        let (mut ui, _, w) = filtered_box(ground, white, fx);
+        assert_eq!(w, words, "{fx:?} draws as no filter at all");
+        assert_eq!(raster_fb(&mut ui), raster_fb(&mut plain));
+    }
+    // -90 degrees is 270, to the word.
+    let (_, _, a) = filtered_box(ground, white, &[(spec::prop::HUE_ROTATE, -90.0)]);
+    let (_, _, b) = filtered_box(ground, white, &[(spec::prop::HUE_ROTATE, 270.0)]);
+    assert_eq!(a, b);
+    // A layer with no colour filter is the eight words it was.
+    let (_, _, blurred) = filtered_box(ground, white, &[(spec::prop::BLUR, 3.0)]);
+    let push = blurred.iter().position(|&w| w == spec::draw_op::LAYER_PUSH).unwrap();
+    assert_eq!(blurred[push + 1] >> 24, 0);
+    assert_eq!(blurred[push + 8], spec::draw_op::RECT, "the layer's content follows its eighth word");
+}
