+#[test]
+fn a_colour_filter_reaches_everything_the_blur_spread() {
+    // A red box blurred and greyed over a grey ground: every pixel of the
+    // frame is grey, the blurred fringe outside the box's own rows and
+    // columns included.
+    let grey = abgr(128, 128, 128, 255);
+    let (mut ui, _, _) = filtered_box(grey, abgr(255, 0, 0, 255), &[(spec::prop::BLUR, 6.0), (spec::prop::GRAYSCALE, 1.0)]);
+    let fb = raster_fb(&mut ui);
+    for y in 0..200 {
+        for x in 0..200 {
+            let [r, g, b, _] = sample_rgba(&fb, x, y);
+            assert!(r == g && g == b, "({x},{y}) is ({r},{g},{b})");
+        }
+    }
+    assert!(sample_rgba(&fb, 100, 100)[0] < 70, "the box is the grey of red");
+    assert!(sample_rgba(&fb, 75, 100)[0] < 128, "and its fringe is darker than the ground");
+}
