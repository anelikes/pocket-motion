+#[test]
+fn every_draw_list_walker_steps_over_a_colour_filtered_layer() {
+    use crate::damage::{DamagePolicy, DamageTracker, DEFAULT_DAMAGE_REGIONS};
+    use crate::raster::{render_scaled, render_scaled_incremental};
+    // A colour-filtered box, then a sibling that moves and a compositor
+    // surface. Each walker must land on the ops after the layer's amounts,
+    // not inside them.
+    let mut ui = Ui::new();
+    let g = ui.create_node(0);
+    ui.set_prop(g, spec::prop::WIDTH, 400.0);
+    ui.set_prop(g, spec::prop::HEIGHT, 200.0);
+    ui.set_prop(g, spec::prop::BG_COLOR, abgr(0, 0, 0, 255) as f64);
+    ui.insert_before(spec::ROOT_ID, g, 0);
+    let b = ui.create_node(0);
+    ui.set_prop(b, spec::prop::WIDTH, 60.0);
+    ui.set_prop(b, spec::prop::HEIGHT, 60.0);
+    ui.set_prop(b, spec::prop::BG_COLOR, abgr(200, 120, 40, 255) as f64);
+    ui.set_prop(b, spec::prop::BRIGHTNESS, 0.5);
+    ui.set_prop(b, spec::prop::HUE_ROTATE, 90.0);
+    ui.set_prop(b, spec::prop::SEPIA, 0.5);
+    ui.insert_before(g, b, 0);
+    let s = ui.create_node(0);
+    ui.set_prop(s, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(s, spec::prop::INSET_L, 200.0);
+    ui.set_prop(s, spec::prop::INSET_T, 20.0);
+    ui.set_prop(s, spec::prop::WIDTH, 30.0);
+    ui.set_prop(s, spec::prop::HEIGHT, 30.0);
+    ui.set_prop(s, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.insert_before(g, s, 1);
+    let surface = ui.create_node(spec::NodeType::Surface as u8);
+    for (p, v) in [
+        (spec::prop::WIDTH, 40.0),
+        (spec::prop::HEIGHT, 30.0),
+        (spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64),
+        (spec::prop::INSET_L, 120.0),
+        (spec::prop::INSET_T, 120.0),
+    ] {
+        ui.set_prop(surface, p, v);
+    }
+    ui.set_compositor_surface(surface, 3, false);
+    ui.insert_before(spec::ROOT_ID, surface, 0);
+    ui.tick();
+    let first = ui.draw().words.clone();
+    validate_drawlist(&first);
+    let push = first.iter().position(|&w| w == spec::draw_op::LAYER_PUSH).unwrap();
+    assert_eq!((first[push + 1] >> 24) & 0x7f, 0b100_1001, "brightness, hue-rotate and sepia");
+    assert!(push < first.iter().position(|&w| w == spec::draw_op::SURFACE_QUAD).expect("a surface op"));
+    // The surface after the layer is found, and a composite with no surface
+    // raster draws what the plain render draws.
+    let frames = ui.compositor_surface_frames();
+    assert_eq!(frames.len(), 1, "the surface after the layer is found");
+    let (vw, vh) = ui.viewport();
+    let mut plain = alloc::vec![0u8; vw as usize * vh as usize * 4];
+    crate::raster::render(&ui, &first, &mut plain);
+    let mut composed = alloc::vec![0u8; vw as usize * vh as usize * 4];
+    crate::compositor::render(&ui, &first, &mut composed, 1, &[]);
+    assert!(plain == composed, "the composite draws what the plain render draws");
+    // The compositor's op lengths walk the list to its end.
+    let mut at = 0;
+    while at < first.len() {
+        let n = crate::compositor::draw_op_len(&first, at).expect("a known op");
+        if at == push {
+            assert_eq!(n, 11);
+        }
+        at += n;
+    }
+    assert_eq!(at, first.len());
+    // The damage decoder bounds the sibling's move rather than giving up.
+    ui.set_prop(s, spec::prop::INSET_L, 260.0);
+    ui.tick();
+    let second = ui.draw().words.clone();
+    let pixels = spec::SCREEN_W as usize * spec::SCREEN_H as usize;
+    let mut fb = alloc::vec![0u8; pixels * 4];
+    let mut state = DamageTracker::<DEFAULT_DAMAGE_REGIONS>::new();
+    render_scaled_incremental(&ui, &first, &mut fb, 1, &mut state, DamagePolicy::default()).unwrap();
+    let plan = render_scaled_incremental(&ui, &second, &mut fb, 1, &mut state, DamagePolicy::default()).unwrap();
+    assert!(!plan.is_full_redraw(), "a move outside the layer has a sound partial bound");
+    let mut full = alloc::vec![0u8; pixels * 4];
+    render_scaled(&ui, &second, &mut full, 1);
+    assert!(fb == full);
+    // A changed amount is a change to the layer: a full redraw, equal to the
+    // full render.
+    ui.set_prop(b, spec::prop::HUE_ROTATE, 200.0);
+    ui.tick();
+    let third = ui.draw().words.clone();
+    let plan = render_scaled_incremental(&ui, &third, &mut fb, 1, &mut state, DamagePolicy::default()).unwrap();
+    assert!(plan.is_full_redraw());
+    render_scaled(&ui, &third, &mut full, 1);
+    assert!(fb == full);
+}
