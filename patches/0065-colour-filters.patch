+#[test]
+fn a_colour_filter_applies_to_the_blurred_picture() {
+    // A box half black, half white, blurred and then given a steep contrast:
+    // CSS's `blur() contrast()` thresholds the blurred edge back to a step
+    // a few pixels wide. Before the blur the contrast would change nothing
+    // (black and white are already its extremes) and the edge would stay a
+    // 6 px gaussian ramp.
+    let mut ui = Ui::new();
+    let g = ui.create_node(0);
+    ui.set_prop(g, spec::prop::WIDTH, 300.0);
+    ui.set_prop(g, spec::prop::HEIGHT, 200.0);
+    ui.set_prop(g, spec::prop::BG_COLOR, abgr(0, 0, 0, 255) as f64);
+    ui.insert_before(spec::ROOT_ID, g, 0);
+    let b = ui.create_node(0);
+    ui.set_prop(b, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(b, spec::prop::INSET_L, 60.0);
+    ui.set_prop(b, spec::prop::INSET_T, 60.0);
+    ui.set_prop(b, spec::prop::FLEX_DIR, spec::FlexDir::Row as u32 as f64);
+    ui.set_prop(b, spec::prop::BLUR, 6.0);
+    ui.set_prop(b, spec::prop::CONTRAST, 8.0);
+    ui.insert_before(g, b, 0);
+    for (k, c) in [(0, abgr(0, 0, 0, 255)), (1, abgr(255, 255, 255, 255))] {
+        let half = ui.create_node(0);
+        ui.set_prop(half, spec::prop::WIDTH, 90.0);
+        ui.set_prop(half, spec::prop::HEIGHT, 80.0);
+        ui.set_prop(half, spec::prop::BG_COLOR, c as f64);
+        ui.insert_before(b, half, k);
+    }
+    ui.tick();
+    let fb = raster_fb(&mut ui);
+    // The halves meet at x = 150; the blurred ramp is grey at 145 and 155.
+    assert_eq!(sample_rgba(&fb, 145, 100), [0, 0, 0, 255], "5 px into the black half is black again");
+    assert_eq!(sample_rgba(&fb, 155, 100), [255, 255, 255, 255], "5 px into the white half is white again");
+}
