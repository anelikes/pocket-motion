+/// What a colour filter's layer costs against drawing the colours it would
+/// produce directly — which is what applying the filter at draw time would
+/// emit. Not a guard: run it with
+/// `cargo test --release --lib colour_filter_layer_cost -- --ignored --nocapture`.
+/// Numbers and the decision they support: pocket-motion
+/// `baselines/colour-filters.md`.
+#[test]
+#[ignore]
+fn colour_filter_layer_cost() {
+    use std::time::Instant;
+    // `n` boxes of w x h on a 1920x1080 ground (a gradient when full-frame),
+    // hue-rotated and saturated through a layer, or given the colour that
+    // filter makes and drawn directly. Minimum of 40 renders.
+    let scene = |n: usize, w: f64, h: f64, layered: bool| {
+        let mut ui = Ui::new();
+        ui.set_viewport(1920.0, 1080.0);
+        let g = ui.create_node(0);
+        ui.set_prop(g, spec::prop::WIDTH, 1920.0);
+        ui.set_prop(g, spec::prop::HEIGHT, 1080.0);
+        ui.set_prop(g, spec::prop::BG_COLOR, abgr(20, 24, 40, 255) as f64);
+        ui.insert_before(spec::ROOT_ID, g, 0);
+        for k in 0..n {
+            let b = ui.create_node(0);
+            ui.set_prop(b, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+            ui.set_prop(b, spec::prop::INSET_L, (40 + (k % 10) * 185) as f64);
+            ui.set_prop(b, spec::prop::INSET_T, ((40 + (k / 10) * 100) % 1000) as f64);
+            ui.set_prop(b, spec::prop::WIDTH, w);
+            ui.set_prop(b, spec::prop::HEIGHT, h);
+            ui.set_prop(b, spec::prop::RADIUS, 8.0);
+            if w > 1000.0 {
+                ui.set_prop(b, spec::prop::GRAD_KIND, spec::GradKind::Linear as u32 as f64);
+                ui.set_prop(b, spec::prop::GRAD_ANGLE, 63.0);
+                ui.set_prop(b, spec::prop::GRAD_FROM, abgr(255, 0, 40, 255) as f64);
+                ui.set_prop(b, spec::prop::GRAD_TO, abgr(0, 90, 255, 255) as f64);
+            }
+            if layered {
+                ui.set_prop(b, spec::prop::BG_COLOR, abgr(220, 120, 40, 255) as f64);
+                ui.set_prop(b, spec::prop::HUE_ROTATE, 90.0);
+                ui.set_prop(b, spec::prop::SATURATE, 1.5);
+            } else {
+                ui.set_prop(b, spec::prop::BG_COLOR, abgr(120, 200, 40, 255) as f64);
+            }
+            ui.insert_before(g, b, 0);
+        }
+        ui.tick();
+        let words = ui.draw().words.clone();
+        let mut fb = alloc::vec![0u8; 1920 * 1080 * 4];
+        let mut best = f64::MAX;
+        for _ in 0..40 {
+            let t = Instant::now();
+            crate::raster::render(&ui, &words, &mut fb);
+            best = best.min(t.elapsed().as_secs_f64() * 1000.0);
+        }
+        best
+    };
+    for (n, w, h) in [(1, 160.0, 64.0), (40, 160.0, 64.0), (100, 160.0, 64.0), (1, 1920.0, 1080.0)] {
+        let (d, l) = (scene(n, w, h, false), scene(n, w, h, true));
+        std::eprintln!("{n} x {w}x{h}: direct {d:.2} ms, layered {l:.2} ms, {:.3} ms a layer", (l - d) / n as f64);
+    }
+}
