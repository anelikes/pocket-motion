+fn dash_of(lens: &[f32], offset: f32) -> Dash {
+    let mut d = Dash { count: lens.len() as u8, lens: [0.0; DASH_MAX], offset };
+    d.lens[..lens.len()].copy_from_slice(lens);
+    d
+}
+
+fn dash_words(e: &PathEntry, trim: Trim, dash: Dash, cap: Cap) -> Vec<u32> {
+    let mut p = paint_stroke(!0, 4.0, Join::Round, cap);
+    p.trim = trim;
+    p.dash = dash;
+    let mut w = Vec::new();
+    emit(&mut w, e, &Affine::IDENTITY, &p, (100.0, 100.0), &mut PathStats::default());
+    w
+}
+
+/// `e` flattened at the scenes' tolerance, trimmed and dashed.
+fn dashed(e: &PathEntry, t: Trim, d: Dash) -> Flat {
+    let mut pts = Vec::new();
+    e.points_at(0.0, &mut pts);
+    let mut flat = Flat::default();
+    flatten(&e.verbs, &pts, FLATTEN_TOL, &mut flat);
+    let mut out = Flat::default();
+    dash(&flat, &t, &d, &mut out, &mut Vec::new(), &mut DashScratch::default());
+    out
+}
+
+/// SVG's dashes on [0, len] of an open line, walked entry by entry in f64
+/// from the pattern position the offset names: a different computation
+/// from the core's (which takes each period's start from its index).
+fn reference_dashes(lens: &[f64], offset: f64, len: f64) -> Vec<(f64, f64)> {
+    let mut pat: Vec<f64> = lens.to_vec();
+    if pat.len() % 2 == 1 {
+        pat.extend_from_slice(lens);
+    }
+    let period: f64 = pat.iter().sum();
+    let mut s = -offset.rem_euclid(period);
+    let mut out: Vec<(f64, f64)> = Vec::new();
+    let mut i = 0;
+    let mut joins = false;
+    while s <= len {
+        let (l, gap) = (pat[i % pat.len()], pat[(i + 1) % pat.len()]);
+        let (a, b) = (s.max(0.0), (s + l).min(len));
+        if joins {
+            let last = out.last_mut().unwrap();
+            last.1 = last.1.max(b);
+            joins = gap == 0.0;
+        } else {
+            let pushed = if l == 0.0 { s >= 0.0 } else { b > a };
+            if pushed {
+                out.push(if l == 0.0 { (s, s) } else { (a, b) });
+            }
+            joins = pushed && gap == 0.0;
+        }
+        s += l + gap;
+        i += 2;
+    }
+    out
+}
+
+fn line_entry(len: f32) -> PathEntry {
+    let mut s = Shape::default();
+    s.m(0.0, 50.0).l(len, 50.0);
+    s.entry()
