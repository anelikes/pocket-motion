+/// Most lengths a dash pattern carries (spec `PATH_DASH_MAX`).
+pub const DASH_MAX: usize = 4;
+
+/// Most dashes one stroke draws in a frame, counting every dash the
+/// pattern places whether or not the trim keeps it. A pattern far finer
+/// than its outline is long stops there rather than costing the frame
+/// without bound; the rest of the stroke is not drawn.
+pub const DASH_MAX_PIECES: usize = 1 << 16;
