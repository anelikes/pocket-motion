+        sc.spans.clear();
+        match iv {
+            None => sc.spans.push((0.0, total)),
+            Some(iv) if each => {
+                if iv[1].1 > 0.0 {
+                    sc.spans.push((0.0, iv[1].1 * total));
+                    sc.spans.push((iv[0].0 * total, total));
+                } else {
+                    sc.spans.push((iv[0].0 * total, iv[0].1 * total));
+                }
+            }
