+#[test]
+fn dashes_lie_where_the_pattern_puts_them() {
+    // An open line along x, so arc length is x: every piece and every dot
+    // is a dash of SVG's pattern, against `reference_dashes`. Odd counts
+    // repeat, offsets of either sign and past a period, dots, a zero gap.
+    // Red if the phase runs the wrong way, an odd count is not repeated,
+    // the first or last dash is not clipped, or a zero-length dash is lost.
+    let len = 97.0f32;
+    let e = line_entry(len);
+    let cases: &[(&[f32], f32)] = &[
+        (&[10.0, 5.0], 0.0),
+        (&[10.0, 5.0], 3.0),
+        (&[10.0, 5.0], -4.0),
+        (&[10.0, 5.0], 47.0),
+        (&[6.0], 0.0),
+        (&[6.0], 2.5),
+        (&[3.0, 1.0, 2.0], 1.5),
+        (&[0.0, 8.0], 0.0),
+        (&[0.0, 8.0], 2.0),
+        (&[4.0, 0.0, 2.0, 3.0], 5.0),
+        (&[1.5, 2.25, 0.0, 2.25], -7.0),
+    ];
+    for &(lens, off) in cases {
+        let out = dashed(&e, Trim::NONE, dash_of(lens, off));
+        let mut got: Vec<(f64, f64)> = out.subs.iter().map(|s| (out.pts[s.start].x as f64, out.pts[s.end - 1].x as f64)).collect();
+        got.extend(out.dots.iter().map(|(p, _)| (p.x as f64, p.x as f64)));
+        got.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let want = reference_dashes(&lens.iter().map(|&v| v as f64).collect::<Vec<_>>(), off as f64, len as f64);
+        assert_eq!(got.len(), want.len(), "{lens:?} + {off}: {got:?} against {want:?}");
+        for (g, w) in got.iter().zip(&want) {
+            assert!((g.0 - w.0).abs() < 1e-3 && (g.1 - w.1).abs() < 1e-3, "{lens:?} + {off}: {g:?} against {w:?}");
+        }
+        for (p, d) in &out.dots {
+            assert!(p.y == 50.0 && (d.x - 1.0).abs() < 1e-6 && d.y == 0.0, "a dot sits on the line, facing along it: {p:?} {d:?}");
+        }
+    }
