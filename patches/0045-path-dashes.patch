+#[test]
+fn a_solid_pattern_is_the_trim_byte_for_byte() {
+    // No lengths, a zero period, a negative or non-finite length, more than
+    // DASH_MAX: a solid stroke, through trim's own code. And a pattern with
+    // no gap is one dash the length of each subpath: the solid stroke again.
+    // Red if any of them takes the dash path, or a zero gap leaves a seam.
+    let e = spiral_entry();
+    let trims = [
+        Trim::NONE,
+        Trim { start: 0.1, end: 0.7, offset: 0.3, mode: TrimMode::Each },
+        Trim { start: 0.2, end: 0.9, offset: 0.6, mode: TrimMode::Whole },
+    ];
+    for t in trims {
+        let solid = stroke_words(&e, t, Cap::Round);
+        let invalid = [
+            Dash::NONE,
+            dash_of(&[0.0, 0.0], 3.0),
+            dash_of(&[3.0, -1.0], 0.0),
+            dash_of(&[f32::NAN, 2.0], 0.0),
+            dash_of(&[f32::INFINITY, 2.0], 0.0),
+            Dash { count: 5, lens: [2.0; DASH_MAX], offset: 0.0 },
+        ];
+        for d in invalid {
+            assert_eq!(dash_words(&e, t, d, Cap::Round), solid, "{d:?} under {t:?} is solid");
+        }
+    }
+    let solid = stroke_words(&e, Trim::NONE, Cap::Round);
+    for d in [dash_of(&[7.0, 0.0], 0.0), dash_of(&[7.0, 0.0], 3.5), dash_of(&[2.0, 0.0, 3.0, 0.0], 1.0)] {
+        assert_eq!(dash_words(&e, Trim::NONE, d, Cap::Round), solid, "{d:?}: no gap is the solid stroke");
