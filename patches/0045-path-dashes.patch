+/// A dash pattern, SVG's `stroke-dasharray` and `stroke-dashoffset`, in
+/// the path's own units (arc length on the flattened local outline).
+#[derive(Clone, Copy, Debug)]
+pub struct Dash {
+    /// How many of `lens` the pattern has; 0 is a solid stroke.
+    pub count: u8,
+    /// Dash, gap, dash, gap ...
+    pub lens: [f32; DASH_MAX],
+    /// The distance into the pattern at each subpath's start.
+    pub offset: f32,
+}
+
+impl Dash {
+    pub const NONE: Dash = Dash { count: 0, lens: [0.0; DASH_MAX], offset: 0.0 };
+
+    /// The pattern as SVG reads it — an odd count repeated once, so dashes
+    /// and gaps alternate — with its entry count and period. None for a
+    /// solid stroke: no lengths, a negative or non-finite one, or a period
+    /// that is not above zero.
+    fn pattern(&self) -> Option<([f32; 2 * DASH_MAX], usize, f32)> {
+        let n = self.count as usize;
+        if n == 0 || n > DASH_MAX {
+            return None;
+        }
+        let m = if n % 2 == 1 { 2 * n } else { n };
+        let mut e = [0.0f32; 2 * DASH_MAX];
+        let mut period = 0.0f32;
+        for (i, slot) in e.iter_mut().enumerate().take(m) {
+            let v = self.lens[i % n];
+            if !(v >= 0.0) || !v.is_finite() {
+                return None;
+            }
+            *slot = v;
+            period += v;
+        }
+        if !(period > 0.0) || !period.is_finite() {
+            return None;
+        }
+        Some((e, m, period))
+    }
+}
+
+/// The dashes of a subpath of length `total`, in order: positive ones as
+/// (a, b) with a < b, zero-length ones as (a, a), from the last to start
+/// before 0 to the last to start at or before `total` (before it on a
+/// closed subpath, whose end is its start). They are not clipped: `dash`
+/// keeps only what lies in the trim spans, which lie in [0, total]. The
+/// dashes of period k start at `k * period + c - phase`, computed from k
+/// rather than accumulated, so a long outline's dashes do not drift. A dash
+/// after a zero-length gap continues the one before it, so a pattern with
+/// no gap is one dash the length of the subpath.
+#[allow(clippy::too_many_arguments)]
+fn dash_spans(pat: &[f32; 2 * DASH_MAX], m: usize, period: f32, offset: f32, total: f32, closed: bool, budget: &mut usize, out: &mut Vec<(f32, f32)>) {
+    out.clear();
+    let phase = if offset.is_finite() { offset - crate::layout::floorf(offset / period) * period } else { 0.0 };
+    let phase = if phase >= 0.0 && phase < period { phase } else { 0.0 };
+    // The gap before this dash is zero.
+    let mut joins = false;
+    let mut k = 0u32;
+    loop {
+        let base = k as f32 * period - phase;
+        if base > total {
+            return;
+        }
+        // `m` is even: entry i is a dash and i + 1 the gap after it.
+        let mut c = 0.0f32;
+        let mut i = 0usize;
+        while i < m {
+            let (len, gap, a) = (pat[i], pat[i + 1], base + c);
+            c += len;
+            c += gap;
+            i += 2;
+            if *budget == 0 {
+                return;
+            }
+            *budget -= 1;
+            if a > total || (closed && a >= total) {
+                return;
+            }
+            let b = a + len;
+            if joins {
+                if let Some(last) = out.last_mut() {
+                    if b > last.1 {
+                        last.1 = b;
+                    }
+                    joins = gap == 0.0;
+                    continue;
+                }
+            }
+            out.push((a, b));
+            joins = gap == 0.0;
+        }
+        k += 1;
+    }
