+/// hides dashes without moving them. On a closed subpath a dash that is on
+/// at both its end and its start is one piece through the start point, as
+/// trim's wrapped window is, and a pattern with no gap on it leaves it
+/// closed. A solid pattern is `trim` itself, byte for byte.
+pub fn dash(flat: &Flat, t: &Trim, d: &Dash, out: &mut Flat, cum: &mut Vec<f32>, sc: &mut DashScratch) {
+    let Some((pat, m, period)) = d.pattern() else {
+        trim(flat, t, out, cum);
+        return;
+    };
+    out.clear();
