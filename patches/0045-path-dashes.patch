+/// The unit direction of the sub's outline at segment `j` (from vertex j
+/// to j + 1), or the nearest segment with a length; +x if none has one.
+fn direction_at(pts: &[Pt], sub: Sub, cum: &[f32], j: usize) -> Pt {
+    let segs = cum.len() - 1;
+    let pick = |j: usize| {
+        let (a, b) = (ring(pts, sub, j), ring(pts, sub, j + 1));
+        let l = dist(a, b);
+        if l > 0.0 {
+            Some(pt((b.x - a.x) / l, (b.y - a.y) / l))
+        } else {
+            None
+        }
+    };
+    for k in j..segs {
+        if let Some(d) = pick(k) {
+            return d;
+        }
+    }
+    for k in (0..j.min(segs)).rev() {
+        if let Some(d) = pick(k) {
+            return d;
+        }
+    }
+    pt(1.0, 0.0)
+}
