+/// One text node "A" at (40, 40) over a white ground, with the given stroke.
+fn stroked_block(fill: u32, stroke_width: f32, stroke_color: u32, pos: spec::StrokePos) -> (Ui, Vec<u32>) {
+    stroked_ink(fill, stroke_width, stroke_color, pos, (10, 30))
+}
+
+fn stroked_ink(
+    fill: u32,
+    stroke_width: f32,
+    stroke_color: u32,
+    pos: spec::StrokePos,
+    ink: (usize, usize),
+) -> (Ui, Vec<u32>) {
+    let mut ui = Ui::new();
+    assert!(ui.load_font_atlas(&block_atlas(0, 40, ink.0, ink.1)));
+    let ground = ui.create_node(0);
+    ui.set_prop(ground, spec::prop::WIDTH, 200.0);
+    ui.set_prop(ground, spec::prop::HEIGHT, 200.0);
+    ui.set_prop(ground, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.insert_before(spec::ROOT_ID, ground, 0);
+    let t = ui.create_node(spec::NodeType::Text as u8);
+    ui.set_prop(t, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(t, spec::prop::INSET_L, 40.0);
+    ui.set_prop(t, spec::prop::INSET_T, 40.0);
+    ui.set_prop(t, spec::prop::TEXT_COLOR, fill as f64);
+    ui.set_prop(t, spec::prop::TEXT_STROKE_WIDTH, stroke_width as f64);
+    ui.set_prop(t, spec::prop::TEXT_STROKE_COLOR, stroke_color as f64);
+    ui.set_prop(t, spec::prop::TEXT_STROKE_POS, pos as u32 as f64);
+    ui.set_text(t, "A");
+    ui.insert_before(ground, t, 0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    validate_drawlist(&words);
+    (ui, words)
+}
