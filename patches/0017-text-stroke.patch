+    assert_eq!(sample_rgba(&fb, 48, 60), [255, 0, 0, 255], "1.5 px outside the edge is on the ring");
+    assert_eq!(sample_rgba(&fb, 51, 60), [255, 0, 0, 255], "1.5 px inside the edge is on the ring");
+    assert_eq!(sample_rgba(&fb, 60, 60), [255, 255, 255, 255], "the middle stays hollow");
+    assert_eq!(sample_rgba(&fb, 45, 60), [255, 255, 255, 255], "past the outer half is ground");
+
+    let fill = abgr(0, 0, 255, 255);
+    let (_, words) = stroked_block(fill, 4.0, stroke, spec::StrokePos::Center);
+    let s = words.iter().position(|&w| w == spec::draw_op::GLYPH_STROKE).unwrap();
+    let g = words.iter().position(|&w| w == spec::draw_op::GLYPH_RUN).unwrap();
+    assert!(g < s, "a center stroke is emitted after (over) the fill");
