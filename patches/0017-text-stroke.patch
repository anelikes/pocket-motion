+fn text_stroke_outside_without_a_fill_is_the_outer_ring() {
+    let stroke = abgr(255, 0, 0, 255);
+    let (mut ui, words) = stroked_block(0, 3.0, stroke, spec::StrokePos::Outside);
+    let s = words.iter().position(|&w| w == spec::draw_op::GLYPH_STROKE).unwrap();
+    assert_eq!(words[s + 4], 2, "outside with no fill is the ring form");
+    let fb = raster_fb(&mut ui);
+    assert_eq!(sample_rgba(&fb, 60, 60), [255, 255, 255, 255], "the glyph's own ink is not stroked");
+    assert_eq!(sample_rgba(&fb, 48, 60), [255, 0, 0, 255], "the outside band is");
+}
+
+/// The ops a text node "A" emits under `scale`, with and without a stroke.
+fn scaled_text_ops(stroke_width: f32, scale: f32) -> Vec<u32> {
+    let mut ui = Ui::new();
+    assert!(ui.load_font_atlas(&block_atlas(0, 40, 10, 30)));
+    let t = ui.create_node(spec::NodeType::Text as u8);
+    ui.set_prop(t, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(t, spec::prop::INSET_L, 40.0);
+    ui.set_prop(t, spec::prop::INSET_T, 40.0);
+    ui.set_prop(t, spec::prop::TEXT_COLOR, abgr(0, 0, 255, 255) as f64);
+    ui.set_prop(t, spec::prop::TEXT_STROKE_WIDTH, stroke_width as f64);
+    ui.set_prop(t, spec::prop::TEXT_STROKE_COLOR, abgr(255, 0, 0, 255) as f64);
+    ui.set_prop(t, spec::prop::SCALE, scale as f64);
+    ui.set_text(t, "A");
+    ui.insert_before(spec::ROOT_ID, t, 0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    validate_drawlist(&words);
+    words
+}
+
+#[test]
+fn a_stroked_run_keeps_unscaled_cells_under_a_scale() {
+    // An unstroked run under an axis-aligned scale draws scaled glyph-page
+    // TEX_QUADs and no GLYPH_RUN.
+    let plain = validate_drawlist(&scaled_text_ops(0.0, 1.5));
+    assert_eq!(plain[spec::draw_op::GLYPH_RUN as usize], 0);
+    assert!(plain[spec::draw_op::TEX_QUAD as usize] > 0);
+    // GLYPH_STROKE places cells unscaled, so a stroked run keeps GLYPH_RUN
+    // for its fill: the outline and the glyph it rings are one size.
+    let stroked = validate_drawlist(&scaled_text_ops(4.0, 1.5));
+    assert_eq!(stroked[spec::draw_op::GLYPH_RUN as usize], 1);
+    assert_eq!(stroked[spec::draw_op::GLYPH_STROKE as usize], 1);
+    assert_eq!(stroked[spec::draw_op::TEX_QUAD as usize], 0);
+}
+
+#[test]
+fn a_stroke_reaching_past_its_cells_survives_the_run_cull() {
+    let mut ui = Ui::new();
+    assert!(ui.load_font_atlas(&block_atlas(0, 40, 0, 40)));
+    let clipper = ui.create_node(0);
+    ui.set_prop(clipper, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(clipper, spec::prop::INSET_L, 100.0);
+    ui.set_prop(clipper, spec::prop::INSET_T, 40.0);
+    ui.set_prop(clipper, spec::prop::WIDTH, 100.0);
+    ui.set_prop(clipper, spec::prop::HEIGHT, 100.0);
+    ui.set_prop(clipper, spec::prop::OVERFLOW, spec::Overflow::Hidden as u32 as f64);
+    ui.insert_before(spec::ROOT_ID, clipper, 0);
+    // The cell spans x 59..99, one pixel short of the clip at 100 — the run
+    // cull drops it — and a 6 px outside stroke reaches 105.
+    let t = ui.create_node(spec::NodeType::Text as u8);
+    ui.set_prop(t, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(t, spec::prop::INSET_L, -41.0);
+    ui.set_prop(t, spec::prop::TEXT_COLOR, abgr(0, 0, 255, 255) as f64);
+    ui.set_prop(t, spec::prop::TEXT_STROKE_WIDTH, 6.0);
+    ui.set_prop(t, spec::prop::TEXT_STROKE_COLOR, abgr(255, 0, 0, 255) as f64);
+    ui.set_text(t, "A");
+    ui.insert_before(clipper, t, 0);
+    ui.tick();
+    let counts = validate_drawlist(&ui.draw().words.clone());
+    assert_eq!(counts[spec::draw_op::GLYPH_RUN as usize], 0, "the fill's cell is outside the clip");
+    assert_eq!(counts[spec::draw_op::GLYPH_STROKE as usize], 1, "its stroke is not");
+}
+
+#[test]
+fn a_text_node_without_a_stroke_emits_no_stroke_op() {
+    let fill = abgr(0, 0, 255, 255);
+    let (_, words) = stroked_block(fill, 0.0, abgr(255, 0, 0, 255), spec::StrokePos::Outside);
+    assert!(!words.iter().any(|&w| w == spec::draw_op::GLYPH_STROKE));
+    let (_, words) = stroked_block(fill, 4.0, 0, spec::StrokePos::Outside);
+    assert!(!words.iter().any(|&w| w == spec::draw_op::GLYPH_STROKE), "a transparent stroke colour is no stroke");
+}
+
+#[test]
+fn a_moving_stroke_redraws_incrementally_to_the_full_render() {
+    use crate::damage::{DamagePolicy, DamageTracker, DEFAULT_DAMAGE_REGIONS};
+    use crate::raster::{render_scaled, render_scaled_incremental};
+    // Ink to within 2 px of the cell edge, so a 6 px stroke reaches 4 px past
+    // the cell on every side — past what a GLYPH_RUN's bounds would damage.
+    let (mut ui, first) =
+        stroked_ink(abgr(0, 0, 255, 255), 6.0, abgr(255, 0, 0, 255), spec::StrokePos::Outside, (2, 38));
+    // Move the text 30 px right: the stroke's old and new reach both damage.
+    let t = {
+        let words = ui.draw().words.clone();
+        assert_eq!(words, first);
+        // The text node is the ground's only child; look it up by hit-test at the ink.
+        ui.hit_test(60.0, 60.0)
+    };
+    assert!(t != 0);
+    ui.set_prop(t, spec::prop::INSET_L, 70.0);
+    ui.tick();
+    let second = ui.draw().words.clone();
+    let pixels = spec::SCREEN_W as usize * spec::SCREEN_H as usize;
+    let mut fb = alloc::vec![0u8; pixels * 4];
+    let mut state = DamageTracker::<DEFAULT_DAMAGE_REGIONS>::new();
+    render_scaled_incremental(&ui, &first, &mut fb, 1, &mut state, DamagePolicy::default()).unwrap();
+    let plan = render_scaled_incremental(&ui, &second, &mut fb, 1, &mut state, DamagePolicy::default()).unwrap();
+    assert!(!plan.is_full_redraw());
+    let mut full = alloc::vec![0u8; pixels * 4];
+    render_scaled(&ui, &second, &mut full, 1);
+    assert!(fb == full, "incremental redraw of a moved stroke differs from the full render");
+}
