+
+/// A v4 atlas of two glyphs in `cell`-px square cells: gid 0 (tofu) empty,
+/// gid 1 ('A') an opaque square covering cell pixels lo..hi on both axes.
+fn block_atlas(slot: u8, cell: u8, lo: usize, hi: usize) -> Vec<u8> {
+    let mut out = encode_atlas(slot, cell, cell, cell - 2, cell, 2, &[(0xfffd, 0, cell), ('A' as u32, 1, cell)]);
+    let c = cell as usize;
+    let cov0 = spec::font_atlas::HEADER_SIZE + 2 * spec::font_atlas::CMAP_ENTRY_SIZE;
+    let g1 = cov0 + c * c;
+    for y in lo..hi {
+        for x in lo..hi {
+            out[g1 + y * c + x] = 255;
+        }
+    }
+    out
+}
