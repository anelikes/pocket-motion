+/**
+ * `text-stroke*` (pocket-motion): the outline of a text run.
+ *
+ *   text-stroke              1 px
+ *   text-stroke-N            N px (integer, 0..64)
+ *   text-stroke-[N] / [Npx]  N px, fractional allowed
+ *   text-stroke-outside      the default: grows outward, painted under the fill
+ *   text-stroke-center       straddles the glyph edge, painted over the fill
+ *   text-stroke-<color>      palette name, `transparent`, or `[#hex]`
+ *
+ * A width with no colour draws nothing (the colour defaults to transparent),
+ * and `text-transparent` with a stroke is hollow text.
+ */
+function parseTextStroke(rest: string, D: Decl[]): boolean {
+  if (rest === "stroke") { D.push([PROP.textStrokeWidth, px(1)]); return true; }
+  const v = rest.slice("stroke-".length);
+  if (v === "outside") { D.push([PROP.textStrokePos, int(ENUMS.StrokePos.Outside)]); return true; }
+  if (v === "center") { D.push([PROP.textStrokePos, int(ENUMS.StrokePos.Center)]); return true; }
+  if (/^\d+$/.test(v)) {
+    const w = parseInt(v, 10);
+    if (w > STROKE_MAX_WIDTH) return false;
+    D.push([PROP.textStrokeWidth, px(w)]);
+    return true;
+  }
+  const arb = /^\[(\d+(?:\.\d+)?)(?:px)?\]$/.exec(v);
+  if (arb) {
+    const w = parseFloat(arb[1]!);
+    if (w > STROKE_MAX_WIDTH) return false;
+    D.push([PROP.textStrokeWidth, px(w)]);
+    return true;
+  }
+  const c = colorValue(v);
+  if (c === null) return false;
+  D.push([PROP.textStrokeColor, c]);
+  return true;
+}
