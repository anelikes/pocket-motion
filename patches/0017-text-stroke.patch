+#[test]
+fn text_stroke_outside_draws_under_the_fill_and_reaches_its_width() {
+    let fill = abgr(0, 0, 255, 255);
+    let stroke = abgr(255, 0, 0, 255);
+    let (mut ui, words) = stroked_block(fill, 4.0, stroke, spec::StrokePos::Outside);
+    let s = words.iter().position(|&w| w == spec::draw_op::GLYPH_STROKE).expect("a stroke op");
+    let g = words.iter().position(|&w| w == spec::draw_op::GLYPH_RUN).expect("a fill op");
+    assert!(s < g, "an outside stroke is emitted before (under) the fill");
+    assert_eq!(words[s + 4], 0, "outside with a visible fill is mode 0");
+    let fb = raster_fb(&mut ui);
+    // The square spans x 50..70, y 50..70 on screen (cell at 40,40; ink 10..30).
+    assert_eq!(sample_rgba(&fb, 60, 60), [0, 0, 255, 255], "interior is the fill");
+    assert_eq!(sample_rgba(&fb, 47, 60), [255, 0, 0, 255], "3 px out is inside a 4 px stroke");
+    assert_eq!(sample_rgba(&fb, 71, 71), [255, 0, 0, 255], "a pixel 2.1 px off the corner is stroked");
+    let corner = sample_rgba(&fb, 72, 72);
+    assert!(corner[1] > 0 && corner[1] < 255, "3.5 px off the corner is the anti-aliased rim, got {corner:?}");
+    assert_eq!(sample_rgba(&fb, 44, 60), [255, 255, 255, 255], "6 px out is past the stroke");
+}
