+// ---- GLYPH_STROKE: text outline by distance to the ink (pocket-motion) ----------------
+
+/// Largest region, in physical pixels, one GLYPH_STROKE rasterises. A run
+/// covering more than this (a 4K frame of text is 8.3 M) is drawn only over
+/// its first rows up to the bound; the core never emits one that large for
+/// a line of text.
+const STROKE_MAX_REGION: usize = 16 * 1024 * 1024;
+
+/// Nearest-seed distance field over `cov` (w x h, coverage 0..255). Seeds
+/// are pixels with coverage > 0 (of the complement when `invert`). Two
+/// raster-order passes of 8-neighbour dead reckoning carry each pixel's
+/// nearest seed by exact integer squared distance; the field is then
+/// `|p - s| + (0.5 - c(s))`, the offset placing the ink edge inside an
+/// anti-aliased seed pixel — so the field is 0.5 - c at a seed itself and a
+/// dilation of width 0 is the coverage it started from.
+///
+/// The seed nearest by centre is not always the one nearest by that sum —
+/// a faint anti-aliased pixel can be closer than the solid one behind it —
+/// and on a curve the difference shows as steps in the stroke's outer edge.
+/// So where the field is near `band` (the stroke's edge, the only place
+/// where the exact value reaches the picture) the sum is re-taken over the
+/// seeds of the 3x3 neighbourhood and the smallest kept. Integer
+/// compares, Newton sqrt: the same input gives the same field on every host.
+fn seed_distance(cov: &[u8], w: usize, h: usize, invert: bool, band: f32, out: &mut Vec<f32>) {
+    const NONE: i32 = i32::MIN;
+    let n = w * h;
+    let c_of = |v: u8| -> u8 { if invert { 255 - v } else { v } };
+    // Nearest seed per pixel as (x, y), and its squared distance.
+    let mut sx: Vec<i32> = alloc::vec![NONE; n];
+    let mut sy: Vec<i32> = alloc::vec![0; n];
+    let mut d2: Vec<i64> = alloc::vec![i64::MAX; n];
+    for y in 0..h {
+        for x in 0..w {
+            let i = y * w + x;
+            if c_of(cov[i]) > 0 {
+                sx[i] = x as i32;
+                sy[i] = y as i32;
+                d2[i] = 0;
+            }
+        }
+    }
+    #[inline(always)]
+    fn relax(i: usize, j: usize, x: i32, y: i32, sx: &mut [i32], sy: &mut [i32], d2: &mut [i64]) {
+        let cx = sx[j];
+        if cx == i32::MIN {
+            return;
+        }
+        let cy = sy[j];
+        let (dx, dy) = ((x - cx) as i64, (y - cy) as i64);
+        let d = dx * dx + dy * dy;
+        if d < d2[i] {
+            d2[i] = d;
+            sx[i] = cx;
+            sy[i] = cy;
+        }
+    }
+    for y in 0..h {
+        let yi = y as i32;
+        for x in 0..w {
+            let (i, xi) = (y * w + x, x as i32);
+            if y > 0 {
+                if x > 0 {
+                    relax(i, i - w - 1, xi, yi, &mut sx, &mut sy, &mut d2);
+                }
+                relax(i, i - w, xi, yi, &mut sx, &mut sy, &mut d2);
+                if x + 1 < w {
+                    relax(i, i - w + 1, xi, yi, &mut sx, &mut sy, &mut d2);
+                }
+            }
+            if x > 0 {
+                relax(i, i - 1, xi, yi, &mut sx, &mut sy, &mut d2);
+            }
+        }
+        for x in (0..w.saturating_sub(1)).rev() {
+            relax(y * w + x, y * w + x + 1, x as i32, yi, &mut sx, &mut sy, &mut d2);
+        }
+    }
+    for y in (0..h).rev() {
+        let yi = y as i32;
+        for x in (0..w).rev() {
+            let (i, xi) = (y * w + x, x as i32);
+            if y + 1 < h {
+                if x + 1 < w {
+                    relax(i, i + w + 1, xi, yi, &mut sx, &mut sy, &mut d2);
+                }
+                relax(i, i + w, xi, yi, &mut sx, &mut sy, &mut d2);
+                if x > 0 {
+                    relax(i, i + w - 1, xi, yi, &mut sx, &mut sy, &mut d2);
+                }
+            }
+            if x + 1 < w {
+                relax(i, i + 1, xi, yi, &mut sx, &mut sy, &mut d2);
+            }
+        }
+        for x in 1..w {
+            relax(y * w + x, y * w + x - 1, x as i32, yi, &mut sx, &mut sy, &mut d2);
+        }
+    }
+    out.clear();
+    out.resize(n, 1.0e9);
+    let off = |x: i32, y: i32| 0.5 - c_of(cov[y as usize * w + x as usize]) as f32 / 255.0;
+    for py in 0..h as i32 {
+        for px in 0..w as i32 {
+            let i = py as usize * w + px as usize;
+            if sx[i] == NONE {
+                continue;
+            }
+            let mut d = sqrtf_newton(d2[i] as f32) + off(sx[i], sy[i]);
+            // The refined value is never above the provisional one, so the
+            // window reaches further on the far side of the edge.
+            let e = d - band;
+            if e > -1.0 && e < 2.0 {
+                for ny in (py - 1).max(0)..=(py + 1).min(h as i32 - 1) {
+                    for nx in (px - 1).max(0)..=(px + 1).min(w as i32 - 1) {
+                        let j = ny as usize * w + nx as usize;
+                        let cx = sx[j];
+                        if cx == NONE {
+                            continue;
+                        }
+                        let cy = sy[j];
+                        let (dx, dy) = ((px - cx) as f32, (py - cy) as f32);
+                        let c = sqrtf_newton(dx * dx + dy * dy) + off(cx, cy);
+                        if c < d {
+                            d = c;
+                        }
+                    }
+                }
+            }
+            out[i] = d;
+        }
+    }
+}
+
+/// `sqrt` for non-negative finite values: the bit-halving estimate and three
+/// Newton steps `draw.rs` already uses — plain IEEE-754 add/mul/div, so the
+/// same input gives the same bits on every host (no libm in the core).
+#[inline]
+fn sqrtf_newton(x: f32) -> f32 {
+    if x <= 0.0 {
+        return 0.0;
+    }
+    let mut y = f32::from_bits((x.to_bits() >> 1) + 0x1fc0_0000);
+    y = 0.5 * (y + x / y);
+    y = 0.5 * (y + x / y);
+    y = 0.5 * (y + x / y);
+    y
+}
+
+#[allow(clippy::too_many_arguments)]
+fn glyph_stroke<T: RenderTarget>(
+    ui: &impl RenderResources,
+    target: &mut T,
+    stride: i32,
+    output_scale: i32,
+    screen: Clip,
+    clip: Clip,
+    slot: u8,
+    color: u32,
+    width: f32,
+    mode: u32,
+    glyphs: &[u32],
+) {
+    let Some(atlas) = ui.font_atlas(slot) else {
+        return;
+    };
+    let (r, g, b, a) = channels(color);
+    if a == 0 || !(width > 0.0) || mode > 2 {
+        return;
+    }
+    let width = width.min(spec::draw_op::STROKE_MAX_WIDTH) * output_scale as f32;
+    // Center strokes straddle the edge: half out (dilation), half in (erosion).
+    let reach = if mode == 1 { width * 0.5 } else { width };
+    let margin = reach as i32 + 2;
+    let cell_w = atlas.cell_w as i32 * output_scale;
+    let cell_h = atlas.cell_h as i32 * output_scale;
+    let atlas_density = atlas.raster_density as i32;
+    let coverage_w = atlas.coverage_width() as i32;
+    let coverage_h = atlas.coverage_height() as i32;
+    let bpr = atlas.bytes_per_row();
+
+    // Region: every cell widened by the reach, on screen. Coverage outside
+    // the clip still counts — a glyph past a scissor edge strokes into it.
+    let mut region = Clip { x0: i32::MAX, y0: i32::MAX, x1: i32::MIN, y1: i32::MIN };
+    for pair in glyphs.chunks_exact(2) {
+        let (gx, gy) = xy(pair[0], output_scale);
+        region.x0 = region.x0.min(gx - margin);
+        region.y0 = region.y0.min(gy - margin);
+        region.x1 = region.x1.max(gx + cell_w + margin);
+        region.y1 = region.y1.max(gy + cell_h + margin);
+    }
+    let region = region.intersect(screen);
+    if region.x0 >= region.x1 || region.y0 >= region.y1 {
+        return;
+    }
+    let out = region.intersect(clip);
+    if out.x0 >= out.x1 || out.y0 >= out.y1 {
+        return;
+    }
+    let rw = (region.x1 - region.x0) as usize;
+    let mut rh = (region.y1 - region.y0) as usize;
+    if rw * rh > STROKE_MAX_REGION {
+        rh = STROKE_MAX_REGION / rw;
+    }
+    let mut cov: Vec<u8> = alloc::vec![0u8; rw * rh];
+    for pair in glyphs.chunks_exact(2) {
+        let (gx, gy) = xy(pair[0], output_scale);
+        let gid = (pair[1] & 0xffff) as u16;
+        if gid >= atlas.glyph_count {
+            continue;
+        }
+        let x0 = gx.max(region.x0);
+        let x1 = (gx + cell_w).min(region.x1);
+        let y0 = gy.max(region.y0);
+        let y1 = (gy + cell_h).min(region.y0 + rh as i32);
+        if x0 >= x1 || y0 >= y1 {
+            continue;
+        }
+        let rows = atlas.glyph_rows(gid);
+        for py in y0..y1 {
+            let sy = coverage_index(py - gy, output_scale, atlas_density, coverage_h);
+            let row = &rows[sy * bpr..];
+            let base = (py - region.y0) as usize * rw;
+            for px in x0..x1 {
+                let cx = coverage_index(px - gx, output_scale, atlas_density, coverage_w);
+                let c = row[cx];
+                let o = base + (px - region.x0) as usize;
+                if c > cov[o] {
+                    cov[o] = c;
+                }
+            }
+        }
+    }
+
+    let mut dist: Vec<f32> = Vec::new();
+    seed_distance(&cov, rw, rh, false, reach, &mut dist);
+    let mut dist_in: Vec<f32> = Vec::new();
+    if mode == 1 {
+        seed_distance(&cov, rw, rh, true, reach, &mut dist_in);
+    }
+    let unit = |x: f32| -> f32 { x.max(0.0).min(1.0) };
+    let y_end = out.y1.min(region.y0 + rh as i32);
+    for py in out.y0..y_end {
+        let base = (py - region.y0) as usize * rw;
+        for px in out.x0..out.x1 {
+            let o = base + (px - region.x0) as usize;
+            let grown = unit(reach + 0.5 - dist[o]);
+            let cover = match mode {
+                0 => grown,
+                2 => unit(grown - cov[o] as f32 / 255.0),
+                // Ring: dilated by half minus eroded by half. Eroded is the
+                // complement of the complement's dilation.
+                _ => unit(grown + unit(reach + 0.5 - dist_in[o]) - 1.0),
+            };
+            let k = (cover * 255.0 + 0.5) as u32;
+            if k != 0 {
+                target.blend((py * stride + px) as usize, r, g, b, (a * k + 127) / 255);
+            }
+        }
+    }
+}
