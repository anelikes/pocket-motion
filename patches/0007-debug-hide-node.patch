+#[test]
+fn debug_hide_removes_pixels_and_clears_byte_for_byte() {
+    let mut ui = Ui::new();
+    let mk = |x: f32, color: u32| {
+        let mut s = StyleSpec::new();
+        s.base = alloc::vec![
+            (spec::prop::POS_TYPE, spec::PosType::Absolute as u32),
+            (spec::prop::WIDTH, 40f32.to_bits()),
+            (spec::prop::HEIGHT, 40f32.to_bits()),
+            (spec::prop::INSET_L, x.to_bits()),
+            (spec::prop::INSET_T, 10f32.to_bits()),
+            (spec::prop::BG_COLOR, color),
+        ];
+        s
+    };
+    let red = abgr(0xcc, 0x20, 0x20, 0xff);
+    let blue = abgr(0x20, 0x20, 0xcc, 0xff);
+    assert!(ui.load_styles(&encode_styles(&[mk(10.0, red), mk(80.0, blue)])));
+    let a = ui.create_node(0);
+    let b = ui.create_node(0);
+    ui.insert_before(spec::ROOT_ID, a, 0);
+    ui.insert_before(spec::ROOT_ID, b, 0);
+    ui.set_style(a, 0);
+    ui.set_style(b, 1);
+    ui.tick();
+
+    let baseline = raster_fb(&mut ui);
+    assert_eq!(sample_rgba(&baseline, 20, 20), [0xcc, 0x20, 0x20, 0xff]);
+    assert_eq!(sample_rgba(&baseline, 90, 20), [0x20, 0x20, 0xcc, 0xff]);
+
+    ui.debug_hide(a);
+    let hidden = raster_fb(&mut ui);
+    assert_ne!(hidden, baseline, "hiding a painted node must change a pixel");
+    assert_eq!(sample_rgba(&hidden, 20, 20), [0, 0, 0, 0xff], "A's pixels are gone");
+    assert_eq!(sample_rgba(&hidden, 90, 20), [0x20, 0x20, 0xcc, 0xff], "B is untouched");
+
+    // Other nodes' inspect rects must not move: hide is draw-time only.
+    ui.debug_inspect(b);
+    ui.draw();
+    let xy = ui.debug_rect_xy();
+    let wh = ui.debug_rect_wh();
+    ui.debug_inspect(0);
+    ui.debug_hide(0);
+    ui.debug_inspect(b);
+    ui.draw();
+    assert_eq!(ui.debug_rect_xy(), xy);
+    assert_eq!(ui.debug_rect_wh(), wh);
+    ui.debug_inspect(0);
+
+    ui.debug_hide(0);
+    let restored = raster_fb(&mut ui);
+    assert_eq!(restored, baseline, "debug_hide(0) must reproduce the original framebuffer");
+}
