diff --git a/engine/wasm/src/lib.rs b/engine/wasm/src/lib.rs
index 2ffd2d3a..48576cbf 100644
--- a/engine/wasm/src/lib.rs
+++ b/engine/wasm/src/lib.rs
@@ -271,6 +271,26 @@ pub extern "C" fn ui_upload_texture(ptr: *const u8, len: usize, w: u32, h: u32,
     ui().upload_texture(unsafe { bytes(ptr, len) }, w, h, psm)
 }
 
+/// `ui_upload_texture` carrying spec::img flags — FLAG_LINEAR (2) requests
+/// bilinear sampling, FLAG_RLE (1) marks the pixel stream PackBits-RLE.
+///
+/// `Ui::upload_texture_flags` has always been able to do this; every other
+/// route to it goes through a pak entry (`ui_upload_img_entry`) or a tileset,
+/// so a host uploading raw pixels it produced itself could only get the
+/// flagless default, which is nearest sampling. That is the right default for
+/// pixel art drawn 1:1 and the wrong one for anything the rasteriser resamples.
+#[no_mangle]
+pub extern "C" fn ui_upload_texture_flags(
+    ptr: *const u8,
+    len: usize,
+    w: u32,
+    h: u32,
+    psm: u32,
+    flags: u32,
+) -> i32 {
+    ui().upload_texture_flags(unsafe { bytes(ptr, len) }, w, h, psm, flags as u8)
+}
+
 /// Upload a self-contained IMG pak entry (spec op uploadImgEntry;
 /// framework/compiler/pak.ts layout — v2 PSM_T8 palette + optional RLE + filter flags
 /// parsed core-side). Returns the generation-tagged handle or -1.
diff --git a/framework/src/host.ts b/framework/src/host.ts
index f0327dee..2156fcf3 100644
--- a/framework/src/host.ts
+++ b/framework/src/host.ts
@@ -182,6 +182,11 @@ export interface HostOps {
   /** Upload a self-contained IMG entry blob (framework/compiler/pak.ts layout, incl.
    *  PSM_T8 palette + RLE/filter flags). → handle or -1. */
   uploadImgEntry?(blob: Uint8Array): number;
+  /** `uploadTexture` carrying spec::img flags — IMG_FLAG_LINEAR (2) selects
+   *  bilinear sampling instead of the nearest default, IMG_FLAG_RLE (1) marks
+   *  the pixel stream PackBits-RLE. The only route to filtered sampling for
+   *  pixels the caller produced rather than baked into a pak entry. */
+  uploadTextureFlags?(buf: Uint8Array, w: number, h: number, psm: number, flags: number): number;
 
   // -- host service channel + video plane (spec ops 30..37). Optional: only
   //    native hosts with a tethered companion process (PSPLINK usbhostfs,
diff --git a/hosts/web/wasm-ops.js b/hosts/web/wasm-ops.js
index 99199e5e..fa2ea853 100644
--- a/hosts/web/wasm-ops.js
+++ b/hosts/web/wasm-ops.js
@@ -182,6 +182,14 @@ export async function createWasmUi(wasm, options = {}) {
     ops.uploadImgEntry = (blob) => withBytes(blob, (p, l) => ex.ui_upload_img_entry(p, l));
   }
 
+  // uploadTexture carrying spec::img flags — same feature-detection, same
+  // reason. Callers that want IMG_FLAG_LINEAR (bilinear) on pixels they built
+  // themselves have no other route: uploadImgEntry needs a pak-entry blob.
+  if (ex.ui_upload_texture_flags) {
+    ops.uploadTextureFlags = (buf, w, h, psm, flags) =>
+      withBytes(buf, (p, l) => ex.ui_upload_texture_flags(p, l, w, h, psm, flags));
+  }
+
   // Virtual cursor ops (spec ops 27..29, input.cursor) — feature-detected so
