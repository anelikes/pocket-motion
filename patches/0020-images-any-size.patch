new file mode 100644
index 00000000..d6788f30
--- /dev/null
+++ b/tests/image-dims.test.ts
@@ -0,0 +1,20 @@
+// pocket-motion: an IMG entry of any size from 1 to IMG_MAX_DIM per side.
+import { describe, expect, test } from "bun:test";
+import { encodeImageEntry } from "../framework/compiler/pak.ts";
+import { IMG_MAX_DIM, PSM } from "../contracts/spec/spec.ts";
+
+const img = (width: number, height: number) => ({ width, height, rgba: new Uint8Array(width * height * 4) });
+
+describe("image entry dimensions", () => {
+  test("a size that is not a power of two encodes, header and payload exact", () => {
+    const blob = encodeImageEntry(img(300, 170), PSM.PSM_8888);
+    const dv = new DataView(blob.buffer);
+    expect([dv.getUint16(0, true), dv.getUint16(2, true)]).toEqual([300, 170]);
+    expect(blob.length).toBe(8 + 300 * 170 * 4);
+  });
+  test("IMG_MAX_DIM is the largest side; one more is refused", () => {
+    expect(IMG_MAX_DIM).toBe(2048);
+    expect(() => encodeImageEntry(img(2048, 1))).not.toThrow();
+    expect(() => encodeImageEntry(img(2049, 1))).toThrow("each side must be 1..2048 px");
+  });
+});
