+// ---- images of any size (pocket-motion) ---------------------------------------------
+
+#[test]
+fn an_image_of_any_size_up_to_img_max_dim_uploads_and_samples_by_its_own_size() {
+    let mut ui = Ui::new();
+    // 3x5 RGBA: column x has red = 80 * x, row y has green = 50 * y.
+    let (w, h) = (3u32, 5u32);
+    let mut px = Vec::new();
+    for y in 0..h {
+        for x in 0..w {
+            px.extend_from_slice(&[(80 * x) as u8, (50 * y) as u8, 0, 255]);
+        }
+    }
+    let tex = ui.upload_texture(&px, w, h, spec::psm::PSM_8888);
+    assert!(tex >= 0, "a 3x5 texture uploads");
+    assert!(ui.upload_texture(&alloc::vec![0u8; 4 * 2049], 2049, 1, spec::psm::PSM_8888) < 0, "2049 wide is refused");
+    assert!(ui.upload_texture(&alloc::vec![0u8; 4 * 2048], 2048, 1, spec::psm::PSM_8888) >= 0, "2048 is the edge");
+    let n = ui.create_node(spec::NodeType::Image as u8);
+    ui.set_prop(n, spec::prop::WIDTH, 30.0);
+    ui.set_prop(n, spec::prop::HEIGHT, 50.0);
+    ui.set_image(n, tex);
+    ui.insert_before(spec::ROOT_ID, n, 0);
+    ui.tick();
+    let fb = raster_fb(&mut ui);
+    // Each texel is a 10x10 block on screen, nearest-sampled.
+    for ty in 0..5usize {
+        for tx in 0..3usize {
+            assert_eq!(
+                sample_rgba(&fb, tx * 10 + 5, ty * 10 + 5),
+                [(80 * tx) as u8, (50 * ty) as u8, 0, 255],
+                "texel {tx},{ty}"
+            );
+        }
+    }
+}
