+describe("svg bake document structure", () => {
+  const square = doc(32, 32, `<path fill="#fff" d="M8 0H16V8H8Z"/>`);
+
+  test("<g transform> composes with the shape's own, outermost last", () => {
+    expect(sameBytes(doc(32, 32, `<g transform="translate(8 0)"><rect width="4" height="4" transform="scale(2)" fill="#fff"/></g>`), square)).toBe(true);
+    expect(sameBytes(doc(32, 32, `<g transform="translate(8 0)"><g transform="scale(2)"><path fill="#fff" d="M0 0H4V4H0Z"/></g></g>`), square)).toBe(true);
+  });
+
+  test("a transform list applies its rightmost function first", () => {
+    expect(sameBytes(doc(32, 32, `<path fill="#fff" transform="translate(8 0) scale(2)" d="M0 0H4V4H0Z"/>`), square)).toBe(true);
+    expect(sameBytes(doc(32, 32, `<path fill="#fff" transform="matrix(2 0 0 2 8 0)" d="M0 0H4V4H0Z"/>`), square)).toBe(true);
+  });
+
+  test("a <g> passes fill and stroke to its children", () => {
+    expect(pixel(bakeSvg(doc(16, 16, `<g fill="#ff0000"><path d="M0 0H8V8H0Z"/></g>`)), 4, 4)).toEqual([255, 0, 0, 255]);
+    expect(pixel(bakeSvg(doc(16, 16, `<g stroke="#00ff00" stroke-width="2"><line x1="0" y1="8" x2="16" y2="8"/></g>`)), 4, 7)).toEqual([0, 255, 0, 255]);
