+  test("display none and visibility hidden paint nothing", () => {
+    expect(pixel(bakeSvg(doc(16, 16, `<g display="none"><rect width="16" height="16" fill="#fff"/></g><rect width="1" height="1"/>`)), 8, 8)[3]).toBe(0);
