+  });
+
+  test("what would paint and is not implemented is refused, not dropped", () => {
+    const refused: [string, string][] = [
+      [`<text x="0" y="10">hi</text>`, "<text> is not drawn"],
+      [`<use href="#a"/>`, "<use> is not drawn"],
+      [`<image href="a.png" width="4" height="4"/>`, "<image> is not drawn"],
