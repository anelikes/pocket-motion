@@ -0,0 +1,253 @@
+// tests/fixtures/svg-bake-cases.ts — inputs for holding framework/compiler/bake-svg.ts
+// to its reference (tests/fixtures/bake-svg-reference.ts) and for timing it.
+// Everything here is generated from a seed, so a failing case reproduces.
+
+type Pt = [number, number];
+
+/** A seeded 32-bit LCG; `next()` is uniform on [0, 1). */
+export function lcg(seed: number): () => number {
+  let s = seed >>> 0;
+  return () => (s = (Math.imul(s, 1664525) + 1013904223) >>> 0) / 4294967296;
+}
+
+const fmt = (n: number) => +n.toFixed(3);
+
+/**
+ * A coordinate in [lo, hi) that lands, often, exactly on a pixel edge, a
+ * subsample position or a subsample midpoint — the places where a crossing
+ * test that is not the reference's exact arithmetic would decide differently.
+ */
+function coord(next: () => number, lo: number, hi: number): number {
+  const v = lo + next() * (hi - lo);
+  switch (Math.floor(next() * 6)) {
+    case 0: return Math.round(v);
+    case 1: return Math.round(v * 8) / 8;
+    case 2: return Math.round(v * 4) / 4 + 0.125;
+    case 3: return v + 1e-12;
+    default: return v;
+  }
+}
+
+function contour(next: () => number, w: number, h: number): Pt[] {
+  const kind = Math.floor(next() * 5);
+  const n = kind === 0 ? 3 : kind === 1 ? 4 + Math.floor(next() * 4) : 3 + Math.floor(next() * 30);
+  const cx = coord(next, -5, w + 5);
+  const cy = coord(next, -5, h + 5);
+  const r = 0.2 + next() * Math.max(w, h) * (next() < 0.3 ? 1.5 : 0.5);
+  const pts: Pt[] = [];
+  for (let i = 0; i < n; i++) {
+    if (kind === 2) {
+      // a self-intersecting scribble reaching outside the window
+      pts.push([coord(next, -10, w + 10), coord(next, -10, h + 10)]);
+      continue;
+    }
+    const a = (i / n) * Math.PI * 2 * (next() < 0.2 ? -1 : 1);
+    const rr = r * (0.3 + next());
+    let p: Pt = [cx + rr * Math.cos(a), cy + rr * Math.sin(a)];
+    const prev = pts[pts.length - 1];
+    if (next() < 0.2) p = [Math.round(p[0] * 4) / 4 + 0.125, Math.round(p[1] * 4) / 4 + 0.125];
+    if (prev && next() < 0.1) p = [prev[0], p[1]]; // vertical edge
+    if (prev && next() < 0.1) p = [p[0], prev[1]]; // horizontal edge
+    if (prev && next() < 0.05) p = [prev[0], prev[1]]; // repeated point
+    pts.push(p);
+  }
+  if (kind === 4) pts.reverse();
+  return pts;
+}
+
+export interface PathCase {
+  contours: Pt[][];
+  evenOdd: boolean;
+  window: [number, number, number, number];
+}
+
+export interface CircleCase {
+  cx: number;
+  cy: number;
+  r: number;
+  window: [number, number, number, number];
+}
+
+/** Random fills over small canvases: 1-4 contours, either rule, a sub-window. */
+export function coverageCases(seed: number, count: number): { paths: PathCase[]; circles: CircleCase[] } {
+  const next = lcg(seed);
+  const paths: PathCase[] = [];
+  const circles: CircleCase[] = [];
+  for (let t = 0; t < count; t++) {
+    const w = 1 + Math.floor(next() * 64);
+    const h = 1 + Math.floor(next() * 64);
+    const contours: Pt[][] = [];
+    const k = 1 + Math.floor(next() * 4);
+    for (let i = 0; i < k; i++) contours.push(contour(next, w, h));
+    const evenOdd = next() < 0.5;
+    const x0 = Math.floor((next() * w) / 2);
+    const y0 = Math.floor((next() * h) / 2);
+    const x1 = x0 + Math.floor(next() * (w - x0)) + (next() < 0.05 ? 0 : 1);
+    const y1 = y0 + Math.floor(next() * (h - y0)) + 1;
+    paths.push({ contours, evenOdd, window: [x0, y0, x1, y1] });
+
+    const cx = coord(next, -10, w + 10);
+    const cy = coord(next, -10, h + 10);
+    const radii = [0, -coord(next, 0, 5), coord(next, 0, 2), coord(next, 0, Math.max(w, h)), Math.round(next() * 20) / 4, 0.125 * Math.floor(next() * 100)];
+    const r = radii[Math.floor(next() * radii.length)]!;
+    // the window the baker gives a circle
+    circles.push({
+      cx,
+      cy,
+      r,
+      window: [
+        Math.max(0, Math.floor(cx - r - 1)),
+        Math.max(0, Math.floor(cy - r - 1)),
+        Math.min(w, Math.ceil(cx + r + 1)),
+        Math.min(h, Math.ceil(cy + r + 1)),
+      ],
+    });
+  }
+  return { paths, circles };
+}
+
+/**
+ * Fills whose edges pass, in exact arithmetic, through two subsample
+ * positions: each edge runs from a fraction of a step before one sample to a
+ * fraction past another, so its endpoints are rounded and the crossing lands
+ * within an ulp or two of the sample it should hit. Whether such a sample is
+ * covered is decided by the last bit of the crossing — which is what makes
+ * these the cases that tell the reference's exact arithmetic from the same
+ * line computed in another order. Random coordinates almost never land there.
+ */
+export function knifeEdgeCases(seed: number, count: number): PathCase[] {
+  const next = lcg(seed);
+  const sample = (lo: number, hi: number) => (Math.floor((lo + next() * (hi - lo)) * 4) + 0.5) / 4;
+  const out: PathCase[] = [];
+  for (let t = 0; t < count; t++) {
+    const size = 4 + Math.floor(next() * 12);
+    const contours: Pt[][] = [];
+    const k = 1 + Math.floor(next() * 3);
+    for (let i = 0; i < k; i++) {
+      const pts: Pt[] = [];
+      const n = 3 + Math.floor(next() * 3);
+      for (let j = 0; j < n; j++) {
+        const s1: Pt = [sample(0, size), sample(0, size)];
+        const s2: Pt = [sample(0, size), sample(0, size)];
+        const a = 0.1 + next() * 0.9;
+        const b = 0.1 + next() * 0.9;
+        pts.push([s1[0] - a * (s2[0] - s1[0]), s1[1] - a * (s2[1] - s1[1])]);
+        pts.push([s2[0] + b * (s2[0] - s1[0]), s2[1] + b * (s2[1] - s1[1])]);
+      }
+      contours.push(pts);
+    }
+    out.push({ contours, evenOdd: next() < 0.5, window: [0, 0, size, size] });
+  }
+  return out;
+}
+
+function hexagon(cx: number, cy: number, r: number): string {
+  let d = "";
+  for (let k = 0; k < 6; k++) {
+    const a = (Math.PI / 180) * (60 * k - 30);
+    d += (k === 0 ? "M" : "L") + fmt(cx + r * Math.cos(a)) + " " + fmt(cy + r * Math.sin(a));
+  }
+  return d + "Z";
+}
+
+function hexCentres(width: number, height: number, r: number): Pt[] {
+  const dx = Math.sqrt(3) * r;
+  const dy = 1.5 * r;
+  const out: Pt[] = [];
+  for (let row = 0; r + row * dy <= height - r; row++) {
+    for (let col = 0; r + col * dx + (row % 2 ? dx / 2 : 0) <= width - r; col++) {
+      out.push([r + col * dx + (row % 2 ? dx / 2 : 0), r + row * dy]);
+    }
+  }
+  return out;
+}
+
+/**
+ * The case that made the per-subsample baker unusable: one path holding a hex
+ * grid of 952 cells drawn as rings (outer and inner hexagon, evenodd) — 11,424
+ * edges over 1400x1000. Measured at more than ten minutes before.
+ */
+export function hexGridSvg(): string {
+  const d = hexCentres(1400, 1000, 23).map(([x, y]) => hexagon(x, y, 23) + hexagon(x, y, 21)).join("");
+  return `<svg width="1400" height="1000" viewBox="0 0 1400 1000"><path fill="#38bdf8" fill-rule="evenodd" d="${d}"/></svg>`;
+}
+
+/** The same grid as one stroked path: 952 closed hexagons, stroke-width 2. */
+export function hexGridStrokeSvg(): string {
+  const d = hexCentres(1400, 1000, 23).map(([x, y]) => hexagon(x, y, 22)).join("");
+  return `<svg width="1400" height="1000" viewBox="0 0 1400 1000"><path fill="none" stroke="#38bdf8" stroke-width="2" d="${d}"/></svg>`;
+}
+
+function bezierCircle(cx: number, cy: number, r: number): string {
+  const k = 0.5522847498 * r;
+  return (
+    `M${cx + r} ${cy}C${cx + r} ${fmt(cy + k)} ${fmt(cx + k)} ${cy + r} ${cx} ${cy + r}` +
+    `C${fmt(cx - k)} ${cy + r} ${cx - r} ${fmt(cy + k)} ${cx - r} ${cy}` +
+    `C${cx - r} ${fmt(cy - k)} ${fmt(cx - k)} ${cy - r} ${cx} ${cy - r}` +
+    `C${fmt(cx + k)} ${cy - r} ${cx + r} ${fmt(cy - k)} ${cx + r} ${cy}Z`
+  );
+}
+
+/** A 20-unit ring on a 1080x1080 canvas, as two bezier circles under evenodd (bake it at 2x). */
+export function ringPathSvg(): string {
+  return `<svg width="1080" height="1080" viewBox="0 0 1080 1080"><path fill="#f59e0b" fill-rule="evenodd" d="${bezierCircle(540, 540, 520)}${bezierCircle(540, 540, 500)}"/></svg>`;
+}
+
+/** The same ring as a stroked circle. */
+export function ringStrokeSvg(): string {
+  return `<svg width="1080" height="1080" viewBox="0 0 1080 1080"><circle cx="540" cy="540" r="510" fill="none" stroke="#f59e0b" stroke-width="20"/></svg>`;
+}
+
+/** 300 closed blobs of 8 cubic segments, translucent fills, on 1920x1080. */
+export function illustrationSvg(paths = 300): string {
+  const next = lcg(12345);
+  let body = "";
+  for (let p = 0; p < paths; p++) {
+    const cx = next() * 1920;
+    const cy = next() * 1080;
+    const r = 20 + next() * 220;
+    const pts: Pt[] = [];
+    for (let i = 0; i < 8; i++) {
+      const a = (i / 8) * Math.PI * 2;
+      const rr = r * (0.6 + 0.4 * next());
+      pts.push([cx + rr * Math.cos(a), cy + rr * Math.sin(a)]);
+    }
+    let d = `M${fmt(pts[0]![0])} ${fmt(pts[0]![1])}`;
+    for (let i = 0; i < 8; i++) {
+      const [a, b, pa, nb] = [pts[i]!, pts[(i + 1) % 8]!, pts[(i + 7) % 8]!, pts[(i + 2) % 8]!];
+      d += `C${fmt(a[0] + (b[0] - pa[0]) / 6)} ${fmt(a[1] + (b[1] - pa[1]) / 6)} ${fmt(b[0] - (nb[0] - a[0]) / 6)} ${fmt(b[1] - (nb[1] - a[1]) / 6)} ${fmt(b[0])} ${fmt(b[1])}`;
+    }
+    const colour = "#" + Math.floor(next() * 0xffffff).toString(16).padStart(6, "0");
+    body += `<path fill="${colour}" fill-opacity="${fmt(0.4 + 0.6 * next())}" d="${d}Z"/>`;
+  }
+  return `<svg width="1920" height="1080" viewBox="0 0 1920 1080">${body}</svg>`;
+}
+
+function sparklinePoints(): string[] {
+  const pts: string[] = [];
+  for (let i = 0; i < 360; i++) {
+    const x = 40 + i * (1840 / 359);
+    const y = 540 - 300 * Math.sin(i / 17) * Math.cos(i / 41) - 80 * Math.sin(i / 3.3);
+    pts.push(`${fmt(x)},${fmt(y)}`);
+  }
+  return pts;
+}
+
+/** The area under a 360-point sparkline, as a filled path. */
+export function sparklineAreaSvg(): string {
+  return `<svg width="1920" height="1080" viewBox="0 0 1920 1080"><path fill="#22c55e" d="M40 1000L${sparklinePoints().join("L")}L1880 1000Z"/></svg>`;
+}
+
+/** The 360-point sparkline itself, stroked with round joins and caps. */
+export function sparklineStrokeSvg(): string {
+  return `<svg width="1920" height="1080" viewBox="0 0 1920 1080"><polyline fill="none" stroke="#22c55e" stroke-width="4" stroke-linejoin="round" stroke-linecap="round" points="${sparklinePoints().join(" ")}"/></svg>`;
+}
+
+/** The contours of a path made only of M, L and Z, in its own coordinates. */
+export function polygonContours(d: string): Pt[][] {
+  return d
+    .split(/[Zz]/)
+    .map((c) => c.trim())
+    .filter(Boolean)
+    .map((c) => c.slice(1).split("L").map((p) => p.trim().split(/[\s,]+/).map(Number) as Pt));
+}
