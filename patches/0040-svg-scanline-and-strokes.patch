+  test("opacity on a <g> composites its children as one layer", () => {
+    const img = bakeSvg(doc(16, 16, `<g opacity="0.5"><rect width="10" height="10" fill="#ff0000"/><rect x="5" y="5" width="10" height="10" fill="#0000ff"/></g>`));
