+// ---- strokes, transforms, groups -------------------------------------------------
+
+const doc = (w: number, h: number, body: string) => `<svg width="${w}" height="${h}">${body}</svg>`;
+const sameBytes = (a: string, b: string, density = 1) =>
+  Buffer.from(bakeSvg(a, density).rgba).equals(Buffer.from(bakeSvg(b, density).rgba));
+const pixel = (img: { width: number; rgba: Uint8Array }, x: number, y: number) =>
+  Array.from(img.rgba.slice((y * img.width + x) * 4, (y * img.width + x) * 4 + 4));
+/** Pixels whose alpha differs, and by how much at most. */
+function alphaDiff(a: string, b: string, density = 1): { pixels: number; max: number } {
+  const x = bakeSvg(a, density).rgba;
+  const y = bakeSvg(b, density).rgba;
+  let pixels = 0;
+  let max = 0;
+  for (let i = 3; i < x.length; i += 4) {
+    const d = Math.abs(x[i]! - y[i]!);
+    if (d > 0) pixels++;
+    max = Math.max(max, d);
+  }
+  return { pixels, max };
+}
+/** One subsample of sixteen, in alpha. */
+const ONE_SAMPLE = 16;
+
+describe("svg bake strokes", () => {
+  test("a butt-capped line is the rectangle it sweeps", () => {
+    expect(
+      sameBytes(
+        doc(32, 20, `<line x1="4" y1="10" x2="28" y2="10" stroke="#fff" stroke-width="4"/>`),
+        doc(32, 20, `<rect x="4" y="8" width="24" height="4" fill="#fff"/>`),
+      ),
+    ).toBe(true);
+  });
+
+  test("a square cap extends the line by half the width", () => {
+    expect(
+      sameBytes(
+        doc(32, 20, `<line x1="4" y1="10" x2="28" y2="10" stroke="#fff" stroke-width="4" stroke-linecap="square"/>`),
+        doc(32, 20, `<rect x="2" y="8" width="28" height="4" fill="#fff"/>`),
+      ),
+    ).toBe(true);
+  });
+
+  test("a round cap is a half disc", () => {
+    expect(
+      sameBytes(
+        doc(32, 20, `<line x1="4" y1="10" x2="28" y2="10" stroke="#fff" stroke-width="4" stroke-linecap="round"/>`),
+        doc(32, 20, `<rect x="4" y="8" width="24" height="4" fill="#fff"/><circle cx="4" cy="10" r="2" fill="#fff"/><circle cx="28" cy="10" r="2" fill="#fff"/>`),
+      ),
+    ).toBe(true);
+  });
+
+  test("miter and bevel joins at a right angle are the outlines they describe", () => {
+    const line = (join: string) =>
+      doc(64, 64, `<polyline points="10,10 50,10 50,50" fill="none" stroke="#fff" stroke-width="4" stroke-linejoin="${join}"/>`);
+    expect(sameBytes(line("miter"), doc(64, 64, `<path fill="#fff" d="M10 8H52V50H48V12H10Z"/>`))).toBe(true);
+    expect(sameBytes(line("bevel"), doc(64, 64, `<path fill="#fff" d="M10 8H50L52 10V50H48V12H10Z"/>`))).toBe(true);
+  });
+
+  test("a miter past stroke-miterlimit is a bevel", () => {
+    const sharp = (extra: string) =>
+      doc(64, 64, `<polyline points="10,40 50,30 10,20" fill="none" stroke="#fff" stroke-width="4" ${extra}/>`);
+    expect(sameBytes(sharp(`stroke-miterlimit="1"`), sharp(`stroke-linejoin="bevel"`))).toBe(true);
+    expect(sameBytes(sharp(`stroke-miterlimit="10"`), sharp(`stroke-linejoin="bevel"`))).toBe(false);
+  });
+
+  test("a closed rect, polygon or Z path strokes to a ring with mitred corners", () => {
+    const ring = doc(64, 64, `<path fill="#fff" fill-rule="evenodd" d="M8 8H52V42H8ZM12 12H48V38H12Z"/>`);
+    expect(sameBytes(doc(64, 64, `<rect x="10" y="10" width="40" height="30" fill="none" stroke="#fff" stroke-width="4"/>`), ring)).toBe(true);
+    expect(sameBytes(doc(64, 64, `<polygon points="10,10 50,10 50,40 10,40" fill="none" stroke="#fff" stroke-width="4"/>`), ring)).toBe(true);
+    expect(sameBytes(doc(64, 64, `<path d="M10 10H50V40H10Z" fill="none" stroke="#fff" stroke-width="4"/>`), ring)).toBe(true);
+  });
+
+  test("a stroked circle is the annulus to within one subsample per pixel", () => {
+    const stroked = bakeSvg(doc(64, 64, `<circle cx="32" cy="32" r="20" fill="none" stroke="#fff" stroke-width="6"/>`), 2);
+    let worst = 0;
+    for (let y = 0; y < 128; y++) {
+      for (let x = 0; x < 128; x++) {
+        let covered = 0;
+        for (let yy = 0; yy < 4; yy++) {
+          for (let xx = 0; xx < 4; xx++) {
+            const dx = x + (xx + 0.5) / 4 - 64;
+            const dy = y + (yy + 0.5) / 4 - 64;
+            const d2 = dx * dx + dy * dy;
+            if (d2 <= 46 * 46 && d2 > 34 * 34) covered++;
+          }
+        }
+        worst = Math.max(worst, Math.abs(Math.round((255 * covered) / 16) - stroked.rgba[(y * 128 + x) * 4 + 3]!));
+      }
+    }
+    expect(worst).toBeLessThanOrEqual(ONE_SAMPLE);
+  });
+
+  test("a zero-length subpath draws its round or square cap, and nothing for butt", () => {
+    const dot = (cap: string) =>
+      bakeSvg(doc(16, 16, `<path stroke="#fff" stroke-width="6" stroke-linecap="${cap}" d="M8 8Z"/><rect width="1" height="1" fill="#000"/>`));
+    expect(pixel(dot("round"), 8, 8)[3]).toBe(255);
+    expect(pixel(dot("square"), 10, 10)[3]).toBe(255);
+    expect(pixel(dot("butt"), 8, 8)[3]).toBe(0);
+  });
+
+  test("a closed subpath of two points goes out and back: joins at both ends, no caps", () => {
+    const bar = doc(32, 16, `<rect x="4" y="6" width="24" height="4" fill="#fff"/>`);
+    expect(sameBytes(doc(32, 16, `<path d="M4 8L28 8Z" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="square"/>`), bar)).toBe(true);
+    expect(sameBytes(doc(32, 16, `<polygon points="4,8 28,8" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="square"/>`), bar)).toBe(true);
+  });
+
+  test("a drawing command after Z starts its subpath at the start point", () => {
+    const img = bakeSvg(doc(32, 32, `<path fill="none" stroke="#fff" stroke-width="2" d="M4 4H12V12ZL4 28"/>`));
+    expect(pixel(img, 4, 20)[3]).toBe(255);
+  });
+
+  test("fill and stroke under opacity composite as one group", () => {
+    const grouped = bakeSvg(doc(32, 32, `<rect x="8" y="8" width="16" height="16" fill="#ff0000" stroke="#0000ff" stroke-width="4" opacity="0.5"/>`));
+    expect(pixel(grouped, 8, 16)).toEqual([0, 0, 255, 128]); // the stroke over the fill: no red through it
+    expect(pixel(grouped, 16, 16)).toEqual([255, 0, 0, 128]);
+    const separate = bakeSvg(doc(32, 32, `<rect x="8" y="8" width="16" height="16" fill="#ff0000" stroke="#0000ff" stroke-width="4" fill-opacity="0.5" stroke-opacity="0.5"/>`));
+    expect(pixel(separate, 8, 16)).toEqual([85, 0, 170, 192]);
+  });
+
+  test("stroke=\"hole\" erases along the stroke", () => {
+    const img = bakeSvg(doc(16, 16, `<rect width="16" height="16" fill="#fff"/><line x1="0" y1="8" x2="16" y2="8" stroke="hole" stroke-width="2"/>`));
+    expect(pixel(img, 4, 7)[3]).toBe(0);
+    expect(pixel(img, 4, 4)[3]).toBe(255);
+  });
+});
+
+describe("svg bake arcs and shapes", () => {
+  test("two arcs make the circle they describe", () => {
+    const circle = doc(64, 64, `<circle cx="32" cy="32" r="20" fill="#fff"/>`);
+    for (const d of ["M12 32A20 20 0 1 0 52 32A20 20 0 1 0 12 32Z", "M12 32a20 20 0 0 1 40 0a20,20,0,0,1-40,0z"]) {
+      expect(alphaDiff(doc(64, 64, `<path fill="#fff" d="${d}"/>`), circle, 2).max).toBeLessThanOrEqual(ONE_SAMPLE);
+    }
+  });
+
+  test("an arc's x-axis-rotation and radius scale-up follow the SVG rules", () => {
+    expect(sameBytes(
+      doc(64, 64, `<path fill="#fff" d="M32 2A30 20 90 0 1 32 62A30 20 90 0 1 32 2Z"/>`),
+      doc(64, 64, `<ellipse cx="32" cy="32" rx="20" ry="30" fill="#fff"/>`),
+      2,
+    )).toBe(true);
+    expect(sameBytes(
+      doc(64, 64, `<path fill="#fff" d="M12 32A1 1 0 0 1 52 32Z"/>`),
+      doc(64, 64, `<path fill="#fff" d="M12 32A20 20 0 0 1 52 32Z"/>`),
+      2,
