+
+  test("rect rx rounds the corners", () => {
+    const img = bakeSvg(doc(32, 32, `<rect x="0" y="0" width="32" height="32" rx="8" fill="#fff"/>`));
+    expect(pixel(img, 0, 0)[3]).toBe(0);
