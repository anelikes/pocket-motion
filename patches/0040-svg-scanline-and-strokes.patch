+  test("the hex grid: 11,424 edges in one path, at four windows", () => {
+    const d = /d="([^"]*)"/.exec(hexGridSvg())![1]!;
+    const contours = polygonContours(d);
+    expect(contours.reduce((n, c) => n + c.length, 0)).toBe(11424);
+    for (const window of [[0, 0, 24, 24], [700, 480, 724, 504], [1376, 976, 1400, 1000], [313, 857, 337, 881]] as Window[]) {
+      const want = referencePathCoverage(contours, true, ...window);
+      const got = counts((v) => coverPath(contours, true, ...window, v), window);
+      expect(firstDifference(want, got, window)).toBeNull();
+    }
+  }, 60_000);
+});
+
+describe("svg bake: every SVG in this tree the reference bakes, bakes to the same bytes", () => {
+  const ROOT = join(import.meta.dir, "..");
+  const listed = Bun.spawnSync(["git", "ls-files", "*.svg"], { cwd: ROOT }).stdout.toString().trim();
+  const files = listed ? listed.split("\n") : [];
+  // <text> was dropped by the reference and is refused now; with it, the
+  // strokes and the <line>s the reference also dropped taken out, the rest
+  // of such a file is held to the same bytes.
+  const withoutDroppedMarkup = (svg: string) =>
+    svg
+      .replace(/<text\b[\s\S]*?<\/text>/g, "")
+      .replace(/<line\b[^>]*\/>/g, "")
+      .replace(/\sstroke[\w-]*="[^"]*"/g, "");
+
+  test("the tree carries SVGs to check", () => {
+    expect(files.length).toBeGreaterThan(0);
+  });
+
+  for (const file of files) {
+    test(file, async () => {
+      const svg = await Bun.file(join(ROOT, file)).text();
+      for (const density of [1, 2, 3]) {
+        let want;
+        try {
+          want = referenceBakeSvg(svg, density);
+        } catch {
+          return; // the reference refuses it; nothing to hold
+        }
+        if (/<text\b/.test(svg)) {
+          expect(() => bakeSvg(svg, density)).toThrow("<text> is not drawn by this baker");
+          const stripped = withoutDroppedMarkup(svg);
+          expect(bakeSvg(stripped, density).rgba).toEqual(referenceBakeSvg(stripped, density).rgba);
+          continue;
+        }
+        const got = bakeSvg(svg, density);
+        expect([got.width, got.height]).toEqual([want.width, want.height]);
+        expect(Buffer.from(got.rgba).equals(Buffer.from(want.rgba))).toBe(true);
+      }
+    }, 60_000);
+  }
+});
+
+describe("svg bake cost", () => {
+  // The reference took more than ten minutes on this path; the scanline
+  // touches each crossing once per sample row.
+  test("the 952-cell hex grid and its stroked twin bake inside five seconds", () => {
+    const t = performance.now();
+    bakeSvg(hexGridSvg());
+    bakeSvg(hexGridStrokeSvg());
+    expect(performance.now() - t).toBeLessThan(5000);
+  });
+});
