+++ b/engine/core/src/shutter.rs
@@ -0,0 +1,202 @@
+//! A baked timeline evaluated at a sub-tick instant, for a shutter
+//! (pocket-motion, patches/0034).
+//!
+//! The realm samples a timeline at whole ticks. A shutter renders one frame as
+//! the average of several samples spread over an exposure, and a sample needs
+//! the value between two ticks. This module defines it, narrowly:
+//!
+//! - Only TRANSFORM props are ever evaluated off the tick (`integrates`).
+//!   Opacity, colours, layout and paint props keep the value of the frame's
+//!   own tick in every sample, so a gate stays a gate and a fade reads as it
+//!   does unblurred.
+//! - Between ticks `n` and `n + 1` the value is the segment's own eased curve
+//!   at the fraction, and ONLY when both ticks sit on one segment that has at
+//!   least one interior tick and whose curve the realm's value at `n + 1`
+//!   continues. Everything else is a JUMP: a zero-length keyframe interval, a
+//!   one-tick segment, a fill-less start or end, a choreography loop wrap, and
+//!   an iteration wrap whose end differs from its start (rotations compare
+//!   modulo 360). A sample never reaches across a jump: it is clamped to the
+//!   tick on the canonical side, so no two samples of one frame straddle one.
+//! - Offset 0 takes `sample_track` at the canonical tick — the expression
+//!   `tick_timelines` uses — so a one-sample shutter is the unblurred frame.
+//!
+//! Tracks spawned by `animate()` and transitions, springs and physics are not
+//! timelines and keep their tick value in every sample.
+
+use crate::anim;
+use crate::spec;
+use crate::spec::style_table as st;
+use crate::style::{Timeline, TimelineTrack};
+
+/// Props the shutter evaluates off the tick. All are paint-time (none is
+/// layout-dirtying), so a sample costs a draw and a raster, never a relayout.
+pub fn integrates(prop: u8) -> bool {
+    use spec::prop as p;
+    matches!(
+        prop,
+        p::TRANSLATE_X
+            | p::TRANSLATE_Y
+            | p::TRANSLATE_Z
+            | p::SCALE
+            | p::SCALE_X
+            | p::SCALE_Y
+            | p::ROTATE
+            | p::ROTATE_X
+            | p::ROTATE_Y
+            | p::SKEW_X
+    )
+}
+
+fn rotary(prop: u8) -> bool {
+    use spec::prop as p;
+    matches!(prop, p::ROTATE | p::ROTATE_X | p::ROTATE_Y)
+}
+
+/// Two raw f32 payloads the realm draws identically.
+fn same_picture(prop: u8, a: u32, b: u32) -> bool {
+    let (x, y) = (f32::from_bits(a), f32::from_bits(b));
+    if x == y {
+        return true;
+    }
+    if rotary(prop) {
+        let k = (x - y) / 360.0;
+        return k == (k as i32) as f32;
+    }
+    false
+}
+
+/// The value `tick_timelines` writes for `track` when the instance's clock
+/// reads `n` (None = the timeline does not write the prop at `n`).
+pub fn value_at(tl: &Timeline, loop_frames: u16, track: &TimelineTrack, n: u32) -> Option<u32> {
+    let is_color = spec::PROP_VALUE_KIND[track.prop as usize] == spec::value_kind::COLOR;
+    let t_abs = if loop_frames > 0 { n % loop_frames as u32 } else { n };
+    let rel = t_abs as i64 - tl.delay_frames as i64;
+    let total = tl.period_frames as i64 * tl.iterations as i64;
+    if rel < 0 {
+        (tl.fill & st::ANIM_FILL_BACKWARDS != 0).then(|| anim::sample_track(track, 0, is_color))
+    } else if tl.iterations != 0 && rel >= total {
+        (tl.fill & st::ANIM_FILL_FORWARDS != 0)
+            .then(|| anim::sample_track(track, tl.period_frames as u32, is_color))
+    } else {
+        let lt = (rel % tl.period_frames as i64) as u32;
+        Some(anim::sample_track(track, lt, is_color))
+    }
+}
+
+/// The value at `lt + p/q` (iteration-local ticks, `0 <= p < q`) if the unit
+/// interval `[lt, lt + 1]` is continuous, given the realm's value at its right
+/// tick; `None` if it is a jump. `wrap`: the right tick is the next
+/// iteration's first.
+fn within_iteration(track: &TimelineTrack, lt: u32, p: i64, q: i64, right: u32, wrap: bool) -> Option<u32> {
+    let prop = track.prop;
+    let seg = track.segments.iter().find(|s| s.t0 as u32 <= lt && lt + 1 <= s.t1 as u32);
+    let Some(s) = seg else {
+        // A hold: constant across the interval only if the right tick holds too.
+        let v = anim::sample_track(track, lt, false);
+        let holds = f32::from_bits(v) == f32::from_bits(right) || (wrap && same_picture(prop, v, right));
+        return holds.then_some(v);
+    };
+    let len = (s.t1 - s.t0) as i64;
+    if len < 2 {
+        return None; // no tick of the realm ever shows this segment in progress
+    }
+    if lt + 1 == s.t1 as u32 {
+        let continues = f32::from_bits(right) == f32::from_bits(s.to)
+            || (wrap && same_picture(prop, s.to, right));
+        if !continues {
+            return None;
+        }
+    }
+    if p == 0 {
+        return Some(anim::sample_track(track, lt, false));
+    }
+    let x = (((lt as i64 - s.t0 as i64) * q + p) as f64 / (len * q) as f64) as f32;
+    const BEZIER: u8 = spec::Easing::CubicBezier as u8;
+    let f = if s.easing == BEZIER {
+        let [x1, y1, x2, y2] = s.bezier;
+        anim::cubic_bezier(x1, y1, x2, y2, x)
+    } else {
+        anim::ease(s.easing, x)
+    };
+    Some(anim::interp(s.from, s.to, f, false))
+}
+
+/// Value at instance clock `m + p/q` (`m >= 0`, `0 <= p < q`) when `[m, m+1]`
+/// is continuous; `None` when it is a jump. Outer Some(None) = not written
+/// across the whole interval.
+fn interval(tl: &Timeline, loop_frames: u16, track: &TimelineTrack, m: u32, p: i64, q: i64) -> Option<Option<u32>> {
+    let va = value_at(tl, loop_frames, track, m);
+    let vb = value_at(tl, loop_frames, track, m + 1);
+    let eq = |a: Option<u32>, b: Option<u32>| match (a, b) {
+        (None, None) => true,
+        (Some(x), Some(y)) => f32::from_bits(x) == f32::from_bits(y),
+        _ => false,
+    };
+    if loop_frames > 0 && (m + 1) % loop_frames as u32 == 0 {
+        // The whole choreography restarts here.
+        return eq(va, vb).then_some(va);
+    }
+    let a = if loop_frames > 0 { m % loop_frames as u32 } else { m };
+    let rel_a = a as i64 - tl.delay_frames as i64;
+    let total = tl.period_frames as i64 * tl.iterations as i64;
+    if rel_a + 1 < 0 || (tl.iterations != 0 && rel_a >= total) {
+        return Some(va); // before the start or after the end: constant
+    }
+    if rel_a < 0 {
+        return eq(va, vb).then_some(va); // the start tick
+    }
+    let period = tl.period_frames as i64;
+    let lt = (rel_a % period) as u32;
+    let right = vb?; // written -> not written is a jump
+    let wrap = lt as i64 + 1 == period && (tl.iterations == 0 || rel_a + 1 < total);
+    within_iteration(track, lt, p, q, right, wrap).map(Some)
+}
+
+/// The value the shutter samples for `track` at instance clock `tc + num/den`
+/// (`den > 0`), where `tc` is the clock the realm last sampled. Clamped to the
+/// tick on `tc`'s side of the first jump between the two.
+pub fn sampled(tl: &Timeline, loop_frames: u16, track: &TimelineTrack, tc: u32, num: i64, den: i64) -> Option<u32> {
+    let at = |n: i64| value_at(tl, loop_frames, track, n as u32);
+    if num == 0 {
+        return at(tc as i64);
+    }
+    let whole = num.div_euclid(den);
+    let p = num.rem_euclid(den);
+    let target = tc as i64 + whole;
+    let continuous = |m: i64| interval(tl, loop_frames, track, m as u32, 0, 1).is_some();
+    if num > 0 {
+        let mut m = tc as i64;
+        while m < target {
+            if !continuous(m) {
+                return at(m);
+            }
+            m += 1;
+        }
+        if p == 0 {
+            return at(target);
+        }
+        match interval(tl, loop_frames, track, target as u32, p, den) {
+            Some(v) => v,
+            None => at(target),
+        }
+    } else {
+        let stop = if p > 0 { target + 1 } else { target };
+        let mut m = tc as i64 - 1;
+        while m >= stop {
+            if m < 0 || !continuous(m) {
+                return at(m + 1);
+            }
+            m -= 1;
+        }
+        if p == 0 {
+            return at(target);
+        }
+        if target < 0 {
+            return at(target + 1); // before the instance existed
+        }
+        match interval(tl, loop_frames, track, target as u32, p, den) {
+            Some(v) => v,
+            None => at(target + 1),
+        }
+    }
+}
