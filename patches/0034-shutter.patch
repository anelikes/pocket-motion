+// ---- pocket-motion: shutter (patches/0034) -----------------------------------
+//
+// An exposure is `samples` renders of the current state with every playing
+// baked timeline's transform tracks re-evaluated between ticks
+// (`Ui::shutter_sample`), averaged here in integers. Nothing in it moves a
+// clock or runs guest code; it ends by writing the frame's own values back
+// and walking the draw list once more, so the core, its DrawList and the
+// inspector latches are what a plain render leaves behind.
+
+/// Per physical pixel: four u32 sums (r*a, g*a, b*a, a) over the samples, then
+/// the resolved exposure as RGBA8 in the words after them. One allocation, so
+/// a host that snapshots linear memory can skip it as one range
+/// (`ui_exposure_scratch_ptr`/`_len`): every exposure writes all of it before
+/// reading any of it.
+static mut EXPOSURE_SCRATCH: Vec<u32> = Vec::new();
+/// `(2*sum_c + n) / 2n` for every opaque sum `sum_c`, for the `n` it was built for.
+static mut EXPOSURE_LUT: Vec<u8> = Vec::new();
+static mut EXPOSURE_LUT_N: u32 = 0;
+
+/// Physical pixel count at `scale`, or None when the scale is out of range.
+fn exposure_pixels(scale: u32) -> Option<usize> {
+    if !(1..=raster::MAX_RENDER_SCALE).contains(&scale) {
+        return None;
+    }
+    let (w, h) = ui().viewport();
+    (w as usize)
+        .checked_mul(scale as usize)?
+        .checked_mul((h as usize).checked_mul(scale as usize)?)
+}
+
+/// Size the exposure scratch for `scale` now rather than at the first
+/// exposure. A host that snapshots linear memory calls this before its first
+/// snapshot: the allocation is then part of every snapshot's heap, and a
+/// restore never allocates it again beyond the restored watermark. Returns 1,
+/// or 0 for a scale out of range.
+#[no_mangle]
+pub extern "C" fn ui_exposure_reserve(scale: u32) -> i32 {
+    let Some(pixels) = exposure_pixels(scale) else {
+        return 0;
+    };
+    unsafe {
+        EXPOSURE_SCRATCH.resize(pixels * 5, 0);
+    }
+    1
+}
+
+/// Start of the exposure scratch in linear memory (0 before any is sized).
+#[no_mangle]
+pub extern "C" fn ui_exposure_scratch_ptr() -> u32 {
+    unsafe {
+        if EXPOSURE_SCRATCH.is_empty() {
+            0
+        } else {
+            EXPOSURE_SCRATCH.as_ptr() as u32
+        }
+    }
+}
+
+/// Length of the exposure scratch in bytes.
+#[no_mangle]
+pub extern "C" fn ui_exposure_scratch_len() -> u32 {
+    unsafe { (EXPOSURE_SCRATCH.len() * 4) as u32 }
+}
+
+/// Write the transform timelines at `num/den` ticks from the frame's tick into
+/// the tree (`Ui::shutter_sample`). `num = 0` restores the frame's own values.
+/// For a host that renders the samples itself — the reference the core's
+/// average is checked against.
+#[no_mangle]
+pub extern "C" fn ui_shutter_sample(num: i32, den: i32) {
+    if den > 0 {
+        ui().shutter_sample(num as i64, den as i64)
+    }
+}
+
+/// Sample k of n, centred on the frame's tick and evenly spaced over a span of
+/// `span_num/span_den` ticks: `span * (2k + 1 - n) / 2n`, as a numerator over
+/// a denominator, both exact in i64.
+fn exposure_offset(span_num: u32, span_den: u32, k: i64, n: i64) -> (i64, i64) {
+    (span_num as i64 * (2 * k + 1 - n), span_den as i64 * 2 * n)
+}
+
+/// Back to the frame's own state: the tick's values, and a DrawList (and
+/// inspector latch) walked from them.
+fn exposure_restore() {
+    let u = ui();
+    u.shutter_sample(0, 1);
+    u.draw();
+}
+
+/// Add one straight-alpha RGBA8 sample into the premultiplied accumulator:
+/// per pixel the sums of r*a, g*a, b*a and a, exact in u32 for <= 256 samples
+/// (255 * 255 * 256 < 2^32). Four pixels per step: each channel byte is
+/// multiplied by its pixel's alpha (the alpha byte by 1) into u16, then
+/// widened and added. Same bytes as the scalar loop.
+#[cfg(target_feature = "simd128")]
+fn exposure_accumulate(src: &[u8], acc: &mut [u32]) {
+    use core::arch::wasm32::*;
+    let quads = src.len() / 16;
+    let rgb = u32x4_splat(0x00ff_ffff);
+    let one = u32x4_splat(0x0100_0000);
+    for i in 0..quads {
+        // SAFETY: i*16+16 <= src.len() and acc.len() == src.len(); wasm loads
+        // and stores need no alignment.
+        unsafe {
+            let v = v128_load(src.as_ptr().add(i * 16) as *const v128);
+            let a = i8x16_shuffle::<3, 3, 3, 3, 7, 7, 7, 7, 11, 11, 11, 11, 15, 15, 15, 15>(v, v);
+            let m = v128_bitselect(a, one, rgb);
+            let lo = u16x8_extmul_low_u8x16(v, m);
+            let hi = u16x8_extmul_high_u8x16(v, m);
+            let p = acc.as_mut_ptr().add(i * 16) as *mut v128;
+            v128_store(p, i32x4_add(v128_load(p), u32x4_extend_low_u16x8(lo)));
+            v128_store(p.add(1), i32x4_add(v128_load(p.add(1)), u32x4_extend_high_u16x8(lo)));
+            v128_store(p.add(2), i32x4_add(v128_load(p.add(2)), u32x4_extend_low_u16x8(hi)));
+            v128_store(p.add(3), i32x4_add(v128_load(p.add(3)), u32x4_extend_high_u16x8(hi)));
+        }
+    }
+    exposure_accumulate_scalar(&src[quads * 16..], &mut acc[quads * 16..]);
+}
+
+#[cfg(not(target_feature = "simd128"))]
+fn exposure_accumulate(src: &[u8], acc: &mut [u32]) {
+    exposure_accumulate_scalar(src, acc)
+}
+
+fn exposure_accumulate_scalar(src: &[u8], acc: &mut [u32]) {
+    for (px, a) in src.chunks_exact(4).zip(acc.chunks_exact_mut(4)) {
+        let al = px[3] as u32;
+        a[0] += px[0] as u32 * al;
+        a[1] += px[1] as u32 * al;
+        a[2] += px[2] as u32 * al;
+        a[3] += al;
+    }
+}
+
+/// Resolve `n` accumulated samples to straight-alpha RGBA8, rounding half up:
+/// a = (2*sum_a + n) / 2n, c = (2*sum_ca + sum_a) / (2*sum_a). A pixel opaque
+/// in every sample takes the table, which is the same expression; one no
+/// sample covered is transparent black, the clear colour. A pixel every sample
+/// agrees on resolves to itself, so a region the shutter does not move is
+/// byte-identical at any n.
+fn exposure_resolve(acc: &[u32], out: &mut [u8], n: u32, lut: &[u8]) {
+    let full = 255 * n;
+    for (a, o) in acc.chunks_exact(4).zip(out.chunks_exact_mut(4)) {
+        let sa = a[3];
+        if sa == full {
+            // Opaque: sum_ca = 255 * sum_c exactly.
+            o[0] = lut[(a[0] / 255) as usize];
+            o[1] = lut[(a[1] / 255) as usize];
+            o[2] = lut[(a[2] / 255) as usize];
+            o[3] = 255;
+        } else if sa == 0 {
+            o.copy_from_slice(&[0, 0, 0, 0]);
+        } else {
+            for c in 0..3 {
+                o[c] = ((2 * a[c] as u64 + sa as u64) / (2 * sa as u64)).min(255) as u8;
+            }
+            o[3] = ((2 * sa + n) / (2 * n)) as u8;
+        }
+    }
+}
+
+/// Render one exposure at `scale`: `samples` renders at offsets centred on the
+/// frame's tick, spread over `span_num/span_den` ticks, averaged. Returns the
+/// RGBA8 exposure (physical size, straight alpha), valid until the next
+/// exposure. `samples <= 1` or a zero span is `ui_render_scaled` and nothing
+/// else. Null for a scale out of range, `samples > 256`, or `span_den == 0`.
+#[no_mangle]
+pub extern "C" fn ui_render_exposure(scale: u32, span_num: u32, span_den: u32, samples: u32) -> *const u8 {
+    if samples <= 1 || span_num == 0 {
+        return render_at_scale(scale);
+    }
+    if samples > 256 || span_den == 0 {
+        return core::ptr::null();
+    }
+    let Some(pixels) = exposure_pixels(scale) else {
+        return core::ptr::null();
+    };
+    let n = samples as i64;
+    unsafe {
+        if EXPOSURE_SCRATCH.len() != pixels * 5 {
+            EXPOSURE_SCRATCH.clear();
+            EXPOSURE_SCRATCH.resize(pixels * 5, 0);
+        }
+        let (acc, tail) = EXPOSURE_SCRATCH.split_at_mut(pixels * 4);
+        acc.fill(0);
+        for k in 0..n {
+            let (num, den) = exposure_offset(span_num, span_den, k, n);
+            ui().shutter_sample(num, den);
+            let ptr = render_at_scale(scale);
+            if ptr.is_null() {
+                exposure_restore();
+                return ptr;
+            }
+            exposure_accumulate(&FRAMEBUFFER[..pixels * 4], acc);
+        }
+        exposure_restore();
+        if EXPOSURE_LUT_N != samples {
+            EXPOSURE_LUT.clear();
+            for sc in 0..=255 * samples {
+                EXPOSURE_LUT.push(((2 * sc + samples) / (2 * samples)) as u8);
+            }
+            EXPOSURE_LUT_N = samples;
+        }
+        let out = core::slice::from_raw_parts_mut(tail.as_mut_ptr() as *mut u8, pixels * 4);
+        exposure_resolve(acc, out, samples, &EXPOSURE_LUT);
+        out.as_ptr()
+    }
+}
+
+/// `ui_draw_hash` over an exposure: the per-sample DrawList hashes, in sample
+/// order, folded into one. Hiding a node changes it exactly when the node
+/// emitted geometry in at least one sample. `samples <= 1` or a zero span is
+/// `ui_draw_hash`; 0 for what `ui_render_exposure` refuses.
+#[no_mangle]
+pub extern "C" fn ui_draw_hash_exposure(span_num: u32, span_den: u32, samples: u32) -> u64 {
+    if samples <= 1 || span_num == 0 {
+        return draw_hash(&ui().draw().words);
+    }
+    if samples > 256 || span_den == 0 {
+        return 0;
+    }
+    let n = samples as i64;
+    let mut folded: u64 = 0xcbf2_9ce4_8422_2325;
+    for k in 0..n {
+        let (num, den) = exposure_offset(span_num, span_den, k, n);
+        ui().shutter_sample(num, den);
+        let h = draw_hash(&ui().draw().words);
+        for byte in h.to_le_bytes() {
+            folded ^= byte as u64;
+            folded = folded.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+    }
+    exposure_restore();
+    folded
+}
