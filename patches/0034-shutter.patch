+// ---- shutter: timelines between ticks (pocket-motion patch 0034) -------------
+
+/// One node playing `anims` (comma-list order) under a choreography loop of
+/// `loop_frames` (0 = none), with `base` on its style.
+fn shutter_world(anims: Vec<AnimSpec>, loop_frames: u16, base: Vec<(u8, u32)>) -> (Ui, i32) {
+    let mut s = StyleSpec::new();
+    s.base = base;
+    s.animation = Some((loop_frames, (0..anims.len() as u16).collect()));
+    let mut ui = Ui::new();
+    assert!(ui.load_styles(&encode_styles_with_anims(&[s], &anims)));
+    let n = ui.create_node(0);
+    ui.insert_before(spec::ROOT_ID, n, 0);
+    ui.set_style(n, 0);
+    (ui, n)
+}
+
+fn one_track(delay: u16, period: u16, iterations: u16, fill: u8, prop: u8, segs: Vec<SegSpec>) -> AnimSpec {
+    AnimSpec { delay_frames: delay, period_frames: period, iterations, fill, tracks: alloc::vec![(prop, segs)] }
+}
+
+const FILL_BOTH: u8 = spec::style_table::ANIM_FILL_BACKWARDS | spec::style_table::ANIM_FILL_FORWARDS;
+const LINEAR: u8 = spec::Easing::Linear as u8;
+
+fn lin(t0: u16, t1: u16, from: f32, to: f32) -> SegSpec {
+    SegSpec(t0, t1, from.to_bits(), to.to_bits(), LINEAR, None)
+}
+
+fn tx(ui: &Ui, n: i32) -> f32 {
+    ui.resolved_style(n).unwrap().translate_x
+}
+
+/// Tick until the clock the last tick sampled reads `c`, then return the
+/// tick's value and the value sampled at `c + num/den` (the core is put back
+/// to the tick before returning).
+fn sampled_around(ui: &mut Ui, n: i32, num: i64, den: i64) -> (f32, f32) {
+    let at_tick = tx(ui, n);
+    ui.shutter_sample(num, den);
