+/** Bounds of a normalised outline: on-curve points, plus each cubic's extrema (derivative roots). */
+function bounds(verbs: readonly number[], pts: readonly number[]): [number, number, number, number] | null {
+  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
+  const add = (x: number, y: number): void => {
+    if (x < x0) x0 = x;
+    if (x > x1) x1 = x;
+    if (y < y0) y0 = y;
+    if (y > y1) y1 = y;
+  };
+  const extrema = (p0: number, p1: number, p2: number, p3: number, out: number[]): void => {
+    // B'(t) / 3 = a t^2 + b t + c
+    const a = -p0 + 3 * p1 - 3 * p2 + p3;
+    const b = 2 * (p0 - 2 * p1 + p2);
+    const c = p1 - p0;
+    if (Math.abs(a) < 1e-12) {
+      if (Math.abs(b) > 1e-12) out.push(-c / b);
+      return;
+    }
+    const disc = b * b - 4 * a * c;
+    if (disc < 0) return;
+    const r = Math.sqrt(disc);
+    out.push((-b + r) / (2 * a), (-b - r) / (2 * a));
+  };
+  let k = 0;
+  let px = 0, py = 0;
+  let drew = false;
+  for (const v of verbs) {
+    if (v === PATH_VERB.move) {
+      px = pts[k]!;
+      py = pts[k + 1]!;
+      k += 2;
+    } else if (v === PATH_VERB.line) {
+      add(px, py);
+      px = pts[k]!;
+      py = pts[k + 1]!;
+      add(px, py);
+      k += 2;
+      drew = true;
+    } else if (v === PATH_VERB.cubic) {
+      const [ax, ay, bx, by, ex, ey] = pts.slice(k, k + 6) as [number, number, number, number, number, number];
+      add(px, py);
+      add(ex, ey);
+      const ts: number[] = [];
+      extrema(px, ax, bx, ex, ts);
+      extrema(py, ay, by, ey, ts);
+      for (const t of ts) {
+        if (!(t > 0 && t < 1)) continue;
+        const u = 1 - t;
+        const w0 = u * u * u, w1 = 3 * u * u * t, w2 = 3 * u * t * t, w3 = t * t * t;
+        add(w0 * px + w1 * ax + w2 * bx + w3 * ex, w0 * py + w1 * ay + w2 * by + w3 * ey);
+      }
+      px = ex;
+      py = ey;
+      k += 6;
+      drew = true;
+    }
+  }
+  return drew ? [x0, y0, x1, y1] : null;
+}
+
+/** A px number for a class token or an outline: thousandths, no exponent, no -0. */
+function fmt(v: number): string {
+  const r = Math.round(v * 1000) / 1000;
+  return r === 0 ? "0" : String(r);
+}
+
+function hexColor([r, g, b, a]: [number, number, number, number]): string {
+  const h = (n: number): string => n.toString(16).padStart(2, "0");
+  return `#${h(r)}${h(g)}${h(b)}${a === 255 ? "" : h(a)}`;
+}
+
+// ---- the import -----------------------------------------------------------------------------
+
+/** One node of the expansion: a View (a `<g>` with an id) or a `<Path>`. */
+export interface SvgPart {
+  kind: "group" | "path";
+  /** The element's id, which becomes the node's debugName. */
+  id?: string;
+  /** The node's own class tokens: its box relative to its parent, its paint, its opacity. */
+  cls: string;
+  /** The outline, in px relative to the node's box (paths only). */
+  d?: string;
+  children: SvgPart[];
+  /** 1-based line of the element in the .svg. */
+  line: number;
+}
+
+export interface SvgImport {
+  /** The picture's box, px. */
+  width: number;
+  height: number;
+  /** The root's overflow clips the picture to its box (SVG's default for the outermost svg). */
+  clip: boolean;
+  /** The canvas's children, positioned in it. */
+  parts: SvgPart[];
+  /** Every id carried by a node, in document order. */
+  ids: string[];
+  /** Ids the file declares on elements that draw nothing, with why. */
+  skipped: Map<string, string>;
+}
+
+interface Box {
+  x0: number;
+  y0: number;
+  x1: number;
+  y1: number;
+}
+
+/** A node before placement: its box is absolute on the canvas, its outline relative to that box. */
+interface Built {
+  kind: "group" | "path";
+  id?: string;
+  /** Paint and opacity tokens; the placement is prepended by `finish`. */
+  tokens: string[];
+  d?: string;
+  box: Box;
+  children: Built[];
+  line: number;
+}
+
+/** A node placed in its parent's box. */
+function finish(b: Built, parent: Box | null): SvgPart {
+  const place =
+    `absolute left-[${b.box.x0 - (parent?.x0 ?? 0)}px] top-[${b.box.y0 - (parent?.y0 ?? 0)}px] ` +
+    `w-[${b.box.x1 - b.box.x0}px] h-[${b.box.y1 - b.box.y0}px]`;
+  return {
+    kind: b.kind,
+    ...(b.id !== undefined ? { id: b.id } : {}),
+    cls: [place, ...b.tokens].join(" "),
+    ...(b.d !== undefined ? { d: b.d } : {}),
+    children: b.children.map((c) => finish(c, b.box)),
+    line: b.line,
+  };
+}
+
+/**
+ * Import an SVG document as positioned outlines. `size` overrides the root's
+ * width and height (px); without it they are read from the root, falling
+ * back to the viewBox's size.
+ */
+export function importSvg(text: string, size: { width?: number; height?: number } = {}): SvgImport {
+  const root = parseXml(text);
+  if (root.name !== "svg") throw new SvgImportError(`the root element is <${root.name}>, not <svg>`);
+  const rootOwn = ownProperties(root);
+  if (rootOwn.transform !== undefined) {
+    throw new SvgImportError("a transform on the root <svg> is not read - wrap the content in a <g transform>");
+  }
+  let vb: [number, number, number, number] | null = null;
+  if (root.attrs.viewBox !== undefined) {
+    const v = numberList(root.attrs.viewBox, "viewBox");
+    if (v.length !== 4 || !(v[2]! > 0) || !(v[3]! > 0)) throw new SvgImportError(`viewBox=${JSON.stringify(root.attrs.viewBox)} is not "x y w h" with w and h above 0`);
+    vb = v as [number, number, number, number];
+  }
+  // The root's own size, unless the element gives one: an editor's `210mm`
+  // or `100%` is a size this cannot read, and the element's px are the answer.
+  const rootSize = (k: "width" | "height", fallback: number | undefined): number | undefined => {
+    if (root.attrs[k] === undefined) return fallback;
+    try {
+      return parseLength(root.attrs[k], k, 0);
+    } catch (e) {
+      throw new SvgImportError(`${(e as Error).message} - give the <Svg> width and height in px`);
+    }
+  };
+  const width = size.width ?? rootSize("width", vb?.[2]);
+  const height = size.height ?? rootSize("height", vb?.[3]);
+  if (width === undefined || height === undefined) {
+    throw new SvgImportError("the root <svg> has no width, height or viewBox - give the <Svg> width and height");
+  }
+  if (!(width > 0) || !(height > 0)) throw new SvgImportError(`the picture's size ${width}x${height} is not above 0`);
+
+  // The viewport map: viewBox -> px, by preserveAspectRatio.
+  let viewport: Mat = IDENTITY;
+  if (vb) {
+    const par = (root.attrs.preserveAspectRatio ?? "xMidYMid meet").trim().replace(/^defer\s+/, "");
+    const m = /^(none|x(Min|Mid|Max)Y(Min|Mid|Max))(?:\s+(meet|slice))?$/.exec(par);
+    if (!m) throw new SvgImportError(`preserveAspectRatio=${JSON.stringify(root.attrs.preserveAspectRatio)} does not parse`);
+    const [vx, vy, vw, vh] = vb;
+    if (m[1] === "none") {
+      const sx = width / vw, sy = height / vh;
+      viewport = [sx, 0, 0, sy, -vx * sx, -vy * sy];
+    } else {
+      const s = m[4] === "slice" ? Math.max(width / vw, height / vh) : Math.min(width / vw, height / vh);
+      const align = (k: string | undefined, room: number): number => (k === "Min" ? 0 : k === "Max" ? room : room / 2);
+      viewport = [s, 0, 0, s, align(m[2], width - vw * s) - vx * s, align(m[3], height - vh * s) - vy * s];
+    }
+  }
+  const overflow = (rootOwn.overflow ?? "hidden").trim();
+  if (!["hidden", "visible", "scroll", "auto"].includes(overflow)) throw new SvgImportError(`overflow=${JSON.stringify(overflow)} does not parse`);
+
+  const ids: string[] = [];
+  const seenIds = new Map<string, number>();
+  const skipped = new Map<string, string>();
+  const at = (el: XmlElement, e: unknown): never => {
+    const id = el.attrs.id !== undefined ? ` id=${JSON.stringify(el.attrs.id)}` : "";
+    const msg = e instanceof Error ? e.message : String(e);
+    throw new SvgImportError(`<${el.name}${id}> (line ${el.line}): ${msg}`);
+  };
+
+  const inherit = (parent: Record<string, string>, own: Record<string, string>): Record<string, string> => {
+    const out = { ...parent };
+    for (const k of INHERITED) {
+      const v = own[k];
+      if (v !== undefined && v.trim() !== "inherit") out[k] = v;
+    }
+    return out;
+  };
+
+  const claimId = (el: XmlElement): string | undefined => {
+    const id = el.attrs.id;
+    if (id === undefined) return undefined;
+    if (id.trim() === "") throw new SvgImportError("an empty id");
+    const prev = seenIds.get(id);
+    if (prev !== undefined) throw new SvgImportError(`id ${JSON.stringify(id)} is also on line ${prev}; ids name parts and must be unique`);
+    seenIds.set(id, el.line);
+    return id;
+  };
+
+  /** Refuse anything in a subtree that is refused by name; nothing in it is drawn. */
+  const refuseInside = (el: XmlElement): void => {
+    for (const c of el.children) {
+      if (c.name.includes(":") || DESCRIPTIVE.has(c.name)) continue;
+      const hint = REFUSED_ELEMENTS[c.name.toLowerCase()];
+      if (hint !== undefined) at(c, hint);
+      if (c.name !== "g" && !SHAPES.has(c.name) && c.name !== "defs") at(c, "is not an element this import reads");
+      if (c.attrs.id !== undefined && !skipped.has(c.attrs.id)) skipped.set(c.attrs.id, "it is inside <defs>, which is not drawn");
+      refuseInside(c);
+    }
+  };
+
+  const opacityTokens = (own: Record<string, string>): string[] => {
+    if (own.opacity === undefined) return [];
+    const o = parseAlpha(own.opacity, "opacity");
+    return o === 1 ? [] : [`opacity-${fmt(o * 100)}`];
+  };
+
+  /** Children of a container element, unnamed groups flattened into them. */
+  const walkChildren = (el: XmlElement, ctm: Mat, props: Record<string, string>): Built[] => {
+    const out: Built[] = [];
+    for (const c of el.children) {
+      if (c.name.includes(":") || DESCRIPTIVE.has(c.name)) continue; // an editor's metadata; never drawn
+      const hint = REFUSED_ELEMENTS[c.name.toLowerCase()];
+      if (hint !== undefined) at(c, hint);
+      if (c.name === "defs") {
+        // Nothing in <defs> is drawn; what is refused by name is refused there too.
+        refuseInside(c);
+        continue;
+      }
+      if (c.name !== "g" && !SHAPES.has(c.name)) at(c, "is not an element this import reads");
+      let built: Built | Built[] | null;
+      try {
+        built = element(c, ctm, props);
+      } catch (e) {
+        if (e instanceof SvgImportError && e.message.startsWith("<")) throw e;
+        if (e instanceof SvgImportError || e instanceof PathDataError) at(c, e);
+        throw e;
+      }
+      if (built === null) continue;
+      if (Array.isArray(built)) out.push(...built);
+      else out.push(built);
+    }
+    return out;
+  };
+
+  const element = (el: XmlElement, parentCtm: Mat, parentProps: Record<string, string>): Built | Built[] | null => {
+    const own = ownProperties(el);
+    const id = claimId(el);
+    const skip = (why: string): null => {
+      if (id !== undefined) skipped.set(id, why);
+      return null;
+    };
+    if ((own.display ?? "").trim() === "none") return skip('display="none"');
+    const props = inherit(parentProps, own);
+    const ctm = own.transform !== undefined ? mul(parentCtm, parseTransform(own.transform)) : parentCtm;
+
+    if (el.name === "g") {
+      const kids = walkChildren(el, ctm, props);
+      if (kids.length === 0) return skip("it contains nothing that draws");
+      const opacity = opacityTokens(own);
+      // A group with no id and no opacity is only a transform and a cascade, both
+      // already applied to its children: it adds no node.
+      if (id === undefined && opacity.length === 0) return kids;
+      const box: Box = {
+        x0: Math.min(...kids.map((k) => k.box.x0)),
+        y0: Math.min(...kids.map((k) => k.box.y0)),
+        x1: Math.max(...kids.map((k) => k.box.x1)),
+        y1: Math.max(...kids.map((k) => k.box.y1)),
+      };
+      if (id !== undefined) ids.push(id);
+      return { kind: "group", ...(id !== undefined ? { id } : {}), tokens: opacity, box, children: kids, line: el.line };
+    }
+
+    const inner = el.children.find((c) => !c.name.includes(":") && !DESCRIPTIVE.has(c.name));
+    if (inner) {
+      const hint = REFUSED_ELEMENTS[inner.name.toLowerCase()];
+      if (hint !== undefined) at(inner, hint);
+      throw new SvgImportError(`it holds <${inner.name}> (line ${inner.line}); a shape's children are not drawn`);
+    }
+    if ((props.visibility ?? "visible").trim() !== "visible") return skip(`visibility="${props.visibility}"`);
+    const data = shapeData(el, own);
+    if (data === null) return skip("its geometry is empty");
+    const norm = normalizePathData(data);
+
+    // Fold the element's transform and the viewport into the outline.
+    const m = mul(viewport, ctm);
+    const pts = norm.pts.slice();
+    for (let k = 0; k < pts.length; k += 2) {
+      const x = pts[k]!, y = pts[k + 1]!;
+      pts[k] = m[0] * x + m[2] * y + m[4];
+      pts[k + 1] = m[1] * x + m[3] * y + m[5];
+    }
+    const b = bounds(norm.verbs, pts);
+    if (b === null) return skip("its geometry is empty");
+
+    // Paint.
+    const color = props.color ?? INITIAL.color!;
+    const fill = parseColor(props.fill ?? INITIAL.fill!, "fill", color);
+    const stroke = parseColor(props.stroke ?? INITIAL.stroke!, "stroke", color);
+    const fillAlpha = parseAlpha(props["fill-opacity"] ?? "1", "fill-opacity");
+    const strokeAlpha = parseAlpha(props["stroke-opacity"] ?? "1", "stroke-opacity");
+    const tokens: string[] = [];
+    // A line encloses no area; a polyline is filled as if closed, as SVG fills it.
+    if (fill && el.name !== "line") {
+      const a = Math.round(fill[3] * fillAlpha);
+      if (a > 0) tokens.push(`fill-[${hexColor([fill[0], fill[1], fill[2], a])}]`);
+    }
+    const rule = (props["fill-rule"] ?? "nonzero").trim();
+    if (rule !== "nonzero" && rule !== "evenodd") throw new SvgImportError(`fill-rule=${JSON.stringify(rule)} is not nonzero or evenodd`);
+    if (rule === "evenodd" && tokens.length > 0) tokens.push("fill-evenodd");
+    let halfStroke = 0;
+    const userWidth = parseLength(props["stroke-width"], "stroke-width", 1);
+    if (userWidth < 0) throw new SvgImportError(`stroke-width=${JSON.stringify(props["stroke-width"])} is negative`);
+    const strokeA = stroke ? Math.round(stroke[3] * strokeAlpha) : 0;
+    if (stroke && strokeA > 0 && userWidth > 0) {
+      // A stroke is drawn in the element's own units and then transformed; folded
+      // into px it is one width only when the map is a uniform scale and rotation.
+      const [a, bb, c, d] = m;
+      const sx2 = a * a + bb * bb;
+      const sy2 = c * c + d * d;
+      const dot = a * c + bb * d;
+      const tol = 1e-9 * Math.max(sx2, sy2);
+      if (Math.abs(sx2 - sy2) > tol || Math.abs(dot) > tol) {
+        throw new SvgImportError(
+          `it is stroked under a transform that is not a uniform scale and rotation ` +
+            `(matrix ${[a, bb, c, d].map(fmt).join(" ")}, the viewBox map included); its stroke would not keep SVG's shape - ` +
+            "outline the stroke in the file, or remove the skew or non-uniform scale",
+        );
+      }
+      const w = userWidth * Math.sqrt(sx2);
+      halfStroke = w / 2;
+      tokens.push(`stroke-[${hexColor([stroke[0], stroke[1], stroke[2], strokeA])}]`, `stroke-[${fmt(w)}px]`);
+      const join = (props["stroke-linejoin"] ?? "miter").trim();
+      if (join !== "miter" && join !== "round" && join !== "bevel") throw new SvgImportError(`stroke-linejoin=${JSON.stringify(join)} is not miter, round or bevel`);
+      if (join !== "miter") tokens.push(`stroke-join-${join}`);
+      const cap = (props["stroke-linecap"] ?? "butt").trim();
+      if (cap !== "butt" && cap !== "round" && cap !== "square") throw new SvgImportError(`stroke-linecap=${JSON.stringify(cap)} is not butt, round or square`);
+      if (cap !== "butt") tokens.push(`stroke-cap-${cap}`);
+      const miter = parseLength(props["stroke-miterlimit"], "stroke-miterlimit", 4);
+      if (!(miter >= 1)) throw new SvgImportError(`stroke-miterlimit=${JSON.stringify(props["stroke-miterlimit"])} is under 1`);
+      if (miter !== 4) tokens.push(`stroke-miter-[${fmt(miter)}]`);
+    }
+
+    // The node's box: the outline's bounds, half a stroke out, on whole px.
+    const box: Box = {
+      x0: Math.floor(b[0] - halfStroke),
+      y0: Math.floor(b[1] - halfStroke),
+      x1: Math.ceil(b[2] + halfStroke),
+      y1: Math.ceil(b[3] + halfStroke),
+    };
+    if (box.x1 <= box.x0) box.x1 = box.x0 + 1;
+    if (box.y1 <= box.y0) box.y1 = box.y0 + 1;
+    let d = "";
+    let k = 0;
+    for (const v of norm.verbs) {
+      const p = (n: number): string => `${fmt(pts[k + n]! - box.x0)} ${fmt(pts[k + n + 1]! - box.y0)}`;
+      if (v === PATH_VERB.move) { d += `M${p(0)}`; k += 2; }
+      else if (v === PATH_VERB.line) { d += `L${p(0)}`; k += 2; }
+      else if (v === PATH_VERB.cubic) { d += `C${p(0)} ${p(2)} ${p(4)}`; k += 6; }
+      else d += "Z";
+    }
+    if (id !== undefined) ids.push(id);
+    return { kind: "path", ...(id !== undefined ? { id } : {}), tokens: [...tokens, ...opacityTokens(own)], d, box, children: [], line: el.line };
+  };
+
+  const rootProps = inherit(INITIAL, rootOwn);
+  const parts = walkChildren(root, IDENTITY, rootProps).map((b) => finish(b, null));
+  // In document order: the order the walk claimed them, not the order it finished them.
+  const emitted = new Set(ids);
+  return { width, height, clip: overflow !== "visible", parts, ids: [...seenIds.keys()].filter((id) => emitted.has(id)), skipped };
+}
+
+// ---- where a module uses <Svg> --------------------------------------------------------------
+
+/** The import sources `Svg` is the framework's component under. */
+export function isSvgComponentSource(source: string): boolean {
+  return /^@pocketjs\/framework(?:\/solid)?\/components$/.test(source);
+}
+
+export interface SvgSite {
+  /** The `src` as written. */
+  src: string;
+  /** 1-based line and column of the `src` value (its opening quote). */
+  line: number;
+  column: number;
+  /** `width`/`height` written as number literals, when they are. */
+  width?: number;
+  height?: number;
+}
+
+/**
+ * Every `<Svg src="…">` in a module, by parsing it — the same elements the
+ * build expands: a JSX element named by a binding imported as `Svg` from the
+ * framework's components. What `lint` reads, so it answers about the files
+ * the build would open.
+ */
+export function svgSites(source: string, filename: string): SvgSite[] {
+  let ast: unknown;
+  try {
+    ast = babelParse(source, { sourceType: "module", plugins: ["jsx", "typescript"], sourceFilename: filename });
+  } catch {
+    return []; // a module that does not parse is the build's error, not this one's
+  }
+  const locals = new Set<string>();
+  const sites: SvgSite[] = [];
+  const visit = (node: unknown, collect: boolean): void => {
+    if (Array.isArray(node)) {
+      for (const n of node) visit(n, collect);
+      return;
+    }
+    if (node === null || typeof node !== "object") return;
+    const n = node as Record<string, unknown> & { type?: string };
+    if (!collect && n.type === "ImportDeclaration" && isSvgComponentSource((n.source as { value: string }).value)) {
+      for (const s of n.specifiers as Array<{ type: string; imported?: { name?: string; value?: string }; local: { name: string } }>) {
+        if (s.type === "ImportSpecifier" && (s.imported?.name ?? s.imported?.value) === "Svg") locals.add(s.local.name);
+      }
+    }
+    if (collect && n.type === "JSXOpeningElement") {
+      const name = n.name as { type: string; name?: string };
+      if (name.type === "JSXIdentifier" && locals.has(name.name!)) {
+        const site = siteOf(n.attributes as unknown[]);
+        if (site) sites.push(site);
+      }
+    }
+    for (const key of Object.keys(n)) {
+      if (key === "loc" || key === "start" || key === "end" || key === "extra") continue;
+      visit(n[key], collect);
+    }
+  };
+  const program = (ast as { program: unknown }).program;
+  visit(program, false);
+  if (locals.size > 0) visit(program, true);
+  return sites;
+}
+
+function literalString(v: unknown): { value: string; loc: { line: number; column: number } } | null {
+  const n = v as { type?: string; value?: string; expression?: unknown; quasis?: Array<{ value: { cooked?: string } }>; expressions?: unknown[]; loc?: { start: { line: number; column: number } } } | null;
+  if (!n) return null;
+  if (n.type === "StringLiteral") return { value: n.value!, loc: n.loc!.start };
+  if (n.type === "JSXExpressionContainer") return literalString(n.expression);
+  if (n.type === "TemplateLiteral" && n.expressions!.length === 0 && n.quasis!.length === 1) {
+    return { value: n.quasis![0]!.value.cooked ?? "", loc: n.loc!.start };
+  }
+  return null;
+}
+
+function literalNumber(v: unknown): number | undefined {
+  const n = v as { type?: string; value?: unknown; expression?: unknown } | null;
+  if (!n) return undefined;
+  if (n.type === "NumericLiteral") return n.value as number;
+  if (n.type === "JSXExpressionContainer") return literalNumber(n.expression);
+  if (n.type === "StringLiteral" && /^\s*\d+(?:\.\d+)?\s*$/.test(n.value as string)) return Number(n.value);
+  return undefined;
+}
+
+function siteOf(attributes: unknown[]): SvgSite | null {
+  let site: SvgSite | null = null;
+  let width: number | undefined;
+  let height: number | undefined;
