+// An SVG document -> a tree of `<Path>`s (pocket-motion patch 0053).
+//
+// `<Svg src="./robot.svg" parts={{ arm: "animate-draw" }} />` is expanded by
+// the build (jsx-plugin.ts) into Views and `<Path>`s whose outlines are
+// literals, so the collector bakes them like any other `<Path>` and every
+// part is a node an animation, `assert` or `visibility` can name. This module
+// is the document half: it reads the XML subset, resolves the presentation
+// cascade and turns every shape into a positioned outline with its paint as
+// class tokens. Nothing here draws; the core's PATH op does.
+//
+// Every element's transform, the viewBox and preserveAspectRatio are FOLDED
+// into the outlines, which are written in px relative to their own box: a
+// part's node is its own bounds, so its transform origin (the box centre) is
+// the centre of the part — CSS `transform-box: fill-box`, which is what a
+// rotate or scale on one part means to an author — and a View's transform
+// props stay free for the author's animation instead of holding the file's.
+//
+// Determinism: the outlines become pak bytes, so nothing here may depend on
+// the host's libm. Rotations and skews go through path-data.ts's `cosSinDeg`
+// (exact at multiples of 90 degrees, a fixed f64 series elsewhere); every
+// other step is + - * / and Math.sqrt.
+
+import { parse as babelParse } from "@babel/parser";
+import { PATH_VERB } from "../../contracts/spec/spec.ts";
+import { cosSinDeg, normalizePathData, PathDataError } from "./path-data.ts";
+
+/** A refusal, naming the element (and its line in the .svg) it is about. */
+export class SvgImportError extends Error {}
+
+// ---- XML ------------------------------------------------------------------------------------
+
+export interface XmlElement {
+  name: string;
+  attrs: Record<string, string>;
+  children: XmlElement[];
+  /** 1-based line of the start tag in the document. */
+  line: number;
+}
+
+const NAMED_ENTITIES: Record<string, string> = { amp: "&", lt: "<", gt: ">", quot: '"', apos: "'" };
+
+function decodeEntities(v: string, line: number): string {
+  return v.replace(/&(#x[0-9a-fA-F]+|#\d+|[A-Za-z][\w.-]*);/g, (_, ref: string) => {
+    if (ref[0] === "#") {
+      const cp = ref[1] === "x" ? parseInt(ref.slice(2), 16) : parseInt(ref.slice(1), 10);
+      if (!(cp >= 0 && cp <= 0x10ffff)) throw new SvgImportError(`line ${line}: &${ref}; is not a character`);
+      return String.fromCodePoint(cp);
+    }
+    const ch = NAMED_ENTITIES[ref];
+    if (ch === undefined) throw new SvgImportError(`line ${line}: entity &${ref}; is not one of XML's five`);
+    return ch;
+  });
+}
+
+/** The element tree of an XML document: comments, processing instructions, the doctype and CDATA dropped. */
+export function parseXml(text: string): XmlElement {
+  const src = text.charCodeAt(0) === 0xfeff ? text.slice(1) : text;
+  let i = 0;
+  let line = 1;
+  const advanceTo = (j: number): void => {
+    for (let k = i; k < j; k++) if (src.charCodeAt(k) === 10) line++;
+    i = j;
+  };
+  const skipPast = (end: string, what: string): void => {
+    const j = src.indexOf(end, i);
+    if (j < 0) throw new SvgImportError(`line ${line}: unterminated ${what}`);
