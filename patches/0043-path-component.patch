+// The key a `<Path>` resolves through (pocket-motion patch 0043).
+//
+// A `<Path>`'s `d` (one string, or the morph keys as an array) and its
+// `viewBox` name ONE PATH TABLE entry. The build (tools/build.ts) bakes an
+// entry per distinct pair it finds written as literals and records each
+// pair's key in the generated styles module; at mount the component computes
+// the same key from the values it was given and the renderer looks it up.
+// Sharing this one function is what makes the two agree.
+
+/** The PATH_IDS key of a `<Path>`'s `d` and `viewBox`. */
+export function pathKey(d: string | readonly string[], viewBox?: string): string {
+  return JSON.stringify([typeof d === "string" ? [d] : [...d], viewBox ?? null]);
+}
