index 00000000..84c13bc7
--- /dev/null
+++ b/framework/compiler/path-data.ts
@@ -0,0 +1,464 @@
+// SVG path data -> PATH TABLE entries (pocket-motion patch 0043).
+//
+// `<Path d="…">` names an outline the build bakes: this module parses the
+// whole SVG path grammar (implicit repeats, exponents, arc flags written
+// without separators), normalises it to the four verbs the core draws —
+// move, line, cubic, close — and aligns the morph keys of one `<Path>` to
+// one verb list. The core then morphs, flattens, trims and strokes the entry
+// per frame (engine/core/src/path.rs); nothing here depends on a target.
+//
+// Determinism: a pak's bytes must not depend on the machine that built it,
+// and JavaScriptCore's Math.sin/cos/atan2 are implementation-defined. So an
+// arc is converted with + - * / and Math.sqrt alone, which IEEE 754 rounds
+// correctly on every host: its sweep is split by bisection of unit vectors,
+// never by an angle, and each piece's control length comes from half-angle
+// identities. The one transcendental is the arc's x-axis rotation, an angle
+// the author wrote in degrees; it goes through `sinDeg`/`cosDeg` below, a
+// Taylor series evaluated in f64 after an exact reduction, so 0, 90, 180 and
+// 270 degrees are exact and every other angle is the same bits everywhere.
+
+import { PATH_MAX_SHAPES, PATH_VERB, type PathEntry } from "../../contracts/spec/spec.ts";
+
+/** A refusal, with the source position (0-based character offset) when there is one. */
+export class PathDataError extends Error {}
+
+const ARG_COUNT: Record<string, number> = { m: 2, l: 2, h: 1, v: 1, c: 6, s: 4, q: 4, t: 2, a: 7, z: 0 };
+
+interface Command {
+  /** The letter as written (case carries relative/absolute). */
+  letter: string;
+  args: number[];
+  /** Ordinal of the command in the source, counting implicit repeats. */
+  index: number;
+}
+
+const WSP = /[\x20\x09\x0a\x0c\x0d]/;
+const NUMBER = /[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?/y;
+
+/** Parse `d` into commands, each with exactly its argument count. */
+export function parsePathData(d: string): Command[] {
+  const out: Command[] = [];
+  let i = 0;
+  const n = d.length;
+  const skip = (): void => {
+    while (i < n && WSP.test(d[i]!)) i++;
+  };
+  const skipComma = (): void => {
+    skip();
+    if (d[i] === ",") {
+      i++;
+      skip();
+    }
+  };
+  const fail = (what: string): never => {
+    throw new PathDataError(`${what} at character ${i} of ${JSON.stringify(d.length > 60 ? d.slice(0, 57) + "..." : d)}`);
+  };
+  const number = (): number => {
+    NUMBER.lastIndex = i;
+    const m = NUMBER.exec(d);
+    if (!m) fail("expected a number");
+    i += m![0].length;
+    const v = Number(m![0]);
+    if (!Number.isFinite(v)) fail(`${m![0]} is not finite`);
+    return v;
+  };
+  const flag = (): number => {
+    const c = d[i];
+    if (c !== "0" && c !== "1") fail("expected an arc flag (0 or 1)");
+    i++;
+    return c === "1" ? 1 : 0;
+  };
+  const startsNumber = (): boolean => i < n && /[+\-.\d]/.test(d[i]!);
+  skip();
+  let index = 0;
+  while (i < n) {
+    const letter = d[i]!;
+    const lower = letter.toLowerCase();
+    if (!(lower in ARG_COUNT)) fail(`unknown command ${JSON.stringify(letter)}`);
+    if (out.length === 0 && lower !== "m") fail("path data starts with a moveto");
+    i++;
+    skip();
+    const count = ARG_COUNT[lower]!;
+    if (count === 0) {
+      out.push({ letter, args: [], index: index++ });
+      skip();
+      continue;
+    }
+    // One argument group, then as many more as follow; after a moveto the
+    // further pairs are linetos of the same case (SVG 1.1, 8.3.2).
+    let first = true;
+    do {
+      const args: number[] = [];
+      for (let k = 0; k < count; k++) {
+        if (k > 0) skipComma();
+        args.push(lower === "a" && (k === 3 || k === 4) ? flag() : number());
+      }
+      const name = first ? letter : lower === "m" ? (letter === "m" ? "l" : "L") : letter;
+      out.push({ letter: name, args, index: index++ });
+      first = false;
+      skipComma();
+    } while (startsNumber());
+  }
+  if (out.length === 0) fail("empty path data");
+  return out;
+}
+
+// ---- deterministic degree trigonometry ------------------------------------------------
+
+/** sin(x) for |x| <= pi/4, Taylor to x^21 (error below 1e-22). */
+function sinSeries(x: number): number {
+  const x2 = x * x;
+  let t = 1;
+  for (let k = 21; k >= 3; k -= 2) t = 1 - (x2 / (k * (k - 1))) * t;
+  return x * t;
+}
+
+/** cos(x) for |x| <= pi/4, Taylor to x^22. */
+function cosSeries(x: number): number {
+  const x2 = x * x;
+  let t = 1;
+  for (let k = 22; k >= 2; k -= 2) t = 1 - (x2 / (k * (k - 1))) * t;
+  return t;
+}
+
+/** [cos, sin] of an angle in degrees: exact at multiples of 90, a fixed f64 sequence elsewhere. */
+export function cosSinDeg(deg: number): [number, number] {
+  let r = deg - 360 * Math.floor(deg / 360); // [0, 360)
+  if (r >= 360) r -= 360;
+  // Quadrant, then the octant within it, by exact comparisons.
+  const q = Math.floor(r / 90);
+  const a = r - 90 * q; // [0, 90)
+  let c: number;
+  let s: number;
+  if (a === 0) {
+    c = 1;
+    s = 0;
+  } else if (a <= 45) {
+    const x = a * (Math.PI / 180);
+    c = cosSeries(x);
+    s = sinSeries(x);
+  } else {
+    const x = (90 - a) * (Math.PI / 180);
+    c = sinSeries(x);
+    s = cosSeries(x);
+  }
+  // Rotate the first-quadrant pair by q quarter turns, exactly.
+  for (let k = 0; k < q; k++) [c, s] = [-s, c];
+  // + 0 turns a -0 from the rotation into 0, so a zero is one bit pattern.
+  return [c + 0, s + 0];
+}
+
+// ---- normalisation ------------------------------------------------------------------------
+
+/** One normalised path: PATH_VERB verbs, their points (f64 pairs), and each verb's source command. */
+export interface NormalPath {
+  verbs: number[];
+  pts: number[];
+  src: number[];
+}
+
+/** The four-verb form of `d`: absolute, H/V/S/T/Q/A gone, every subpath after a close reopened by a move. */
+export function normalizePathData(d: string): NormalPath {
+  const cmds = parsePathData(d);
+  const verbs: number[] = [];
+  const pts: number[] = [];
+  const src: number[] = [];
+  let cx = 0, cy = 0; // current point
+  let sx = 0, sy = 0; // subpath start
+  let closed = false; // the last verb was a close
+  // The previous command's second control point, for S and T reflections.
+  let lastCubic: [number, number] | null = null;
+  let lastQuad: [number, number] | null = null;
+  const reopen = (index: number): void => {
+    if (!closed) return;
+    verbs.push(PATH_VERB.move);
+    pts.push(sx, sy);
+    src.push(index);
+    closed = false;
+  };
+  const line = (x: number, y: number, index: number): void => {
+    reopen(index);
+    verbs.push(PATH_VERB.line);
+    pts.push(x, y);
+    src.push(index);
+    cx = x;
+    cy = y;
+  };
+  const cubic = (x1: number, y1: number, x2: number, y2: number, x: number, y: number, index: number): void => {
+    reopen(index);
+    verbs.push(PATH_VERB.cubic);
+    pts.push(x1, y1, x2, y2, x, y);
+    src.push(index);
+    cx = x;
+    cy = y;
+  };
+  for (const cmd of cmds) {
+    const rel = cmd.letter === cmd.letter.toLowerCase();
+    const a = cmd.args;
+    const ox = rel ? cx : 0;
+    const oy = rel ? cy : 0;
+    let nextCubic: [number, number] | null = null;
+    let nextQuad: [number, number] | null = null;
+    switch (cmd.letter.toLowerCase()) {
+      case "m": {
+        const x = a[0]! + ox, y = a[1]! + oy;
+        verbs.push(PATH_VERB.move);
+        pts.push(x, y);
+        src.push(cmd.index);
+        cx = sx = x;
+        cy = sy = y;
+        closed = false;
+        break;
+      }
+      case "l":
+        line(a[0]! + ox, a[1]! + oy, cmd.index);
+        break;
+      case "h":
+        line(a[0]! + ox, cy, cmd.index);
+        break;
+      case "v":
+        line(cx, a[0]! + oy, cmd.index);
+        break;
+      case "c": {
+        const x2 = a[2]! + ox, y2 = a[3]! + oy;
+        cubic(a[0]! + ox, a[1]! + oy, x2, y2, a[4]! + ox, a[5]! + oy, cmd.index);
+        nextCubic = [x2, y2];
+        break;
+      }
+      case "s": {
+        const [x1, y1] = lastCubic ? [2 * cx - lastCubic[0], 2 * cy - lastCubic[1]] : [cx, cy];
+        const x2 = a[0]! + ox, y2 = a[1]! + oy;
+        cubic(x1, y1, x2, y2, a[2]! + ox, a[3]! + oy, cmd.index);
+        nextCubic = [x2, y2];
+        break;
+      }
+      case "q":
+      case "t": {
+        const isQ = cmd.letter.toLowerCase() === "q";
+        let qx = cx, qy = cy;
+        if (isQ) {
+          qx = a[0]! + ox;
+          qy = a[1]! + oy;
+        } else if (lastQuad !== null) {
+          qx = 2 * cx - lastQuad[0];
+          qy = 2 * cy - lastQuad[1];
+        }
+        const x = (isQ ? a[2]! : a[0]!) + ox, y = (isQ ? a[3]! : a[1]!) + oy;
+        // Degree elevation, exact for a quadratic: controls 2/3 of the way to q.
+        cubic(cx + (2 * (qx - cx)) / 3, cy + (2 * (qy - cy)) / 3, x + (2 * (qx - x)) / 3, y + (2 * (qy - y)) / 3, x, y, cmd.index);
+        nextQuad = [qx, qy];
+        break;
+      }
+      case "a":
+        arc(cx, cy, a[0]!, a[1]!, a[2]!, a[3] === 1, a[4] === 1, a[5]! + ox, a[6]! + oy, cmd.index, line, cubic);
+        break;
+      case "z":
+        if (!closed) {
+          verbs.push(PATH_VERB.close);
+          src.push(cmd.index);
+          closed = true;
+        }
+        cx = sx;
+        cy = sy;
+        break;
+    }
+    lastCubic = nextCubic;
+    lastQuad = nextQuad;
+  }
+  return { verbs, pts, src };
+}
+
+/**
+ * An elliptical arc as cubics of at most an eighth of a turn each (SVG 1.1
+ * F.6.5 for the centre). The sweep is never an angle: the arc is cut in
+ * halves by unit-vector bisection until every piece is within 45 degrees,
+ * so it is 1, 2, 4 or 8 pieces, and each piece's handle length
+ * 4/3 tan(alpha/4) comes from its cosine and sine by two half-angle steps.
+ * The end point is the written one, copied. A quarter-turn piece sits up
+ * to 2.7e-4 r off the true ellipse (0.27 px at r = 1000); an eighth, under
+ * 4.3e-6 r.
+ */
+function arc(
+  x1: number,
+  y1: number,
+  rxIn: number,
+  ryIn: number,
+  phi: number,
+  large: boolean,
+  sweep: boolean,
+  x2: number,
+  y2: number,
+  index: number,
+  line: (x: number, y: number, index: number) => void,
+  cubic: (x1: number, y1: number, x2: number, y2: number, x: number, y: number, index: number) => void,
+): void {
+  if (x1 === x2 && y1 === y2) return; // an arc to its own start draws nothing (SVG)
+  let rx = Math.abs(rxIn);
+  let ry = Math.abs(ryIn);
+  if (rx === 0 || ry === 0) {
+    line(x2, y2, index);
+    return;
+  }
+  const [cp, sp] = cosSinDeg(phi);
+  const dx = (x1 - x2) / 2, dy = (y1 - y2) / 2;
+  const x1p = cp * dx + sp * dy;
+  const y1p = -sp * dx + cp * dy;
+  const lambda = (x1p * x1p) / (rx * rx) + (y1p * y1p) / (ry * ry);
+  // Radii too small for the chord grow until it is a diameter: a half ellipse.
+  const half = lambda >= 1;
+  if (half) {
+    const k = Math.sqrt(lambda);
+    rx *= k;
+    ry *= k;
+  }
+  const num = rx * rx * ry * ry - rx * rx * y1p * y1p - ry * ry * x1p * x1p;
+  const den = rx * rx * y1p * y1p + ry * ry * x1p * x1p;
+  const coef = half || !(num > 0) ? 0 : (large === sweep ? -1 : 1) * Math.sqrt(num / den);
+  const cxp = (coef * rx * y1p) / ry;
+  const cyp = (-coef * ry * x1p) / rx;
+  const ccx = cp * cxp - sp * cyp + (x1 + x2) / 2;
+  const ccy = sp * cxp + cp * cyp + (y1 + y2) / 2;
+  const unit = (x: number, y: number): [number, number] => {
+    const l = Math.sqrt(x * x + y * y);
+    return [x / l, y / l];
+  };
+  const u = unit((x1p - cxp) / rx, (y1p - cyp) / ry);
+  const v = unit((-x1p - cxp) / rx, (-y1p - cyp) / ry);
+  const s = sweep ? 1 : -1;
+  // The direction halfway from a to b going the arc's way. Near a full
+  // turn's ends (a and b close) a + b is stable; near a half turn their
+  // difference is, rotated back a quarter turn against the sweep.
+  const mid = (a: [number, number], b: [number, number], big: boolean): [number, number] => {
+    const dot = a[0] * b[0] + a[1] * b[1];
+    if (dot > 0) {
+      const m = unit(a[0] + b[0], a[1] + b[1]);
+      return big ? [-m[0], -m[1]] : m;
+    }
+    const wx = b[0] - a[0], wy = b[1] - a[1];
+    return s > 0 ? unit(wy, -wx) : unit(-wy, wx);
+  };
+  // At least a half turn is cut once knowing it is large, since a + b
+  // alone cannot tell a sweep from its complement; every piece is then
+  // under a half turn and halved while it is past an eighth.
+  const pieces: Array<[number, number]> = [u];
+  const halve = (a: [number, number], b: [number, number]): void => {
+    if (a[0] * b[0] + a[1] * b[1] < EIGHTH_COS) {
+      const m = mid(a, b, false);
+      halve(a, m);
+      halve(m, b);
+      return;
+    }
+    pieces.push(b);
+  };
+  if (large || half) {
+    const m = half ? (s > 0 ? [-u[1], u[0]] as [number, number] : [u[1], -u[0]] as [number, number]) : mid(u, v, true);
+    halve(u, m);
+    halve(m, v);
+  } else {
+    halve(u, v);
+  }
+  // Unit-circle point -> the ellipse in path coordinates.
+  const map = (x: number, y: number): [number, number] => {
+    const ex = rx * x, ey = ry * y;
+    return [cp * ex - sp * ey + ccx, sp * ex + cp * ey + ccy];
+  };
+  for (let k = 0; k + 1 < pieces.length; k++) {
+    const a = pieces[k]!, b = pieces[k + 1]!;
+    const cos = a[0] * b[0] + a[1] * b[1];
+    const sin = Math.abs(a[0] * b[1] - a[1] * b[0]);
+    const t2 = sin / (1 + cos); // tan(alpha/2)
+    const t4 = t2 / (1 + Math.sqrt(1 + t2 * t2)); // tan(alpha/4)
+    const h = (4 / 3) * t4;
+    // Tangents point along the sweep: a quarter turn of the radius, by s.
+    const ta: [number, number] = [-s * a[1], s * a[0]];
+    const tb: [number, number] = [-s * b[1], s * b[0]];
+    const [c1x, c1y] = map(a[0] + h * ta[0], a[1] + h * ta[1]);
+    const [c2x, c2y] = map(b[0] - h * tb[0], b[1] - h * tb[1]);
+    const last = k + 2 === pieces.length;
+    const [ex, ey] = last ? [x2, y2] : map(b[0], b[1]);
+    cubic(c1x, c1y, c2x, c2y, ex, ey, index);
+  }
+}
+
+/** cos 45 degrees, less a margin, so a piece of exactly an eighth is not halved by a rounding. */
+const EIGHTH_COS = Math.SQRT1_2 - 1e-9;
+
+// ---- morph keys and the entry ---------------------------------------------------------
+
+const VERB_NAME = ["move", "line", "cubic", "close"];
+
+/** Promote line `k` of a normalised path to a cubic with controls at 1/3 and 2/3 (exact). */
+function promote(p: NormalPath, k: number): void {
+  let at = 0;
+  for (let j = 0; j < k; j++) at += p.verbs[j] === PATH_VERB.cubic ? 6 : p.verbs[j] === PATH_VERB.close ? 0 : 2;
+  // The line's start is the previous verb's end point (a line never opens a subpath).
+  const x0 = p.pts[at - 2]!, y0 = p.pts[at - 1]!;
+  const x1 = p.pts[at]!, y1 = p.pts[at + 1]!;
+  const dx = x1 - x0, dy = y1 - y0;
+  p.pts.splice(at, 2, x0 + dx / 3, y0 + dy / 3, x0 + (2 * dx) / 3, y0 + (2 * dy) / 3, x1, y1);
+  p.verbs[k] = PATH_VERB.cubic;
+}
+
+/**
+ * The PATH TABLE entry for one `<Path>`: its morph keys (one or more `d`
+ * strings) aligned to one verb list, and its viewBox. A line in one key
+ * where another has a cubic is promoted; any other difference is refused,
+ * naming the first differing command of each key. Point counts are never
+ * equalised: a resampled correspondence is a picture nobody declared.
+ */
+export function compilePathEntry(keys: readonly string[], viewBox?: string): PathEntry {
+  if (keys.length === 0) throw new PathDataError("a <Path> needs at least one d");
+  if (keys.length > PATH_MAX_SHAPES) throw new PathDataError(`a <Path> morphs at most ${PATH_MAX_SHAPES} keys, got ${keys.length}`);
+  const paths = keys.map((d, i) => {
+    try {
+      return normalizePathData(d);
+    } catch (e) {
+      if (e instanceof PathDataError && keys.length > 1) throw new PathDataError(`morph key ${i}: ${e.message}`);
+      throw e;
+    }
+  });
+  const first = paths[0]!;
+  for (let i = 1; i < paths.length; i++) {
+    const p = paths[i]!;
+    const n = Math.max(first.verbs.length, p.verbs.length);
+    for (let k = 0; k < n; k++) {
+      const a = first.verbs[k], b = p.verbs[k];
+      if (a === b) continue;
+      if (a === PATH_VERB.line && b === PATH_VERB.cubic) {
+        for (const q of paths.slice(0, i)) if (q.verbs[k] === PATH_VERB.line) promote(q, k);
+        continue;
+      }
+      if (a === PATH_VERB.cubic && b === PATH_VERB.line) {
+        promote(p, k);
+        continue;
+      }
+      const name = (q: NormalPath, j: number): string =>
+        q.verbs[j] === undefined ? "nothing (it has ended)" : `a ${VERB_NAME[q.verbs[j]!]} (source command ${q.src[j]})`;
+      throw new PathDataError(
+        `morph keys 0 and ${i} differ at normalised command ${k}: key 0 has ${name(first, k)}, key ${i} has ${name(p, k)}. ` +
+          "Keys must share their commands (a line against a cubic is promoted); draw them with the same structure.",
+      );
+    }
+  }
+  const entry: PathEntry = {
+    verbs: first.verbs.slice(),
+    shapes: paths.map((p) => p.pts.map((v) => Math.fround(v))),
+  };
+  for (const [i, shape] of entry.shapes.entries()) {
+    const bad = shape.find((v) => !Number.isFinite(v));
+    if (bad !== undefined) throw new PathDataError(`${keys.length > 1 ? `morph key ${i}: ` : ""}a coordinate is not a finite f32 (${bad})`);
+  }
+  if (entry.verbs.length > 0xffff) throw new PathDataError(`a path normalises to ${entry.verbs.length} commands; the table holds 65535`);
+  if (viewBox !== undefined) entry.viewBox = parseViewBox(viewBox);
+  return entry;
+}
+
+/** `"x y w h"` (whitespace and/or commas) with w, h > 0, as f32. */
+export function parseViewBox(viewBox: string): [number, number, number, number] {
+  const parts = viewBox.trim().split(/[\s,]+/).filter((s) => s.length > 0);
+  const nums = parts.map((s) => (/^[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?$/.test(s) ? Math.fround(Number(s)) : NaN));
+  if (nums.length !== 4 || !nums.every(Number.isFinite) || !(nums[2]! > 0) || !(nums[3]! > 0)) {
+    throw new PathDataError(`viewBox ${JSON.stringify(viewBox)} is not "x y w h" with w and h above 0`);
+  }
+  return nums as [number, number, number, number];
+}
