+/// The coverage bytes of an `encode_atlas*` blob: everything after the cmap
+/// and before a v4 blob's trailing kern section (a u32 pair count, 0 here).
+fn coverage_mut(blob: &mut [u8], start: usize) -> &mut [u8] {
+    let version = u16::from_le_bytes([blob[4], blob[5]]);
+    let end = blob.len() - if version >= 4 { 4 } else { 0 };
+    &mut blob[start..end]
+}
+
+/// v4 atlas with an explicit kern section. `pairs` must be sorted by
+/// `(left, right)` and refer to atlas-local gids.
+fn encode_atlas_with_kern(
+    slot: u8,
+    cell_w: u8,
+    cell_h: u8,
+    baseline: u8,
+    line_height: u8,
+    glyph_count: u16,
+    glyphs: &[(u32, u16, u8)],
+    pairs: &[(u16, u16, i8)],
+) -> Vec<u8> {
+    let mut out = encode_atlas_version_density(
+        spec::font_atlas::VERSION,
+        1,
+        slot,
+        cell_w,
+        cell_h,
+        baseline,
+        line_height,
+        glyph_count,
+        glyphs,
+    );
+    if spec::font_atlas::VERSION >= 4 {
+        out.truncate(out.len() - 4);
+    }
+    out.extend_from_slice(&(pairs.len() as u32).to_le_bytes());
+    for &(left, right, delta) in pairs {
+        out.extend_from_slice(&left.to_le_bytes());
+        out.extend_from_slice(&right.to_le_bytes());
+        out.push(delta as u8);
+    }
     out
 }
 
