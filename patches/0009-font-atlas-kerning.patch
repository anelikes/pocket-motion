+#[test]
+fn measure_run_and_layout_run_agree_on_a_kerned_string() {
+    use crate::text::Fonts;
+    let glyphs = &[(0xfffd, 0, 8), ('A' as u32, 1, 10), ('V' as u32, 2, 10)];
+    // AV −3, matching the apply-before-place rule: V sits at 7, width is 17.
+    let blob = encode_atlas_with_kern(0, 8, 8, 7, 10, 3, glyphs, &[(1, 2, -3)]);
+    let mut fonts = Fonts::new();
+    assert!(fonts.load(&blob));
+    let (w, h) = fonts.measure_run("AV", 0, 0.0, f32::NAN);
+    assert_eq!((w, h), (17.0, 10.0));
+    let mut pos = Vec::new();
+    fonts.layout_run("AV", 0, 0.0, f32::NAN, 0, w, &mut pos);
+    assert_eq!(pos.len(), 2);
+    assert_eq!(pos[0].gid, 1);
+    assert_eq!(pos[1].gid, 2);
+    assert_eq!(pos[0].x, 0.0);
+    assert_eq!(pos[1].x, 7.0);
+    assert_eq!(pos[1].x + 10.0, w);
+
+    let (w2, h2) = fonts.measure_run("AVA", 0, 1.0, f32::NAN);
+    // A +track, AV −3, V +track, VA 0, A +track = 10+1-3+10+1+10+1 = 30
+    assert_eq!((w2, h2), (30.0, 10.0));
+    pos.clear();
+    fonts.layout_run("AVA", 0, 1.0, f32::NAN, 0, w2, &mut pos);
+    assert_eq!(pos.len(), 3);
+    assert_eq!(pos[0].x, 0.0);
+    assert_eq!(pos[1].x, 8.0); // 10+1-3
+    assert_eq!(pos[2].x, 19.0); // 8+10+1
+    assert_eq!(pos[2].x + 10.0 + 1.0, w2);
+
+    // A newline resets the previous gid — "A\nV" does not apply AV.
+    let (wn, hn) = fonts.measure_run("A\nV", 0, 0.0, f32::NAN);
+    assert_eq!((wn, hn), (10.0, 20.0));
+}
