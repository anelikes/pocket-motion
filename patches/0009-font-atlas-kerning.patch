+#[test]
+fn font_atlas_v4_rejects_a_truncated_kern_section() {
+    use crate::text::Fonts;
+    let glyphs = &[(0xfffd, 0, 8), ('A' as u32, 1, 6), ('B' as u32, 2, 5)];
+    let blob = encode_atlas_with_kern(2, 8, 8, 7, 10, 3, glyphs, &[(1, 2, -4)]);
+    assert!(Fonts::new().load(&blob));
+    assert!(!Fonts::new().load(&blob[..blob.len() - 1]));
+    let bitmap_end = spec::font_atlas::HEADER_SIZE
+        + glyphs.len() * spec::font_atlas::CMAP_ENTRY_SIZE
+        + 3 * 8 * 8;
+    assert!(!Fonts::new().load(&blob[..bitmap_end]));
+    assert!(!Fonts::new().load(&blob[..bitmap_end + 2]));
+    let mut overclaimed = blob.clone();
+    overclaimed[bitmap_end..bitmap_end + 4].copy_from_slice(&99u32.to_le_bytes());
+    assert!(!Fonts::new().load(&overclaimed));
+}
