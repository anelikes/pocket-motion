+#[test]
+fn font_atlas_v3_parses_and_kerns_to_zero() {
+    use crate::text::Fonts;
+    let glyphs = &[(0xfffd, 0, 8), ('A' as u32, 1, 6), ('B' as u32, 2, 5)];
+    let blob = encode_atlas_version_density(3, 1, 2, 8, 8, 7, 10, 3, glyphs);
+    let mut fonts = Fonts::new();
+    assert!(fonts.load(&blob));
+    let atlas = fonts.atlas(2).unwrap();
+    assert_eq!(atlas.kern(1, 2), 0);
+    assert_eq!(fonts.measure_run("AB", 2, 0.0, f32::NAN).0, 11.0);
+}
