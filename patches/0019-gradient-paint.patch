+const LINEAR_TO: Record<string, number> = { t: 0, r: 90, b: 180, l: 270 };
+const DIR_ANGLE: Record<number, number> = {
+  [ENUMS.GradDir.ToTop]: 0, [ENUMS.GradDir.ToRight]: 90,
+  [ENUMS.GradDir.ToBottom]: 180, [ENUMS.GradDir.ToLeft]: 270,
+};
