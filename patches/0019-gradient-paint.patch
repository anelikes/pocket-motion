+    else if (side) { angle = { top: 0, right: 90, bottom: 180, left: 270 }[side[1] as "top"]; args.shift(); }
+  }
+  if (radial && args.length > 0 && /^(ellipse|ellipse farthest-corner)$/.test(args[0]!)) args.shift();
