+#[test]
+fn bg_clip_text_paints_scaled_glyph_pages_too() {
+    // Under an axis-aligned scale the run is drawn as glyph-page TEX_QUADs
+    // instead of a GLYPH_RUN; the paint recolours whatever its span writes,
+    // so the gradient still lands in the glyphs.
+    let (red, blue) = (abgr(255, 0, 0, 255), abgr(0, 0, 255, 255));
+    let mut ui = Ui::new();
+    assert!(ui.load_font_atlas(&block_atlas(0, 40, 0, 40)));
+    let ground = ui.create_node(0);
+    ui.set_prop(ground, spec::prop::WIDTH, 200.0);
+    ui.set_prop(ground, spec::prop::HEIGHT, 200.0);
+    ui.set_prop(ground, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.insert_before(spec::ROOT_ID, ground, 0);
+    let t = ui.create_node(spec::NodeType::Text as u8);
+    ui.set_prop(t, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(t, spec::prop::INSET_L, 40.0);
+    ui.set_prop(t, spec::prop::INSET_T, 40.0);
+    ui.set_prop(t, spec::prop::WIDTH, 120.0);
+    ui.set_text(t, "AAA");
+    ui.set_prop(t, spec::prop::TEXT_COLOR, 0.0);
+    ui.set_prop(t, spec::prop::BG_CLIP, spec::BgClip::Text as u32 as f64);
+    ui.set_prop(t, spec::prop::GRAD_KIND, spec::GradKind::Linear as u32 as f64);
+    ui.set_prop(t, spec::prop::GRAD_ANGLE, 90.0);
+    ui.set_prop(t, spec::prop::GRAD_FROM, red as f64);
+    ui.set_prop(t, spec::prop::GRAD_TO, blue as f64);
+    ui.set_prop(t, spec::prop::SCALE, 1.25);
+    ui.insert_before(ground, t, 0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    let counts = validate_drawlist(&words);
+    assert_eq!(counts[spec::draw_op::PAINT_PUSH as usize], 1);
+    assert_eq!(counts[spec::draw_op::GLYPH_RUN as usize], 0, "a scaled run draws glyph pages");
+    let p = words.iter().position(|&w| w == spec::draw_op::PAINT_PUSH).unwrap();
+    let q = words.iter().position(|&w| w == spec::draw_op::PAINT_POP).unwrap();
+    assert!(words[p..q].contains(&spec::draw_op::TEX_QUAD), "the paint wraps the glyph pages");
+    let fb = raster_fb(&mut ui);
+    // The box spans 40..160 scaled 1.25 about its centre: 25..175.
+    let left = sample_rgba(&fb, 30, 60);
+    let right = sample_rgba(&fb, 170, 60);
+    assert!(left[0] > 200 && left[2] < 60 && left[1] < 10, "the first glyph is red: {left:?}");
+    assert!(right[2] > 200 && right[0] < 60 && right[1] < 10, "the last glyph is blue: {right:?}");
+}
