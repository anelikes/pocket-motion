+#[test]
+fn bg_clip_text_paints_the_gradient_into_the_glyphs_only() {
+    let (red, blue) = (abgr(255, 0, 0, 255), abgr(0, 0, 255, 255));
+    let mut ui = Ui::new();
+    assert!(ui.load_font_atlas(&block_atlas(0, 40, 0, 40)));
+    let ground = ui.create_node(0);
+    ui.set_prop(ground, spec::prop::WIDTH, 200.0);
