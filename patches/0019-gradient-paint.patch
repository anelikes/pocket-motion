+#[test]
+fn a_three_stop_linear_gradient_to_the_right_hits_each_stop() {
+    let (red, green, blue) = (abgr(255, 0, 0, 255), abgr(0, 255, 0, 255), abgr(0, 0, 255, 255));
+    let (mut ui, _, words) =
+        gradient_box(spec::GradKind::Linear, 90.0, &[(red, 0.0), (green, 0.5), (blue, 1.0)], &[]);
+    let counts = validate_drawlist(&words);
+    assert_eq!(counts[spec::draw_op::PAINT_PUSH as usize], 1);
+    assert_eq!(counts[spec::draw_op::GRAD_RECT as usize], 0, "the paint replaces the two-stop path");
+    let fb = raster_fb(&mut ui);
+    let p = |x: usize| sample_rgba(&fb, x, 120);
+    assert!(p(0)[0] >= 253 && p(0)[1] <= 2, "left edge is red: {:?}", p(0));
+    assert!(p(100)[1] >= 250, "the middle is green: {:?}", p(100));
+    assert!(p(199)[2] >= 253 && p(199)[1] <= 2, "right edge is blue: {:?}", p(199));
+    assert_eq!(p(50)[2], 0, "the first half has no blue");
+    assert_eq!(p(150)[0], 0, "the second half has no red");
+    for x in 1..100 {
+        assert!(p(x)[0] <= p(x - 1)[0], "red falls monotonically");
+    }
+    assert_eq!(sample_rgba(&fb, 250, 120), [255, 255, 255, 255], "nothing outside the box");
+    // Vertically constant for a 90 degree gradient.
+    assert_eq!(sample_rgba(&fb, 60, 101), sample_rgba(&fb, 60, 138));
+}
