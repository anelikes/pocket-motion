+    ui.insert_before(spec::ROOT_ID, ground, 0);
+    let t = ui.create_node(spec::NodeType::Text as u8);
+    ui.set_prop(t, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(t, spec::prop::INSET_L, 20.0);
+    ui.set_prop(t, spec::prop::INSET_T, 20.0);
+    ui.set_prop(t, spec::prop::WIDTH, 160.0);
+    // "AAAA": four solid 40 px cells side by side, 160 px of ink.
+    ui.set_text(t, "AAAA");
+    ui.set_prop(t, spec::prop::TEXT_COLOR, 0.0);
+    ui.set_prop(t, spec::prop::BG_COLOR, abgr(0, 255, 0, 255) as f64);
+    ui.set_prop(t, spec::prop::BG_CLIP, spec::BgClip::Text as u32 as f64);
+    ui.set_prop(t, spec::prop::GRAD_KIND, spec::GradKind::Linear as u32 as f64);
+    ui.set_prop(t, spec::prop::GRAD_ANGLE, 90.0);
+    ui.set_prop(t, spec::prop::GRAD_FROM, red as f64);
+    ui.set_prop(t, spec::prop::GRAD_TO, blue as f64);
+    ui.insert_before(ground, t, 0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    let counts = validate_drawlist(&words);
+    assert_eq!(counts[spec::draw_op::PAINT_PUSH as usize], 1);
+    let p = words.iter().position(|&w| w == spec::draw_op::PAINT_PUSH).unwrap();
+    assert_eq!(words[p + 9 + 2 * 2], spec::draw_op::GLYPH_RUN, "the paint wraps the glyph run");
+    let fb = raster_fb(&mut ui);
+    let left = sample_rgba(&fb, 21, 40);
+    let right = sample_rgba(&fb, 178, 40);
+    assert!(left[0] > 245 && left[2] < 10, "the first glyph is red: {left:?}");
+    assert!(right[2] > 245 && right[0] < 10, "the last glyph is blue: {right:?}");
+    assert_eq!(sample_rgba(&fb, 100, 150), [255, 255, 255, 255], "the ground colour is not painted as a box");
+    assert_eq!(sample_rgba(&fb, 100, 40)[1], 0, "and not into the glyphs either: the gradient is");
+}
