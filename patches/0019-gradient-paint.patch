+    ui.set_prop(b, spec::prop::GRAD_ANGLE, angle as f64);
+    let (first, rest) = stops.split_first().unwrap();
+    let (last, mid) = rest.split_last().unwrap();
+    ui.set_prop(b, spec::prop::GRAD_FROM, first.0 as f64);
+    ui.set_prop(b, spec::prop::GRAD_FROM_POS, first.1 as f64);
+    ui.set_prop(b, spec::prop::GRAD_TO, last.0 as f64);
+    ui.set_prop(b, spec::prop::GRAD_TO_POS, last.1 as f64);
+    let vias = [
+        (spec::prop::GRAD_VIA1, spec::prop::GRAD_VIA1_POS),
+        (spec::prop::GRAD_VIA2, spec::prop::GRAD_VIA2_POS),
+        (spec::prop::GRAD_VIA3, spec::prop::GRAD_VIA3_POS),
+        (spec::prop::GRAD_VIA4, spec::prop::GRAD_VIA4_POS),
+    ];
+    for (k, &(c, p)) in mid.iter().enumerate() {
+        ui.set_prop(b, vias[k].0, c as f64);
+        ui.set_prop(b, vias[k].1, p as f64);
+    }
+    for &(p, v) in extra {
+        ui.set_prop(b, p, v);
+    }
+    ui.insert_before(g, b, 0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    validate_drawlist(&words);
+    (ui, b, words)
+}
