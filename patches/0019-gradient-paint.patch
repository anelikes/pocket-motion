+describe("gradient paint (pocket-motion)", () => {
+  const stopsOf = (m: Map<number, number>) => ({
+    kind: m.get(PROP.gradKind),
+    angle: m.has(PROP.gradAngle) ? bitsF32(m.get(PROP.gradAngle)!) : undefined,
+  });
+  test("a legacy two-stop literal stays legacy", () => {
+    const m = props(parseClassLiteral("bg-gradient-to-r from-red-500 to-blue-500"));
+    expect(m.has(PROP.gradKind)).toBe(false);
+    expect(m.get(PROP.gradDir)).toBe(ENUMS.GradDir.ToRight);
+  });
+  test("a via under bg-gradient-to-* is upstream's middle stop; in a paint it is the stop table's; never both", () => {
+    const m = props(parseClassLiteral("bg-gradient-to-r from-red-500 via-green-500 to-blue-500"));
+    expect(m.has(PROP.gradKind)).toBe(false);
+    expect(m.get(PROP.gradVia)).toBe(paletteColor("green-500")!);
+    expect(f32Of(m, PROP.gradViaPos)).toBe(0.5);
+    expect(m.has(PROP.gradVia1)).toBe(false);
+    const at30 = props(parseClassLiteral("bg-gradient-to-r from-red-500 via-green-500 via-30% to-blue-500"));
+    expect(at30.has(PROP.gradKind)).toBe(false);
+    expect(f32Of(at30, PROP.gradViaPos)).toBeCloseTo(0.3, 6);
+    const p = props(parseClassLiteral("bg-linear-90 from-red-500 via-green-500 to-blue-500"));
+    expect(stopsOf(p)).toEqual({ kind: ENUMS.GradKind.Linear, angle: 90 });
+    expect(p.get(PROP.gradVia1)).toBe(paletteColor("green-500")!);
+    expect(f32Of(p, PROP.gradVia1Pos)).toBe(0.5);
+    expect(p.has(PROP.gradVia) || p.has(PROP.gradViaPos)).toBe(false);
+    // bg-clip-text over a legacy three-stop gradient takes the paint: only it reaches glyphs.
+    const t = props(parseClassLiteral("bg-clip-text text-transparent bg-gradient-to-r from-red-500 via-green-500 to-blue-500"));
+    expect(stopsOf(t)).toEqual({ kind: ENUMS.GradKind.Linear, angle: 90 });
+    expect(t.get(PROP.gradVia1)).toBe(paletteColor("green-500")!);
+    expect(t.has(PROP.gradVia)).toBe(false);
+  });
+  test("positions, angles and radial", () => {
+    const m = props(parseClassLiteral("bg-linear-45 from-red-500 from-10% via-white via-40% to-blue-500 to-90%"));
+    expect(stopsOf(m)).toEqual({ kind: ENUMS.GradKind.Linear, angle: 45 });
+    expect([f32Of(m, PROP.gradFromPos), f32Of(m, PROP.gradVia1Pos), f32Of(m, PROP.gradToPos)].map((x) => Math.round(x * 100))).toEqual([10, 40, 90]);
+    expect(stopsOf(props(parseClassLiteral("bg-linear-[37.5deg] from-black to-white"))).angle).toBe(37.5);
+    expect(stopsOf(props(parseClassLiteral("bg-linear-to-l from-black to-white"))).angle).toBe(270);
+    expect(stopsOf(props(parseClassLiteral("bg-radial from-white to-black"))).kind).toBe(ENUMS.GradKind.Radial);
+  });
+  test("arbitrary linear-gradient(): up to six stops, CSS position fix-up", () => {
+    const m = props(parseClassLiteral("bg-[linear-gradient(90deg,#ff0000,#00ff00,#0000ff_80%,white)]"));
+    expect(stopsOf(m)).toEqual({ kind: ENUMS.GradKind.Linear, angle: 90 });
+    expect(m.get(PROP.gradFrom)).toBe(abgr(255, 0, 0));
+    expect(f32Of(m, PROP.gradVia1Pos)).toBeCloseTo(0.4, 6);
+    expect(f32Of(m, PROP.gradVia2Pos)).toBeCloseTo(0.8, 6);
+    expect(m.get(PROP.gradTo)).toBe(abgr(255, 255, 255));
+    expect(f32Of(m, PROP.gradToPos)).toBe(1);
+    expect(parseClassLiteral("bg-[linear-gradient(#000,#111,#222,#333,#444,#555,#666)]")).toBeNull();
+    const r = props(parseClassLiteral("bg-[radial-gradient(#ffffff,#ffffff00_70%)]"));
+    expect(r.get(PROP.gradKind)).toBe(ENUMS.GradKind.Radial);
+    expect(f32Of(r, PROP.gradToPos)).toBeCloseTo(0.7, 6);
+  });
+  test("bg-clip-text over a legacy gradient takes the paint path", () => {
+    const m = props(parseClassLiteral("bg-clip-text text-transparent bg-gradient-to-b from-white to-slate-400"));
