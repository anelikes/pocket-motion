+    /// One PAINT_PUSH (pocket-motion; format in spec.ts) for the node's
+    /// gradient over its `w x h` box under `world`. The parameter is an
+    /// affine function of the screen point: the inverse of `world` takes a
+    /// point to the box, and there the CSS gradient line (linear: through
+    /// the centre at `grad_angle`, as long as the box's extent along it;
+    /// radial: the farthest-corner ellipse about the centre) gives t. False,
+    /// emitting nothing, for a degenerate box or transform.
+    fn emit_paint_push(&self, dl: &mut DrawList, world: &Affine, w: f32, h: f32, r: &style::Resolved) -> bool {
+        let det = world.a * world.d - world.b * world.c;
+        if det == 0.0 || !(w > 0.0) || !(h > 0.0) {
+            return false;
+        }
+        // local = inverse(world)(x, y) = (p*x + q*y + u, s*x + t*y + v)
+        let (p, q) = (world.d / det, -world.c / det);
+        let u = (world.c * world.ty - world.d * world.tx) / det;
+        let (sx, ty) = (-world.b / det, world.a / det);
+        let v = (world.b * world.tx - world.a * world.ty) / det;
