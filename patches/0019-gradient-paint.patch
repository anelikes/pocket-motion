+#[test]
+fn a_stop_fading_to_transparent_keeps_its_colour() {
+    // Premultiplied interpolation: red to transparent is half-alpha red in
+    // the middle, not a darkened red.
+    let (mut ui, _, _) = gradient_box(
+        spec::GradKind::Linear,
+        90.0,
+        &[(abgr(255, 0, 0, 255), 0.0), (abgr(0, 0, 0, 0), 1.0)],
+        &[],
