+// ---- PAINT_PUSH / PAINT_POP: gradient paint (pocket-motion) ------------------------
+
+/// Entries in a paint's colour table over t in 0..1.
+const PAINT_LUT: usize = 4096;
+
+/// A decoded PAINT_PUSH: the screen -> t map and the stops baked into a
+/// table of straight-alpha colours, premultiplied while interpolating (as
+/// CSS does), so a stop fading to transparent does not darken on the way.
+struct GradientPaint {
+    radial: bool,
+    /// a..f in PHYSICAL pixel units: the logical coefficients divided by the
+    /// render scale, with the pixel-centre half-step folded into c and f.
+    m: [f32; 6],
+    lut: Vec<u32>,
+}
+
+impl GradientPaint {
+    fn decode(w: &[u32], scale: i32) -> GradientPaint {
+        let radial = w[0] == spec::GradKind::Radial as u32;
+        let n = w[1] as usize;
+        let k = |i: usize| {
+            let v = f32::from_bits(w[2 + i]);
+            if v.is_finite() { v } else { 0.0 }
+        };
+        let inv = 1.0 / scale as f32;
+        // t(x_log, y_log) with x_log = (px + 0.5) / scale.
+        let m = [
+            k(0) * inv,
+            k(1) * inv,
+            k(2) + (k(0) + k(1)) * 0.5 * inv,
+            k(3) * inv,
+            k(4) * inv,
+            k(5) + (k(3) + k(4)) * 0.5 * inv,
+        ];
+        let mut stops: Vec<(u32, f32)> = Vec::with_capacity(n);
+        for s in 0..n {
+            let pos = f32::from_bits(w[8 + 2 * s + 1]);
+            stops.push((w[8 + 2 * s], if pos.is_finite() { pos.max(0.0).min(1.0) } else { 0.0 }));
+        }
+        let premul = |c: u32| {
+            let (r, g, b, a) = channels(c);
+            [r * a, g * a, b * a, a * 255]
+        };
+        let mut lut = alloc::vec![0u32; PAINT_LUT];
+        for (e, slot) in lut.iter_mut().enumerate() {
+            let t = e as f32 / (PAINT_LUT - 1) as f32;
+            // First stop at or past t; before the first / after the last, clamp.
+            let j = stops.iter().position(|s| s.1 >= t).unwrap_or(stops.len());
+            let v = if j == 0 {
+                premul(stops[0].0)
+            } else if j == stops.len() {
+                premul(stops[stops.len() - 1].0)
+            } else {
+                let (a, b) = (stops[j - 1], stops[j]);
+                let span = b.1 - a.1;
+                let f = if span > 0.0 { (t - a.1) / span } else { 1.0 };
+                let fw = (f.max(0.0).min(1.0) * 256.0 + 0.5) as u32;
+                let (pa, pb) = (premul(a.0), premul(b.0));
+                [0, 1, 2, 3].map(|c| (pa[c] * (256 - fw) + pb[c] * fw + 128) >> 8)
+            };
+            // Back to straight alpha (v[3] is alpha * 255).
+            let al = v[3];
+            *slot = if al == 0 {
+                0
+            } else {
+                let un = |p: u32| ((p * 255 + al / 2) / al).min(255);
+                let a8 = ((al + 127) / 255).min(255);
+                un(v[0]) | (un(v[1]) << 8) | (un(v[2]) << 16) | (a8 << 24)
+            };
+        }
+        GradientPaint { radial, m, lut }
+    }
+
+    #[inline]
+    fn at(&self, x: i32, y: i32) -> u32 {
+        let (xf, yf) = (x as f32, y as f32);
+        let m = &self.m;
+        let t = if self.radial {
+            let u = m[0] * xf + m[1] * yf + m[2];
+            let v = m[3] * xf + m[4] * yf + m[5];
+            sqrtf_newton(u * u + v * v)
+        } else {
+            m[0] * xf + m[1] * yf + m[2]
+        };
+        let t = if t.is_finite() { t.max(0.0).min(1.0) } else { 0.0 };
+        self.lut[(t * (PAINT_LUT - 1) as f32 + 0.5) as usize]
+    }
+}
+
+/// A target under a gradient paint: every write keeps its alpha and takes
+/// the paint's colour at that pixel, the paint's own alpha multiplied in.
+struct Painted<'a> {
+    inner: &'a mut dyn RenderTarget,
+    stride: i32,
+    paint: GradientPaint,
+}
+
+impl RenderTarget for Painted<'_> {
+    #[inline]
+    fn pixel_len(&self) -> usize {
+        self.inner.pixel_len()
+    }
+
+    #[inline]
+    fn fill_clear(&mut self, start: usize, len: usize) {
+        self.inner.fill_clear(start, len);
+    }
+
+    #[inline]
+    fn blend(&mut self, offset: usize, _r: u32, _g: u32, _b: u32, a: u32) {
+        let o = offset as i32;
+        let (cr, cg, cb, ca) = channels(self.paint.at(o % self.stride, o / self.stride));
+        let a = (a.min(255) * ca + 127) / 255;
+        if a != 0 {
+            self.inner.blend(offset, cr, cg, cb, a);
+        }
+    }
+
+    fn fill_opaque(&mut self, start: usize, len: usize, r: u32, g: u32, b: u32) {
+        for k in 0..len {
+            self.blend(start + k, r, g, b, 255);
+        }
+    }
+
+    #[inline]
+    fn read(&self, offset: usize) -> Option<(u32, u32, u32, u32)> {
+        self.inner.read(offset)
+    }
+}
