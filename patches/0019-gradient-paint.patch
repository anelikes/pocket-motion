+
+/**
+ * Gradient paint utilities after `bg-` (pocket-motion):
+ *
+ *   bg-linear-N, bg-linear-[Ndeg]   an angle, CSS convention (0 = to top)
+ *   bg-linear-to-t|r|b|l            the four sides
+ *   bg-radial                       the farthest-corner ellipse about the centre
+ *   bg-clip-text / bg-clip-border   paint the ground into the glyphs / the box
+ *   bg-[linear-gradient(45deg,#f00,#0f0_30%,#00f)]
+ *   bg-[radial-gradient(#fff,#fff0_70%)]
+ *                                   up to 6 stops, `_` for a space, stops
+ *                                   `#hex` or palette names with an optional
+ *                                   `N%`; missing positions spread evenly
+ *                                   between known ones, as CSS
+ */
+function parseGradientPaint(rest: string, acc: VariantAcc): boolean {
+  const D = acc.decls;
+  if (rest === "radial") { acc.gradKind = ENUMS.GradKind.Radial; acc.gradPaint = true; return true; }
+  if (rest === "clip-text") { acc.clipText = true; D.push([PROP.bgClip, int(ENUMS.BgClip.Text)]); return true; }
+  if (rest === "clip-border") { D.push([PROP.bgClip, int(ENUMS.BgClip.Border)]); return true; }
+  if (rest.startsWith("linear-")) {
+    const v = rest.slice("linear-".length);
+    let angle: number | null = null;
+    const to = /^to-([tblr])$/.exec(v);
+    if (to) angle = LINEAR_TO[to[1]!]!;
+    else if (/^\d+$/.test(v)) angle = parseInt(v, 10);
+    else {
+      const arb = /^\[(-?\d+(?:\.\d+)?)(?:deg)?\]$/.exec(v);
+      if (arb) angle = parseFloat(arb[1]!);
+    }
+    if (angle === null) return false;
+    acc.gradKind = ENUMS.GradKind.Linear;
+    acc.gradAngle = angle;
