+#[test]
+fn gradient_angle_and_radial_follow_the_css_line() {
+    let (black, white) = (abgr(0, 0, 0, 255), abgr(255, 255, 255, 255));
+    // 180 deg (to bottom): top dark, bottom light, rows constant.
+    let (mut ui, _, _) = gradient_box(spec::GradKind::Linear, 180.0, &[(black, 0.0), (white, 1.0)], &[]);
+    let fb = raster_fb(&mut ui);
+    assert!(sample_rgba(&fb, 10, 100)[0] < 10 && sample_rgba(&fb, 10, 139)[0] > 245);
+    assert_eq!(sample_rgba(&fb, 10, 120), sample_rgba(&fb, 190, 120));
+    // Radial: the centre is the first stop, the corners reach the last.
+    let (mut ui, _, _) = gradient_box(spec::GradKind::Radial, 0.0, &[(black, 0.0), (white, 1.0)], &[]);
+    let fb = raster_fb(&mut ui);
+    assert!(sample_rgba(&fb, 100, 120)[0] < 8, "centre: {:?}", sample_rgba(&fb, 100, 120));
+    assert!(sample_rgba(&fb, 0, 100)[0] > 240, "corner: {:?}", sample_rgba(&fb, 0, 100));
+    assert_eq!(sample_rgba(&fb, 60, 120), sample_rgba(&fb, 139, 120), "symmetric about the centre");
+}
