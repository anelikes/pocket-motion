+            ui.set_prop(b, spec::prop::BG_COLOR, abgr(200, 200, 200, 128) as f64);
+            ui.set_prop(b, spec::prop::BLUR, 3.0);
+            ui.insert_before(g, b, k);
+        }
+        ui.tick();
+        raster_fb(&mut ui)
+    };
+    let (one, two) = (build(false), build(true));
+    for x in 20..140 {
+        assert_eq!(sample_rgba(&one, x, 90), sample_rgba(&two, x, 90), "column {x} of the first node");
+    }
+}
