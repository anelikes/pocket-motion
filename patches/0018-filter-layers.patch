+    free: Vec<Vec<u8>>,
+}
+
+impl LayerPool {
+    fn take(&mut self, pixels: usize) -> Vec<u8> {
+        match self.free.pop() {
+            Some(b) if b.len() == pixels * 4 => b,
+            _ => alloc::vec![0u8; pixels * 4],
+        }
+    }
+}
+
+impl LayerTarget {
+    fn new(bytes: Vec<u8>) -> LayerTarget {
+        LayerTarget { bytes, lo: usize::MAX, hi: 0 }
+    }
+
+    #[inline]
+    fn touch(&mut self, start: usize, len: usize) {
+        self.lo = self.lo.min(start);
+        self.hi = self.hi.max(start + len);
+    }
+}
+
+impl RenderTarget for LayerTarget {
+    #[inline]
+    fn pixel_len(&self) -> usize {
+        self.bytes.len() / 4
+    }
+
+    #[inline]
+    fn blend(&mut self, offset: usize, r: u32, g: u32, b: u32, a: u32) {
+        if a == 0 {
+            return;
+        }
+        self.touch(offset, 1);
+        RgbaTarget::<false> { bytes: &mut self.bytes }.blend(offset, r, g, b, a);
+    }
+
+    #[inline]
+    fn fill_opaque(&mut self, start: usize, len: usize, r: u32, g: u32, b: u32) {
+        if len == 0 {
+            return;
+        }
+        self.touch(start, len);
+        RgbaTarget::<false> { bytes: &mut self.bytes }.fill_opaque(start, len, r, g, b);
+    }
+
+    #[inline]
+    fn fill_clear(&mut self, start: usize, len: usize) {
+        RgbaTarget::<false> { bytes: &mut self.bytes }.fill_clear(start, len);
+    }
+
+    #[inline]
+    fn read(&self, offset: usize) -> Option<(u32, u32, u32, u32)> {
+        let o = offset * 4;
+        Some((
+            self.bytes[o] as u32,
+            self.bytes[o + 1] as u32,
+            self.bytes[o + 2] as u32,
+            self.bytes[o + 3] as u32,
+        ))
+    }
+}
+
+/// The separable blend function B(backdrop, source) of W3C Compositing
+/// Level 1, on 0..255 channels, integer. Add is linear dodge.
+#[inline]
+fn blend_channel(mode: u32, cb: u32, cs: u32) -> u32 {
+    let mul = |a: u32, b: u32| (a * b + 127) / 255;
+    match mode {
+        1 => mul(cb, cs),
+        2 => cb + cs - mul(cb, cs),
+        3 => {
+            // Overlay = HardLight with the roles swapped.
+            if cb <= 127 {
+                mul(2 * cb, cs)
+            } else {
+                let c = 2 * cb - 255;
+                c + cs - mul(c, cs)
+            }
+        }
+        4 => (cb + cs).min(255),
+        _ => cs,
+    }
+}
+
+/// Composite one straight-alpha source pixel by blend mode: the mixed
+/// source `(1 - ab) * cs + ab * B(cb, cs)`, then the target's own
+/// source-over. Normal, or a target that cannot read its backdrop, is the
+/// plain `blend`.
+#[inline]
+fn blend_with<T: RenderTarget + ?Sized>(t: &mut T, offset: usize, r: u32, g: u32, b: u32, a: u32, mode: u32) {
+    if mode == 0 || mode > 4 {
+        t.blend(offset, r, g, b, a);
+        return;
+    }
+    let Some((dr, dg, db, da)) = t.read(offset) else {
+        t.blend(offset, r, g, b, a);
+        return;
+    };
+    let mix = |cs: u32, cb: u32| ((255 - da) * cs + da * blend_channel(mode, cb, cs) + 127) / 255;
+    t.blend(offset, mix(r, dr), mix(g, dg), mix(b, db), a);
+}
+
+/// Extended-box parameters for one of three passes approximating a gaussian
+/// of standard deviation `sigma` px (Gwosdek, Grewenig, Bruhn, Weickert
+/// 2011): radius `r` and an edge weight in 1/256ths for the samples at
+/// +-(r + 1), so the variance — and the picture — moves continuously with
+/// `sigma` rather than in whole-box steps.
+fn extended_box(sigma: f32) -> (usize, u64) {
+    let v = sigma * sigma / 3.0;
+    let r = ((sqrtf_newton(12.0 * v + 1.0) - 1.0) * 0.5) as usize;
+    let rf = r as f32;
+    let den = 2.0 * ((rf + 1.0) * (rf + 1.0) - v);
+    let alpha = if den > 0.0 { (2.0 * rf + 1.0) * (v - rf * (rf + 1.0) / 3.0) / den } else { 0.0 };
+    let we = (alpha.max(0.0).min(1.0) * 256.0 + 0.5) as u64;
+    (r, we.min(255))
+}
+
+/// `(256 * sum + we * edge) / den`, rounded — one extended-box sample —
+/// through a fixed-point reciprocal `inv = round(2^40 / den)`: a u64 multiply
+/// where a division per sample was the cost of the whole blur. Integer, so
+/// the same words give the same pixels; the numerator stays under 2^36 for
+/// every radius BLUR_MAX allows, so the product fits.
+#[inline(always)]
+fn box_out(sum: u64, edge: u64, we: u64, inv: u64) -> u32 {
+    (((256 * sum + we * edge) * inv + (1u64 << 39)) >> 40) as u32
+}
+
+#[inline]
+fn box_inv(r: usize, we: u64) -> u64 {
+    let den = (2 * r as u64 + 1) * 256 + 2 * we;
+    ((1u64 << 40) + den / 2) / den
+}
+
+/// One extended-box pass along the rows of a `w x h` image of `ch`
+/// interleaved channels, zero outside it. Each row is copied into a line
+/// padded by r + 1 zeros on both sides so the window never branches.
+fn box_rows(img: &mut [u32], w: usize, h: usize, ch: usize, r: usize, we: u64, line: &mut Vec<u32>) {
+    let inv = box_inv(r, we);
+    let pad = r + 1;
+    line.clear();
+    line.resize((w + 2 * pad) * ch, 0);
+    for y in 0..h {
+        let row = &mut img[y * w * ch..(y + 1) * w * ch];
+        line[pad * ch..(pad + w) * ch].copy_from_slice(row);
+        for c in 0..ch {
+            // Window for x = 0 is line[pad - r ..= pad + r].
+            let mut sum: u64 = 0;
+            for k in (pad - r)..=(pad + r) {
+                sum += line[k * ch + c] as u64;
+            }
+            for x in 0..w {
+                let lo = x + pad - r; // first index in the window
+                let edge = line[(lo - 1) * ch + c] as u64 + line[(lo + 2 * r + 1) * ch + c] as u64;
+                row[x * ch + c] = box_out(sum, edge, we, inv);
+                sum = sum + line[(lo + 2 * r + 1) * ch + c] as u64 - line[lo * ch + c] as u64;
+            }
+        }
+    }
+}
+
+/// The same pass down columns, one accumulator per column and channel, row
+/// by row so the reads stay sequential.
+fn box_cols(img: &mut [u32], w: usize, h: usize, ch: usize, r: usize, we: u64, src: &mut Vec<u32>) {
+    let inv = box_inv(r, we);
+    let rw = w * ch;
+    src.clear();
+    src.extend_from_slice(img);
+    let mut acc: Vec<u64> = alloc::vec![0u64; rw];
+    for k in 0..=r.min(h.saturating_sub(1)) {
+        for (a, v) in acc.iter_mut().zip(&src[k * rw..(k + 1) * rw]) {
+            *a += *v as u64;
+        }
+    }
+    for y in 0..h {
+        let up = (y as isize - r as isize - 1 >= 0).then(|| (y - r - 1) * rw);
+        let down = (y + r + 1 < h).then(|| (y + r + 1) * rw);
+        let out = &mut img[y * rw..(y + 1) * rw];
+        for x in 0..rw {
+            let mut edge = 0u64;
+            if let Some(u) = up {
+                edge += src[u + x] as u64;
+            }
+            if let Some(d) = down {
+                edge += src[d + x] as u64;
+            }
+            out[x] = box_out(acc[x], edge, we, inv);
+        }
+        // Slide: row y + r + 1 enters, row y - r leaves.
+        if let Some(d) = down {
+            for (a, v) in acc.iter_mut().zip(&src[d..d + rw]) {
+                *a += *v as u64;
+            }
+        }
+        if y >= r {
+            let l = (y - r) * rw;
+            for (a, v) in acc.iter_mut().zip(&src[l..l + rw]) {
+                *a -= *v as u64;
+            }
+        }
+    }
+}
+
+/// Gaussian blur of a `w x h` image of `ch` interleaved channels by three
+/// extended-box passes per axis.
+fn blur_plane(img: &mut [u32], w: usize, h: usize, ch: usize, sigma: f32, scratch: &mut Vec<u32>) {
+    if !(sigma > 0.05) || w == 0 || h == 0 {
+        return;
+    }
+    let (r, we) = extended_box(sigma);
+    for _ in 0..3 {
+        box_rows(img, w, h, ch, r, we, scratch);
+    }
+    for _ in 0..3 {
+        box_cols(img, w, h, ch, r, we, scratch);
+    }
+}
+
+/// Resolution divisor for a blur of deviation `sigma` px: the largest power
+/// of two k <= sigma / 4, at most 8. Every pass costs per pixel whatever the
+/// radius, so a wide blur is paid in area; at sigma >= 4k the dropped
+/// frequencies were going to be blurred away anyway.
+#[inline]
+fn blur_divisor(sigma: f32) -> usize {
+    if sigma >= 32.0 {
+        8
+    } else if sigma >= 16.0 {
+        4
+    } else if sigma >= 8.0 {
+        2
+    } else {
+        1
+    }
+}
+
+/// Gaussian blur, at full resolution below a deviation of 8 px and at
+/// 1/k resolution above it (`blur_divisor`): box-average down by k, blur
+/// with the deviation that leaves after the down- and up-sampling filters'
+/// own variance ((k^2 - 1) / 12 and k^2 / 6), then bilinear back up. Integer
+/// throughout except the one deviation, so the result is a function of the
+/// input words alone.
+fn blur_image(img: &mut [u32], w: usize, h: usize, ch: usize, sigma: f32, scratch: &mut Vec<u32>) {
+    let k = blur_divisor(sigma);
+    if k == 1 {
+        blur_plane(img, w, h, ch, sigma, scratch);
+        return;
+    }
+    let (dw, dh) = (w.div_ceil(k), h.div_ceil(k));
+    let shift = k.trailing_zeros();
+    let mut down: Vec<u32> = alloc::vec![0u32; dw * dh * ch];
+    let mut acc: Vec<u64> = alloc::vec![0u64; dw * ch];
+    let kk = (k * k) as u64;
+    for dy in 0..dh {
+        acc.fill(0);
+        for y in dy * k..((dy + 1) * k).min(h) {
+            let row = &img[y * w * ch..(y + 1) * w * ch];
+            for (x, px) in row.chunks_exact(ch).enumerate() {
+                let o = (x >> shift) * ch;
+                for (a, v) in acc[o..o + ch].iter_mut().zip(px) {
+                    *a += *v as u64;
+                }
+            }
+        }
+        for (d, a) in down[dy * dw * ch..(dy + 1) * dw * ch].iter_mut().zip(&acc) {
+            *d = ((*a + kk / 2) / kk) as u32;
+        }
+    }
+    let kf = k as f32;
+    let var = sigma * sigma - (kf * kf - 1.0) / 12.0 - kf * kf / 6.0;
+    let sd = if var > 0.0 { sqrtf_newton(var) / kf } else { 0.0 };
+    blur_plane(&mut down, dw, dh, ch, sd, scratch);
+    // Bilinear up: pixel x's centre sits at (2x + 1 - k) / 2k in the small
+    // image, in 1/256ths exactly because k divides 128.
+    let tap = |x: usize, n: usize| -> (usize, usize, u64) {
+        let p = (2 * x as i64 + 1 - k as i64) * (128 / k as i64);
+        if p <= 0 {
+            return (0, 0, 0);
+        }
+        let i0 = (p >> 8) as usize;
+        let f = (p & 255) as u64;
+        if i0 + 1 >= n {
+            (n - 1, n - 1, 0)
+        } else {
+            (i0, i0 + 1, f)
+        }
+    };
+    // Rows first into a w x dh buffer, then columns into the image.
+    let xtaps: Vec<(usize, usize, u64)> = (0..w).map(|x| tap(x, dw)).collect();
+    let mut rows: Vec<u32> = alloc::vec![0u32; w * dh * ch];
+    for y in 0..dh {
+        let src = &down[y * dw * ch..(y + 1) * dw * ch];
+        let dst = &mut rows[y * w * ch..(y + 1) * w * ch];
+        for (x, &(a, b, f)) in xtaps.iter().enumerate() {
+            for c in 0..ch {
+                let va = src[a * ch + c] as u64;
+                let vb = src[b * ch + c] as u64;
+                dst[x * ch + c] = ((va * (256 - f) + vb * f + 128) >> 8) as u32;
+            }
+        }
+    }
+    let rw = w * ch;
+    for y in 0..h {
+        let (a, b, f) = tap(y, dh);
+        let (ra, rb) = (&rows[a * rw..(a + 1) * rw], &rows[b * rw..(b + 1) * rw]);
+        for ((o, va), vb) in img[y * rw..(y + 1) * rw].iter_mut().zip(ra).zip(rb) {
+            *o = ((*va as u64 * (256 - f) + *vb as u64 * f + 128) >> 8) as u32;
+        }
+    }
+}
+
+/// Pad of a blur of standard deviation `sigma`: three deviations, rounded out.
+#[inline]
+fn blur_pad(sigma: f32) -> i32 {
+    if sigma > 0.05 {
+        (3.0 * sigma) as i32 + 2
+    } else {
+        0
+    }
+}
+
+/// Filter the finished layer and composite it over `target` inside `clip`.
+/// Returns the rows of the layer that may now be non-zero, so the caller can
+/// clear exactly those.
+fn composite_layer<T: RenderTarget>(
+    target: &mut T,
+    layer: &mut LayerTarget,
+    fx: &LayerFx,
+    clip: Clip,
+    stride: i32,
+    scale: i32,
+) -> (usize, usize) {
+    if layer.lo >= layer.hi {
+        return (0, 0);
+    }
+    let w = stride as usize;
+    // Content bounds: the touched rows, then the columns with any alpha.
+    let (ry0, ry1) = (layer.lo / w, (layer.hi - 1) / w + 1);
+    let written = (ry0, ry1);
+    if clip.x0 >= clip.x1 || clip.y0 >= clip.y1 {
+        return written;
+    }
+    let (mut x0, mut x1) = (w, 0usize);
+    for y in ry0..ry1 {
+        let row = &layer.bytes[y * w * 4..(y + 1) * w * 4];
+        for x in 0..w {
+            if row[x * 4 + 3] != 0 {
+                x0 = x0.min(x);
+                x1 = x1.max(x + 1);
+            }
+        }
+    }
+    if x0 >= x1 {
+        return written;
+    }
+    let mut content = Clip { x0: x0 as i32, y0: ry0 as i32, x1: x1 as i32, y1: ry1 as i32 };
+    let mut scratch: Vec<u32> = Vec::new();
+
+    // Blur: premultiply the padded region into one RGBA image, blur, and write
+    // back straight alpha. The pad is clipped: nothing outside the clip was
+    // drawn, and nothing outside it will be shown.
+    let sigma = fx.blur * scale as f32;
+    let pad = blur_pad(sigma);
+    if pad > 0 {
+        let region = Clip {
+            x0: content.x0 - pad,
+            y0: content.y0 - pad,
+            x1: content.x1 + pad,
+            y1: content.y1 + pad,
+        }
+        .intersect(clip);
+        if region.x0 >= region.x1 || region.y0 >= region.y1 {
+            return written;
+        }
+        let (rw, rh) = ((region.x1 - region.x0) as usize, (region.y1 - region.y0) as usize);
+        let mut img: Vec<u32> = alloc::vec![0u32; rw * rh * 4];
+        for y in 0..rh {
+            let src = &layer.bytes[((region.y0 as usize + y) * w + region.x0 as usize) * 4..];
+            for x in 0..rw {
+                let a = src[x * 4 + 3] as u32;
+                if a == 0 {
+                    continue;
+                }
+                let i = (y * rw + x) * 4;
+                // Premultiplied, scaled by 255 so three passes keep precision.
+                img[i] = src[x * 4] as u32 * a;
+                img[i + 1] = src[x * 4 + 1] as u32 * a;
+                img[i + 2] = src[x * 4 + 2] as u32 * a;
+                img[i + 3] = a * 255;
+            }
+        }
+        blur_image(&mut img, rw, rh, 4, sigma, &mut scratch);
+        for y in 0..rh {
+            let dst = &mut layer.bytes[((region.y0 as usize + y) * w + region.x0 as usize) * 4..];
+            for x in 0..rw {
+                let i = (y * rw + x) * 4;
+                let a = img[i + 3]; // alpha * 255
+                let o = x * 4;
+                if a == 0 {
+                    dst[o..o + 4].fill(0);
+                    continue;
+                }
+                let un = |p: u32| ((p as u64 * 255 + a as u64 / 2) / a as u64).min(255) as u8;
+                dst[o] = un(img[i]);
+                dst[o + 1] = un(img[i + 1]);
+                dst[o + 2] = un(img[i + 2]);
+                dst[o + 3] = ((a + 127) / 255).min(255) as u8;
+            }
+        }
+        content = region;
+    }
+    let written = (written.0.min(content.y0 as usize), written.1.max(content.y1 as usize));
+
+    // Shadow: the layer's alpha, offset, blurred, times gain, tinted.
+    let (sr, sg, sb, sa) = channels(fx.shadow_color);
+    let mut shadow: Vec<u32> = Vec::new();
+    let mut srect = Clip { x0: 0, y0: 0, x1: 0, y1: 0 };
+    if sa > 0 && fx.shadow_gain > 0.0 {
+        let round = |v: f32| -> i32 { if v >= 0.0 { (v + 0.5) as i32 } else { -((-v + 0.5) as i32) } };
+        let dx = round(fx.shadow_x * scale as f32);
+        let dy = round(fx.shadow_y * scale as f32);
+        let ssigma = fx.shadow_blur * 0.5 * scale as f32;
+        let spad = blur_pad(ssigma);
+        srect = Clip {
+            x0: content.x0 + dx - spad,
+            y0: content.y0 + dy - spad,
+            x1: content.x1 + dx + spad,
+            y1: content.y1 + dy + spad,
+        }
+        .intersect(clip);
+        if srect.x0 < srect.x1 && srect.y0 < srect.y1 {
+            let (sw, sh) = ((srect.x1 - srect.x0) as usize, (srect.y1 - srect.y0) as usize);
+            shadow = alloc::vec![0u32; sw * sh];
+            for y in 0..sh {
+                let ly = srect.y0 + y as i32 - dy;
+                if ly < content.y0 || ly >= content.y1 {
+                    continue;
+                }
+                for x in 0..sw {
+                    let lx = srect.x0 + x as i32 - dx;
+                    if lx < content.x0 || lx >= content.x1 {
+                        continue;
+                    }
+                    shadow[y * sw + x] = layer.bytes[(ly as usize * w + lx as usize) * 4 + 3] as u32 * 256;
+                }
+            }
+            blur_image(&mut shadow, sw, sh, 1, ssigma, &mut scratch);
+            // Fold the gain and the colour's alpha in: 0..255 coverage.
+            let gain = (fx.shadow_gain * 256.0 + 0.5) as u64;
+            for v in shadow.iter_mut() {
+                let a = (*v as u64 * gain / 256 + 128) / 256; // 0..255 * gain
+                *v = ((a.min(255) * sa as u64 + 127) / 255) as u32;
+            }
+        } else {
+            srect = Clip { x0: 0, y0: 0, x1: 0, y1: 0 };
+        }
+    }
+
+    // Composite: content over its shadow, then over the target by mode.
+    let has_shadow = !shadow.is_empty();
+    let u = if has_shadow {
+        Clip {
+            x0: content.x0.min(srect.x0),
+            y0: content.y0.min(srect.y0),
+            x1: content.x1.max(srect.x1),
+            y1: content.y1.max(srect.y1),
+        }
+    } else {
+        content
+    }
+    .intersect(clip);
+    let sw = (srect.x1 - srect.x0).max(0) as usize;
+    for y in u.y0..u.y1 {
+        for x in u.x0..u.x1 {
+            let off = (y as usize) * w + x as usize;
+            let o = off * 4;
+            let (cr, cg, cb, ca) = (
+                layer.bytes[o] as u32,
+                layer.bytes[o + 1] as u32,
+                layer.bytes[o + 2] as u32,
+                layer.bytes[o + 3] as u32,
+            );
+            let s = if has_shadow && x >= srect.x0 && x < srect.x1 && y >= srect.y0 && y < srect.y1 {
+                shadow[(y - srect.y0) as usize * sw + (x - srect.x0) as usize]
+            } else {
+                0
+            };
+            if ca == 0 && s == 0 {
+                continue;
+            }
+            let (r, g, b, a) = if s == 0 || ca >= 255 {
+                (cr, cg, cb, ca)
+            } else if ca == 0 {
+                (sr, sg, sb, s)
+            } else {
+                // Straight-alpha source-over of the content on its shadow.
+                let ia = 255 - ca;
+                let oa = ca + (s * ia + 127) / 255;
+                let den = oa * 255;
+                let mix = |c: u32, d: u32| (c * ca * 255 + d * s * ia + den / 2) / den;
+                (mix(cr, sr), mix(cg, sg), mix(cb, sb), oa)
+            };
+            blend_with(target, off, r, g, b, a, fx.blend);
+        }
+    }
+    written
+}
