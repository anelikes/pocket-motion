+#[test]
+fn blur_spreads_symmetrically_and_moves_continuously_with_sigma() {
+    let black = abgr(0, 0, 0, 255);
+    let white = abgr(255, 255, 255, 255);
+    let (mut ui, _, words) = filtered_box(black, white, &[(spec::prop::BLUR, 4.0)]);
+    let push = words.iter().position(|&w| w == spec::draw_op::LAYER_PUSH).expect("a layer");
+    assert_eq!(f32::from_bits(words[push + 2]), 4.0);
+    let fb = raster_fb(&mut ui);
+    let at = |x: usize, y: usize| sample_rgba(&fb, x, y)[0];
+    assert!(at(100, 100) > 250, "the middle of a 40 px box barely moves under a 4 px blur");
+    assert!(at(76, 100) > 0 && at(76, 100) < 128, "4 px outside the edge is lit, dimly: {}", at(76, 100));
+    assert_eq!(at(60, 100), 0, "20 px outside is past three deviations");
+    for d in 1..16 {
+        assert_eq!(at(80 - d, 100), at(119 + d, 100), "left/right symmetric at {d}");
+        assert_eq!(at(100, 80 - d), at(100, 119 + d), "top/bottom symmetric at {d}");
+    }
+    assert!(at(79, 100) > at(78, 100) && at(78, 100) > at(77, 100), "monotone falloff");
+    // Continuous in sigma: 4.1 differs from 4.0, by little.
+    let (mut ui2, _, _) = filtered_box(black, white, &[(spec::prop::BLUR, 4.1)]);
+    let fb2 = raster_fb(&mut ui2);
+    assert_ne!(fb, fb2, "a tenth of a pixel of deviation moves the picture");
+    let worst = fb.iter().zip(&fb2).map(|(a, b)| (*a as i32 - *b as i32).abs()).max().unwrap();
+    assert!(worst <= 6, "and moves it by little: {worst}");
+}
