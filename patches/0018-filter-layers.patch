+#[test]
+fn blend_modes_match_the_w3c_separable_functions() {
+    let ground = abgr(128, 64, 200, 255);
+    let src = abgr(255, 128, 0, 255);
+    let px = |mode: spec::BlendMode| {
+        let (mut ui, _, _) = filtered_box(ground, src, &[(spec::prop::BLEND_MODE, mode as u32 as f64)]);
+        let fb = raster_fb(&mut ui);
+        (sample_rgba(&fb, 100, 100), sample_rgba(&fb, 10, 10))
+    };
+    let m = |a: u32, b: u32| ((a * b + 127) / 255) as u8;
+    let (inside, outside) = px(spec::BlendMode::Multiply);
+    assert_eq!(outside, [128, 64, 200, 255], "outside the node the ground is untouched");
+    assert_eq!(inside, [m(128, 255), m(64, 128), m(200, 0), 255]);
+    let screen = |b: u32, s: u32| (b + s - (b * s + 127) / 255) as u8;
+    assert_eq!(px(spec::BlendMode::Screen).0, [screen(128, 255), screen(64, 128), screen(200, 0), 255]);
+    let add = |b: u32, s: u32| (b + s).min(255) as u8;
+    assert_eq!(px(spec::BlendMode::Add).0, [add(128, 255), add(64, 128), add(200, 0), 255]);
+    let overlay = |b: u32, s: u32| {
+        if b <= 127 {
+            ((2 * b * s + 127) / 255) as u8
+        } else {
+            let c = 2 * b - 255;
+            (c + s - (c * s + 127) / 255) as u8
+        }
+    };
+    assert_eq!(px(spec::BlendMode::Overlay).0, [overlay(128, 255), overlay(64, 128), overlay(200, 0), 255]);
+    assert_eq!(px(spec::BlendMode::Normal).0, [255, 128, 0, 255]);
+}
