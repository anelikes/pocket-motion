+// ---- LAYER_PUSH / LAYER_POP: filter layers (pocket-motion) -------------------------
+
+/// A 200x200 ground of `ground` with one absolute 40x40 box of `color` at
+/// (80, 80); `fx` sets filter props on the box. Returns the Ui, the box id
+/// and the draw words.
+fn filtered_box(ground: u32, color: u32, fx: &[(u8, f64)]) -> (Ui, i32, Vec<u32>) {
+    let mut ui = Ui::new();
+    let g = ui.create_node(0);
+    ui.set_prop(g, spec::prop::WIDTH, 200.0);
+    ui.set_prop(g, spec::prop::HEIGHT, 200.0);
+    ui.set_prop(g, spec::prop::BG_COLOR, ground as f64);
+    ui.insert_before(spec::ROOT_ID, g, 0);
+    let b = ui.create_node(0);
+    ui.set_prop(b, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(b, spec::prop::INSET_L, 80.0);
+    ui.set_prop(b, spec::prop::INSET_T, 80.0);
+    ui.set_prop(b, spec::prop::WIDTH, 40.0);
+    ui.set_prop(b, spec::prop::HEIGHT, 40.0);
+    ui.set_prop(b, spec::prop::BG_COLOR, color as f64);
+    for &(p, v) in fx {
+        ui.set_prop(b, p, v);
+    }
+    ui.insert_before(g, b, 0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    validate_drawlist(&words);
+    (ui, b, words)
+}
+
+#[test]
+fn no_filter_prop_emits_no_layer_and_the_same_pixels() {
+    let (mut plain, _, words) = filtered_box(abgr(0, 0, 0, 255), abgr(255, 255, 255, 255), &[]);
+    assert!(!words.iter().any(|&w| w == spec::draw_op::LAYER_PUSH));
+    // blur 0 and a transparent shadow colour are no filter either.
+    let (mut zero, _, zwords) = filtered_box(
+        abgr(0, 0, 0, 255),
+        abgr(255, 255, 255, 255),
+        &[(spec::prop::BLUR, 0.0), (spec::prop::DROP_SHADOW_X, 5.0), (spec::prop::DROP_SHADOW_BLUR, 4.0)],
+    );
+    assert_eq!(zwords, words);
+    assert_eq!(raster_fb(&mut zero), raster_fb(&mut plain));
+}
