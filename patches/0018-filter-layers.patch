+    const v = arbPx(tok.slice(5));
+    if (v === null || v < 0 || v > BLUR_MAX) return false;
+    D.push([PROP.blur, px(v)]);
+    return true;
+  }
+  if (tok.startsWith("mix-blend-")) {
+    const mode = BLEND_MODES[tok.slice("mix-blend-".length)];
+    if (mode === undefined) return false;
+    D.push([PROP.blendMode, int(mode)]);
+    return true;
+  }
