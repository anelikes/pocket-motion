+    /// The arc under a world `emit_arc` does not draw in screen space. Each
+    /// sample point is taken back through the inverse of `world` into the
+    /// node's local frame and tested against the arc there — ring, angle and
+    /// caps in local pixels — so the arc turns with its ancestors' rotation,
+    /// mirrors with a negative scale, and under a scale that differs per axis
+    /// (or a skew) is the same ring stretched: an elliptical band whose
+    /// stroke and caps stretch with it, as every other drawing under that
+    /// transform does. The samples, the coverage and the RECT runs are the
+    /// screen-space path's: 2x2 per pixel, `cov / 4` of the colour.
+    #[allow(clippy::too_many_arguments)]
+    fn emit_arc_transformed(
+        &self,
+        dl: &mut DrawList,
+        world: &Affine,
+        w: f32,
+        h: f32,
+        r: &style::Resolved,
+        color: u32,
+        clip: &Clip,
+    ) {
+        let det = world.a * world.d - world.b * world.c;
+        if det == 0.0 || !det.is_finite() {
+            return;
+        }
+        let outer = w.min(h) * 0.5;
+        let width = r.arc_width.min(outer);
+        if outer <= 0.0 || width <= 0.0 {
+            return;
+        }
+        let (lcx, lcy) = (w * 0.5, h * 0.5);
+        let rmid = outer - width * 0.5;
+        let half = width * 0.5;
+        let ring_in = (rmid - half).max(0.0);
+        let ring_in2 = ring_in * ring_in;
+        let ring_out2 = outer * outer;
+        let sweep = clampf(r.arc_sweep, -360.0, 360.0);
+        let (a0, asweep) = if sweep < 0.0 { (r.arc_start + sweep, -sweep) } else { (r.arc_start, sweep) };
+        let full = asweep >= 360.0;
+        let major = asweep > 180.0;
+        // 0 deg = 12 o'clock, clockwise positive — in the node's frame.
+        let dir = |deg: f32| {
+            let rad = deg * (PI / 180.0);
+            (sinf(rad), -cosf(rad))
+        };
+        let (svx, svy) = dir(a0);
+        let (evx, evy) = dir(a0 + asweep);
+        let cap0 = (svx * rmid, svy * rmid);
+        let cap1 = (evx * rmid, evy * rmid);
+        let half2 = half * half;
+        // Local point relative to the arc's centre.
+        let (ia, ib, ic, id) = (world.d / det, -world.b / det, -world.c / det, world.a / det);
+        let covered = |lx: f32, ly: f32| -> bool {
+            let d2 = lx * lx + ly * ly;
+            if d2 >= ring_in2 && d2 <= ring_out2 {
+                let in_angle = full || {
+                    let cross_s = svx * ly - svy * lx;
+                    let cross_e = evx * ly - evy * lx;
+                    if major { cross_s >= 0.0 || cross_e <= 0.0 } else { cross_s >= 0.0 && cross_e <= 0.0 }
+                };
+                if in_angle {
+                    return true;
+                }
+            }
+            if full {
+                return false;
+            }
+            let (d0x, d0y) = (lx - cap0.0, ly - cap0.1);
+            if d0x * d0x + d0y * d0y <= half2 {
+                return true;
+            }
+            let (d1x, d1y) = (lx - cap1.0, ly - cap1.1);
+            d1x * d1x + d1y * d1y <= half2
+        };
+
+        // Screen bbox of the local square the outer circle sits in.
+        let corners = [
+            world.apply(lcx - outer, lcy - outer),
+            world.apply(lcx + outer, lcy - outer),
+            world.apply(lcx + outer, lcy + outer),
+            world.apply(lcx - outer, lcy + outer),
+        ];
+        let (mut bx0, mut by0, mut bx1, mut by1) = (corners[0].0, corners[0].1, corners[0].0, corners[0].1);
+        for &(x, y) in &corners[1..] {
+            bx0 = bx0.min(x);
+            by0 = by0.min(y);
+            bx1 = bx1.max(x);
+            by1 = by1.max(y);
+        }
+        let x0 = floorf(clampf(bx0, clip.x0, clip.x1)) as i32;
+        let x1 = ceilf(clampf(bx1, clip.x0, clip.x1)) as i32;
+        let y0 = floorf(clampf(by0, clip.y0, clip.y1)) as i32;
+        let y1 = ceilf(clampf(by1, clip.y0, clip.y1)) as i32;
+
+        // Where a sample row at screen y crosses the local circle of squared
+        // radius `rr`: the x interval, or None. Along the row the local point
+        // is (ia·x + ux, ib·x + uy), a quadratic in x.
+        let span = |sy: f32, rr: f32| -> Option<(f32, f32)> {
+            let dy = sy - world.ty;
+            let ux = -ia * world.tx + ic * dy - lcx;
+            let uy = -ib * world.tx + id * dy - lcy;
+            let qa = ia * ia + ib * ib;
+            let qb = 2.0 * (ia * ux + ib * uy);
+            let qc = ux * ux + uy * uy - rr;
+            if qa <= 0.0 {
+                return None;
+            }
+            let disc = qb * qb - 4.0 * qa * qc;
+            if disc < 0.0 {
+                return None;
+            }
+            let root = sqrtf(disc);
+            Some(((-qb - root) / (2.0 * qa), (-qb + root) / (2.0 * qa)))
+        };
+
+        for row in y0..y1 {
+            let (top, bottom) = (row as f32 + 0.25, row as f32 + 0.75);
+            // Columns a sample of this row can land in the outer circle at,
+            // one pixel wider each side than the roots say.
+            let (lo, hi) = match (span(top, ring_out2), span(bottom, ring_out2)) {
+                (None, None) => continue,
+                (Some(a), None) | (None, Some(a)) => a,
+                (Some(a), Some(b)) => (a.0.min(b.0), a.1.max(b.1)),
+            };
+            let row_x0 = (floorf(lo) as i32 - 1).max(x0);
+            let row_x1 = (ceilf(hi) as i32 + 1).min(x1);
+            // Columns every sample of which is inside the hole, one pixel
+            // narrower each side; the caps sit on the ring and never reach in.
+            let (hole_x0, hole_x1) = match (span(top, ring_in2), span(bottom, ring_in2)) {
+                (Some(a), Some(b)) => (ceilf(a.0.max(b.0)) as i32 + 1, floorf(a.1.min(b.1)) as i32 - 1),
+                _ => (i32::MAX, i32::MIN),
+            };
+            let mut run_start = row_x0;
+            let mut run_cov = 0u32;
+            let flush = |dl: &mut DrawList, start: i32, end: i32, cov: u32| {
+                if cov == 0 || end <= start {
+                    return;
+                }
+                let c = scale_alpha(color, cov as f32 / 4.0);
+                if alpha(c) == 0 {
+                    return;
+                }
+                dl.words.push(spec::draw_op::RECT);
+                dl.words.push(xy_word(start as f32, row as f32));
+                dl.words.push(wh_word((end - start) as f32, 1.0));
+                dl.words.push(c);
+            };
+            let mut col = row_x0;
+            while col < row_x1 {
+                if col >= hole_x0 && col < hole_x1 {
+                    if run_cov != 0 {
+                        flush(dl, run_start, col, run_cov);
+                        run_cov = 0;
+                    }
+                    run_start = hole_x1;
+                    col = hole_x1;
+                    continue;
+                }
+                let mut cov = 0u32;
+                for (ox, oy) in [(0.25f32, 0.25f32), (0.75, 0.25), (0.25, 0.75), (0.75, 0.75)] {
+                    let dx = col as f32 + ox - world.tx;
+                    let dy = row as f32 + oy - world.ty;
+                    if covered(ia * dx + ic * dy - lcx, ib * dx + id * dy - lcy) {
+                        cov += 1;
+                    }
+                }
+                if cov != run_cov {
+                    flush(dl, run_start, col, run_cov);
+                    run_start = col;
+                    run_cov = cov;
+                }
+                col += 1;
+            }
+            flush(dl, run_start, row_x1, run_cov);
+        }
+    }
