+#[test]
+fn an_arc_turns_mirrors_and_stretches_with_its_ancestors() {
+    // A ring of arcs on a turning wrapper used to stand still or vanish: the
+    // arc was drawn from its own start angle in screen space and returned
+    // early under any world that was not axis-aligned. Under a rotation the
+    // arc is now the same arc with its start moved by that rotation; under a
+    // mirror its sweep runs the other way; under a scale that differs per
+    // axis it is the ring stretched.
+    let quarter_at = |deg: f64| (deg + 45.0).rem_euclid(360.0);
+    let close = |a: f64, b: f64| ((a - b + 540.0).rem_euclid(360.0) - 180.0).abs() < 1.0;
+    for &turn in &[30.0f64, 90.0, 135.0, 210.0, -60.0] {
+        let (area, angle, _) = ink_reading(&arc_under(0.0, 90.0, 8.0, turn, 1.0, 1.0));
+        let (want_area, want_angle, _) = ink_reading(&arc_under(turn, 90.0, 8.0, 0.0, 1.0, 1.0));
+        assert!(area > 0.0, "rotate {turn}: the arc drew nothing");
+        assert!(close(want_angle, quarter_at(turn)), "rotate {turn}: reference at {want_angle}");
+        assert!(close(angle, want_angle), "rotate {turn}: the arc sits at {angle} deg, its turned start says {want_angle}");
+        assert!((area - want_area).abs() < want_area * 0.02, "rotate {turn}: area {area} against {want_area}");
+    }
+    // scaleX(-1): the quarter from 12 to 3 o'clock runs from 12 to 9.
+    let (area, angle, _) = ink_reading(&arc_under(0.0, 90.0, 8.0, 0.0, -1.0, 1.0));
+    assert!(area > 0.0, "a mirrored arc drew nothing");
+    assert!(close(angle, 315.0), "mirrored quarter at {angle} deg, want 315");
+    // scaleX(2) on a full ring: twice as wide as it is tall.
+    let (_, _, (x0, y0, x1, y1)) = ink_reading(&arc_under(0.0, 360.0, 4.0, 0.0, 2.0, 1.0));
+    let (bw, bh) = ((x1 - x0) as f64, (y1 - y0) as f64);
+    assert!((bw / bh - 2.0).abs() < 0.05, "a ring under scaleX(2) is {bw}x{bh}");
+}
