+/// An 80 px arc node centred on the screen inside an 80 px wrapper that
+/// carries `rotate`, `scale_x` and `scale_y` about its centre. Returns the
+/// frame (white ink on a transparent clear).
+fn arc_under(start: f64, sweep: f64, width: f64, rotate: f64, scale_x: f64, scale_y: f64) -> alloc::vec::Vec<u8> {
+    let mut ui = Ui::new();
+    let wrap = place_box(&mut ui, 80.0, 80.0, 200.0, 96.0);
+    if rotate != 0.0 {
+        ui.set_prop(wrap, spec::prop::ROTATE, rotate);
+    }
+    if scale_x != 1.0 {
+        ui.set_prop(wrap, spec::prop::SCALE_X, scale_x);
+    }
+    if scale_y != 1.0 {
+        ui.set_prop(wrap, spec::prop::SCALE_Y, scale_y);
+    }
+    let arc = ui.create_node(0);
+    ui.set_prop(arc, spec::prop::WIDTH, 80.0);
+    ui.set_prop(arc, spec::prop::HEIGHT, 80.0);
+    ui.set_prop(arc, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(arc, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.set_prop(arc, spec::prop::ARC_START, start);
+    ui.set_prop(arc, spec::prop::ARC_SWEEP, sweep);
+    ui.set_prop(arc, spec::prop::ARC_WIDTH, width);
+    ui.insert_before(wrap, arc, 0);
+    ui.tick();
+    let words = ui.draw().words.clone();
+    validate_drawlist(&words);
+    raster_fb(&mut ui)
+}
+
+/// Ink area (in pixels of full coverage), the ink's angle about the screen
+/// centre (240, 136) — 0 at 12 o'clock, clockwise — and its bbox.
+fn ink_reading(fb: &[u8]) -> (f64, f64, (usize, usize, usize, usize)) {
+    let (mut area, mut sx, mut sy) = (0.0f64, 0.0f64, 0.0f64);
+    let (mut x0, mut y0, mut x1, mut y1) = (usize::MAX, usize::MAX, 0usize, 0usize);
+    for y in 0..spec::SCREEN_H as usize {
+        for x in 0..spec::SCREEN_W as usize {
+            let a = sample_rgba(fb, x, y)[3] as f64 / 255.0;
+            if a == 0.0 {
+                continue;
+            }
+            area += a;
+            sx += a * (x as f64 + 0.5 - 240.0);
+            sy += a * (y as f64 + 0.5 - 136.0);
+            x0 = x0.min(x);
+            y0 = y0.min(y);
+            x1 = x1.max(x + 1);
+            y1 = y1.max(y + 1);
+        }
+    }
+    let angle = if area > 0.0 { sx.atan2(-sy).to_degrees().rem_euclid(360.0) } else { f64::NAN };
+    (area, angle, (x0, y0, x1, y1))
+}
