diff --git a/tests/pending-work.test.ts b/tests/pending-work.test.ts
new file mode 100644
index 00000000..f7c8a1b7
--- /dev/null
+++ b/tests/pending-work.test.ts
@@ -0,0 +1,252 @@
+// pendingWork() (framework/src/index.ts): every registry the frame pump drains
+// is counted, so "all zero" is a claim about each of them rather than about the
+// ones that happened to exist when the reader was written. Driven through the
+// public render() and the real frame handler, one registry per test; each
+// assertion is red with its counter removed from pendingWork().
+//
+// Run: bun test --conditions=browser tests/pending-work.test.ts
+
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+
+if (Bun.resolveSync("solid-js", import.meta.dir).endsWith("server.js")) {
+  throw new Error("solid-js resolved to its SSR build — run: bun test --conditions=browser");
+}
+
+import { createComponent, createRoot } from "solid-js";
+import { installHost, type Host, type HostOps } from "../framework/src/host.ts";
+import { pendingWork, render as publicRender, type PendingWork } from "../framework/src/index.ts";
+import { resetRendererState, type NodeMirror } from "../framework/src/renderer.ts";
+import { resetStyles } from "../framework/src/styles.ts";
+import { resetInput } from "../framework/src/input.ts";
+import { resetPack } from "../framework/src/pak.ts";
+import { View } from "../framework/src/components.ts";
+import { onFrame, SystemFrameContext } from "../framework/src/frame.ts";
+import { after } from "../framework/src/clock.ts";
+import { installEffectDriver, runEffect } from "../framework/src/effects.ts";
+import { registerServicePump } from "../framework/src/services.ts";
+import { ModelRegion, registerModelRegion } from "../framework/src/model-reactive.ts";
+import { ModelTasks, deliverModelResult, disposeModelTasks, drainModelCommands, registerModelCommandHandler } from "../framework/src/model-tasks.ts";
+import { onMount } from "../framework/src/lifecycle-solid-aot.ts";
+import { ROOT_ID } from "../contracts/spec/spec.ts";
+
+function makeHost(): Host {
+  let nextId = ROOT_ID + 1;
+  const noop = () => {};
+  const ops: HostOps = {
+    createNode: () => nextId++,
+    destroyNode: noop,
+    insertBefore: noop,
+    removeChild: noop,
+    setStyle: noop,
+    setProp: noop,
+    setText: noop,
+    replaceText: noop,
+    uploadTexture: () => 900,
+    setImage: noop,
+    setSprite: noop,
+    animate: () => 7,
+    cancelAnim: noop,
+    setFocus: noop,
+    setActive: noop,
+    loadStyles: noop,
+    loadFontAtlas: noop,
+    measureText: () => 0,
+  };
+  return { kind: "injected", target: "test", strict: true, ops };
+}
+
+const g = globalThis as Record<string, unknown>;
+const ZERO: PendingWork = {
+  frameHooks: 0,
+  systemFrameHooks: 0,
+  timers: 0,
+  effectsPending: 0,
+  effectsQueued: 0,
+  servicePumps: 0,
+  modelTasks: 0,
+  modelDeliveries: 0,
+  modelCommands: 0,
+  modelAnimations: 0,
+  modelRegions: 0,
+  lifecycleHooks: 0,
+};
+const storage = <T>(value: T): [() => T, (next: T) => void] => [() => value, next => { value = next; }];
+
+let host: Host;
+let dispose: (() => void) | null = null;
+const cleanups: (() => void)[] = [];
+
+function frame(): void {
+  (g.frame as (buttons: number) => void)(0);
+}
+
+function mount(body: () => void): void {
+  dispose = publicRender(
+    () => {
+      body();
+      return View({ style: { width: 10, height: 10 } }) as unknown as NodeMirror;
+    },
+    { ops: host.ops, styles: {} },
+  );
+}
+
+/** Exactly one registry non-zero, and it is `key`. */
+function only(key: keyof PendingWork, n = 1): PendingWork {
+  return { ...ZERO, [key]: n };
+}
+
+beforeEach(() => {
+  host = makeHost();
+  installHost(host);
+  resetRendererState();
+  resetStyles();
+  resetPack();
+  resetInput();
+});
+
+afterEach(() => {
+  for (const cleanup of cleanups.splice(0).reverse()) cleanup();
+  dispose?.();
+  dispose = null;
+  drainModelCommands();
+  g.frame = undefined;
+});
+
+describe("pendingWork counts every registry the frame pump drains", () => {
+  test("a mounted app with nothing booked reads all zero", () => {
+    mount(() => {});
+    frame();
+    expect(pendingWork()).toEqual(ZERO);
+    expect((g.__pocketPendingWork as () => PendingWork)()).toEqual(ZERO);
+  });
+
+  test("an app frame callback", () => {
+    mount(() => onFrame(() => {}));
+    frame();
+    expect(pendingWork()).toEqual(only("frameHooks"));
+  });
+
+  test("a system-layer frame callback, which runs while the app is suspended", () => {
+    mount(() => {
+      createComponent(SystemFrameContext.Provider, {
+        value: true,
+        get children() {
+          onFrame(() => {});
+          return null;
+        },
+      });
+    });
+    frame();
+    expect(pendingWork()).toEqual(only("systemFrameHooks"));
+  });
+
+  test("a timer whose deadline is far away", () => {
+    mount(() => { after(10, () => {}); });
+    frame();
+    expect(pendingWork()).toEqual(only("timers"));
+  });
+
+  test("an effect awaiting its driver", () => {
+    installEffectDriver(() => {});
+    mount(() => { runEffect("never", null, () => {}); });
+    frame();
+    expect(pendingWork()).toEqual(only("effectsPending"));
+  });
+
+  test("a driver result awaiting the next frame boundary", () => {
+    let deliver: ((result: unknown) => void) | undefined;
+    installEffectDriver((_cmd, done) => { deliver = done; });
+    mount(() => { runEffect("later", null, () => {}); });
+    frame();
+    deliver!(1);
+    expect(pendingWork()).toEqual({ ...only("effectsQueued"), effectsPending: 1 });
+    frame();
+    expect(pendingWork()).toEqual(ZERO);
+  });
+
+  test("a service pump", () => {
+    mount(() => { cleanups.push(registerServicePump(() => {})); });
+    frame();
+    expect(pendingWork()).toEqual(only("servicePumps"));
+  });
+
+  test("a model task suspended for 600 frames, which issues nothing until it resumes", () => {
+    mount(() => {});
+    frame();
+    const region = new ModelRegion(storage);
+    region.finish([]);
+    const tasks = new ModelTasks(region);
+    tasks.start(1, [], () => ({ next: 1, suspend: { kind: "frames", count: 600 } }));
+    cleanups.push(() => { disposeModelTasks(region); region.dispose(); });
+    frame();
+    expect(pendingWork()).toEqual(only("modelTasks"));
+  });
+
+  test("a model result delivered and not yet consumed", () => {
+    mount(() => {});
+    frame();
+    deliverModelResult({ task: { region: 0, function: 0, call: 0 }, wait: 0, member: 0 }, null);
+    expect(pendingWork()).toEqual(only("modelDeliveries"));
+    frame();
+    expect(pendingWork()).toEqual(ZERO);
+  });
+
+  test("a model host command queued for the next drain", () => {
+    mount(() => {});
+    frame();
+    const region = new ModelRegion(storage);
+    region.finish([]);
+    const tasks = new ModelTasks(region);
+    cleanups.push(() => { disposeModelTasks(region); region.dispose(); });
+    cleanups.push(registerModelCommandHandler(() => {}));
+    tasks.command("jump", ["x", "width", 1]);
+    expect(pendingWork()).toEqual(only("modelCommands"));
+    frame();
+    expect(pendingWork()).toEqual(ZERO);
+  });
+
+  test("a native animation a model task is waiting on", () => {
+    mount(() => {});
+    frame();
+    const region = new ModelRegion(storage);
+    region.refs.set("bar", { current: { id: ROOT_ID + 50 } });
+    region.finish([]);
+    const tasks = new ModelTasks(region);
+    cleanups.push(() => { disposeModelTasks(region); region.dispose(); });
+    (host.ops as HostOps & { takeAnimationCompletions?: () => string }).takeAnimationCompletions = () => "[]";
+    tasks.start(1, [], () => ({ next: 1, suspend: { kind: "animate", args: ["bar", "width", 50, { dur: 1000 }] } }));
+    drainModelCommands();
+    const work = pendingWork();
+    expect(work.modelAnimations).toBe(1);
+    expect(work).toEqual({ ...only("modelTasks"), modelAnimations: 1 });
+  });
+
+  test("a model region written to and not yet reacted", () => {
+    mount(() => {});
+    frame();
+    const region = registerModelRegion(new ModelRegion(storage));
+    region.signal(1, "n", 0);
+    region.finish([]);
+    region.react(true);
+    cleanups.push(() => region.dispose());
+    region.write(1, 5);
+    expect(pendingWork()).toEqual(only("modelRegions"));
+    frame();
+    expect(pendingWork()).toEqual(ZERO);
+  });
+
+  test("a lifecycle hook registered and not yet flushed", () => {
+    mount(() => {});
+    frame();
+    // A hook registered outside the mount pass waits for the next flush.
+    let ran = 0;
+    createRoot(disposeRoot => {
+      cleanups.push(disposeRoot);
+      onMount(() => { ran++; });
+    });
+    expect(pendingWork()).toEqual(only("lifecycleHooks"));
+    frame();
+    expect(ran).toBe(1);
+    expect(pendingWork()).toEqual(ZERO);
+  });
+});
