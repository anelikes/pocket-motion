+/// Two translucent white boxes (alpha 107 and 82, the 0.42 and 0.32 a film
+/// draws its radar wedge and coast glow at) that overlap, inside a node with
+/// a white glow, under an `overflow-mask` ancestor or not, over a dark
+/// ground or none — with none, the glow layer composites onto a transparent
+/// destination, as a glow layer nested in another layer does. Returns the
+/// frame with `first` and `second` drawn as asked.
+fn glow_overlap(first: bool, second: bool, masked: bool, ground: bool) -> alloc::vec::Vec<u8> {
+    let mut ui = Ui::new();
+    if ground {
+        ui.set_prop(spec::ROOT_ID, spec::prop::BG_COLOR, abgr(0, 8, 20, 255) as f64);
+    }
+    let outer = place_box(&mut ui, 300.0, 200.0, 90.0, 36.0);
+    if masked {
+        ui.set_prop(outer, spec::prop::OVERFLOW, spec::Overflow::Mask as u32 as f64);
+        ui.set_prop(outer, spec::prop::RADIUS, 90.0);
+    }
+    let glow = ui.create_node(0);
+    ui.set_prop(glow, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(glow, spec::prop::WIDTH, 300.0);
+    ui.set_prop(glow, spec::prop::HEIGHT, 200.0);
+    ui.set_prop(glow, spec::prop::DROP_SHADOW_BLUR, 12.0);
+    ui.set_prop(glow, spec::prop::DROP_SHADOW_COLOR, abgr(255, 255, 255, 255) as f64);
+    ui.set_prop(glow, spec::prop::DROP_SHADOW_GAIN, 1.0);
+    ui.insert_before(outer, glow, 0);
+    for (on, alpha, x, y) in [(first, 107u8, 40.0, 40.0), (second, 82u8, 110.0, 70.0)] {
+        if !on {
+            continue;
+        }
+        let b = ui.create_node(0);
+        ui.set_prop(b, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+        ui.set_prop(b, spec::prop::INSET_L, x);
+        ui.set_prop(b, spec::prop::INSET_T, y);
+        ui.set_prop(b, spec::prop::WIDTH, 140.0);
+        ui.set_prop(b, spec::prop::HEIGHT, 90.0);
+        ui.set_prop(b, spec::prop::BG_COLOR, abgr(255, 255, 255, alpha) as f64);
+        ui.insert_before(glow, b, 0);
+    }
+    ui.tick();
+    raster_fb(&mut ui)
+}
