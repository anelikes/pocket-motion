+#[test]
+fn src_over_a_transparent_destination_keeps_the_colour_between_its_inputs() {
+    // Straight-alpha src-over is a weighted mean of the two colours, so it
+    // lies between them. The colour was divided by the ROUNDED new alpha,
+    // which can sit up to 127/255 below the exact one; with a small
+    // destination alpha that inflated the colour by up to half of it, and
+    // past 255 the byte wrapped: white at 200 over white at 2 was written as
+    // 0. Inside a filter layer every translucent write takes this path, so
+    // two translucent whites overlapping in a glow layer came out as
+    // near-black speckle. Every source alpha over every destination alpha,
+    // for five colour pairs, on a one-pixel transparent frame.
+    let mut ui = Ui::new();
+    ui.set_viewport(1.0, 1.0);
+    let rect = |c: u32| [spec::draw_op::RECT, 0, 1 | (1 << 16), c];
+    let mut bad = alloc::vec::Vec::new();
+    let mut fb = [0u8; 4];
+    for &(s, d) in &[(255u32, 255u32), (100, 100), (0, 255), (255, 0), (37, 201)] {
+        for da in 1..255u32 {
+            for a in 1..255u32 {
+                let mut words = alloc::vec::Vec::new();
+                words.extend_from_slice(&rect(abgr(d as u8, d as u8, d as u8, da as u8)));
+                words.extend_from_slice(&rect(abgr(s as u8, s as u8, s as u8, a as u8)));
+                crate::raster::render(&ui, &words, &mut fb);
+                let (lo, hi) = (s.min(d), s.max(d));
+                let got = fb[0] as u32;
+                if got < lo || got > hi {
+                    bad.push((s, d, a, da, got));
+                }
+                assert_eq!(fb[3] as u32, a + (da * (255 - a) + 127) / 255, "alpha is src-over");
+            }
+        }
+    }
+    assert!(bad.is_empty(), "{} composites left their inputs' range; first {:?}", bad.len(), &bad[..bad.len().min(6)]);
+}
+
+#[test]
+fn a_translucent_white_over_its_white_glow_stays_white() {
+    // A filter layer composites its content over its shadow (a glow is a
+    // shadow at offset 0) with the same straight-alpha src-over, and divided
+    // by the same rounded alpha: white content over a white glow came out
+    // as 256 and up, and the composite wrapped it to near-black — the dark
+    // speckle where translucent white lines overlap in a glow layer. Every
+    // content alpha, at three glow gains, over a transparent frame and over
+    // an opaque white one: the colour stays white.
+    let mut ui = Ui::new();
+    ui.set_viewport(1.0, 1.0);
+    let white = 0xffff_ffffu32;
+    let mut bad = alloc::vec::Vec::new();
+    let mut fb = [0u8; 4];
+    for &ground in &[false, true] {
+        for &gain in &[0.5f32, 1.0, 2.0] {
+            for a in 1..255u32 {
+                let mut words = alloc::vec::Vec::new();
+                if ground {
+                    words.extend_from_slice(&[spec::draw_op::RECT, 0, 1 | (1 << 16), white]);
+                }
+                words.extend_from_slice(&[
+                    spec::draw_op::LAYER_PUSH,
+                    spec::BlendMode::Normal as u32,
+                    0f32.to_bits(),
+                    0f32.to_bits(),
+                    0f32.to_bits(),
+                    0f32.to_bits(),
+                    white,
+                    gain.to_bits(),
+                    spec::draw_op::RECT,
+                    0,
+                    1 | (1 << 16),
+                    abgr(255, 255, 255, a as u8),
+                    spec::draw_op::LAYER_POP,
+                ]);
+                crate::raster::render(&ui, &words, &mut fb);
+                if fb[..3] != [255, 255, 255] {
+                    bad.push((ground, gain, a, fb));
+                }
+            }
+        }
+    }
+    assert!(bad.is_empty(), "{} white-on-white glows were not white; first {:?}", bad.len(), &bad[..bad.len().min(6)]);
+}
