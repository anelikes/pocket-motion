+#[test]
+fn translucent_whites_overlapping_in_a_glow_never_darken() {
+    // White over white cannot darken: wherever both boxes and their glows
+    // reach, the pair is at least as bright as either alone, to the last
+    // bits of rounding — read premultiplied, so a transparent frame's colour
+    // counts by its alpha. With the rounded divisor the glow composite
+    // wrapped white to near-black onto a transparent destination: speckle in
+    // the overlap and along the halo, mask or no mask.
+    for &(masked, ground) in &[(false, false), (true, false), (false, true), (true, true)] {
+        let a = glow_overlap(true, false, masked, ground);
+        let b = glow_overlap(false, true, masked, ground);
+        let both = glow_overlap(true, true, masked, ground);
+        let lum = |fb: &[u8], x: usize, y: usize| {
+            let p = sample_rgba(fb, x, y);
+            (p[0] as i32 + p[1] as i32 + p[2] as i32) * p[3] as i32 / 255
+        };
+        let mut worst = (0i32, 0usize, 0usize);
+        for y in 0..spec::SCREEN_H as usize {
+            for x in 0..spec::SCREEN_W as usize {
+                let drop = lum(&a, x, y).max(lum(&b, x, y)) - lum(&both, x, y);
+                if drop > worst.0 {
+                    worst = (drop, x, y);
+                }
+            }
+        }
+        assert!(worst.0 <= 3, "masked {masked} ground {ground}: the pair is darker than one box alone by {} at ({},{})", worst.0, worst.1, worst.2);
+    }
+}
