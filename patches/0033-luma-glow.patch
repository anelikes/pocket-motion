+#[test]
+fn a_luma_glow_lights_the_bright_pixels_and_leaves_a_dark_plate_dark() {
+    // An alpha glow is CSS's drop shadow at offset 0: made from the layer's
+    // alpha, so an 85 % dark plate in a white glow has a white halo under
+    // its whole area, 15 % of it shows through, and the plate reads lighter
+    // than it does with no glow. A luma glow is made from the bright pixels'
+    // own colour and added over the content: the plate emits nothing and
+    // comes out exactly as with no glow, while a white 2 px line on it gains
+    // a halo, on the plate and past its edge.
+    let plain = bloom_scene(None, false);
+    let alpha = bloom_scene(Some(spec::GlowMode::Alpha), false);
+    let luma = bloom_scene(Some(spec::GlowMode::Luma), false);
+    let at = |fb: &[u8], x: usize, y: usize| sample_rgba(fb, x, y)[0];
+    assert!(at(&alpha, 240, 100) > at(&plain, 240, 100) + 10, "the alpha glow lightens the plate (the case a bloom is for)");
+    assert_eq!(luma, plain, "a dark plate in a luma glow is the plate with no glow, byte for byte");
+    let lined = bloom_scene(None, true);
+    let glowing = bloom_scene(Some(spec::GlowMode::Luma), true);
+    // 8 px above the line, on the plate; and 8 px past the plate's left
+    // edge, level with the line, on the grey ground — fainter there, a 2 px
+    // line's light spread over a 12 px deviation.
+    for &(x, y, by) in &[(240usize, 128usize, 4u8), (132, 136, 1)] {
+        assert!(at(&glowing, x, y) >= at(&lined, x, y) + by, "({x},{y}): no halo: {} against {}", at(&glowing, x, y), at(&lined, x, y));
+    }
+    // The line itself stays white, and nothing anywhere is darker.
+    assert_eq!(sample_rgba(&glowing, 240, 136)[..3], [255, 255, 255]);
+    for y in 0..spec::SCREEN_H as usize {
+        for x in 0..spec::SCREEN_W as usize {
+            assert!(at(&glowing, x, y) >= at(&lined, x, y), "({x},{y}) darker under a luma glow");
+        }
+    }
+}
