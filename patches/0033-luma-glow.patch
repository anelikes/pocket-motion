+/// A luma glow — a bloom (pocket-motion patch 0033). An alpha glow is CSS's
+/// drop shadow at offset 0: the layer's ALPHA, blurred and tinted, under the
+/// content, so a dark translucent plate in a glow layer gets a halo under
+/// its whole area and reads lighter than the ground around it. A luma glow is
+/// light from the bright pixels only: each pixel's own premultiplied colour,
+/// weighted by how far its brightest channel is above `threshold` (0 there,
+/// 1 at 255), offset like a shadow, blurred with the same passes, times gain,
+/// tinted by the glow colour, and ADDED over what the composite left — the
+/// `plus-lighter` blend, which never darkens. A pixel at or below the
+/// threshold emits nothing, so a dark plate comes out as it would with no
+/// glow at all.
+#[allow(clippy::too_many_arguments)]
+fn luma_glow<T: RenderTarget>(
+    target: &mut T,
+    layer: &LayerTarget,
+    fx: &LayerFx,
+    content: Clip,
+    clip: Clip,
+    stride: i32,
+    scale: i32,
+    scratch: &mut Vec<u32>,
+) {
+    let w = stride as usize;
+    let (tr, tg, tb, ta) = channels(fx.shadow_color);
+    let round = |v: f32| -> i32 { if v >= 0.0 { (v + 0.5) as i32 } else { -((-v + 0.5) as i32) } };
+    let dx = round(fx.shadow_x * scale as f32);
+    let dy = round(fx.shadow_y * scale as f32);
+    let sigma = fx.shadow_blur * 0.5 * scale as f32;
+    let pad = blur_pad(sigma);
+    let rect = Clip {
+        x0: content.x0 + dx - pad,
+        y0: content.y0 + dy - pad,
+        x1: content.x1 + dx + pad,
+        y1: content.y1 + dy + pad,
+    }
+    .intersect(clip);
+    if rect.x0 >= rect.x1 || rect.y0 >= rect.y1 {
+        return;
+    }
+    let (rw, rh) = ((rect.x1 - rect.x0) as usize, (rect.y1 - rect.y0) as usize);
+    // Emission per channel, premultiplied, in 1/256ths so the blur keeps
+    // precision: c * a / 255 * key, key = (v - t) / (255 - t) for the
+    // brightest channel v above the threshold t.
+    let t = fx.threshold.min(255);
+    let mut img: Vec<u32> = alloc::vec![0u32; rw * rh * 3];
+    let mut any = false;
+    for y in 0..rh {
+        let ly = rect.y0 + y as i32 - dy;
+        if ly < content.y0 || ly >= content.y1 {
+            continue;
+        }
+        for x in 0..rw {
+            let lx = rect.x0 + x as i32 - dx;
+            if lx < content.x0 || lx >= content.x1 {
+                continue;
+            }
+            let o = (ly as usize * w + lx as usize) * 4;
+            let (r, g, b, a) = (
+                layer.bytes[o] as u64,
+                layer.bytes[o + 1] as u64,
+                layer.bytes[o + 2] as u64,
+                layer.bytes[o + 3] as u64,
+            );
+            let v = r.max(g).max(b) as u32;
+            if a == 0 || v <= t {
+                continue;
+            }
+            let (kn, kd) = if t >= 255 { (1u64, 1u64) } else { ((v - t) as u64, (255 - t) as u64) };
+            let den = 255 * kd;
+            let i = (y * rw + x) * 3;
+            img[i] = ((r * a * kn * 256 + den / 2) / den) as u32;
+            img[i + 1] = ((g * a * kn * 256 + den / 2) / den) as u32;
+            img[i + 2] = ((b * a * kn * 256 + den / 2) / den) as u32;
+            any = true;
+        }
+    }
+    if !any {
+        return;
+    }
+    blur_image(&mut img, rw, rh, 3, sigma, scratch);
+    let gain = (fx.shadow_gain * 256.0 + 0.5) as u64;
+    for y in 0..rh {
+        for x in 0..rw {
+            let i = (y * rw + x) * 3;
+            // 0..255 per channel, times gain, tinted by the glow colour and
+            // its alpha.
+            let ch = |v: u32, tint: u32| -> u32 {
+                let e = ((v as u64 * gain / 256 + 128) / 256).min(255);
+                ((e * tint as u64 * ta as u64 + 255 * 255 / 2) / (255 * 255)) as u32
+            };
+            let (hr, hg, hb) = (ch(img[i], tr), ch(img[i + 1], tg), ch(img[i + 2], tb));
+            let ha = hr.max(hg).max(hb);
+            if ha == 0 {
+                continue;
+            }
+            // Straight colour of a source whose premultiplied colour is the
+            // emission, at the alpha of its brightest channel; added.
+            let un = |p: u32| (p * 255 + ha / 2) / ha;
+            let off = (rect.y0 as usize + y) * w + rect.x0 as usize + x;
+            blend_with(target, off, un(hr), un(hg), un(hb), ha, spec::BlendMode::Add as u32);
+        }
+    }
+}
