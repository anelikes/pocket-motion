+/// A 200 x 120 glow node at (140, 76) over a mid-grey ground holding a dark
+/// plate (#0b0b0b at 85 %) and, when `line`, a white 2 px line across its
+/// full width.
+/// `glow`: None for no glow at all, Some(mode) for a 24 px white glow.
+fn bloom_scene(glow: Option<spec::GlowMode>, line: bool) -> alloc::vec::Vec<u8> {
+    let mut ui = Ui::new();
+    ui.set_prop(spec::ROOT_ID, spec::prop::BG_COLOR, abgr(64, 64, 64, 255) as f64);
+    let g = place_box(&mut ui, 200.0, 120.0, 140.0, 76.0);
+    if let Some(mode) = glow {
+        ui.set_prop(g, spec::prop::DROP_SHADOW_BLUR, 24.0);
+        ui.set_prop(g, spec::prop::DROP_SHADOW_COLOR, abgr(255, 255, 255, 255) as f64);
+        ui.set_prop(g, spec::prop::DROP_SHADOW_GAIN, 1.0);
+        ui.set_prop(g, spec::prop::GLOW_MODE, mode as u32 as f64);
+    }
+    let plate = ui.create_node(0);
+    ui.set_prop(plate, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+    ui.set_prop(plate, spec::prop::WIDTH, 200.0);
+    ui.set_prop(plate, spec::prop::HEIGHT, 120.0);
+    ui.set_prop(plate, spec::prop::BG_COLOR, abgr(11, 11, 11, 217) as f64);
+    ui.insert_before(g, plate, 0);
+    if line {
+        let l = ui.create_node(0);
+        ui.set_prop(l, spec::prop::POS_TYPE, spec::PosType::Absolute as u32 as f64);
+        ui.set_prop(l, spec::prop::INSET_L, 0.0);
+        ui.set_prop(l, spec::prop::INSET_T, 59.0);
+        ui.set_prop(l, spec::prop::WIDTH, 200.0);
+        ui.set_prop(l, spec::prop::HEIGHT, 2.0);
+        ui.set_prop(l, spec::prop::BG_COLOR, abgr(255, 255, 255, 255) as f64);
+        ui.insert_before(g, l, 0);
+    }
+    ui.tick();
+    let words = ui.draw().words.clone();
+    validate_drawlist(&words);
+    raster_fb(&mut ui)
