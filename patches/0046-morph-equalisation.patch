+// ---- morph equalisation (pocket-motion patch 0046) -------------------------------------
+//
+// Keys drawn separately — an icon and another icon — share no command list,
+// and a morph needs one. `equalizeKeys` gives them one without changing any
+// key's outline: every key keeps every point it was written with, cubics are
+// only ever split (de Casteljau, which leaves the curve where it was), and a
+// line is a cubic with controls at 1/3 and 2/3. What it chooses is the
+// correspondence, and it chooses it by these rules, in this order:
+//
+//   1. Subpaths. Key 0's subpaths keep their order, start points and
+//      directions, so a trim or dash on key 0 is what was written. Each
+//      later key is paired with the key before it, closed subpaths with
+//      closed ones by area and open ones with open ones by length, largest
+//      with largest (ties in written order). A subpath with no partner
+//      pairs with a point: the centre of its own bounding box, so it grows
+//      out of or shrinks into itself. A later key's subpaths take the order
+//      of the slots they pair with.
+//   2. Winding. If the largest closed pair winds opposite ways, every
+//      subpath of the later key is reversed; with no closed pair, the
+//      largest open pair decides by which way round its ends sit closer.
+//      A whole key is reversed or none of it, because reversing one subpath
+//      can change what a nonzero fill covers and reversing all of them
+//      cannot.
+//   3. Start points. On each closed pair the later key's start moves to the
+//      point that minimises the summed squared distance between the two
+//      outlines sampled at 64 equal fractions of their arc lengths. The
+//      candidates are the later key's own vertices and 64 equal fractions
+//      of its length; the first of equal scores wins. Open subpaths keep
+//      their ends.
+//   4. Points. On each slot every key is cut at every vertex any key has,
+//      by fraction of arc length, so a corner of one key meets a point at
+//      the same fraction of the other and every key has the same number of
+//      cubics. Fractions within 1e-9 of each other are one vertex.
+//
+// Arc length is measured on 16 chords a cubic, and a fraction becomes a
+// cubic's parameter by interpolating along those chords; that decides only
+// where a cut lands on the curve, never whether a point is on it. All of it
+// is + - * / and Math.sqrt in f64, which IEEE 754 rounds the same on every
+// host, so the bytes a key set bakes to do not depend on the machine.
+
+type Seg = [number, number, number, number, number, number]; // x1 y1 x2 y2 x3 y3
+interface Sub {
+  closed: boolean;
+  x: number;
+  y: number;
+  segs: Seg[];
+}
+
+const CHORDS = 16;
+const SAMPLES = 64;
+const SAME_FRACTION = 1e-9;
+
+function subsOf(p: NormalPath): Sub[] {
+  const out: Sub[] = [];
+  let k = 0;
+  let cur: Sub | null = null;
+  let cx = 0, cy = 0;
+  for (const v of p.verbs) {
+    if (v === PATH_VERB.move) {
+      cur = { closed: false, x: p.pts[k]!, y: p.pts[k + 1]!, segs: [] };
+      out.push(cur);
+      cx = cur.x;
+      cy = cur.y;
+      k += 2;
+    } else if (v === PATH_VERB.line) {
+      const x = p.pts[k]!, y = p.pts[k + 1]!;
+      const dx = x - cx, dy = y - cy;
+      cur!.segs.push([cx + dx / 3, cy + dy / 3, cx + (2 * dx) / 3, cy + (2 * dy) / 3, x, y]);
+      cx = x;
+      cy = y;
+      k += 2;
+    } else if (v === PATH_VERB.cubic) {
+      cur!.segs.push(p.pts.slice(k, k + 6) as Seg);
+      cx = p.pts[k + 4]!;
+      cy = p.pts[k + 5]!;
+      k += 6;
+    } else {
+      // The closing edge made explicit, so a closed subpath's cubics are its
+      // whole cycle and its start can move along it.
+      const s = cur!;
+      s.closed = true;
+      if (cx !== s.x || cy !== s.y) {
+        const dx = s.x - cx, dy = s.y - cy;
+        s.segs.push([cx + dx / 3, cy + dy / 3, cx + (2 * dx) / 3, cy + (2 * dy) / 3, s.x, s.y]);
+      }
+      cx = s.x;
+      cy = s.y;
+    }
+  }
+  return out;
+}
+
+function segStart(s: Sub, i: number): [number, number] {
+  if (i === 0) return [s.x, s.y];
+  const p = s.segs[i - 1]!;
+  return [p[4], p[5]];
+}
+
+function bez(x0: number, y0: number, g: Seg, t: number): [number, number] {
+  const mt = 1 - t;
+  const a = mt * mt * mt, b = 3 * mt * mt * t, c = 3 * mt * t * t, d = t * t * t;
+  return [a * x0 + b * g[0] + c * g[2] + d * g[4], a * y0 + b * g[1] + c * g[3] + d * g[5]];
+}
+
+/** Cumulative chord lengths: CHORDS + 1 per cubic, and the total. */
+interface Measure {
+  cum: number[][];
+  starts: number[];
+  total: number;
+}
+
+function measure(s: Sub): Measure {
+  const cum: number[][] = [];
+  const starts: number[] = [];
+  let total = 0;
+  for (let i = 0; i < s.segs.length; i++) {
+    const [x0, y0] = segStart(s, i);
+    const row = [0];
+    let px = x0, py = y0, acc = 0;
+    for (let j = 1; j <= CHORDS; j++) {
+      const [x, y] = bez(x0, y0, s.segs[i]!, j / CHORDS);
+      acc += Math.sqrt((x - px) * (x - px) + (y - py) * (y - py));
+      row.push(acc);
+      px = x;
+      py = y;
+    }
+    starts.push(total);
+    cum.push(row);
+    total += acc;
+  }
+  return { cum, starts, total };
+}
+
+/** The cubic and its parameter at arc length `at` (0 <= at <= total). */
+function locate(m: Measure, at: number): [number, number] {
+  // The last cubic starting at or before `at`.
+  let lo = 0, hi = m.starts.length - 1;
+  while (lo < hi) {
+    const mid = (lo + hi + 1) >> 1;
+    if (m.starts[mid]! <= at) lo = mid;
+    else hi = mid - 1;
+  }
+  const i = lo;
+  const row = m.cum[i]!;
+  const local = at - m.starts[i]!;
+  let j = 0;
+  while (j + 1 < CHORDS && row[j + 1]! < local) j++;
+  const span = row[j + 1]! - row[j]!;
+  let u = span > 0 ? (local - row[j]!) / span : 0;
+  if (u < 0) u = 0;
+  if (u > 1) u = 1;
+  return [i, (j + u) / CHORDS];
+}
+
+function pointAt(s: Sub, m: Measure, f: number): [number, number] {
+  if (s.segs.length === 0 || !(m.total > 0)) return [s.x, s.y];
+  const [i, t] = locate(m, f * m.total);
+  const [x0, y0] = segStart(s, i);
+  return bez(x0, y0, s.segs[i]!, t);
+}
+
+/** Split cubic `g` from (x0, y0) at t: the two halves. */
+function split(x0: number, y0: number, g: Seg, t: number): [Seg, Seg] {
+  const lerp = (a: number, b: number): number => a + (b - a) * t;
+  const ax = lerp(x0, g[0]), ay = lerp(y0, g[1]);
+  const bx = lerp(g[0], g[2]), by = lerp(g[1], g[3]);
+  const cx = lerp(g[2], g[4]), cy = lerp(g[3], g[5]);
+  const dx = lerp(ax, bx), dy = lerp(ay, by);
+  const ex = lerp(bx, cx), ey = lerp(by, cy);
+  const fx = lerp(dx, ex), fy = lerp(dy, ey);
+  return [
+    [ax, ay, dx, dy, fx, fy],
+    [ex, ey, cx, cy, g[4], g[5]],
+  ];
+}
+
+function signedArea(s: Sub): number {
+  if (!s.closed) return 0;
+  let a = 0;
+  for (let i = 0; i < s.segs.length; i++) {
+    const [x0, y0] = segStart(s, i);
+    let px = x0, py = y0;
+    for (let j = 1; j <= CHORDS; j++) {
+      const [x, y] = bez(x0, y0, s.segs[i]!, j / CHORDS);
+      a += px * y - x * py;
+      px = x;
+      py = y;
+    }
+  }
+  return a / 2;
+}
+
+function centre(s: Sub): [number, number] {
+  let x0 = s.x, x1 = s.x, y0 = s.y, y1 = s.y;
+  for (const g of s.segs) {
+    for (let k = 0; k < 6; k += 2) {
+      if (g[k]! < x0) x0 = g[k]!;
+      if (g[k]! > x1) x1 = g[k]!;
+      if (g[k + 1]! < y0) y0 = g[k + 1]!;
+      if (g[k + 1]! > y1) y1 = g[k + 1]!;
+    }
+  }
+  return [(x0 + x1) / 2, (y0 + y1) / 2];
+}
+
+const pointSub = (closed: boolean, [x, y]: [number, number]): Sub => ({ closed, x, y, segs: [] });
+
+function reversed(s: Sub): Sub {
+  if (s.segs.length === 0) return s;
+  const last = s.segs[s.segs.length - 1]!;
+  const segs: Seg[] = [];
+  for (let i = s.segs.length - 1; i >= 0; i--) {
+    const g = s.segs[i]!;
+    const [x0, y0] = segStart(s, i);
+    segs.push([g[2], g[3], g[0], g[1], x0, y0]);
+  }
+  return { closed: s.closed, x: last[4], y: last[5], segs };
+}
+
+/** A closed subpath started at fraction f of its length instead (split there unless f is a vertex). */
+function rotated(s: Sub, m: Measure, f: number): Sub {
+  if (f === 0 || s.segs.length === 0) return s;
+  const [i, t] = locate(m, f * m.total);
+  const [x0, y0] = segStart(s, i);
+  let head: Seg[], tail: Seg[];
+  if (t <= 0) {
+    head = s.segs.slice(i);
+    tail = s.segs.slice(0, i);
+  } else if (t >= 1) {
+    head = s.segs.slice(i + 1);
+    tail = s.segs.slice(0, i + 1);
+  } else {
+    const [l, r] = split(x0, y0, s.segs[i]!, t);
+    head = [r, ...s.segs.slice(i + 1)];
+    tail = [...s.segs.slice(0, i), l];
+  }
+  const segs = [...head, ...tail];
+  const st = tail[tail.length - 1]!;
+  return { closed: true, x: st[4], y: st[5], segs };
+}
+
+/** Arc-length fractions of a subpath's interior vertices (a closed one's start is 0). */
+function vertexFractions(s: Sub, m: Measure): number[] {
+  if (!(m.total > 0)) return [];
+  const out: number[] = [];
+  for (let i = 1; i < s.segs.length; i++) out.push(m.starts[i]! / m.total);
+  return out;
+}
+
+/**
+ * A subpath re-cut so it has a vertex at every cut: `cuts` are sorted
+ * fractions in (0, 1), `need[g]` how many vertices every key has at cut g
+ * (more than one where a key repeats a point), and `own[g]` how many of
+ * them are this subpath's own. A cut it does not own splits the cubic it
+ * falls in; a vertex it lacks is a cubic that goes nowhere.
+ */
+function resample(s: Sub, m: Measure, cuts: number[], need: number[], own: number[]): Sub {
+  const n = need.reduce((a, b) => a + b, 1);
+  const zero = (x: number, y: number): Seg => [x, y, x, y, x, y];
+  if (s.segs.length === 0 || !(m.total > 0)) {
+    // A point, or a subpath of no length: n cubics that go nowhere.
+    return { closed: s.closed, x: s.x, y: s.y, segs: Array.from({ length: n }, () => zero(s.x, s.y)) };
+  }
+  // Where each cut lands: inside cubic i at t (a split), or on the vertex
+  // that ends cubic i (this subpath's own, or a split that met the end).
+  const inside: { t: number; extra: number }[][] = s.segs.map(() => []);
+  const after: number[] = s.segs.map(() => 0); // nowhere-cubics after cubic i
+  const before = { extra: 0 }; // nowhere-cubics before the first cubic
+  let ownSeen = 0; // own interior vertices passed so far
+  for (let g = 0; g < cuts.length; g++) {
+    if (own[g]! > 0) {
+      // Vertex ownSeen + 1 ends cubic ownSeen.
+      after[ownSeen]! += need[g]! - own[g]!;
+      ownSeen += own[g]!;
+      continue;
+    }
+    const [i, t] = locate(m, cuts[g]! * m.total);
+    if (t <= 0 && i === 0) before.extra += need[g]!;
+    else if (t <= 0) after[i - 1]! += need[g]!;
+    else if (t >= 1) after[i]! += need[g]!;
+    else inside[i]!.push({ t, extra: need[g]! - 1 });
+  }
+  const segs: Seg[] = [];
+  for (let k = 0; k < before.extra; k++) segs.push(zero(s.x, s.y));
+  for (let i = 0; i < s.segs.length; i++) {
+    let [x0, y0] = segStart(s, i);
+    let g = s.segs[i]!;
+    let done = 0;
+    for (const { t, extra } of inside[i]!) {
+      const [l, r] = split(x0, y0, g, (t - done) / (1 - done));
+      segs.push(l);
+      for (let k = 0; k < extra; k++) segs.push(zero(l[4], l[5]));
+      x0 = l[4];
+      y0 = l[5];
+      g = r;
+      done = t;
+    }
+    segs.push(g);
+    for (let k = 0; k < after[i]!; k++) segs.push(zero(g[4], g[5]));
+  }
+  if (segs.length !== n) throw new PathDataError(`morph equalisation cut a subpath into ${segs.length} cubics, not ${n}`);
+  return { closed: s.closed, x: s.x, y: s.y, segs };
+}
+
+function score(a: Sub, ma: Measure, b: Sub, mb: Measure, shift: number): number {
+  let sum = 0;
+  for (let i = 0; i < SAMPLES; i++) {
+    const f = i / SAMPLES;
+    let g = f + shift;
+    if (g >= 1) g -= 1;
+    const [ax, ay] = pointAt(a, ma, f);
+    const [bx, by] = pointAt(b, mb, g);
+    sum += (ax - bx) * (ax - bx) + (ay - by) * (ay - by);
+  }
+  return sum;
+}
+
+/** Morph keys whose commands differ, on one verb list by the rules above. */
+function equalizeKeys(paths: NormalPath[]): NormalPath[] {
+  const keys = paths.map(subsOf);
+  // slots[s][k]: key k's subpath in slot s.
+  const slots: Sub[][] = keys[0]!.map((s) => [s]);
+  for (let k = 1; k < keys.length; k++) {
+    let mine = keys[k]!.slice();
+    const prev = slots.map((sl) => sl[k - 1]!);
+    const size = (s: Sub): number => {
+      const m = measure(s);
+      return s.closed ? Math.abs(signedArea(s)) : m.total;
+    };
+    // 1. Pair closed with closed and open with open, largest with largest.
+    const placed: (Sub | null)[] = prev.map(() => null);
+    const extra: Sub[] = [];
+    for (const closed of [true, false]) {
+      const slotIx = prev.map((s, i) => [i, s] as const).filter(([, s]) => s.closed === closed);
