diff --git a/engine/core/src/lib.rs b/engine/core/src/lib.rs
index fd71ee6..6c3ddc1 100644
--- a/engine/core/src/lib.rs
+++ b/engine/core/src/lib.rs
@@ -644,6 +644,45 @@ impl Ui {
         if node.node_type == spec::NodeType::Image as u8 {
             node.tex = if tex < 0 { -1 } else { tex };
             node.sprite_frames = 0; // set_image reverts a sprite to a static image
+            // node.uv is deliberately NOT reset — see set_image_uv.
+        }
+    }
+
+    /// Narrow a PLAIN image node to a sub-rect of its texture, in normalized
+    /// UV. The default (0, 0, 1, 1) is the whole texture, which is what every
+    /// image drew before this existed.
+    ///
+    /// The DrawList has always carried per-quad UVs and every backend already
+    /// honors them (`hosts/psp/src/ge.rs` converts them to raw texels); the only
+    /// caller that ever passed anything but the whole texture was the animated
+    /// sprite, whose cell the core derives from its own frame counter. So a
+    /// caller wanting a STATIC sub-rect had no way to ask, and a one-frame
+    /// sprite cannot substitute — its index is always 0.
+    ///
+    /// The motivating case is a picture too large for one texture
+    /// (`TEX_MAX_DIM`): split it into tiles and each tile is its own texture, so
+    /// bilinear at a tile's edge clamps against itself instead of blending with
+    /// the neighbour and the joins show. Give each tile a texel of the
+    /// neighbour's pixels, inset its UV by that texel, and the joins sample
+    /// exactly as one large texture would.
+    ///
+    /// Sticky across `set_image`: the sub-rect describes the node's geometry,
+    /// not the binding, so a host streaming a new texture into the node every
+    /// frame states it once. A bound sprite ignores it.
+    pub fn set_image_uv(&mut self, id: i32, u0: f32, v0: f32, u1: f32, v1: f32) {
+        // Reject anything that is not a usable rect rather than clamping into
+        // one: a non-finite or inverted edge means the caller computed it wrong,
+        // and quietly drawing some other crop would hide that.
+        if !(u0.is_finite() && v0.is_finite() && u1.is_finite() && v1.is_finite()) {
+            return;
+        }
+        if u1 <= u0 || v1 <= v0 {
+            return;
+        }
+        let Some(slot) = self.tree.resolve(id) else { return };
+        let node = &mut self.tree.slots[slot as usize];
+        if node.node_type == spec::NodeType::Image as u8 {
+            node.uv = [u0, v0, u1, v1];
         }
     }
 
