{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.motion-images",
  "name": "pocketjs-motion-images",
  "title": "PocketJS Motion: images of any size",
  "version": "0.0.0",
  "engine": { "capabilities": { "requires": ["text.glyphs.baked"] } },
  "app": {
    "entry": "compositions/images/main.tsx",
    "output": "motion-images",
    "framework": "solid",
    "viewport": { "fixed": { "logical": [1920, 1080], "presentation": "native" } }
  }
}
