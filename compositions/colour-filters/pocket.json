{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.motion-colour-filters",
  "name": "pocketjs-motion-colour-filters",
  "title": "PocketJS Motion: colour filters, still and animated",
  "version": "0.0.0",
  "engine": { "capabilities": { "requires": ["text.glyphs.baked"] } },
  "app": {
    "entry": "compositions/colour-filters/main.tsx",
    "output": "motion-colour-filters",
    "framework": "solid",
    "viewport": { "fixed": { "logical": [960, 540], "presentation": "native" } }
  }
}
