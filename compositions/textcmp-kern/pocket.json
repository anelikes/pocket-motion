{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.motion-textcmp-kern",
  "name": "pocketjs-motion-textcmp-kern",
  "title": "PocketJS Motion: kerning pairs",
  "version": "0.0.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked"
      ]
    }
  },
  "app": {
    "entry": "compositions/textcmp-kern/main.tsx",
    "output": "motion-textcmp-kern",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          1920,
          1080
        ],
        "presentation": "native"
      }
    }
  }
}