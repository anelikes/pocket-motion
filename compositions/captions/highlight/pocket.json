{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.motion-captions-highlight",
  "name": "pocketjs-motion-captions-highlight",
  "title": "PocketJS Motion: captions / highlight",
