{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.motion-captions-alpha-en",
  "name": "pocketjs-motion-captions-alpha-en",
  "title": "PocketJS Motion: captions / alpha-en",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked"
      ]
    }
  },
  "app": {
    "entry": "compositions/captions/alpha-en/main.tsx",
    "output": "motion-captions-alpha-en",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          1920,
          1080
        ],
        "presentation": "native"
      }
    }
  }
}
